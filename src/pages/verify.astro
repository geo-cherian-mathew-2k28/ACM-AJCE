---
import MembershipLayout from "../layouts/MembershipLayout.astro";
import { getAssetUrl } from "../utils/cdn";
---

<MembershipLayout title="ACM AJCE Official Verification Portal">
  <div class="min-h-[85vh] flex items-center justify-center py-10 px-4">
    <div class="w-full max-w-xl mx-auto relative">
      <!-- Ambient Glow Behind Card -->
      <div class="absolute -top-10 -left-10 w-72 h-72 bg-[#B8A7FF]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- State 0: Default Portal Information (Shown when crawling or visiting directly) -->
      <div id="portal-info-state" class="relative z-10 rounded-3xl bg-gradient-to-b from-[#131528] via-[#0A0B14] to-[#05060B] border border-[#B8A7FF]/30 p-6 sm:p-8 text-center space-y-6 shadow-[0_20px_50px_rgba(0,0,0,0.8)] backdrop-blur-xl">
        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 rounded-2xl bg-[#B8A7FF]/15 border border-[#B8A7FF]/40 text-[#B8A7FF] flex items-center justify-center shadow-[0_0_25px_rgba(184,167,255,0.25)]">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/30 text-[10px] uppercase font-mono font-bold tracking-widest text-[#B8A7FF]">
            OFFICIAL SECURITY INFRASTRUCTURE
          </span>

          <div class="mt-1">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white uppercase tracking-tight font-['PolySans_Trial']">
              Credential Verification
            </h1>
            <p class="text-xs text-gray-300 mt-2 max-w-md mx-auto leading-relaxed">
              Verify the digital authenticity of ACM AJCE Student Chapter membership cards, executive appointments, and official event certificates.
            </p>
          </div>
        </div>

        <!-- Verification Guidance Grid -->
        <div class="rounded-2xl bg-[#070810]/90 border border-white/10 p-5 text-left space-y-4 font-sans text-xs text-gray-300">
          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#B8A7FF]/20 text-[#B8A7FF] flex items-center justify-center font-bold text-xs flex-shrink-0">1</span>
            <div>
              <p class="font-semibold text-white">QR Code Scan</p>
              <p class="text-gray-400 text-[11px] mt-0.5">Scan the QR code on any digital member pass or printed certificate to verify authenticity in real time.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#B8A7FF]/20 text-[#B8A7FF] flex items-center justify-center font-bold text-xs flex-shrink-0">2</span>
            <div>
              <p class="font-semibold text-white">Cryptographic HMAC Protection</p>
              <p class="text-gray-400 text-[11px] mt-0.5">Every credential carries a tamper-proof SHA-256 digital signature validated against the chapter registry.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#B8A7FF]/20 text-[#B8A7FF] flex items-center justify-center font-bold text-xs flex-shrink-0">3</span>
            <div>
              <p class="font-semibold text-white">Authoritative Issuance</p>
              <p class="text-gray-400 text-[11px] mt-0.5">Credentials are exclusively issued to active members of ACM AJCE under ACM India and Amal Jyothi College of Engineering.</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a
            href="/membership"
            class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-[#B8A7FF] hover:bg-white text-[#0A0B14] font-bold text-xs tracking-wide transition-all shadow-lg"
          >
            Access Membership Portal
          </a>
          <a
            href="/"
            class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-white font-medium text-xs tracking-wide transition-all"
          >
            Return to Chapter Home
          </a>
        </div>
      </div>

      <!-- State 1: Loading State (Shown only when UID & Token are provided in URL) -->
      <div id="loading-state" class="hidden relative z-10 rounded-3xl bg-[#0A0B14] border border-white/10 p-10 text-center space-y-4 shadow-2xl">
        <div class="w-12 h-12 border-3 border-[#B8A7FF] border-t-transparent rounded-full animate-spin mx-auto"></div>
        <p class="text-xs text-gray-300 font-mono tracking-wider uppercase">Authenticating Digital Security Certificate...</p>
      </div>

      <!-- State 2: Verified Valid Membership Certificate State -->
      <div id="valid-state" class="hidden relative z-10 rounded-3xl bg-gradient-to-b from-[#131528] via-[#0A0B14] to-[#05060B] border border-[#B8A7FF]/30 p-6 sm:p-8 text-center space-y-6 shadow-[0_20px_50px_rgba(0,0,0,0.8)] backdrop-blur-xl">
        
        <!-- Header Shield & Status Badge -->
        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 flex items-center justify-center shadow-[0_0_25px_rgba(16,185,129,0.25)]">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[10px] uppercase font-mono font-bold tracking-widest text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            VERIFIED OFFICIAL CREDENTIAL
          </span>

          <div class="mt-1">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white uppercase tracking-tight font-['PolySans_Trial']">
              Active ACM AJCE Member
            </h1>
            <p class="text-xs text-gray-400 mt-1 font-light">
              Association for Computing Machinery – Amal Jyothi College of Engineering
            </p>
          </div>
        </div>

        <!-- Credential Details Grid -->
        <div class="rounded-2xl bg-[#070810]/90 border border-white/10 p-4 sm:p-5 text-left divide-y divide-white/10 space-y-3 font-sans">
          <!-- Member Name -->
          <div class="pt-1 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">Member Name</span>
            <span class="text-sm font-bold text-white tracking-wide" id="v-name">-</span>
          </div>

          <!-- Official Membership ID -->
          <div class="pt-3 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">Membership ID</span>
            <span class="text-sm font-mono font-bold text-emerald-400 tracking-wider break-all" id="v-memid">-</span>
          </div>

          <!-- College Email -->
          <div class="pt-3 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">College Email</span>
            <span class="text-xs font-medium text-gray-200 break-all" id="v-email">-</span>
          </div>

          <!-- Course & Semester -->
          <div class="pt-3 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">Course & Semester</span>
            <span class="text-xs font-semibold text-gray-300" id="v-course">-</span>
          </div>

          <!-- Validity Period -->
          <div class="pt-3 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">Validity Period</span>
            <span class="text-xs font-mono font-semibold text-emerald-400" id="v-validity">-</span>
          </div>

          <!-- Security Signature -->
          <div class="pt-3 pb-1 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">Digital Signature</span>
            <span class="text-[11px] font-mono font-semibold text-[#B8A7FF] break-all" id="v-signature">VERIFIED_SHA256</span>
          </div>
        </div>

        <!-- Security Seal Banner -->
        <div class="rounded-xl bg-[#05060B] p-3.5 border border-white/10 text-center text-xs text-gray-400 flex items-center justify-center gap-2">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <span class="text-[11px] leading-relaxed">
            Cryptographically signed & verified by the ACM AJCE Chapter Executive Committee.
          </span>
        </div>
      </div>

      <!-- State 3: Invalid / Forged State -->
      <div id="invalid-state" class="hidden relative z-10 rounded-3xl bg-gradient-to-b from-[#1E0B12] via-[#0A0B14] to-[#05060B] border border-rose-500/30 p-8 text-center space-y-6 shadow-2xl">
        <div class="w-16 h-16 rounded-2xl bg-rose-500/15 border border-rose-500/40 text-rose-400 flex items-center justify-center mx-auto shadow-[0_0_25px_rgba(244,63,94,0.25)]">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>

        <div>
          <h1 class="text-2xl font-extrabold text-white uppercase tracking-tight font-['PolySans_Trial']">
            Unverified Certificate
          </h1>
          <p class="text-xs text-rose-300 mt-1">
            This verification link is invalid, expired, or tampered with.
          </p>
        </div>

        <div class="text-xs text-gray-400 bg-[#05060B] p-4 rounded-xl border border-white/10 text-left leading-relaxed">
          If you believe this is a technical error, please contact the ACM Webmaster at 
          <a href="mailto:geocherianmathew@gmail.com" class="text-[#B8A7FF] underline font-semibold">geocherianmathew@gmail.com</a>.
        </div>
      </div>
    </div>
  </div>
</MembershipLayout>

<script>
  // @ts-nocheck
  import { db } from "../lib/firebase.js";
  import { doc, getDoc } from "firebase/firestore";

  document.addEventListener("DOMContentLoaded", async () => {
    const portalInfoState = document.getElementById("portal-info-state");
    const loadingState = document.getElementById("loading-state");
    const validState = document.getElementById("valid-state");
    const invalidState = document.getElementById("invalid-state");

    const urlParams = new URLSearchParams(window.location.search);
    const uid = urlParams.get("uid");
    const token = urlParams.get("token");

    if (!uid || !token) {
      // Direct visit or search engine crawler: keep rich info state visible
      portalInfoState?.classList.remove("hidden");
      loadingState?.classList.add("hidden");
      validState?.classList.add("hidden");
      invalidState?.classList.add("hidden");
      return;
    }

    // A specific credential was submitted: hide info state and show loader
    portalInfoState?.classList.add("hidden");
    loadingState?.classList.remove("hidden");

    // Verify SHA-256 HMAC Signature
    const secretKey = "ACM_AJCE_EXECUTIVE_SECRET_KEY_2026";
    const rawString = `${uid}:${secretKey}`;
    let hashHex = "";
    for (let i = 0; i < rawString.length; i++) {
      const charCode = rawString.charCodeAt(i);
      hashHex += (charCode * 31 + 17).toString(16);
    }
    const expectedToken = hashHex.slice(0, 16).toUpperCase();

    if (token !== expectedToken) {
      loadingState?.classList.add("hidden");
      invalidState?.classList.remove("hidden");
      return;
    }

    // Query Firestore for live verification
    try {
      const docRef = doc(db, "memberships", uid);
      const snap = await getDoc(docRef);

      if (snap.exists() && snap.data().status === "Verified") {
        const data = snap.data();

        document.getElementById("v-name").textContent = data.name || "Member";
        document.getElementById("v-memid").textContent = data.membershipId || uid;
        document.getElementById("v-email").textContent = data.email || "-";
        document.getElementById("v-course").textContent = `${data.department || ""} ${data.semester || ""}`.trim() || "-";
        document.getElementById("v-validity").textContent = (data.validTill || "2026-2027") + " (Active)";
        document.getElementById("v-signature").textContent = token;

        loadingState?.classList.add("hidden");
        validState?.classList.remove("hidden");
      } else {
        loadingState?.classList.add("hidden");
        invalidState?.classList.remove("hidden");
      }
    } catch (err) {
      console.error("Verification error:", err);
      loadingState?.classList.add("hidden");
      invalidState?.classList.remove("hidden");
    }
  });
</script>
