---
import MembershipLayout from "../../layouts/MembershipLayout.astro";
import { getAssetUrl } from "../../utils/cdn";
import cardBgImage from "../../assets/membership-card-bg.png";
const cardBgUrl = cardBgImage.src;
---

<MembershipLayout title="ACM AJCE Membership Portal">
  <div class="membership-container max-w-4xl mx-auto py-8 px-4">
    
    <!-- State 0: Google Authentication Gate -->
    <div id="auth-gate-view" class="portal-panel max-w-md mx-auto p-8 text-center space-y-6">
      <div class="w-16 h-16 rounded-full bg-[#2A2455] border border-[#4D4770] flex items-center justify-center mx-auto text-[#B8A7FF]">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457-.39-2.823-1.07-4"></path>
        </svg>
      </div>

      <div>
        <h1 class="text-2xl font-extrabold text-white mb-2">Student Verification</h1>
        <p class="text-xs text-gray-300 leading-relaxed">
          Sign in with your Google account to access the ACM Membership Registration.
        </p>
      </div>

      <div id="auth-error-banner" class="hidden p-3 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold"></div>

      <button id="google-login-btn" type="button" class="w-full py-3.5 px-5 rounded-xl bg-white hover:bg-gray-100 text-gray-900 font-bold text-sm flex items-center justify-center gap-3 transition-all shadow-lg cursor-pointer">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Sign in with Google
      </button>
    </div>

    <!-- State 1: Membership Form View -->
    <div id="form-view" class="hidden">
      <!-- User Profile Header -->
      <div class="bg-[#131124] border border-[#2A2455] rounded-2xl p-4 sm:p-6 mb-8 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img id="user-photo" src="" alt="User Avatar" class="w-11 h-11 rounded-full border border-[#4D4770] hidden" />
          <div id="user-avatar-fallback" class="w-11 h-11 rounded-full bg-[#2A2455] flex items-center justify-center text-white font-bold text-lg">A</div>
          <div>
            <p class="text-white font-semibold text-sm" id="user-name">Loading Profile...</p>
            <p class="text-xs text-[#B8A7FF]" id="user-email">@ajce.in</p>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs px-3 py-1 rounded-full font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Verified Student
          </span>
          <button id="signout-btn" type="button" class="text-xs text-gray-400 hover:text-rose-400 transition-colors underline cursor-pointer">
            Sign Out
          </button>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Main Registration Form -->
        <div class="md:col-span-2 portal-panel p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-white mb-1">Student Details</h2>
          <p class="text-xs text-gray-400 mb-6">Fill in all required fields to complete your ACM AJCE chapter membership registration.</p>

          <form id="membership-form" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Full Name *</label>
              <input type="text" id="input-fullName" name="fullName" required class="portal-input w-full" placeholder="Enter your full name" />
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Course *</label>
                <select id="input-course" name="course" required class="portal-input w-full">
                  <option value="">Select Course</option>
                  <option value="B.Tech">B.Tech</option>
                  <option value="BCA">BCA</option>
                  <option value="MCA">MCA</option>
                  <option value="Integrated MCA">Integrated MCA</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Semester *</label>
                <select id="input-semester" name="semester" required class="portal-input w-full">
                  <option value="">Select Semester</option>
                  <option value="S1">S1</option>
                  <option value="S2">S2</option>
                  <option value="S3">S3</option>
                  <option value="S4">S4</option>
                  <option value="S5">S5</option>
                  <option value="S6">S6</option>
                  <option value="S7">S7</option>
                  <option value="S8">S8</option>
                  <option value="S9">S9</option>
                  <option value="S10">S10</option>
                </select>
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Department *</label>
                <input type="text" id="input-department" name="department" required class="portal-input w-full" placeholder="Computer Science & Engineering" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Phone No. (WhatsApp) *</label>
                <input type="tel" id="input-phone" name="phone" required class="portal-input w-full" placeholder="9876543210" pattern="[0-9]{10}" title="Please enter a valid 10-digit mobile number" />
              </div>
            </div>

            <!-- Payment & Verification Fields -->
            <div class="pt-4 border-t border-[#2A2455]">
              <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-[#B8A7FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                Payment & Verification
              </h3>

              <div class="grid sm:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Transaction ID / UPI Ref *</label>
                  <input type="text" id="input-txnId" name="txnId" required class="portal-input w-full" placeholder="e.g. 423589123456" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Payment Screenshot *</label>
                  <input type="file" id="input-screenshot" name="screenshot" accept="image/*" required class="portal-input w-full text-xs text-gray-400 file:mr-3 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-[#2A2455] file:text-[#B8A7FF] hover:file:bg-[#3D3575]" />
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <button id="submit-btn" type="submit" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-[#6A5ACD] to-[#8A2BE2] hover:from-[#7B68EE] hover:to-[#9370DB] text-white font-bold text-base shadow-lg transition-all cursor-pointer mt-6 flex items-center justify-center gap-2">
              <span id="submit-btn-text">Submit Registration</span>
              <div id="submit-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
            </button>
          </form>
        </div>

        <!-- Payment Sidebar -->
        <div class="portal-panel p-6 flex flex-col items-center text-center justify-between">
          <div>
            <span class="inline-block text-[#B8A7FF] font-mono text-[11px] uppercase tracking-wider font-bold mb-1">Annual Chapter Fee</span>
            <h3 class="text-3xl font-extrabold text-white mb-2">₹200 <span class="text-xs text-gray-400 font-normal">/ 1 year</span></h3>
            <p class="text-xs text-gray-300 mb-4 leading-relaxed">Scan the QR code below using any UPI App (GPay, PhonePe, Paytm) to complete payment.</p>

            <!-- QR Code -->
            <div class="bg-white p-3 rounded-xl shadow-md inline-block mb-4">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=upi://pay?pa=acmajce@upi&pn=ACM%20AJCE%20Chapter&am=200.00&cu=INR" alt="ACM AJCE Payment QR" class="w-40 h-40 object-contain mx-auto" />
              <p class="text-[10px] text-gray-600 font-mono mt-1 font-semibold">UPI ID: acmajce@upi</p>
            </div>

            <div class="w-full space-y-2 mb-4">
              <a href="upi://pay?pa=acmajce@upi&pn=ACM%20AJCE%20Chapter&am=200.00&cu=INR" class="w-full py-2.5 px-4 rounded-lg bg-white hover:bg-gray-100 text-gray-900 font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-sm">
                Pay ₹200 via GPay / PhonePe
              </a>
            </div>
          </div>

          <div class="text-[11px] text-gray-400 bg-[#131124] p-3 rounded-lg border border-[#2A2455] w-full text-left">
            <p class="font-semibold text-white mb-1">📌 Instructions:</p>
            <ol class="list-decimal list-inside space-y-1">
              <li>Pay ₹200 via UPI.</li>
              <li>Copy the 12-digit UTR/Txn ID.</li>
              <li>Attach screenshot & submit.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- State 2: Verification Pending / Active Status Screen -->
    <div id="status-view" class="hidden portal-panel text-center max-w-lg mx-auto py-10 px-6">
      <div id="status-badge" class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 mb-6 shadow-xl">
        <svg id="status-icon" class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      
      <p class="portal-eyebrow text-[#B8A7FF] font-mono text-xs uppercase tracking-widest mb-1 font-bold">ACM Chapter Membership</p>
      <h1 id="status-title" class="text-2xl font-extrabold text-white mb-3">Verification Pending</h1>
      <p id="status-desc" class="text-gray-300 text-xs mb-6 leading-relaxed">
        Your registration details and payment transaction receipt have been recorded in Firestore DB and are currently under executive review.
      </p>

      <div class="bg-[#131124] border border-[#2A2455] rounded-xl p-5 mb-6 text-left text-xs space-y-3">
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Student Name:</span>
          <span class="text-white font-semibold" id="view-name">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">College Email:</span>
          <span class="text-white font-medium" id="view-email">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Course & Semester:</span>
          <span class="text-gray-200 font-medium" id="view-course-sem">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Transaction UTR:</span>
          <span class="text-amber-300 font-mono font-semibold" id="view-txnid">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Current Status:</span>
          <span class="font-bold" id="view-status">Pending</span>
        </div>
        
        <!-- Official Membership ID Card Section (Visible once Verified) -->
        <div id="verified-card" class="hidden pt-4 border-t border-emerald-500/30">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Official ACM AJCE Membership Pass
              </span>

              <button id="copy-mem-id-btn" type="button" class="py-1 px-3 rounded-lg bg-[#2A2455] hover:bg-[#3D3575] text-[#B8A7FF] text-xs font-semibold flex items-center gap-1.5 border border-[#4D4770] transition-all cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                <span id="copy-mem-text">Copy ID</span>
              </button>
            </div>

            <!-- Pixel-Perfect Digital Membership Card Pass -->
            <div id="membership-card-pass" class="w-full max-w-xl mx-auto rounded-3xl border-2 border-[#B8A7FF]/50 shadow-[0_30px_70px_rgba(0,0,0,0.95)] relative overflow-hidden bg-[#0A0B14] text-white select-none" style="aspect-ratio: 1.6 / 1;">
              
              <!-- 100% Guaranteed Background Template Image Layer -->
              <img 
                src={cardBgImage.src} 
                alt="" 
                class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none" 
              />

              <!-- High-Tech Ambient Dark Vignette Overlay -->
              <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/30 z-[1] pointer-events-none"></div>

              <!-- Card Content Overlay Layer -->
              <div class="relative z-10 h-full p-5 sm:p-7 flex flex-col justify-between">
                
                <!-- Top Header Bar -->
                <div class="flex items-center justify-between pl-3 sm:pl-5 pt-1">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#00FFC2] animate-pulse shadow-[0_0_8px_#00FFC2]"></span>
                    <span class="text-[9px] sm:text-[11px] font-mono font-extrabold text-[#B8A7FF] uppercase tracking-widest">
                      ACM AJCE STUDENT CHAPTER
                    </span>
                  </div>
                  <!-- Note: Top Right is left clear for pre-printed ACM logo on template image -->
                </div>

                <!-- Middle Content Grid -->
                <div class="grid grid-cols-12 gap-3 items-center my-auto pl-3 sm:pl-5 pr-2 sm:pr-4">
                  <!-- Member Info (7 Columns) -->
                  <div class="col-span-7 sm:col-span-7 text-left space-y-1.5 pr-1">
                    <h3 id="card-view-name" class="text-base sm:text-2xl font-black text-white tracking-tight truncate leading-tight drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] font-display">
                      Admin tester
                    </h3>

                    <div>
                      <span id="card-view-id" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#00FFC2]/15 border border-[#00FFC2]/40 text-[#00FFC2] font-mono font-bold text-[11px] sm:text-xs tracking-wider shadow-sm backdrop-blur-sm">
                        ID: ACM-AJCE-1VLG5
                      </span>
                    </div>

                    <div class="pt-1 space-y-0.5 text-[10px] sm:text-xs text-gray-200 font-sans">
                      <p class="truncate font-medium text-gray-100">
                        Course: <span id="card-view-course" class="font-bold text-white">MCA (S6)</span>
                      </p>
                      <p class="truncate font-medium text-gray-300">
                        Email: <span id="card-view-email" class="font-mono text-gray-200">admintester@gmail.com</span>
                      </p>
                      <p class="font-mono text-[#B8A7FF] pt-1 text-[9px] sm:text-[11px] font-bold tracking-wider">
                        VALID: <span id="card-view-validity" class="text-white">Aug 6, 2026 – Aug 6, 2027</span>
                      </p>
                    </div>
                  </div>

                  <!-- QR Code Container (5 Columns) -->
                  <div class="col-span-5 sm:col-span-5 flex flex-col items-center justify-center">
                    <div class="bg-white/95 backdrop-blur-md p-2 sm:p-2.5 rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.6)] text-center border-2 border-[#B8A7FF]/80 flex flex-col items-center">
                      <img id="view-security-qr" src="" alt="Verification QR" class="w-16 h-16 sm:w-26 sm:h-26 object-contain" />
                      <span class="text-[7px] sm:text-[9px] text-purple-950 font-mono font-extrabold block mt-1 uppercase tracking-widest whitespace-nowrap">
                        SCAN TO VERIFY
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Bottom Footer Tag -->
                <div class="pl-3 sm:pl-5 pb-1 flex items-center justify-between border-t border-purple-500/20 pt-2">
                  <span class="text-[8px] sm:text-[10px] font-mono font-bold text-[#00FFC2] uppercase tracking-widest drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]">
                    AUTHENTICATED DIGITAL CREDENTIAL
                  </span>
                </div>

              </div>
            </div>

            <!-- Download Card Button -->
            <button id="download-card-btn" type="button" class="w-full py-3 px-5 rounded-2xl bg-gradient-to-r from-[#6A5ACD] to-[#2A2455] hover:from-[#7B6AD8] hover:to-[#362E69] text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-xl transition-all cursor-pointer border border-[#B8A7FF]/40">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              Download Official Membership Pass (PNG)
            </button>
          </div>
        </div>
      </div>

      <!-- Webmaster Support Contact -->
      <div class="mb-6 p-3 rounded-xl bg-[#131124] border border-[#2A2455] text-xs text-gray-400">
        Having issues with your verification or registration? 
        <button id="webmaster-mail-btn" type="button" class="text-[#B8A7FF] hover:text-white font-semibold underline ml-1 cursor-pointer">
          Contact Webmaster Support
        </button>
      </div>

      <button id="signout-status-btn" type="button" class="text-xs text-gray-400 hover:text-white transition-colors underline cursor-pointer">
        Sign Out of Account
      </button>
    </div>

  </div>
</MembershipLayout>

<style>
  .portal-panel {
    background: #0D0B18;
    border: 1px solid #2A2455;
    border-radius: 1.25rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }

  .portal-input {
    background: #131124;
    border: 1.5px solid #2A2455;
    border-radius: 0.6rem;
    padding: 0.65rem 0.85rem;
    font-size: 0.85rem;
    color: #FBFAFF;
    outline: none;
    transition: all 0.2s ease;
  }

  .portal-input:focus {
    border-color: #6A5ACD;
    box-shadow: 0 0 0 3px rgba(106, 90, 205, 0.2);
  }
</style>

<script>
  // @ts-nocheck
  import { 
    auth, 
    loginWithCollegeGoogle, 
    submitMembershipToFirestore, 
    listenToUserMembership 
  } from "../../lib/firebase.js";
  import { onAuthStateChanged, signOut } from "firebase/auth";

  document.addEventListener("DOMContentLoaded", () => {
    const authGateView = document.getElementById("auth-gate-view");
    const formView = document.getElementById("form-view");
    const statusView = document.getElementById("status-view");
    
    const googleLoginBtn = document.getElementById("google-login-btn");
    const authErrorBanner = document.getElementById("auth-error-banner");
    const signoutBtn = document.getElementById("signout-btn");
    const signoutStatusBtn = document.getElementById("signout-status-btn");
    
    const membershipForm = document.getElementById("membership-form");
    const submitBtn = document.getElementById("submit-btn");
    const submitBtnText = document.getElementById("submit-btn-text");
    const submitSpinner = document.getElementById("submit-spinner");

    const copyMemIdBtn = document.getElementById("copy-mem-id-btn");
    const copyMemText = document.getElementById("copy-mem-text");
    const downloadCardBtn = document.getElementById("download-card-btn");
    const webmasterMailBtn = document.getElementById("webmaster-mail-btn");

    let currentUser = null;
    let unsubscribeFirestore = null;
    let currentMembershipId = "";
    let currentMembershipData = null;

    const showAuthError = (msg) => {
      if (authErrorBanner) {
        authErrorBanner.textContent = "⚠️ " + msg;
        authErrorBanner.classList.remove("hidden");
      }
    };

    const clearAuthError = () => {
      if (authErrorBanner) {
        authErrorBanner.classList.add("hidden");
      }
    };

    // Google Login Handler
    googleLoginBtn?.addEventListener("click", async () => {
      clearAuthError();
      try {
        await loginWithCollegeGoogle();
      } catch (err) {
        showAuthError(err.message || "Login failed.");
      }
    });

    // Signout Handler
    const handleSignOut = async () => {
      if (unsubscribeFirestore) unsubscribeFirestore();
      await signOut(auth);
    };

    signoutBtn?.addEventListener("click", handleSignOut);
    signoutStatusBtn?.addEventListener("click", handleSignOut);

    // Copy Membership ID Handler
    copyMemIdBtn?.addEventListener("click", () => {
      if (currentMembershipId) {
        navigator.clipboard.writeText(currentMembershipId);
        if (copyMemText) copyMemText.textContent = "Copied!";
        setTimeout(() => {
          if (copyMemText) copyMemText.textContent = "Copy ID";
        }, 2000);
      }
    });

    // Webmaster Email Choice Handler (Gmail Web vs Default App)
    webmasterMailBtn?.addEventListener("click", () => {
      const email = "geocherianmathew@gmail.com";
      const subject = encodeURIComponent("ACM AJCE Membership Support");
      const body = encodeURIComponent("Hi Webmaster,\n\nI need help with my ACM AJCE membership verification.\n\nDetails:\nName: " + (currentMembershipData?.fullName || '') + "\nEmail: " + (currentMembershipData?.email || currentUser?.email || ''));
      
      const gmailWebUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${email}&su=${subject}&body=${body}`;
      const defaultMailUrl = `mailto:${email}?subject=${subject}&body=${body}`;

      // Open in Gmail web interface by default for maximum compatibility
      window.open(gmailWebUrl, "_blank");
    });

    // Download High-Resolution Membership Card PNG Canvas
    downloadCardBtn?.addEventListener("click", () => {
      if (!currentMembershipData) return alert("Membership data is loading...");

      const btn = downloadCardBtn;
      btn.disabled = true;
      const originalHtml = btn.innerHTML;
      btn.innerHTML = `<span class="animate-pulse">Generating HD Pass PNG...</span>`;

      const canvas = document.createElement("canvas");
      canvas.width = 1200;
      canvas.height = 750;
      const ctx = canvas.getContext("2d");

      if (!ctx) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
        return;
      }

      const drawPassContent = (bgImg) => {
        // Draw background template image or dark gradient fallback
        if (bgImg) {
          try {
            ctx.drawImage(bgImg, 0, 0, 1200, 750);
          } catch(e) {
            const grad = ctx.createLinearGradient(0, 0, 1200, 750);
            grad.addColorStop(0, "#0D0B18");
            grad.addColorStop(0.5, "#1A182F");
            grad.addColorStop(1, "#2A2455");
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 1200, 750);
          }
        } else {
          const grad = ctx.createLinearGradient(0, 0, 1200, 750);
          grad.addColorStop(0, "#0D0B18");
          grad.addColorStop(0.5, "#1A182F");
          grad.addColorStop(1, "#2A2455");
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, 1200, 750);
        }

        // Header Subtitle
        ctx.fillStyle = "#B8A7FF";
        ctx.font = "bold 20px monospace";
        ctx.fillText("ASSOCIATION FOR COMPUTING MACHINERY", 70, 70);

        ctx.fillStyle = "#E2E8F0";
        ctx.font = "bold 22px monospace";
        ctx.fillText("OFFICIAL STUDENT MEMBERSHIP PASS", 70, 105);

        // Dynamic Member Profile Details
        const name = currentMembershipData.fullName || "Chapter Member";
        const memId = currentMembershipId || "ACM-AJCE-MEM";
        const course = `${currentMembershipData.course || ''} (${currentMembershipData.semester || ''})`;
        const email = currentMembershipData.email || currentUser?.email || "";

        ctx.fillStyle = "#FBFAFF";
        ctx.font = "900 46px sans-serif";
        ctx.fillText(name, 70, 240);

        ctx.fillStyle = "#00FFC2";
        ctx.font = "bold 32px monospace";
        ctx.fillText(`ID: ${memId}`, 70, 295);

        ctx.fillStyle = "#E2E8F0";
        ctx.font = "600 26px sans-serif";
        ctx.fillText(`Course: ${course}`, 70, 365);

        ctx.fillStyle = "#CBD5E1";
        ctx.font = "500 24px sans-serif";
        ctx.fillText(`Email: ${email}`, 70, 415);

        const verifiedDate = currentMembershipData.verifiedAt ? new Date(currentMembershipData.verifiedAt) : new Date();
        const nextYearDate = new Date(verifiedDate);
        nextYearDate.setFullYear(verifiedDate.getFullYear() + 1);
        const formatDate = (d) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

        ctx.fillStyle = "#B8A7FF";
        ctx.font = "bold 24px monospace";
        ctx.fillText(`Valid: ${formatDate(verifiedDate)} – ${formatDate(nextYearDate)}`, 70, 470);

        // Footer Tag (Bottom Left)
        ctx.fillStyle = "#00FFC2";
        ctx.font = "bold 20px monospace";
        ctx.fillText("AUTHENTICATED DIGITAL CREDENTIAL", 70, 680);

        // Draw Verification QR Code on Right
        const qrImg = document.getElementById("view-security-qr");
        if (qrImg && qrImg.src) {
          try {
            ctx.fillStyle = "#FFFFFF";
            ctx.beginPath();
            ctx.roundRect(860, 210, 270, 320, 24);
            ctx.fill();

            ctx.drawImage(qrImg, 885, 230, 220, 220);

            ctx.fillStyle = "#3B0764";
            ctx.font = "bold 17px monospace";
            ctx.textAlign = "center";
            ctx.fillText("SCAN TO VERIFY", 995, 490);
          } catch(e) {}
        }

        // Export PNG & Trigger Download
        try {
          const dataUrl = canvas.toDataURL("image/png");
          const link = document.createElement("a");
          link.download = `${memId}-Membership-Pass.png`;
          link.href = dataUrl;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        } catch (err) {
          console.error("Canvas export error:", err);
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      };

      const bg = new Image();
      bg.onload = () => drawPassContent(bg);
      bg.onerror = () => drawPassContent(null);
      bg.src = typeof cardBgUrl !== 'undefined' ? cardBgUrl : "/brand/membership-card-bg.png";
    });

    // Auth State Persistent Observer
    onAuthStateChanged(auth, (user) => {
      currentUser = user;
      if (unsubscribeFirestore) {
        unsubscribeFirestore();
        unsubscribeFirestore = null;
      }

      if (!user) {
        authGateView?.classList.remove("hidden");
        formView?.classList.add("hidden");
        statusView?.classList.add("hidden");
        return;
      }

      // Populate User Header Profile
      const userNameEl = document.getElementById("user-name");
      const userEmailEl = document.getElementById("user-email");
      const userPhoto = document.getElementById("user-photo");
      const userFallback = document.getElementById("user-avatar-fallback");

      if (userNameEl) userNameEl.textContent = user.displayName || user.email.split("@")[0];
      if (userEmailEl) userEmailEl.textContent = user.email;

      if (user.photoURL && userPhoto) {
        userPhoto.src = user.photoURL;
        userPhoto.classList.remove("hidden");
        if (userFallback) userFallback.classList.add("hidden");
      } else if (userFallback) {
        userFallback.textContent = (user.displayName || user.email).charAt(0).toUpperCase();
      }

      // Pre-fill Name input if empty
      const fullNameInput = document.getElementById("input-fullName");
      if (fullNameInput && !fullNameInput.value && user.displayName) {
        fullNameInput.value = user.displayName;
      }

      // Record Google Sign-In Lead User
      try {
        const existingLeads = JSON.parse(localStorage.getItem("acm_lead_users") || "[]");
        if (!existingLeads.some(l => l.uid === user.uid || l.email === user.email)) {
          existingLeads.unshift({
            uid: user.uid,
            name: user.displayName || "Google User",
            email: user.email,
            photoURL: user.photoURL || "",
            signedInAt: new Date().toLocaleString(),
            status: "Incomplete (Payment Pending)"
          });
          localStorage.setItem("acm_lead_users", JSON.stringify(existingLeads));
        }
      } catch (e) {}

      // Listen to Firestore real-time status for this logged-in user
      unsubscribeFirestore = listenToUserMembership(user.uid, (data) => {
        if (data) {
          renderStatusView(data);
          authGateView?.classList.add("hidden");
          formView?.classList.add("hidden");
          statusView?.classList.remove("hidden");
        } else {
          authGateView?.classList.add("hidden");
          formView?.classList.remove("hidden");
          statusView?.classList.add("hidden");
        }
      });
    });

    // Render Status Screen with Dynamic Dates & Security QR
    function renderStatusView(data) {
      currentMembershipData = data;
      document.getElementById("view-name").textContent = data.fullName || "-";
      document.getElementById("view-email").textContent = data.email || currentUser?.email || "-";
      document.getElementById("view-course-sem").textContent = `${data.course || ''} (${data.semester || ''})`;
      document.getElementById("view-txnid").textContent = data.txnId || "-";

      const statusBadge = document.getElementById("status-badge");
      const statusIcon = document.getElementById("status-icon");
      const statusTitle = document.getElementById("status-title");
      const statusDesc = document.getElementById("status-desc");
      const viewStatus = document.getElementById("view-status");
      const verifiedCard = document.getElementById("verified-card");
      const viewMemId = document.getElementById("view-mem-id");
      const viewValidity = document.getElementById("view-validity");
      const viewMemberBadge = document.getElementById("view-member-badge");
      const viewSecurityQr = document.getElementById("view-security-qr");

      const memId = data.membershipId || `ACM-AJCE-${(data.uid || currentUser?.uid || '').slice(0, 5).toUpperCase()}`;
      currentMembershipId = memId;

      // Dynamic 1-Year Validity Calculation
      const verifiedDate = data.verifiedAt ? new Date(data.verifiedAt) : (data.submittedAt ? new Date(data.submittedAt) : new Date());
      const nextYearDate = new Date(verifiedDate);
      nextYearDate.setFullYear(verifiedDate.getFullYear() + 1);

      const formatDate = (d) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
      const validityStr = `${formatDate(verifiedDate)} – ${formatDate(nextYearDate)}`;
      const activeYears = `${verifiedDate.getFullYear()}-${nextYearDate.getFullYear()}`;

      if (data.status === "Verified") {
        statusBadge.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 mb-6 shadow-xl";
        statusIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>`;
        statusTitle.textContent = "Membership Verified & Active! 🎉";
        statusDesc.textContent = "Congratulations! Your payment has been verified by the ACM Executive Board. Welcome to the ACM AJCE Chapter.";
        viewStatus.textContent = "Verified";
        viewStatus.className = "text-emerald-400 font-bold";
        verifiedCard?.classList.remove("hidden");
        
        const cardNameEl = document.getElementById("card-view-name");
        const cardIdEl = document.getElementById("card-view-id");
        const cardCourseEl = document.getElementById("card-view-course");
        const cardEmailEl = document.getElementById("card-view-email");
        const cardValidityEl = document.getElementById("card-view-validity");

        if (cardNameEl) cardNameEl.textContent = data.fullName || "Member";
        if (cardIdEl) cardIdEl.textContent = `ID: ${memId}`;
        if (cardCourseEl) cardCourseEl.textContent = `${data.course || ''} (${data.semester || ''})`;
        if (cardEmailEl) cardEmailEl.textContent = data.email || currentUser?.email || "-";
        if (cardValidityEl) cardValidityEl.textContent = validityStr;

        if (viewMemId) viewMemId.textContent = memId;
        if (viewValidity) viewValidity.textContent = validityStr;
        if (viewMemberBadge) viewMemberBadge.textContent = `Active Chapter Member (${activeYears})`;

        // Load Security QR Code API Endpoint
        if (viewSecurityQr) {
          viewSecurityQr.src = `/api/verify-qr.png?uid=${encodeURIComponent(data.uid || currentUser?.uid || '')}`;
        }
      } else if (data.status === "Rejected") {
        statusBadge.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/40 mb-6 shadow-xl";
        statusIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>`;
        statusTitle.textContent = "Verification Failed";
        statusDesc.textContent = "Your transaction reference or screenshot could not be verified. Please contact the chapter executive board.";
        viewStatus.textContent = "Rejected";
        viewStatus.className = "text-rose-400 font-bold";
        verifiedCard?.classList.add("hidden");
      } else {
        statusBadge.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 mb-6 shadow-xl";
        statusIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>`;
        statusTitle.textContent = "Verification Pending";
        statusDesc.textContent = "Your registration details and payment transaction receipt have been recorded in Firestore DB and are currently under executive review.";
        viewStatus.textContent = "Pending Verification";
        viewStatus.className = "text-amber-400 font-bold";
        verifiedCard?.classList.add("hidden");
      }
    }

    // Submit Membership Handler
    if (membershipForm) {
      membershipForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!currentUser) return alert("Session expired. Please sign in again.");

        const formData = new FormData(membershipForm);
        const fullName = formData.get("fullName")?.toString().trim();
        const course = formData.get("course")?.toString();
        const semester = formData.get("semester")?.toString();
        const department = formData.get("department")?.toString().trim();
        const phone = formData.get("phone")?.toString().trim();
        const txnId = formData.get("txnId")?.toString().trim();
        const fileInput = document.getElementById("input-screenshot");

        if (!fullName || !course || !semester || !department || !phone || !txnId) {
          return alert("Please fill in all required fields.");
        }
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
          return alert("Please upload your payment screenshot.");
        }

        submitBtn.disabled = true;
        submitBtnText.textContent = "Submitting to Firestore...";
        submitSpinner?.classList.remove("hidden");

        const processSubmission = async (screenshotUrl) => {
          try {
            await submitMembershipToFirestore(currentUser, {
              fullName,
              course,
              semester,
              department,
              phone,
              txnId,
              screenshotUrl
            });
          } catch (err) {
            alert("Failed to submit registration to Firestore: " + err.message);
            submitBtn.disabled = false;
            submitBtnText.textContent = "Submit Registration";
            submitSpinner?.classList.add("hidden");
          }
        };

        const file = fileInput.files[0];
        const reader = new FileReader();
        reader.onload = (event) => {
          processSubmission(event.target.result);
        };
        reader.readAsDataURL(file);
      });
    }
  });
</script>
