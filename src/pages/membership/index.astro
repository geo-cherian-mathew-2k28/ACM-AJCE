---
import MembershipLayout from "../../layouts/MembershipLayout.astro";
---

<MembershipLayout title="ACM AJCE Membership Portal">
  <div class="membership-container max-w-4xl mx-auto py-8 px-4">
    
    <!-- State 1: Membership Form View -->
    <div id="form-view">
      <div class="bg-[#131124] border border-[#2A2455] rounded-2xl p-6 mb-8 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#2A2455] flex items-center justify-center text-white font-bold text-lg" id="user-avatar">A</div>
          <div>
            <p class="text-white font-semibold text-sm" id="user-name">Student Account</p>
            <p class="text-xs text-[#B8A7FF]" id="user-email">Auto-fetched on College Login (@ajce.in)</p>
          </div>
        </div>
        <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs px-3 py-1 rounded-full font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> College Domain (@ajce.in)
        </span>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Main Registration Form -->
        <div class="md:col-span-2 portal-panel p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-white mb-1">Student Details</h2>
          <p class="text-xs text-gray-400 mb-6">Fill in all fields to complete your ACM AJCE chapter membership registration.</p>

          <form id="membership-form" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Full Name *</label>
              <input type="text" id="input-fullName" name="fullName" required class="portal-input w-full" placeholder="Enter your full name" />
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Course *</label>
                <select id="input-course" name="course" required class="portal-input w-full">
                  <option value="">Select Course</option>
                  <option value="B.Tech">B.Tech</option>
                  <option value="BCA">BCA</option>
                  <option value="MCA">MCA</option>
                  <option value="Integrated MCA">Integrated MCA</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Semester *</label>
                <select id="input-semester" name="semester" required class="portal-input w-full">
                  <option value="">Select Semester</option>
                  <option value="S1">S1</option>
                  <option value="S2">S2</option>
                  <option value="S3">S3</option>
                  <option value="S4">S4</option>
                  <option value="S5">S5</option>
                  <option value="S6">S6</option>
                  <option value="S7">S7</option>
                  <option value="S8">S8</option>
                  <option value="S9">S9</option>
                  <option value="S10">S10</option>
                </select>
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Department *</label>
                <input type="text" id="input-department" name="department" required class="portal-input w-full" placeholder="Computer Science & Engineering" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Phone No. (WhatsApp) *</label>
                <input type="tel" id="input-phone" name="phone" required class="portal-input w-full" placeholder="9876543210" pattern="[0-9]{10}" title="Please enter a valid 10-digit mobile number" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">College Email ID (@ajce.in) *</label>
              <input type="email" id="input-email" name="email" required class="portal-input w-full" placeholder="student2028@cs.ajce.in" />
              <p class="text-[11px] text-gray-400 mt-1">Automatically linked to your Google login upon backend authentication integration.</p>
            </div>

            <!-- Payment & Verification Fields -->
            <div class="pt-4 border-t border-[#2A2455]">
              <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-[#B8A7FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                Payment & Verification
              </h3>

              <div class="grid sm:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Transaction ID / UPI Ref *</label>
                  <input type="text" id="input-txnId" name="txnId" required class="portal-input w-full" placeholder="e.g. 423589123456" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Payment Screenshot *</label>
                  <input type="file" id="input-screenshot" name="screenshot" accept="image/*" required class="portal-input w-full text-xs text-gray-400 file:mr-3 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-[#2A2455] file:text-[#B8A7FF] hover:file:bg-[#3D3575]" />
                </div>
              </div>
            </div>

            <!-- Active Submit Button -->
            <button id="submit-btn" type="submit" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-[#6A5ACD] to-[#8A2BE2] hover:from-[#7B68EE] hover:to-[#9370DB] text-white font-bold text-base shadow-lg transition-all cursor-pointer mt-6">
              Submit
            </button>
          </form>
        </div>

        <!-- Payment Sidebar with QR & GPay Button -->
        <div class="portal-panel p-6 flex flex-col items-center text-center justify-between">
          <div>
            <span class="inline-block text-[#B8A7FF] font-mono text-[11px] uppercase tracking-wider font-bold mb-1">Annual Fee</span>
            <h3 class="text-3xl font-extrabold text-white mb-2">₹200 <span class="text-xs text-gray-400 font-normal">/ 1 year</span></h3>
            <p class="text-xs text-gray-300 mb-4 leading-relaxed">Scan the QR code below using any UPI App (GPay, PhonePe, Paytm) to complete payment.</p>

            <!-- QR Code Container -->
            <div class="bg-white p-3 rounded-xl shadow-md inline-block mb-4">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=upi://pay?pa=acmajce@upi&pn=ACM%20AJCE%20Chapter&am=200.00&cu=INR" alt="ACM AJCE Payment QR" class="w-40 h-40 object-contain mx-auto" />
              <p class="text-[10px] text-gray-600 font-mono mt-1 font-semibold">UPI ID: acmajce@upi</p>
            </div>

            <div class="w-full space-y-2 mb-4">
              <a href="upi://pay?pa=acmajce@upi&pn=ACM%20AJCE%20Chapter&am=200.00&cu=INR" class="w-full py-2.5 px-4 rounded-lg bg-white hover:bg-gray-100 text-gray-900 font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>
                Pay ₹200 via GPay / PhonePe
              </a>
              <a href="upi://pay?pa=acmajce@upi&pn=ACM%20AJCE%20Chapter&am=500.00&cu=INR" class="w-full py-2.5 px-4 rounded-lg bg-[#2A2455] hover:bg-[#3D3575] text-[#B8A7FF] font-bold text-xs flex items-center justify-center gap-2 border border-[#4D4770] transition-all">
                Direct to GPay (₹500 Premium)
              </a>
            </div>
          </div>

          <div class="text-[11px] text-gray-400 bg-[#131124] p-3 rounded-lg border border-[#2A2455] w-full text-left">
            <p class="font-semibold text-white mb-1">📌 Instructions:</p>
            <ol class="list-decimal list-inside space-y-1">
              <li>Pay ₹200 via UPI.</li>
              <li>Copy the 12-digit UTR/Txn ID.</li>
              <li>Attach screenshot & submit.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- State 2: Status & Membership Details View -->
    <div id="status-view" class="hidden portal-panel text-center max-w-lg mx-auto py-10 px-6">
      <div id="status-badge" class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 mb-6 shadow-xl">
        <svg id="status-icon" class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      
      <p class="portal-eyebrow text-[#B8A7FF] font-mono text-xs uppercase tracking-widest mb-1 font-bold">ACM Chapter Membership</p>
      <h1 id="status-title" class="text-2xl font-extrabold text-white mb-3">Verification Pending</h1>
      <p id="status-desc" class="text-gray-300 text-xs mb-6 leading-relaxed">
        Your registration details and payment transaction receipt have been recorded and are currently under executive review.
      </p>

      <div class="bg-[#131124] border border-[#2A2455] rounded-xl p-5 mb-6 text-left text-xs space-y-3">
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Student Name:</span>
          <span class="text-white font-semibold" id="view-name">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">College Email:</span>
          <span class="text-white font-medium" id="view-email">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Course & Semester:</span>
          <span class="text-gray-200 font-medium" id="view-course-sem">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Transaction UTR:</span>
          <span class="text-amber-300 font-mono font-semibold" id="view-txnid">-</span>
        </div>
        <div class="flex justify-between border-b border-[#2A2455] pb-2">
          <span class="text-gray-400">Current Status:</span>
          <span class="font-bold" id="view-status">Pending</span>
        </div>
        
        <!-- Official Membership ID Card Section (Visible once Verified) -->
        <div id="verified-card" class="hidden pt-2 border-t border-emerald-500/30">
          <div class="bg-gradient-to-r from-[#2A2455] to-[#1A182F] p-4 rounded-lg border border-emerald-500/40 text-center">
            <span class="text-[10px] text-emerald-400 uppercase tracking-widest font-mono font-bold block mb-1">Official ACM AJCE Membership ID</span>
            <div id="view-mem-id" class="text-xl font-extrabold text-white font-mono tracking-wider">ACM-AJCE-9842</div>
            <p class="text-[10px] text-gray-300 mt-1">Active Chapter Member (2024-2025)</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</MembershipLayout>

<style>
  .portal-panel {
    background: #0D0B18;
    border: 1px solid #2A2455;
    border-radius: 1.25rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }

  .portal-input {
    background: #131124;
    border: 1.5px solid #2A2455;
    border-radius: 0.6rem;
    padding: 0.65rem 0.85rem;
    font-size: 0.85rem;
    color: #FBFAFF;
    outline: none;
    transition: all 0.2s ease;
  }

  .portal-input:focus {
    border-color: #6A5ACD;
    box-shadow: 0 0 0 3px rgba(106, 90, 205, 0.2);
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const formView = document.getElementById("form-view");
    const statusView = document.getElementById("status-view");
    const membershipForm = document.getElementById("membership-form");
    const submitBtn = document.getElementById("submit-btn");

    const inputName = document.getElementById("input-fullName");
    const inputCourse = document.getElementById("input-course");
    const inputSemester = document.getElementById("input-semester");
    const inputDept = document.getElementById("input-department");
    const inputPhone = document.getElementById("input-phone");
    const inputEmail = document.getElementById("input-email");
    const inputTxn = document.getElementById("input-txnId");
    const inputScreenshot = document.getElementById("input-screenshot");



    // Dynamic validation error helper
    const errorMsgContainer = document.createElement("div");
    errorMsgContainer.id = "form-error-msg";
    errorMsgContainer.className = "hidden p-3 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold mt-4 text-center";
    membershipForm?.appendChild(errorMsgContainer);

    const showError = (msg) => {
      if (errorMsgContainer) {
        errorMsgContainer.textContent = "⚠️ " + msg;
        errorMsgContainer.classList.remove("hidden");
      }
    };

    const clearError = () => {
      if (errorMsgContainer) {
        errorMsgContainer.classList.add("hidden");
      }
    };

    // Dynamic User Header Updates based on email input
    inputEmail?.addEventListener("input", () => {
      const emailVal = inputEmail.value.trim();
      const userNameEl = document.getElementById("user-name");
      const userEmailEl = document.getElementById("user-email");
      const userAvatarEl = document.getElementById("user-avatar");

      if (emailVal) {
        if (userEmailEl) userEmailEl.textContent = emailVal;
        const prefix = emailVal.split("@")[0];
        if (prefix && userNameEl) {
          const name = prefix.charAt(0).toUpperCase() + prefix.slice(1);
          userNameEl.textContent = name;
          if (userAvatarEl) userAvatarEl.textContent = name.charAt(0);
        }
      }
    });

    // Real-Time SSE Listener for live verification & edit updates
    const sseUrl = `http://${window.location.hostname || 'localhost'}:5050/events`;
    try {
      const eventSource = new EventSource(sseUrl);
      eventSource.onmessage = (e) => {
        try {
          const msg = JSON.parse(e.data);
          if (msg.type === 'MEMBERSHIPS_UPDATED' || msg.type === 'INIT_STATE') {
            const allMemberships = msg.type === 'INIT_STATE' ? (msg.data.memberships || []) : (msg.data || []);
            localStorage.setItem("acm_memberships", JSON.stringify(allMemberships));
            
            // Sync user submission status if present
            const stored = localStorage.getItem("acm_user_submission");
            if (stored) {
              const submission = JSON.parse(stored);
              const latest = allMemberships.find(m => 
                m.id === submission.id || 
                (m.email && submission.email && m.email.toLowerCase() === submission.email.toLowerCase())
              );
              if (latest) {
                localStorage.setItem("acm_user_submission", JSON.stringify(latest));
              }
            }
            checkStatus();
          }
        } catch (err) {}
      };
    } catch (err) {}

    // Check submission status from Server & LocalStorage
    const checkStatus = async () => {
      let stored = localStorage.getItem("acm_user_submission");
      
      // Also try fetching from Server API for cross-tab & refreshed state
      try {
        const res = await fetch(`http://${window.location.hostname || 'localhost'}:5050/api/memberships`);
        if (res.ok) {
          const serverMemberships = await res.json();
          localStorage.setItem("acm_memberships", JSON.stringify(serverMemberships));
          if (stored) {
            const submission = JSON.parse(stored);
            const latest = serverMemberships.find(m => 
              m.id === submission.id || 
              (m.email && submission.email && m.email.toLowerCase() === submission.email.toLowerCase())
            );
            if (latest) {
              stored = JSON.stringify(latest);
              localStorage.setItem("acm_user_submission", stored);
            }
          }
        }
      } catch (err) {}

      if (stored) {
        try {
          const submission = JSON.parse(stored);
          const allMemberships = JSON.parse(localStorage.getItem("acm_memberships") || "[]");
          const latest = allMemberships.find(m => 
            m.id === submission.id || 
            (m.email && submission.email && m.email.toLowerCase() === submission.email.toLowerCase())
          ) || submission;

          document.getElementById("view-name").textContent = latest.fullName;
          document.getElementById("view-email").textContent = latest.email;
          document.getElementById("view-course-sem").textContent = `${latest.course} (${latest.semester || latest.branch || ''})`;
          document.getElementById("view-txnid").textContent = latest.txnId;

          const statusBadge = document.getElementById("status-badge");
          const statusIcon = document.getElementById("status-icon");
          const statusTitle = document.getElementById("status-title");
          const statusDesc = document.getElementById("status-desc");
          const viewStatus = document.getElementById("view-status");
          const verifiedCard = document.getElementById("verified-card");
          const viewMemId = document.getElementById("view-mem-id");

          if (latest.status === "Verified") {
            statusBadge.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 mb-6 shadow-xl";
            statusIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>`;
            statusTitle.textContent = "Membership Verified & Active! 🎉";
            statusDesc.textContent = "Congratulations! Your payment has been verified by the ACM Executive Board. Welcome to the ACM AJCE Chapter.";
            viewStatus.textContent = "Verified";
            viewStatus.className = "text-emerald-400 font-bold";
            verifiedCard?.classList.remove("hidden");
            if (viewMemId) viewMemId.textContent = latest.id || "ACM-AJCE-9842";
          } else if (latest.status === "Rejected") {
            statusBadge.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/40 mb-6 shadow-xl";
            statusIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>`;
            statusTitle.textContent = "Verification Failed";
            statusDesc.textContent = "Your transaction reference or screenshot could not be verified. Please contact the chapter executive board.";
            viewStatus.textContent = "Rejected";
            viewStatus.className = "text-rose-400 font-bold";
            verifiedCard?.classList.add("hidden");
          } else {
            statusBadge.className = "inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 mb-6 shadow-xl";
            statusIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>`;
            statusTitle.textContent = "Verification Pending";
            statusDesc.textContent = "Your registration details and payment transaction receipt have been recorded and are currently under executive review.";
            viewStatus.textContent = "Pending Verification";
            viewStatus.className = "text-amber-400 font-bold";
            verifiedCard?.classList.add("hidden");
          }

          formView?.classList.add("hidden");
          statusView?.classList.remove("hidden");
        } catch (e) {
          formView?.classList.remove("hidden");
          statusView?.classList.add("hidden");
        }
      } else {
        formView?.classList.remove("hidden");
        statusView?.classList.add("hidden");
      }
    };

    checkStatus();
    window.addEventListener("storage", checkStatus);

    // Form Submit Handler
    if (membershipForm) {
      membershipForm.addEventListener("submit", (e) => {
        e.preventDefault();

        clearError();

        const formData = new FormData(membershipForm);
        const fullName = formData.get("fullName")?.toString().trim();
        const course = formData.get("course")?.toString();
        const semester = formData.get("semester")?.toString();
        const department = formData.get("department")?.toString().trim();
        const phone = formData.get("phone")?.toString().trim();
        const email = formData.get("email")?.toString().trim();
        const txnId = formData.get("txnId")?.toString().trim();
        const fileInput = document.getElementById("input-screenshot");

        // Validate mandatory fields
        if (!fullName) return showError("Please enter your full name.");
        if (!course) return showError("Please select your course.");
        if (!semester) return showError("Please select your semester.");
        if (!department) return showError("Please enter your department.");
        if (!phone || !/^[0-9]{10}$/.test(phone)) return showError("Please enter a valid 10-digit mobile number.");
        if (!email || !email.includes("@")) return showError("Please enter a valid email address.");
        if (!txnId) return showError("Please enter your UPI transaction UTR / Ref ID.");
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) return showError("Please attach your payment receipt screenshot.");

        const saveAndSubmit = (screenshotUrl) => {
          const submissionData = {
            id: "ACM-AJCE-" + Math.floor(1000 + Math.random() * 9000),
            fullName,
            course,
            semester,
            department,
            phone,
            email,
            txnId,
            screenshotUrl: screenshotUrl || "",
            submittedAt: new Date().toLocaleString(),
            status: "Pending Verification"
          };

          // Save locally
          const existingMemberships = JSON.parse(localStorage.getItem("acm_memberships") || "[]");
          existingMemberships.unshift(submissionData);
          localStorage.setItem("acm_memberships", JSON.stringify(existingMemberships));
          localStorage.setItem("acm_user_submission", JSON.stringify(submissionData));

          // Post to Real-Time SSE Server on port 5050
          fetch('http://localhost:5050/api/membership', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(submissionData)
          }).catch(err => console.log('Sync server notice:', err));

          window.dispatchEvent(new Event("storage"));
          checkStatus();
        };

        if (fileInput && fileInput.files && fileInput.files[0]) {
          const reader = new FileReader();
          reader.onload = (event) => {
            saveAndSubmit(event.target.result);
          };
          reader.readAsDataURL(fileInput.files[0]);
        } else {
          saveAndSubmit("");
        }
      });
    }
  });
</script>
