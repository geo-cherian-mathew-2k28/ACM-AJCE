---
import MembershipLayout from "../../layouts/MembershipLayout.astro";
import { getCurrentUser, isAdminEmail } from "../../lib/membership";

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user || !isAdminEmail(user.email, Astro.locals)) return Astro.redirect("/membership");
---

<MembershipLayout title="ACM AJCE Member Operations" signedIn>
  <section class="admin-page">
    <div class="admin-heading">
      <div><p class="portal-eyebrow">Member operations</p><h1 class="portal-title">Chapter membership.</h1></div>
      <a class="portal-button portal-button--subtle" href="/membership">Member dashboard</a>
    </div>

    <div id="admin-metrics" class="admin-metrics" aria-live="polite">
      <article class="portal-panel metric"><span>Total users</span><strong>--</strong></article>
      <article class="portal-panel metric"><span>Active members</span><strong>--</strong></article>
      <article class="portal-panel metric"><span>Membership funds</span><strong>--</strong></article>
      <article class="portal-panel metric"><span>Published events</span><strong>--</strong></article>
    </div>

    <div class="admin-columns">
      <section class="portal-panel admin-section">
        <div class="admin-section__heading"><div><p class="portal-eyebrow">Events</p><h2 id="event-form-title">Create an event</h2></div><button id="reset-event" class="text-button" type="button" hidden>New event</button></div>
        <form id="event-form" class="portal-form">
          <div class="portal-field"><label for="event-title">Title</label><input id="event-title" name="title" required /></div>
          <div class="portal-field"><label for="event-summary">Summary</label><textarea id="event-summary" name="summary" required></textarea></div>
          <div class="form-two"><div class="portal-field"><label for="event-starts">Starts</label><input id="event-starts" name="startsAt" type="datetime-local" required /></div><div class="portal-field"><label for="event-ends">Ends</label><input id="event-ends" name="endsAt" type="datetime-local" /></div></div>
          <div class="form-two"><div class="portal-field"><label for="event-venue">Venue</label><input id="event-venue" name="venue" /></div><div class="portal-field"><label for="event-capacity">Capacity</label><input id="event-capacity" name="capacity" type="number" min="1" /></div></div>
          <div class="portal-field"><label for="event-deadline">Registration deadline</label><input id="event-deadline" name="registrationDeadline" type="datetime-local" /></div>
          <div class="portal-field"><label for="event-details">Member details</label><textarea id="event-details" name="details"></textarea></div>
          <div class="event-toggles"><label class="portal-checkbox"><input name="memberOnly" type="checkbox" checked /> Members only</label><label class="portal-checkbox"><input name="registrationOpen" type="checkbox" checked /> Registration open</label><label class="portal-checkbox"><input name="published" type="checkbox" /> Publish now</label></div>
          <button id="save-event" class="portal-button" type="submit">Save event</button>
          <p id="event-status" class="portal-status" aria-live="polite"></p>
        </form>
      </section>

      <section class="portal-panel admin-section coupon-panel">
        <div class="admin-section__heading"><div><p class="portal-eyebrow">One-time coupons</p><h2>Assign a private code</h2></div></div>
        <form id="coupon-form" class="portal-form">
          <div class="portal-field"><label for="coupon-event">Event</label><select id="coupon-event" name="eventId" required><option value="">Choose event</option></select></div>
          <div class="portal-field"><label for="coupon-member">Member</label><select id="coupon-member" name="userId" required><option value="">Choose member</option></select></div>
          <div class="form-two"><div class="portal-field"><label for="coupon-discount">Discount (paise)</label><input id="coupon-discount" name="discountAmountPaise" type="number" min="0" value="0" /></div><div class="portal-field"><label for="coupon-expiry">Expires</label><input id="coupon-expiry" name="expiresAt" type="datetime-local" /></div></div>
          <button class="portal-button portal-button--subtle" type="submit">Create one-time code</button>
          <p id="coupon-status" class="portal-status" aria-live="polite"></p>
        </form>
      </section>
    </div>

    <section class="admin-records"><div class="records-heading"><div><p class="portal-eyebrow">Events</p><h2>Manage event records</h2></div></div><div id="admin-events" class="admin-events"></div></section>
    <section class="admin-records"><div class="records-heading"><div><p class="portal-eyebrow">Members</p><h2>Member records and ID cards</h2></div></div><div id="admin-members" class="member-table-wrap"><p class="events-loading">Loading member records...</p></div></section>
  </section>

  <dialog id="member-dialog" class="member-dialog">
    <form id="member-form" class="portal-panel portal-form" method="dialog">
      <div class="admin-section__heading"><div><p class="portal-eyebrow">Member record</p><h2>Edit member details</h2></div><button class="text-button" type="button" data-close-dialog>Close</button></div>
      <input name="id" type="hidden" />
      <div class="portal-field"><label for="member-name">Full name</label><input id="member-name" name="fullName" required /></div>
      <div class="portal-field"><label for="member-phone">Phone</label><input id="member-phone" name="phone" required /></div>
      <div class="form-two"><div class="portal-field"><label for="member-department">Department</label><input id="member-department" name="department" required /></div><div class="portal-field"><label for="member-year">Year</label><input id="member-year" name="studyYear" required /></div></div>
      <div class="portal-field"><label for="member-admission">Admission number</label><input id="member-admission" name="admissionNumber" required /></div>
      <button class="portal-button" type="submit">Save member record</button><p id="member-status" class="portal-status" aria-live="polite"></p>
    </form>
  </dialog>
</MembershipLayout>

<style>
  .admin-page { display: grid; gap: 42px; }
  .admin-heading, .admin-section__heading, .records-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .admin-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .metric { min-height: 126px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }
  .metric span { color: rgba(251, 250, 255, 0.56); font: 700 0.66rem/1.35 "Space Mono", monospace; letter-spacing: 0.06em; text-transform: uppercase; }
  .metric strong { color: #e6e1ff; font-size: clamp(1.7rem, 3.6vw, 2.6rem); }
  .admin-columns { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(310px, 0.9fr); gap: 14px; align-items: start; }
  .admin-section { padding: 24px; }
  .admin-section h2, .records-heading h2 { margin: 0; font-size: 1.38rem; }
  .admin-section .portal-form { margin-top: 24px; }
  .form-two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .event-toggles { display: flex; gap: 14px; flex-wrap: wrap; }
  .text-button { border: 0; background: transparent; color: #b8a7ff; padding: 5px 0; font-weight: 700; cursor: pointer; }
  .text-button:hover, .text-button:focus-visible { color: #e6e1ff; outline: none; }
  .admin-records { display: grid; gap: 18px; }
  .admin-events { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .admin-event { padding: 18px; display: grid; gap: 11px; }
  .admin-event p { margin: 0; }
  .admin-event__meta { color: #b8a7ff; font: 700 0.62rem/1.45 "Space Mono", monospace; text-transform: uppercase; }
  .admin-event h3 { margin: 0; font-size: 1rem; }
  .admin-event__summary { min-height: 3.1em; color: rgba(251, 250, 255, 0.61); font-size: 0.85rem; line-height: 1.45; }
  .admin-event__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .admin-event__actions button { min-height: 32px; padding: 0 10px; font-size: 0.72rem; }
  .member-table-wrap { overflow-x: auto; border: 1px solid rgba(230, 225, 255, 0.18); border-radius: 8px; }
  .member-table { width: 100%; min-width: 820px; border-collapse: collapse; background: rgba(11, 12, 22, 0.78); }
  .member-table th, .member-table td { padding: 14px; border-bottom: 1px solid rgba(230, 225, 255, 0.1); text-align: left; vertical-align: top; }
  .member-table th { color: #b8a7ff; font: 700 0.62rem/1.2 "Space Mono", monospace; letter-spacing: 0.06em; text-transform: uppercase; }
  .member-table td { color: rgba(251, 250, 255, 0.79); font-size: 0.82rem; line-height: 1.45; }
  .member-table td strong { color: #fbfaff; }
  .table-actions { display: flex; gap: 9px; }
  .table-actions a, .table-actions button { border: 0; background: transparent; color: #b8a7ff; padding: 0; font-weight: 700; text-decoration: none; cursor: pointer; }
  .member-dialog { width: min(100% - 28px, 570px); padding: 0; border: 0; background: transparent; color: #fbfaff; }
  .member-dialog::backdrop { background: rgba(0, 0, 0, 0.78); backdrop-filter: blur(4px); }
  .member-dialog .portal-form { padding: 24px; }
  @media (max-width: 980px) { .admin-metrics { grid-template-columns: repeat(2, 1fr); } .admin-columns { grid-template-columns: 1fr; } .admin-events { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 590px) { .admin-heading, .admin-section__heading, .records-heading { align-items: flex-start; flex-direction: column; } .admin-metrics, .admin-events, .form-two { grid-template-columns: 1fr; } .admin-section { padding: 20px; } }
</style>

<script>
  // @ts-nocheck
  const getJson = async (url, options = {}) => {
    const response = await fetch(url, options);
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.message || "Unable to complete this request.");
    return data;
  };
  const status = (element, message, state = "") => { element.textContent = message; element.dataset.state = state; };
  const dateInput = (value) => value ? new Date(value).toISOString().slice(0, 16) : "";
  const formatDate = (value) => value ? new Intl.DateTimeFormat("en-IN", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "--";
  let events = [];
  let members = [];
  let editingEventId = null;

  const metrics = document.querySelector("#admin-metrics");
  const eventForm = document.querySelector("#event-form");
  const eventStatus = document.querySelector("#event-status");
  const eventTitle = document.querySelector("#event-form-title");
  const resetEvent = document.querySelector("#reset-event");
  const eventsHost = document.querySelector("#admin-events");
  const membersHost = document.querySelector("#admin-members");
  const couponEvent = document.querySelector("#coupon-event");
  const couponMember = document.querySelector("#coupon-member");
  const couponForm = document.querySelector("#coupon-form");
  const couponStatus = document.querySelector("#coupon-status");
  const memberDialog = document.querySelector("#member-dialog");
  const memberForm = document.querySelector("#member-form");
  const memberStatus = document.querySelector("#member-status");

  const resetEventForm = () => { editingEventId = null; eventForm.reset(); eventTitle.textContent = "Create an event"; resetEvent.hidden = true; status(eventStatus, ""); };
  const setOptions = (select, values, label) => { select.replaceChildren(new Option(`Choose ${label}`, "")); values.forEach((item) => select.add(new Option(item.title || item.full_name, item.id))); };

  const renderEvents = () => {
    eventsHost.replaceChildren();
    if (!events.length) { eventsHost.textContent = "No events have been created yet."; return; }
    events.forEach((event) => {
      const card = document.createElement("article"); card.className = "portal-panel admin-event";
      const meta = document.createElement("p"); meta.className = "admin-event__meta"; meta.textContent = `${event.published ? "Published" : "Draft"} / ${formatDate(event.starts_at)}`;
      const title = document.createElement("h3"); title.textContent = event.title;
      const summary = document.createElement("p"); summary.className = "admin-event__summary"; summary.textContent = event.summary;
      const actions = document.createElement("div"); actions.className = "admin-event__actions";
      const edit = document.createElement("button"); edit.type = "button"; edit.className = "portal-button portal-button--subtle"; edit.textContent = "Edit";
      edit.addEventListener("click", () => {
        editingEventId = event.id; eventTitle.textContent = `Edit ${event.title}`; resetEvent.hidden = false;
        eventForm.title.value = event.title; eventForm.summary.value = event.summary; eventForm.details.value = event.details || ""; eventForm.venue.value = event.venue || ""; eventForm.startsAt.value = dateInput(event.starts_at); eventForm.endsAt.value = dateInput(event.ends_at); eventForm.registrationDeadline.value = dateInput(event.registration_deadline); eventForm.capacity.value = event.capacity || ""; eventForm.memberOnly.checked = Boolean(event.member_only); eventForm.registrationOpen.checked = Boolean(event.registration_open); eventForm.published.checked = Boolean(event.published); eventForm.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      const remove = document.createElement("button"); remove.type = "button"; remove.className = "portal-button portal-button--danger"; remove.textContent = "Delete";
      remove.addEventListener("click", async () => { if (!window.confirm(`Delete ${event.title}?`)) return; try { await getJson(`/api/admin/events/${event.id}`, { method: "DELETE" }); await loadRecords(); } catch (error) { window.alert(error.message); } });
      actions.append(edit, remove); card.append(meta, title, summary, actions); eventsHost.append(card);
    });
  };

  const renderMembers = () => {
    membersHost.replaceChildren();
    const table = document.createElement("table"); table.className = "member-table";
    const head = document.createElement("thead"); head.innerHTML = "<tr><th>Member</th><th>Academic details</th><th>Membership</th><th>Payment</th><th>Actions</th></tr>";
    const body = document.createElement("tbody");
    members.forEach((member) => {
      const row = document.createElement("tr");
      const memberCell = document.createElement("td"); const name = document.createElement("strong"); name.textContent = member.full_name; memberCell.append(name, document.createElement("br"), document.createTextNode(member.email), document.createElement("br"), document.createTextNode(member.phone || "Profile incomplete"));
      const academicCell = document.createElement("td"); academicCell.textContent = `${member.department || "--"} / ${member.study_year || "--"}\n${member.admission_number || "--"}`;
      const membershipCell = document.createElement("td"); membershipCell.textContent = member.member_number ? `${member.membership_status}\n${member.member_number}\nUntil ${formatDate(member.expires_at)}` : "Not active";
      const paymentCell = document.createElement("td"); paymentCell.textContent = member.razorpay_payment_id ? `Rs. ${((member.amount_paise || 0) / 100).toFixed(2)}\n${member.razorpay_payment_id}` : "--";
      const actionCell = document.createElement("td"); const actions = document.createElement("div"); actions.className = "table-actions";
      const edit = document.createElement("button"); edit.type = "button"; edit.textContent = "Edit"; edit.addEventListener("click", () => openMember(member));
      const card = document.createElement("a"); card.href = `/membership/card?member=${encodeURIComponent(member.id)}`; card.textContent = "ID card"; actions.append(edit, card); actionCell.append(actions);
      row.append(memberCell, academicCell, membershipCell, paymentCell, actionCell); body.append(row);
    });
    table.append(head, body); membersHost.append(table);
  };

  const openMember = (member) => { memberForm.id.value = member.id; memberForm.fullName.value = member.full_name || ""; memberForm.phone.value = member.phone || ""; memberForm.department.value = member.department || ""; memberForm.studyYear.value = member.study_year || ""; memberForm.admissionNumber.value = member.admission_number || ""; status(memberStatus, ""); memberDialog.showModal(); };

  const loadRecords = async () => {
    const [overview, eventData, memberData] = await Promise.all([getJson("/api/admin/overview"), getJson("/api/admin/events"), getJson("/api/admin/members")]);
    const values = [overview.users, overview.activeMembers, `Rs. ${(overview.fundsPaise / 100).toFixed(2)}`, overview.publishedEvents]; metrics.querySelectorAll("strong").forEach((node, index) => node.textContent = values[index]);
    events = eventData.events; members = memberData.members; setOptions(couponEvent, events, "event"); setOptions(couponMember, members, "member"); renderEvents(); renderMembers();
  };

  eventForm.addEventListener("submit", async (event) => { event.preventDefault(); try { const values = Object.fromEntries(new FormData(eventForm)); values.memberOnly = eventForm.memberOnly.checked; values.registrationOpen = eventForm.registrationOpen.checked; values.published = eventForm.published.checked; const url = editingEventId ? `/api/admin/events/${editingEventId}` : "/api/admin/events"; await getJson(url, { method: editingEventId ? "PATCH" : "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(values) }); status(eventStatus, "Event saved.", "success"); resetEventForm(); await loadRecords(); } catch (error) { status(eventStatus, error.message, "error"); } });
  resetEvent.addEventListener("click", resetEventForm);
  couponForm.addEventListener("submit", async (event) => { event.preventDefault(); try { const data = await getJson("/api/admin/coupons", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(couponForm))) }); status(couponStatus, `Code created: ${data.code}. Copy it now; it cannot be retrieved later.`, "success"); couponForm.reset(); } catch (error) { status(couponStatus, error.message, "error"); } });
  memberForm.addEventListener("submit", async (event) => { event.preventDefault(); try { const data = Object.fromEntries(new FormData(memberForm)); const id = data.id; delete data.id; await getJson(`/api/admin/members/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify(data) }); status(memberStatus, "Member record saved.", "success"); await loadRecords(); window.setTimeout(() => memberDialog.close(), 450); } catch (error) { status(memberStatus, error.message, "error"); } });
  document.querySelector("[data-close-dialog]")?.addEventListener("click", () => memberDialog.close());
  loadRecords().catch((error) => { membersHost.textContent = error.message; });
</script>
