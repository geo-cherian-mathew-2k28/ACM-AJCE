    visibleEvents.forEach((event) => { const row = document.createElement("div"); row.className = "console-compact-item"; const date = new Date(event.starts_at); const dateBox = document.createElement("span"); dateBox.className = "console-date-box"; dateBox.textContent = `${date.toLocaleDateString("en-IN", { day: "2-digit" })}\n${date.toLocaleDateString("en-IN", { month: "short" })}`; const copy = document.createElement("div"); const title = document.createElement("strong"); title.textContent = event.title; const meta = document.createElement("span"); meta.textContent = `${event.venue || "Venue pending"} / ${formatDate(event.starts_at)}`; copy.append(title, meta); const tag = document.createElement("span"); tag.className = "console-tag"; tag.textContent = event.registration_open ? "Open" : "Closed"; row.append(dateBox, copy, tag); overviewEvents.append(row); });
    overviewMembers.replaceChildren();
    members.slice(0, 4).forEach((member) => { const chip = document.createElement("div"); chip.className = "console-member-chip"; const name = document.createElement("strong"); name.textContent = member.full_name; const meta = document.createElement("span"); meta.textContent = member.member_number || "Profile created"; chip.append(name, meta); overviewMembers.append(chip); });
  };
  const renderMembers = (query = "") => {
    membersTable.replaceChildren();
    const normalized = query.trim().toLowerCase();
    const filtered = members.filter((member) => [member.full_name, member.email, member.department, member.admission_number].join(" ").toLowerCase().includes(normalized));
    if (!filtered.length) { membersTable.textContent = "No members match that search."; return; }
    const table = document.createElement("table"); table.className = "console-table";
    const head = document.createElement("thead"); head.innerHTML = "<tr><th>Member</th><th>Academic details</th><th>Membership</th><th>Payment</th><th>Actions</th></tr>";
    const body = document.createElement("tbody");
    filtered.forEach((member) => { const row = document.createElement("tr"); const person = document.createElement("td"); const name = document.createElement("strong"); name.textContent = member.full_name; person.append(name, document.createElement("br"), document.createTextNode(member.email), document.createElement("br"), document.createTextNode(member.phone || "Profile incomplete")); const academic = document.createElement("td"); academic.textContent = `${member.department || "--"} / ${member.study_year || "--"}\n${member.admission_number || "--"}`; const membership = document.createElement("td"); membership.textContent = member.member_number ? `${member.membership_status}\n${member.member_number}\nUntil ${formatDate(member.expires_at)}` : "Not active"; const payment = document.createElement("td"); payment.textContent = member.razorpay_payment_id ? `${formatMoney(member.amount_paise)}\n${member.razorpay_payment_id}` : "--"; const action = document.createElement("td"); const actions = document.createElement("div"); actions.className = "console-table__actions"; const edit = document.createElement("button"); edit.type = "button"; edit.textContent = "Edit"; edit.addEventListener("click", () => openMember(member)); const card = document.createElement("a"); card.textContent = "ID card"; card.href = demoMode ? "/membership/card?preview=member" : `/membership/card?member=${encodeURIComponent(member.id)}`; actions.append(edit, card); action.append(actions); row.append(person, academic, membership, payment, action); body.append(row); }); table.append(head, body); membersTable.append(table); };
  const renderEvents = () => {
    eventsGrid.replaceChildren();
    if (!events.length) { eventsGrid.textContent = "No events have been created yet."; return; }
    events.forEach((event) => {
      const card = document.createElement("article");
      card.className = "console-event-card";
      if (event.poster_url) {
        const poster = document.createElement("img");
        poster.className = "console-event-card__poster";
        poster.src = event.poster_url;
        poster.alt = `${event.title} poster`;
        card.append(poster);
      }
      const meta = document.createElement("p");
      meta.className = "console-event-card__meta";
      meta.textContent = `${event.published ? "Published" : "Draft"} / ${formatDate(event.starts_at, true)}`;
      const title = document.createElement("h3");
      title.textContent = event.title;
      const summary = document.createElement("p");
      summary.className = "console-event-card__summary";
      summary.textContent = event.summary;
      const links = document.createElement("div");
      links.className = "console-event-card__links";
      [[event.event_url, "Event link"], [event.whatsapp_url, "WhatsApp"], [event.after_registration_content, "Member follow-up"]].forEach(([url, label]) => {
        if (!url) return;
        if (label === "Member follow-up") {
          const item = document.createElement("span");
          item.textContent = label;
          links.append(item);
          return;
        }
        const link = document.createElement("a");
        link.href = url;
        link.target = "_blank";
        link.rel = "noreferrer";
        link.textContent = label;
        links.append(link);
      });
      if (event.coupon_enabled) {
        const coupon = document.createElement("span");
        const discount = Number(event.coupon_discount_amount_paise || 0);
        coupon.textContent = `Member coupon / save ${formatMoney(discount)}`;
        links.append(coupon);
      }
      if (Number(event.registration_fee_paise || 0)) {
        const fee = document.createElement("span");
        fee.textContent = `Fee ${formatMoney(event.registration_fee_paise)}`;
        links.append(fee);
      }
      const footer = document.createElement("div");
      footer.className = "console-event-card__footer";
      const state = document.createElement("span");
      state.className = "console-tag";
      state.textContent = event.registration_open ? "Registration open" : "Registration closed";
      const actions = document.createElement("div");
      actions.className = "console-event-card__actions";
      const edit = document.createElement("button");
      edit.type = "button";
      edit.textContent = "Edit";
      edit.addEventListener("click", () => editEvent(event));
      const remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Delete";
      remove.addEventListener("click", () => deleteEvent(event));
      actions.append(edit, remove);
      footer.append(state, actions);
      card.append(meta, title, summary);
      if (links.children.length) card.append(links);
      card.append(footer);
      eventsGrid.append(card);
    });
  };
  const renderCoupons = () => { couponHistory.replaceChildren(); if (!coupons.length) { couponHistory.textContent = "No coupons have been issued yet."; return; } const table = document.createElement("table"); table.className = "console-table"; const head = document.createElement("thead"); head.innerHTML = "<tr><th>Member</th><th>Event</th><th>Value</th><th>Expiry</th><th>Status</th></tr>"; const body = document.createElement("tbody"); coupons.forEach((coupon) => { const row = document.createElement("tr"); const person = document.createElement("td"); const name = document.createElement("strong"); name.textContent = coupon.member_name; person.append(name, document.createElement("br"), document.createTextNode(coupon.member_email)); const event = document.createElement("td"); event.textContent = coupon.event_title; const discount = document.createElement("td"); discount.textContent = coupon.discount_amount_paise ? formatMoney(coupon.discount_amount_paise) : "Access code"; const expiry = document.createElement("td"); expiry.textContent = coupon.expires_at ? formatDate(coupon.expires_at, true) : "No expiry"; const state = document.createElement("td"); state.textContent = coupon.used_at ? `Used ${formatDate(coupon.used_at, true)}` : "Available"; row.append(person, event, discount, expiry, state); body.append(row); }); table.append(head, body); couponHistory.append(table); };
  const renderCertificates = () => {
    certificateEventsList.replaceChildren();
    if (!certificateEvents.length) { certificateEventsList.textContent = "Create an event before issuing participation certificates."; return; }
    certificateEvents.forEach((event) => {
      const row = document.createElement("article");
      row.className = "console-certificate-event";
      const copy = document.createElement("div");
      const title = document.createElement("strong"); title.textContent = event.title;
      const details = document.createElement("span"); details.textContent = `${formatDate(event.starts_at)}${event.venue ? ` / ${event.venue}` : ""}`;
      copy.append(title, details);
      const count = document.createElement("span"); count.className = "console-certificate-event__count";
      count.textContent = `${event.issued_count || 0} issued / ${event.registrant_count || 0} registered`;
      const button = document.createElement("button"); button.type = "button";
      const pending = Math.max(0, Number(event.registrant_count || 0) - Number(event.issued_count || 0));
      button.textContent = pending ? `Issue ${pending} certificate${pending === 1 ? "" : "s"}` : "All certificates issued";
      button.disabled = !pending;
      button.addEventListener("click", async () => {
        if (demoMode) {
          event.issued_count = event.registrant_count;
          overview = { ...overview, certificatesIssued: Number(overview.certificatesIssued || 0) + pending };
          renderCertificates(); renderOverview(); status(certificateStatus, `${pending} preview certificates marked as issued.`, "success");
          return;
        }
        button.disabled = true;
        status(certificateStatus, "Issuing certificates...");
        try {
          const result = await getJson("/api/admin/certificates", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ eventId: event.id }) });
          status(certificateStatus, `${result.issued} certificate${result.issued === 1 ? "" : "s"} issued. ${result.alreadyIssued ? `${result.alreadyIssued} already existed.` : ""}`, "success");
          await loadRecords();
        } catch (error) { button.disabled = false; status(certificateStatus, error.message, "error"); }
      });
      row.append(copy, count, button); certificateEventsList.append(row);
    });
  };
  const renderFunds = () => {
    setText('[data-fund="current"]', formatMoney(fundData.currentFundsPaise));
    setText('[data-fund="membership"]', formatMoney(fundData.membershipPaise));
    const manualLabel = fundData.adjustmentPaise < 0 ? `-${formatMoney(Math.abs(fundData.adjustmentPaise))}` : formatMoney(fundData.adjustmentPaise);
    setText('[data-fund="manual"]', manualLabel);
    fundsTable.replaceChildren();
    if (!fundEntries.length) { fundsTable.textContent = "No manual fund entries yet."; return; }
    const table = document.createElement("table");
    table.className = "console-table";
    const head = document.createElement("thead");
    head.innerHTML = "<tr><th>Date</th><th>Entry</th><th>Category</th><th>Movement</th><th>Recorded by</th></tr>";
    const body = document.createElement("tbody");
    fundEntries.forEach((entry) => {
      const row = document.createElement("tr");
      const date = document.createElement("td"); date.textContent = formatDate(entry.recorded_at);
      const entryCell = document.createElement("td");
      const title = document.createElement("strong"); title.textContent = entry.title;
      entryCell.append(title);
      if (entry.notes) { entryCell.append(document.createElement("br"), document.createTextNode(entry.notes)); }
      const category = document.createElement("td"); category.textContent = entry.category || "--";
      const movement = document.createElement("td"); movement.textContent = `${entry.entry_type === "debit" ? "-" : "+"}${formatMoney(entry.amount_paise)}`;
      movement.dataset.movement = entry.entry_type;
      const recordedBy = document.createElement("td"); recordedBy.textContent = entry.recorded_by_name || "Admin";
      row.append(date, entryCell, category, movement, recordedBy);
      body.append(row);
    });
    table.append(head, body);
    fundsTable.append(table);
  };
  const updateCouponFields = () => { couponDiscountInput.disabled = !couponToggle.checked; couponDiscountInput.closest("label").classList.toggle("is-disabled", !couponToggle.checked); };
  const resetEventForm = () => { editingEventId = null; eventForm.reset(); eventForm.memberOnly.checked = true; eventForm.registrationOpen.checked = true; eventForm.registrationFeeRupees.value = "0"; eventForm.couponDiscountRupees.value = "0"; eventForm.couponEnabled.checked = false; updateCouponFields(); eventEditorTitle.textContent = "Create event"; resetEventButton.hidden = true; status(eventStatus, ""); };
  const editEvent = (event) => { editingEventId = event.id; eventEditorTitle.textContent = `Edit ${event.title}`; resetEventButton.hidden = false; eventForm.title.value = event.title; eventForm.summary.value = event.summary; eventForm.details.value = event.details || ""; eventForm.venue.value = event.venue || ""; eventForm.posterUrl.value = event.poster_url || ""; eventForm.eventUrl.value = event.event_url || ""; eventForm.whatsappUrl.value = event.whatsapp_url || ""; eventForm.afterRegistrationContent.value = event.after_registration_content || ""; eventForm.startsAt.value = dateInput(event.starts_at); eventForm.endsAt.value = dateInput(event.ends_at); eventForm.registrationDeadline.value = dateInput(event.registration_deadline); eventForm.capacity.value = event.capacity || ""; eventForm.registrationFeeRupees.value = Number(event.registration_fee_paise || 0) / 100; eventForm.couponDiscountRupees.value = Number(event.coupon_discount_amount_paise || 0) / 100; eventForm.memberOnly.checked = Boolean(event.member_only); eventForm.couponEnabled.checked = Boolean(event.coupon_enabled); eventForm.registrationOpen.checked = Boolean(event.registration_open); eventForm.published.checked = Boolean(event.published); updateCouponFields(); window.scrollTo({ top: document.querySelector(".console-events-workbench").offsetTop - 18, behavior: "smooth" }); };
  const deleteEvent = async (event) => { if (demoMode) { status(eventStatus, "Preview mode does not remove saved events."); return; } if (!window.confirm(`Delete ${event.title}?`)) return; try { await getJson(`/api/admin/events/${event.id}`, { method: "DELETE" }); await loadRecords(); } catch (error) { status(eventStatus, error.message, "error"); } };
  const openMember = (member) => { memberForm.id.value = member.id; memberForm.fullName.value = member.full_name || ""; memberForm.phone.value = member.phone || ""; memberForm.department.value = member.department || ""; memberForm.studyYear.value = member.study_year || ""; memberForm.admissionNumber.value = member.admission_number || ""; status(memberStatus, ""); memberDialog.showModal(); };
  const loadRecords = async () => { if (demoMode) { overview = demoOverview; events = demoEvents; members = demoMembers; coupons = demoCoupons; certificateEvents = demoCertificateEvents.map((event) => ({ ...event })); fundData = { ...demoFundData }; fundEntries = [...demoFundEntries]; } else { const [overviewResponse, eventResponse, memberResponse, couponResponse, fundResponse, certificateResponse] = await Promise.all([getJson("/api/admin/overview"), getJson("/api/admin/events"), getJson("/api/admin/members"), getJson("/api/admin/coupons"), getJson("/api/admin/funds"), getJson("/api/admin/certificates")]); overview = overviewResponse; events = eventResponse.events; members = memberResponse.members; coupons = couponResponse.coupons; certificateEvents = certificateResponse.events; fundData = fundResponse; fundEntries = fundResponse.entries; } renderOverview(); renderMembers(memberSearch.value); renderEvents(); renderCoupons(); renderCertificates(); renderFunds(); };
  couponToggle?.addEventListener("change", updateCouponFields);
  updateCouponFields();
  eventForm.addEventListener("submit", async (event) => { event.preventDefault(); if (demoMode) { status(eventStatus, "Preview mode only. This event is not saved."); return; } try { const values = Object.fromEntries(new FormData(eventForm)); values.memberOnly = eventForm.memberOnly.checked; values.couponEnabled = eventForm.couponEnabled.checked; values.registrationOpen = eventForm.registrationOpen.checked; values.published = eventForm.published.checked; const endpoint = editingEventId ? `/api/admin/events/${editingEventId}` : "/api/admin/events"; await getJson(endpoint, { method: editingEventId ? "PATCH" : "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(values) }); status(eventStatus, "Event saved.", "success"); resetEventForm(); await loadRecords(); } catch (error) { status(eventStatus, error.message, "error"); } });
  resetEventButton.addEventListener("click", resetEventForm);
  fundForm?.addEventListener("submit", async (event) => { event.preventDefault(); const values = Object.fromEntries(new FormData(fundForm)); const amountPaise = Math.round(Number(values.amountRupees) * 100); if (!Number.isFinite(amountPaise) || amountPaise <= 0) { status(fundStatus, "Enter a valid amount in rupees.", "error"); return; } if (demoMode) { const entry = { id: crypto.randomUUID(), entry_type: values.entryType, amount_paise: amountPaise, title: String(values.title), category: String(values.category || ""), notes: String(values.notes || ""), recorded_at: values.recordedAt ? new Date(String(values.recordedAt)).toISOString() : new Date().toISOString(), recorded_by_name: "ACM AJCE Admin" }; fundEntries.unshift(entry); const movement = entry.entry_type === "debit" ? -entry.amount_paise : entry.amount_paise; fundData = { ...fundData, adjustmentPaise: fundData.adjustmentPaise + movement, currentFundsPaise: fundData.currentFundsPaise + movement }; overview = { ...overview, fundsPaise: fundData.currentFundsPaise }; fundForm.reset(); renderOverview(); renderFunds(); status(fundStatus, "Preview fund entry added to this session.", "success"); return; } try { await getJson("/api/admin/funds", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ entryType: values.entryType, amountPaise, title: values.title, category: values.category, notes: values.notes, recordedAt: values.recordedAt }) }); fundForm.reset(); await loadRecords(); status(fundStatus, "Fund entry saved.", "success"); } catch (error) { status(fundStatus, error.message, "error"); } });
  memberForm.addEventListener("submit", async (event) => { event.preventDefault(); if (demoMode) { status(memberStatus, "Preview mode only. Member records are unchanged."); return; } try { const data = Object.fromEntries(new FormData(memberForm)); const id = data.id; delete data.id; await getJson(`/api/admin/members/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify(data) }); status(memberStatus, "Member record saved.", "success"); await loadRecords(); window.setTimeout(() => memberDialog.close(), 450); } catch (error) { status(memberStatus, error.message, "error"); } });
  memberSearch.addEventListener("input", () => renderMembers(memberSearch.value));
  document.querySelector("[data-close-dialog]")?.addEventListener("click", () => memberDialog.close());
  loadRecords().catch((error) => { overviewEvents.textContent = error.message; membersTable.textContent = error.message; });
</script>
