  const demoCoupons = [
    { id: "coupon-one", event_title: "UXplore 2026", member_name: "Ananya Thomas", member_email: "ananya.thomas@ajce.in", discount_amount_paise: 0, expires_at: "2026-08-15T18:00:00.000Z", used_at: null, created_at: "2026-08-01T09:00:00.000Z" },
    { id: "coupon-two", event_title: "Data Alchemy", member_name: "Arjun Mathew", member_email: "arjun.mathew@ajce.in", discount_amount_paise: 5000, expires_at: "2026-09-03T18:00:00.000Z", used_at: "2026-08-15T12:00:00.000Z", created_at: "2026-08-03T10:00:00.000Z" },
  ];

  const views = [...document.querySelectorAll("[data-console-view]")];
  const navItems = [...document.querySelectorAll("[data-console-nav]")];
  const switchView = (view) => {
    views.forEach((panel) => { panel.hidden = panel.dataset.consoleView !== view; });
    navItems.forEach((item) => { const active = item.dataset.view === view; item.classList.toggle("is-active", active); if (active) item.setAttribute("aria-current", "page"); else item.removeAttribute("aria-current"); });
    window.scrollTo({ top: 0, behavior: "smooth" });
  };
  navItems.forEach((item) => item.addEventListener("click", () => switchView(item.dataset.view)));
  document.querySelectorAll("[data-switch-view]").forEach((button) => button.addEventListener("click", () => switchView(button.dataset.switchView)));
  document.querySelector("[data-new-event]")?.addEventListener("click", () => { switchView("events"); resetEventForm(); });

  const overviewEvents = document.querySelector("#overview-events");
  const overviewMembers = document.querySelector("#overview-members");
  const membersTable = document.querySelector("#members-table");
  const eventsGrid = document.querySelector("#events-grid");
  const couponHistory = document.querySelector("#coupon-history");
  const fundsTable = document.querySelector("#funds-table");
  const eventForm = document.querySelector("#event-form");
  const eventStatus = document.querySelector("#event-status");
  const eventEditorTitle = document.querySelector("#event-editor-title");
  const resetEventButton = document.querySelector("#reset-event");
  const couponForm = document.querySelector("#coupon-form");
  const couponStatus = document.querySelector("#coupon-status");
  const couponEvent = document.querySelector("#coupon-event");
  const couponMember = document.querySelector("#coupon-member");
  const memberSearch = document.querySelector("#member-search");
  const memberDialog = document.querySelector("#member-dialog");
  const memberForm = document.querySelector("#member-form");
  const memberStatus = document.querySelector("#member-status");

  const setOptions = (select, values, label) => { select.replaceChildren(new Option(`Choose ${label}`, "")); values.forEach((item) => select.add(new Option(item.title || item.full_name, item.id))); };
  const renderOverview = () => {
    setText('[data-metric="users"]', overview.users ?? 0);
    setText('[data-metric="members"]', overview.activeMembers ?? 0);
    setText('[data-metric="funds"]', formatMoney(overview.fundsPaise));
    setText('[data-metric="events"]', overview.openEvents ?? 0);
    setText('[data-health="registrations"]', overview.registrations ?? 0);
    setText('[data-health="coupons"]', overview.couponsIssued ?? 0);
    const rate = overview.users ? `${Math.round(((overview.activeMembers || 0) / overview.users) * 100)}%` : "--";
    setText('[data-health="rate"]', rate);
    overviewEvents.replaceChildren();
    const visibleEvents = events.filter((event) => event.published).slice(0, 3);
    if (!visibleEvents.length) { overviewEvents.textContent = "No published events yet."; return; }
    visibleEvents.forEach((event) => { const row = document.createElement("div"); row.className = "console-compact-item"; const date = new Date(event.starts_at); const dateBox = document.createElement("span"); dateBox.className = "console-date-box"; dateBox.textContent = `${date.toLocaleDateString("en-IN", { day: "2-digit" })}\n${date.toLocaleDateString("en-IN", { month: "short" })}`; const copy = document.createElement("div"); const title = document.createElement("strong"); title.textContent = event.title; const meta = document.createElement("span"); meta.textContent = `${event.venue || "Venue pending"} / ${formatDate(event.starts_at)}`; copy.append(title, meta); const tag = document.createElement("span"); tag.className = "console-tag"; tag.textContent = event.registration_open ? "Open" : "Closed"; row.append(dateBox, copy, tag); overviewEvents.append(row); });
    overviewMembers.replaceChildren();
    members.slice(0, 4).forEach((member) => { const chip = document.createElement("div"); chip.className = "console-member-chip"; const name = document.createElement("strong"); name.textContent = member.full_name; const meta = document.createElement("span"); meta.textContent = member.member_number || "Profile created"; chip.append(name, meta); overviewMembers.append(chip); });
  };
  const renderMembers = (query = "") => {
    membersTable.replaceChildren();
    const normalized = query.trim().toLowerCase();
    const filtered = members.filter((member) => [member.full_name, member.email, member.department, member.admission_number].join(" ").toLowerCase().includes(normalized));
    if (!filtered.length) { membersTable.textContent = "No members match that search."; return; }
    const table = document.createElement("table"); table.className = "console-table";
    const head = document.createElement("thead"); head.innerHTML = "<tr><th>Member</th><th>Academic details</th><th>Membership</th><th>Payment</th><th>Actions</th></tr>";
    const body = document.createElement("tbody");
    filtered.forEach((member) => { const row = document.createElement("tr"); const person = document.createElement("td"); const name = document.createElement("strong"); name.textContent = member.full_name; person.append(name, document.createElement("br"), document.createTextNode(member.email), document.createElement("br"), document.createTextNode(member.phone || "Profile incomplete")); const academic = document.createElement("td"); academic.textContent = `${member.department || "--"} / ${member.study_year || "--"}\n${member.admission_number || "--"}`; const membership = document.createElement("td"); membership.textContent = member.member_number ? `${member.membership_status}\n${member.member_number}\nUntil ${formatDate(member.expires_at)}` : "Not active"; const payment = document.createElement("td"); payment.textContent = member.razorpay_payment_id ? `${formatMoney(member.amount_paise)}\n${member.razorpay_payment_id}` : "--"; const action = document.createElement("td"); const actions = document.createElement("div"); actions.className = "console-table__actions"; const edit = document.createElement("button"); edit.type = "button"; edit.textContent = "Edit"; edit.addEventListener("click", () => openMember(member)); const card = document.createElement("a"); card.textContent = "ID card"; card.href = demoMode ? "/membership/card?preview=member" : `/membership/card?member=${encodeURIComponent(member.id)}`; actions.append(edit, card); action.append(actions); row.append(person, academic, membership, payment, action); body.append(row); }); table.append(head, body); membersTable.append(table); };
  const renderEvents = () => { eventsGrid.replaceChildren(); if (!events.length) { eventsGrid.textContent = "No events have been created yet."; return; } events.forEach((event) => { const card = document.createElement("article"); card.className = "console-event-card"; const meta = document.createElement("p"); meta.className = "console-event-card__meta"; meta.textContent = `${event.published ? "Published" : "Draft"} / ${formatDate(event.starts_at, true)}`; const title = document.createElement("h3"); title.textContent = event.title; const summary = document.createElement("p"); summary.className = "console-event-card__summary"; summary.textContent = event.summary; const footer = document.createElement("div"); footer.className = "console-event-card__footer"; const state = document.createElement("span"); state.className = "console-tag"; state.textContent = event.registration_open ? "Registration open" : "Registration closed"; const actions = document.createElement("div"); actions.className = "console-event-card__actions"; const edit = document.createElement("button"); edit.type = "button"; edit.textContent = "Edit"; edit.addEventListener("click", () => editEvent(event)); const remove = document.createElement("button"); remove.type = "button"; remove.textContent = "Delete"; remove.addEventListener("click", () => deleteEvent(event)); actions.append(edit, remove); footer.append(state, actions); card.append(meta, title, summary, footer); eventsGrid.append(card); }); };
  const renderCoupons = () => { couponHistory.replaceChildren(); if (!coupons.length) { couponHistory.textContent = "No coupons have been issued yet."; return; } const table = document.createElement("table"); table.className = "console-table"; const head = document.createElement("thead"); head.innerHTML = "<tr><th>Member</th><th>Event</th><th>Value</th><th>Expiry</th><th>Status</th></tr>"; const body = document.createElement("tbody"); coupons.forEach((coupon) => { const row = document.createElement("tr"); const person = document.createElement("td"); const name = document.createElement("strong"); name.textContent = coupon.member_name; person.append(name, document.createElement("br"), document.createTextNode(coupon.member_email)); const event = document.createElement("td"); event.textContent = coupon.event_title; const discount = document.createElement("td"); discount.textContent = coupon.discount_amount_paise ? formatMoney(coupon.discount_amount_paise) : "Access code"; const expiry = document.createElement("td"); expiry.textContent = coupon.expires_at ? formatDate(coupon.expires_at, true) : "No expiry"; const state = document.createElement("td"); state.textContent = coupon.used_at ? `Used ${formatDate(coupon.used_at, true)}` : "Available"; row.append(person, event, discount, expiry, state); body.append(row); }); table.append(head, body); couponHistory.append(table); };
  const renderFunds = () => { const paid = members.filter((member) => member.razorpay_payment_id); const total = paid.reduce((sum, member) => sum + (Number(member.amount_paise) || 0), 0); setText('[data-fund="collected"]', formatMoney(overview.fundsPaise ?? total)); setText('[data-fund="paid"]', paid.length); setText('[data-fund="average"]', paid.length ? formatMoney(total / paid.length) : "--"); fundsTable.replaceChildren(); if (!paid.length) { fundsTable.textContent = "No verified payments yet."; return; } const table = document.createElement("table"); table.className = "console-table"; const head = document.createElement("thead"); head.innerHTML = "<tr><th>Member</th><th>Member number</th><th>Amount</th><th>Razorpay payment</th></tr>"; const body = document.createElement("tbody"); paid.forEach((member) => { const row = document.createElement("tr"); [member.full_name, member.member_number || "--", formatMoney(member.amount_paise), member.razorpay_payment_id].forEach((value) => { const cell = document.createElement("td"); cell.textContent = value; row.append(cell); }); body.append(row); }); table.append(head, body); fundsTable.append(table); };
  const resetEventForm = () => { editingEventId = null; eventForm.reset(); eventForm.memberOnly.checked = true; eventForm.registrationOpen.checked = true; eventEditorTitle.textContent = "Create event"; resetEventButton.hidden = true; status(eventStatus, ""); };
  const editEvent = (event) => { editingEventId = event.id; eventEditorTitle.textContent = `Edit ${event.title}`; resetEventButton.hidden = false; eventForm.title.value = event.title; eventForm.summary.value = event.summary; eventForm.details.value = event.details || ""; eventForm.venue.value = event.venue || ""; eventForm.startsAt.value = dateInput(event.starts_at); eventForm.endsAt.value = dateInput(event.ends_at); eventForm.registrationDeadline.value = dateInput(event.registration_deadline); eventForm.capacity.value = event.capacity || ""; eventForm.memberOnly.checked = Boolean(event.member_only); eventForm.registrationOpen.checked = Boolean(event.registration_open); eventForm.published.checked = Boolean(event.published); window.scrollTo({ top: document.querySelector(".console-events-workbench").offsetTop - 18, behavior: "smooth" }); };
  const deleteEvent = async (event) => { if (demoMode) { status(eventStatus, "Preview mode does not remove saved events."); return; } if (!window.confirm(`Delete ${event.title}?`)) return; try { await getJson(`/api/admin/events/${event.id}`, { method: "DELETE" }); await loadRecords(); } catch (error) { status(eventStatus, error.message, "error"); } };
  const openMember = (member) => { memberForm.id.value = member.id; memberForm.fullName.value = member.full_name || ""; memberForm.phone.value = member.phone || ""; memberForm.department.value = member.department || ""; memberForm.studyYear.value = member.study_year || ""; memberForm.admissionNumber.value = member.admission_number || ""; status(memberStatus, ""); memberDialog.showModal(); };
  const loadRecords = async () => { if (demoMode) { overview = demoOverview; events = demoEvents; members = demoMembers; coupons = demoCoupons; } else { const [overviewResponse, eventResponse, memberResponse, couponResponse] = await Promise.all([getJson("/api/admin/overview"), getJson("/api/admin/events"), getJson("/api/admin/members"), getJson("/api/admin/coupons")]); overview = overviewResponse; events = eventResponse.events; members = memberResponse.members; coupons = couponResponse.coupons; } setOptions(couponEvent, events, "event"); setOptions(couponMember, members, "member"); renderOverview(); renderMembers(memberSearch.value); renderEvents(); renderCoupons(); renderFunds(); };
  eventForm.addEventListener("submit", async (event) => { event.preventDefault(); if (demoMode) { status(eventStatus, "Preview mode only. This event is not saved."); return; } try { const values = Object.fromEntries(new FormData(eventForm)); values.memberOnly = eventForm.memberOnly.checked; values.registrationOpen = eventForm.registrationOpen.checked; values.published = eventForm.published.checked; const endpoint = editingEventId ? `/api/admin/events/${editingEventId}` : "/api/admin/events"; await getJson(endpoint, { method: editingEventId ? "PATCH" : "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(values) }); status(eventStatus, "Event saved.", "success"); resetEventForm(); await loadRecords(); } catch (error) { status(eventStatus, error.message, "error"); } });
  resetEventButton.addEventListener("click", resetEventForm);
  couponForm.addEventListener("submit", async (event) => { event.preventDefault(); if (demoMode) { status(couponStatus, "Preview code: AJCE-DEMO-2026. No real coupon was created.", "success"); return; } try { const data = await getJson("/api/admin/coupons", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(couponForm))) }); status(couponStatus, `Code created: ${data.code}. Copy it now; it cannot be retrieved later.`, "success"); couponForm.reset(); await loadRecords(); } catch (error) { status(couponStatus, error.message, "error"); } });
  memberForm.addEventListener("submit", async (event) => { event.preventDefault(); if (demoMode) { status(memberStatus, "Preview mode only. Member records are unchanged."); return; } try { const data = Object.fromEntries(new FormData(memberForm)); const id = data.id; delete data.id; await getJson(`/api/admin/members/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify(data) }); status(memberStatus, "Member record saved.", "success"); await loadRecords(); window.setTimeout(() => memberDialog.close(), 450); } catch (error) { status(memberStatus, error.message, "error"); } });
  memberSearch.addEventListener("input", () => renderMembers(memberSearch.value));
  document.querySelector("[data-close-dialog]")?.addEventListener("click", () => memberDialog.close());
  loadRecords().catch((error) => { overviewEvents.textContent = error.message; membersTable.textContent = error.message; });
</script>
