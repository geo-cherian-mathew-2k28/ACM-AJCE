---
import AdminConsoleLayout from "../../layouts/AdminConsoleLayout.astro";
import { getCurrentUser, isAdminEmail } from "../../lib/membership";

const isLocalPreviewHost = ["localhost", "127.0.0.1", "::1"].includes(
  Astro.url.hostname
);
const isPreview = isLocalPreviewHost && Astro.url.searchParams.get("preview") === "admin";
const user = isPreview
  ? { full_name: "ACM AJCE Admin", email: "preview.admin@acm-ajce.local" }
  : await getCurrentUser(Astro.request, Astro.locals);
if (!isPreview && (!user || !isAdminEmail(user.email, Astro.locals))) {
  return Astro.redirect("/membership");
}

const viewerName = user?.full_name ?? "ACM AJCE Admin";
const viewerEmail = user?.email ?? "preview.admin@acm-ajce.local";
const greetingName = viewerName === "ACM AJCE Admin" ? "ACM AJCE" : viewerName.split(" ")[0];
---

<AdminConsoleLayout viewerName={viewerName} viewerEmail={viewerEmail} preview={isPreview}>
  <section class="console-page" data-demo={isPreview ? "true" : "false"}>
    <header class="console-page__heading">
      <div>
        <p>Chapter control center</p>
        <h1>Good evening, {greetingName}.</h1>
        <span>Members, events, and funds at a glance.</span>
      </div>
      <div class="console-heading-actions"><button class="console-primary console-primary--violet" type="button" data-new-event>New event</button><button class="console-primary console-primary--mint" type="button" data-add-fund>Record funds</button></div>
    </header>

    <section class="console-view" data-console-view="overview">
      <div class="console-signalbar">
        <span><i class="console-signalbar__dot"></i>Chapter systems online</span>
        <span><strong data-signal="events">--</strong> active registrations</span>
        <span><strong data-signal="members">--</strong> local members</span>
        <span><strong data-signal="funds">--</strong> current funds</span>
      </div>
      <div class="console-quick-actions" aria-label="Quick actions">
        <button type="button" data-new-event><span class="console-quick-actions__icon console-quick-actions__icon--violet">+</span><span><strong>Create event</strong><small>Set up registrations</small></span></button>
        <button type="button" data-switch-view="coupons"><span class="console-quick-actions__icon console-quick-actions__icon--amber">#</span><span><strong>Issue code</strong><small>Assign one-time access</small></span></button>
        <button type="button" data-add-fund><span class="console-quick-actions__icon console-quick-actions__icon--mint">+</span><span><strong>Record funds</strong><small>Keep the balance current</small></span></button>
      </div>
      <div class="console-metrics">
        <article class="console-metric"><span class="console-metric__glyph console-metric__glyph--violet">P</span><div><span>Total people</span><strong data-metric="users">--</strong><small>Accounts in the chapter</small></div></article>
        <article class="console-metric"><span class="console-metric__glyph console-metric__glyph--cyan">M</span><div><span>Active members</span><strong data-metric="members">--</strong><small>Current local plans</small></div></article>
        <article class="console-metric"><span class="console-metric__glyph console-metric__glyph--amber">F</span><div><span>Current funds</span><strong data-metric="funds">--</strong><small>Membership and manual entries</small></div></article>
        <article class="console-metric"><span class="console-metric__glyph console-metric__glyph--mint">C</span><div><span>Certificates issued</span><strong data-metric="certificates">--</strong><small>Participation records</small></div></article>
      </div>

      <div class="console-overview-grid">
        <section class="console-panel console-health">
          <div class="console-panel__heading"><div><span class="console-kicker">Chapter pulse</span><h2>What needs attention</h2></div></div>
          <div class="console-health__rows">
            <div><span>Event registrations</span><strong data-health="registrations">--</strong></div>
            <div><span>Issued coupons</span><strong data-health="coupons">--</strong></div>
            <div><span>Certificates issued</span><strong data-health="certificates">--</strong></div>
            <div><span>Membership renewal rate</span><strong data-health="rate">--</strong></div>
          </div>
          <p class="console-note">A compact read of registrations, member activity, and current balance.</p>
        </section>
        <section class="console-panel">
          <div class="console-panel__heading"><div><span class="console-kicker">Coming up</span><h2>Event timeline</h2></div><button class="console-text-action" type="button" data-switch-view="events">Manage events</button></div>
          <div id="overview-events" class="console-compact-list"><p class="console-empty">Loading events...</p></div>
        </section>
      </div>

      <section class="console-panel">
        <div class="console-panel__heading"><div><span class="console-kicker">Latest members</span><h2>Recently added to the chapter</h2></div><button class="console-text-action" type="button" data-switch-view="members">View members</button></div>
        <div id="overview-members" class="console-member-strip"><p class="console-empty">Loading member records...</p></div>
      </section>
    </section>

    <section class="console-view" data-console-view="members" hidden>
      <header class="console-section-heading"><div><span class="console-kicker">Member directory</span><h2>People and membership records</h2><p>Review contact, academic, membership, and payment information without leaving the console.</p></div><label class="console-search"><span>Search</span><input id="member-search" type="search" placeholder="Name, email, department" /></label></header>
      <div id="members-table" class="console-table-wrap"><p class="console-empty">Loading member records...</p></div>
    </section>

    <section class="console-view" data-console-view="events" hidden>
      <header class="console-section-heading"><div><span class="console-kicker">Event operations</span><h2>Create and manage member events</h2><p>Publish events when the chapter is ready, then keep registrations and capacity in one place.</p></div></header>
      <div class="console-events-workbench">
        <div id="events-grid" class="console-events-grid"><p class="console-empty">Loading events...</p></div>
        <aside class="console-panel console-editor">
          <div class="console-panel__heading"><div><span class="console-kicker">Event editor</span><h2 id="event-editor-title">Create event</h2></div><button id="reset-event" class="console-text-action" type="button" hidden>New event</button></div>
          <form id="event-form" class="console-form">
            <label class="console-field"><span>Title</span><input name="title" required /></label>
            <label class="console-field"><span>Short summary</span><textarea name="summary" required></textarea></label>
            <div class="console-form__two"><label class="console-field"><span>Starts</span><input name="startsAt" type="datetime-local" required /></label><label class="console-field"><span>Ends</span><input name="endsAt" type="datetime-local" /></label></div>
            <div class="console-form__two"><label class="console-field"><span>Venue</span><input name="venue" /></label><label class="console-field"><span>Capacity</span><input name="capacity" type="number" min="1" /></label></div>
            <div class="console-form__two"><label class="console-field"><span>Registration fee (Rs.)</span><input name="registrationFeeRupees" type="number" min="0" step="0.01" value="0" /></label><label class="console-field"><span>Member coupon discount (Rs.)</span><input name="couponDiscountRupees" type="number" min="0" step="0.01" value="0" data-coupon-discount /></label></div>
            <label class="console-field"><span>Registration deadline</span><input name="registrationDeadline" type="datetime-local" /></label>
            <label class="console-field"><span>Member details</span><textarea name="details"></textarea></label>
            <label class="console-field"><span>Poster image URL</span><input name="posterUrl" type="url" placeholder="https://..." /></label>
            <div class="console-form__two"><label class="console-field"><span>Event link</span><input name="eventUrl" type="url" placeholder="https://..." /></label><label class="console-field"><span>WhatsApp link</span><input name="whatsappUrl" type="url" placeholder="https://chat.whatsapp.com/..." /></label></div>
            <label class="console-field"><span>After registration message</span><textarea name="afterRegistrationContent" placeholder="What a registered member should know next"></textarea></label>
            <div class="console-checks"><label><input name="memberOnly" type="checkbox" checked /> Members only</label><label><input name="couponEnabled" type="checkbox" data-coupon-toggle /> Enable private member coupon</label><label><input name="registrationOpen" type="checkbox" checked /> Registration open</label><label><input name="published" type="checkbox" /> Publish now</label></div>
            <p class="console-form-note">When member coupons are enabled, every active member receives a different account-bound code. The code is rejected for every other account and expires after use.</p>
            <button class="console-primary" type="submit">Save event</button><p id="event-status" class="console-status" aria-live="polite"></p>
          </form>
        </aside>
      </div>
    </section>

    <section class="console-view" data-console-view="certificates" hidden>
      <header class="console-section-heading"><div><span class="console-kicker">Certificate operations</span><h2>Issue event certificates with a clear audit trail</h2><p>Choose an event, then issue certificates to its registered participants. Each participant receives at most one certificate per event.</p></div></header>
      <section class="console-panel console-certificate-panel">
        <div class="console-panel__heading"><div><span class="console-kicker">Eligible registrations</span><h2>Certificates by event</h2></div></div>
        <div id="certificate-events" class="console-certificate-events"><p class="console-empty">Loading event certificate records...</p></div>
        <p id="certificate-status" class="console-status" aria-live="polite"></p>
      </section>
    </section>

    <section class="console-view" data-console-view="coupons" hidden>
      <header class="console-section-heading"><div><span class="console-kicker">Member coupon records</span><h2>Private event benefits, without exposed codes</h2><p>Enable the member coupon while creating an event. The system provisions one account-bound code for each active member, stores only its validation hash, and marks it unusable after registration.</p></div></header>
      <section class="console-panel">
        <div class="console-panel__heading"><div><span class="console-kicker">Coupon activity</span><h2>Issued and redeemed codes</h2></div></div>
        <div id="coupon-history" class="console-table-wrap console-table-wrap--inner"><p class="console-empty">Loading coupon history...</p></div>
      </section>
    </section>

    <section class="console-view" data-console-view="funds" hidden>
      <header class="console-section-heading"><div><span class="console-kicker">Chapter funds</span><h2>Balance and fund activity</h2><p>Record opening balances, income, and expenses alongside verified membership payments.</p></div></header>
      <div class="console-fund-grid">
        <article class="console-panel console-fund-card console-fund-card--balance"><span>Current balance</span><strong data-fund="current">--</strong><small>After manual income and expenses</small></article>
        <article class="console-panel console-fund-card"><span>Membership income</span><strong data-fund="membership">--</strong><small>Verified Razorpay payments</small></article>
        <article class="console-panel console-fund-card"><span>Manual movement</span><strong data-fund="manual">--</strong><small>Cash, sponsorships, and expenses</small></article>
      </div>
      <div class="console-fund-layout">
        <section class="console-panel console-fund-entry">
          <div class="console-panel__heading"><div><span class="console-kicker">New entry</span><h2>Record current funds</h2></div></div>
          <form id="fund-form" class="console-form">
            <div class="console-form__two"><label class="console-field"><span>Type</span><select name="entryType"><option value="credit">Income / balance added</option><option value="debit">Expense / balance used</option></select></label><label class="console-field"><span>Amount in rupees</span><input name="amountRupees" type="number" min="1" step="0.01" required /></label></div>
            <label class="console-field"><span>Entry title</span><input name="title" placeholder="Opening balance, sponsor support, venue expense" required /></label>
            <div class="console-form__two"><label class="console-field"><span>Category</span><input name="category" placeholder="Operations" /></label><label class="console-field"><span>Recorded on</span><input name="recordedAt" type="date" /></label></div>
            <label class="console-field"><span>Notes</span><textarea name="notes" placeholder="Optional reference or payment note"></textarea></label>
            <button class="console-primary console-primary--mint" type="submit">Save fund entry</button><p id="fund-status" class="console-status" aria-live="polite"></p>
          </form>
        </section>
        <section class="console-panel"><div class="console-panel__heading"><div><span class="console-kicker">Fund ledger</span><h2>Recent entries</h2></div></div><div id="funds-table" class="console-table-wrap console-table-wrap--inner"><p class="console-empty">Loading fund activity...</p></div></section>
      </div>
    </section>
  </section>

  <dialog id="member-dialog" class="console-dialog">
    <form id="member-form" class="console-panel console-form" method="dialog">
      <div class="console-panel__heading"><div><span class="console-kicker">Member record</span><h2>Edit details</h2></div><button class="console-text-action" type="button" data-close-dialog>Close</button></div>
      <input name="id" type="hidden" />
      <label class="console-field"><span>Full name</span><input name="fullName" required /></label>
      <label class="console-field"><span>Phone</span><input name="phone" required /></label>
      <div class="console-form__two"><label class="console-field"><span>Department</span><input name="department" required /></label><label class="console-field"><span>Year</span><input name="studyYear" required /></label></div>
      <label class="console-field"><span>Admission number</span><input name="admissionNumber" required /></label>
      <button class="console-primary" type="submit">Save member record</button><p id="member-status" class="console-status" aria-live="polite"></p>
    </form>
  </dialog>
</AdminConsoleLayout>

<style is:global>
  .console-page { display: grid; gap: 30px; }
  .console-page__heading, .console-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .console-page__heading > div > p, .console-kicker { margin: 0 0 9px; color: #b8a7ff; font: 700 0.64rem/1 "Space Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  .console-page__heading h1 { max-width: 680px; margin: 0; color: #fbfaff; font-size: clamp(2rem, 4.2vw, 3.35rem); letter-spacing: 0; line-height: 1; }
  .console-page__heading > div > span { display: block; max-width: 650px; margin-top: 12px; color: #a6a2b4; font-size: 0.93rem; line-height: 1.55; }
  .console-primary { min-height: 40px; border: 1px solid #b8a7ff; border-radius: 5px; padding: 0 14px; background: #b8a7ff; color: #2a2455; font-size: 0.76rem; font-weight: 800; cursor: pointer; transition: background 150ms ease, transform 150ms ease; }
  .console-primary:hover, .console-primary:focus-visible { background: #e6e1ff; transform: translateY(-1px); outline: none; }
  .console-primary[disabled] { opacity: 0.55; cursor: wait; transform: none; }
  .console-view { display: grid; gap: 20px; }
  .console-view[hidden] { display: none; }
  .console-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .console-metric, .console-panel { border: 1px solid rgba(230, 225, 255, 0.14); border-radius: 7px; background: #101117; box-shadow: 0 16px 38px rgba(0, 0, 0, 0.13); }
  .console-metric { min-height: 158px; padding: 20px; display: grid; align-content: space-between; gap: 16px; }
  .console-metric span, .console-fund-card span { color: #aaa6b9; font: 700 0.61rem/1.2 "Space Mono", monospace; letter-spacing: 0.075em; text-transform: uppercase; }
  .console-metric strong, .console-fund-card strong { color: #f8f7ff; font-size: clamp(1.9rem, 3vw, 2.65rem); line-height: 1; }
  .console-metric small, .console-fund-card small { color: #777384; font-size: 0.72rem; line-height: 1.4; }
  .console-overview-grid, .console-coupon-layout { display: grid; grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr); gap: 12px; }
  .console-panel { padding: 21px; }
  .console-panel__heading { display: flex; justify-content: space-between; gap: 16px; align-items: start; margin-bottom: 18px; }
  .console-panel__heading h2, .console-section-heading h2 { margin: 0; color: #f8f7ff; font-size: 1.14rem; letter-spacing: 0; }
  .console-section-heading p { max-width: 670px; margin: 10px 0 0; color: #9793a4; font-size: 0.88rem; line-height: 1.5; }
  .console-text-action { padding: 0; border: 0; background: transparent; color: #b8a7ff; font-size: 0.72rem; font-weight: 800; cursor: pointer; }
  .console-text-action:hover, .console-text-action:focus-visible { color: #e6e1ff; outline: none; }
  .console-health__rows { display: grid; gap: 9px; }
  .console-health__rows div { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 38px; padding-bottom: 9px; border-bottom: 1px solid rgba(230, 225, 255, 0.08); color: #aaa6b9; font-size: 0.81rem; }
  .console-health__rows strong { color: #f5f3ff; font-family: "Space Mono", monospace; font-size: 0.78rem; }
  .console-note { margin: 16px 0 0; color: #767182; font-size: 0.72rem; line-height: 1.5; }
  .console-compact-list { display: grid; gap: 8px; }
  .console-compact-item { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: 54px; padding-bottom: 10px; border-bottom: 1px solid rgba(230, 225, 255, 0.08); }
  .console-compact-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .console-date-box { width: 39px; padding: 5px 2px; border: 1px solid rgba(184, 167, 255, 0.42); border-radius: 4px; color: #d9d2ff; text-align: center; font: 700 0.63rem/1.1 "Space Mono", monospace; }
  .console-compact-item strong, .console-compact-item span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .console-compact-item strong { color: #eceaf4; font-size: 0.8rem; line-height: 1.25; }
  .console-compact-item span { margin-top: 5px; color: #817d8d; font-size: 0.69rem; line-height: 1.25; }
  .console-tag { padding: 4px 6px; border: 1px solid rgba(184, 167, 255, 0.33); border-radius: 4px; color: #b8a7ff; font: 700 0.58rem/1 "Space Mono", monospace; letter-spacing: 0.04em; text-transform: uppercase; }
  .console-member-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; }
  .console-member-chip { min-width: 0; padding: 12px; border: 1px solid rgba(230, 225, 255, 0.11); border-radius: 5px; background: rgba(42, 36, 85, 0.2); }
  .console-member-chip strong, .console-member-chip span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .console-member-chip strong { color: #eeecf6; font-size: 0.77rem; }
  .console-member-chip span { margin-top: 5px; color: #8b8698; font-size: 0.67rem; }
  .console-search { display: grid; gap: 6px; min-width: min(100%, 260px); }
  .console-search span, .console-field > span { color: #a9a5b7; font: 700 0.6rem/1 "Space Mono", monospace; letter-spacing: 0.08em; text-transform: uppercase; }
  .console-search input, .console-field input, .console-field textarea, .console-field select { width: 100%; min-height: 39px; border: 1px solid rgba(230, 225, 255, 0.18); border-radius: 4px; padding: 8px 10px; background: #0b0c11; color: #f5f3fb; outline: none; }
  .console-field textarea { min-height: 79px; resize: vertical; }
  .console-search input:focus, .console-field input:focus, .console-field textarea:focus, .console-field select:focus { border-color: #b8a7ff; }
  .console-table-wrap { overflow-x: auto; border: 1px solid rgba(230, 225, 255, 0.13); border-radius: 7px; background: #101117; }
  .console-table-wrap--inner { border: 0; border-radius: 0; background: transparent; }
  .console-table { width: 100%; min-width: 780px; border-collapse: collapse; }
  .console-table th, .console-table td { padding: 13px; border-bottom: 1px solid rgba(230, 225, 255, 0.08); text-align: left; vertical-align: top; }
  .console-table th { color: #918c9f; font: 700 0.59rem/1 "Space Mono", monospace; letter-spacing: 0.075em; text-transform: uppercase; }
  .console-table td { color: #bebac9; font-size: 0.75rem; line-height: 1.45; white-space: pre-line; }
  .console-table td strong { color: #f3f1fa; }
  .console-table__actions { display: flex; gap: 9px; }
  .console-table__actions a, .console-table__actions button { border: 0; padding: 0; background: transparent; color: #b8a7ff; font-size: 0.72rem; font-weight: 800; text-decoration: none; cursor: pointer; }
  .console-events-workbench { display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, 0.6fr); gap: 12px; align-items: start; }
  .console-events-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .console-event-card { min-height: 210px; padding: 19px; display: flex; flex-direction: column; border: 1px solid rgba(230, 225, 255, 0.14); border-radius: 7px; background: #101117; }
  .console-event-card__meta { margin: 0 0 13px; color: #b8a7ff; font: 700 0.59rem/1.4 "Space Mono", monospace; letter-spacing: 0.045em; text-transform: uppercase; }
  .console-event-card h3 { margin: 0; color: #f5f3fb; font-size: 1rem; }
  .console-event-card__summary { margin: 10px 0 16px; color: #9894a5; font-size: 0.78rem; line-height: 1.45; }
  .console-event-card__footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; }
  .console-event-card__actions { display: flex; gap: 8px; }
  .console-event-card__actions button { min-height: 31px; border: 1px solid rgba(184, 167, 255, 0.3); border-radius: 4px; padding: 0 8px; background: transparent; color: #d8d2f6; font-size: 0.68rem; font-weight: 800; cursor: pointer; }
  .console-event-card__actions button:last-child { border-color: rgba(255, 160, 180, 0.32); color: #ffb6c4; }
  .console-editor { position: sticky; top: 20px; }
  .console-form { display: grid; gap: 13px; }
  .console-field { display: grid; gap: 7px; }
  .console-form__two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .console-checks { display: flex; flex-wrap: wrap; gap: 10px; color: #bbb7c5; font-size: 0.72rem; }
  .console-checks label { display: inline-flex; gap: 6px; align-items: center; }
  .console-checks input { accent-color: #b8a7ff; }
  .console-status { min-height: 18px; margin: 0; color: #b8a7ff; font-size: 0.72rem; line-height: 1.45; }
  .console-status[data-state="error"] { color: #ffb2c2; }
  .console-status[data-state="success"] { color: #a3edc5; }
  .console-fund-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .console-fund-card { min-height: 140px; display: grid; align-content: space-between; gap: 12px; }
  .console-empty { margin: 0; color: #787383; font-size: 0.78rem; }
  .console-dialog { width: min(100% - 28px, 560px); padding: 0; border: 0; background: transparent; color: #f8f7ff; }
  .console-dialog::backdrop { background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(4px); }
  @media (max-width: 1120px) { .console-metrics { grid-template-columns: repeat(2, 1fr); } .console-events-workbench { grid-template-columns: 1fr; } .console-editor { position: static; } .console-member-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .console-page__heading, .console-section-heading { align-items: flex-start; flex-direction: column; } .console-overview-grid, .console-coupon-layout, .console-events-grid, .console-fund-grid { grid-template-columns: 1fr; } .console-search { width: 100%; } }
  @media (max-width: 470px) { .console-metrics, .console-member-strip, .console-form__two { grid-template-columns: 1fr; } .console-page__heading h1 { font-size: 2rem; } }

  .console-page { gap: 22px; }
  .console-page__heading { align-items: center; padding: 2px 1px 3px; }
  .console-page__heading > div > p { margin-bottom: 7px; }
  .console-page__heading h1 { max-width: none; font-size: clamp(2rem, 3.3vw, 2.9rem); }
  .console-page__heading > div > span { margin-top: 8px; font-size: 0.82rem; }
  .console-heading-actions { display: flex; flex-wrap: wrap; gap: 9px; justify-content: flex-end; }
  .console-primary { min-height: 39px; border-radius: 7px; box-shadow: 0 9px 20px rgba(0, 0, 0, 0.18); }
  .console-primary--violet { border-color: #9182ff; background: #7666ea; color: #fff; }
