---
import MembershipLayout from "../../layouts/MembershipLayout.astro";
import {
  getActiveMembership,
  getCurrentUser,
  getDatabase,
  isAdminEmail,
  type MemberUser,
  type MembershipRecord,
} from "../../lib/membership";

const viewer = await getCurrentUser(Astro.request, Astro.locals);
if (!viewer) return Astro.redirect("/membership");

const requestedMemberId = Astro.url.searchParams.get("member");
const memberId = requestedMemberId && isAdminEmail(viewer.email, Astro.locals) ? requestedMemberId : viewer.id;
const database = getDatabase(Astro.locals);
const member = await database.prepare("SELECT * FROM users WHERE id = ? LIMIT 1").bind(memberId).first<MemberUser>();
const membership = member ? await getActiveMembership(database, member.id) : null;
if (!member || !membership) return Astro.redirect("/membership");

const validTo = new Date((membership as MembershipRecord).expires_at).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
---

<MembershipLayout title="ACM AJCE Member ID" signedIn>
  <section class="id-page">
    <div class="id-page__heading">
      <div><p class="portal-eyebrow">ACM AJCE member ID</p><h1 class="portal-title">Your chapter card.</h1></div>
      <div class="id-page__actions"><a class="portal-button portal-button--subtle" href="/membership">Dashboard</a><button class="portal-button" type="button" id="download-card">Download as PDF</button></div>
    </div>
    <article id="member-card" class="member-id-card">
      <div class="member-id-card__top"><img src="/brand/acm-ajce-light.png" alt="ACM AJCE" /><span>LOCAL CHAPTER</span></div>
      <div class="member-id-card__body">
        <div><p class="member-id-card__label">Member</p><h2>{member.full_name}</h2><p>{member.department} / {member.study_year}</p></div>
        <div class="member-id-card__seal">ACM<br />AJCE</div>
      </div>
      <div class="member-id-card__bottom"><span>{membership.member_number}</span><span>VALID TO {validTo.toUpperCase()}</span></div>
    </article>
  </section>
</MembershipLayout>

<style>
  .id-page { display: grid; gap: 42px; }
  .id-page__heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .id-page__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .member-id-card { width: min(100%, 760px); padding: clamp(22px, 4vw, 42px); border: 1px solid rgba(230, 225, 255, 0.5); border-radius: 8px; background: linear-gradient(135deg, #211d44, #4f4296 58%, #7c6add); box-shadow: 0 28px 60px rgba(87, 71, 176, 0.28); }
  .member-id-card__top, .member-id-card__bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: #e6e1ff; font: 700 0.67rem/1.2 "Space Mono", monospace; letter-spacing: 0.07em; }
  .member-id-card__top img { width: 130px; max-height: 50px; object-fit: contain; object-position: left center; filter: brightness(0) invert(1); }
  .member-id-card__body { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin: clamp(66px, 12vw, 116px) 0 32px; }
  .member-id-card__label { margin: 0 0 9px; color: #cfc7ff; font: 700 0.65rem/1 "Space Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  .member-id-card h2 { margin: 0; font-size: clamp(1.7rem, 5vw, 3.35rem); letter-spacing: 0; }
  .member-id-card__body p:not(.member-id-card__label) { margin: 10px 0 0; color: rgba(251, 250, 255, 0.75); }
  .member-id-card__seal { width: 76px; height: 76px; display: grid; place-items: center; border: 1px solid rgba(251, 250, 255, 0.78); border-radius: 50%; color: #fbfaff; text-align: center; font: 700 0.76rem/1.1 "Space Mono", monospace; }
  @media (max-width: 600px) { .id-page__heading { align-items: flex-start; flex-direction: column; } .member-id-card__body { align-items: flex-start; flex-direction: column; margin: 60px 0 28px; } .member-id-card__seal { align-self: flex-end; margin-top: -30px; } .member-id-card__top, .member-id-card__bottom { align-items: flex-start; flex-direction: column; } }
</style>

<script>
  document.querySelector("#download-card")?.addEventListener("click", () => window.print());
</script>

<style is:global>
  @media print {
    .portal-grid, .portal-header, .id-page__heading { display: none !important; }
    .portal-main { width: 100%; padding: 0; }
    .id-page { min-height: 100vh; display: grid; place-items: center; }
    .member-id-card { box-shadow: none; }
  }
</style>
