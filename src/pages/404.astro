---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/25 text-[#B8A7FF] text-xs font-mono uppercase tracking-widest mb-6">
      Error 404 // Resource Missing
    </div>
    <h1 class="text-6xl sm:text-8xl font-black text-white tracking-tighter mb-4 font-mono">
      404
    </h1>
    <h2 class="text-xl sm:text-2xl font-bold text-gray-200 mb-3">
      Page Not Found
    </h2>
    <p class="text-sm text-gray-400 max-w-md mx-auto mb-8 leading-relaxed">
      The requested URL was not found on this server. It may have moved or been consolidated into the new ACM AJCE portal.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-[#B8A7FF] text-[#0A0B14] font-bold text-sm hover:bg-white transition-all shadow-lg"
      >
        Back to Home
      </a>
      <a
        href="/#events"
        class="px-5 py-2.5 rounded-xl bg-white/5 border border-white/15 text-white text-sm hover:bg-white/10 transition-all"
      >
        Upcoming Events
      </a>
      <a
        href="/membership"
        class="px-5 py-2.5 rounded-xl bg-white/5 border border-white/15 text-white text-sm hover:bg-white/10 transition-all"
      >
        Membership
      </a>
      <a
        href="/verify"
        class="px-5 py-2.5 rounded-xl bg-white/5 border border-white/15 text-white text-sm hover:bg-white/10 transition-all"
      >
        Verify Credential
      </a>
    </div>
  </div>
</Layout>
