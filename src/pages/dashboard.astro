---
import Layout from "../layouts/Layout.astro";
import "../styles/globals.css";
---

<Layout title="ACM AJCE - Executive Dashboard">
  <div class="dashboard-shell min-h-screen bg-[#05060B] text-[#FBFAFF] p-4 sm:p-6 lg:p-10 font-sans transition-colors duration-300">
    
    <!-- Top Bar -->
    <header class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-[#2A2455] mb-6">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight">ACM Executive Dashboard</h1>
        </div>
        <p class="text-xs text-gray-400 mt-1">Live management for Contact Form Submissions, Registrations & Incomplete Google Leads</p>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="py-2 px-3 rounded-lg bg-[#131124] hover:bg-[#1A182F] border border-[#2A2455] text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer"
          title="Toggle Light/Dark Theme"
        >
          <span id="theme-toggle-icon">🌙</span>
          <span id="theme-toggle-label" class="hidden sm:inline">Dark</span>
        </button>

        <button id="refresh-data-btn" class="py-2 px-3 sm:px-4 rounded-lg bg-[#2A2455] hover:bg-[#3D3575] border border-[#4D4770] text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer">
          <svg class="w-4 h-4 text-[#B8A7FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Refresh
        </button>

        <a href="/" class="py-2 px-3 sm:px-4 rounded-lg bg-[#131124] hover:bg-[#1A182F] text-xs font-medium text-gray-300 border border-[#2A2455] transition-all whitespace-nowrap">
          Exit
        </a>
      </div>
    </header>

    <div class="max-w-7xl mx-auto space-y-6 sm:space-y-8">

      <!-- Navigation Tabs (3 Tabs for Registrations, Contact Messages, Incomplete Leads) -->
      <div class="grid grid-cols-3 gap-2 bg-[#0D0B18] p-1.5 rounded-xl border border-[#2A2455]">
        <button id="tab-memberships" class="dash-tab active-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate">
          Registrations (<span id="count-memberships">0</span>)
        </button>
        <button id="tab-leads" class="dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate">
          Incomplete Leads (<span id="count-leads">0</span>)
        </button>
        <button id="tab-contacts" class="dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate">
          Messages (<span id="count-contacts">0</span>)
        </button>
      </div>

      <!-- Tab Content 1: ACM Memberships Section -->
      <div id="section-memberships" class="dash-section">
        <div class="bg-[#0D0B18] border border-[#2A2455] rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-4 sm:p-5 border-b border-[#2A2455] flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-[#B8A7FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
              Student Membership Requests
            </h2>
            <button id="clear-memberships-btn" class="text-xs text-rose-400 hover:text-rose-300 font-medium">Clear All</button>
          </div>

          <!-- Mobile Cards Container (Visible on <768px) -->
          <div id="membership-mobile-cards" class="md:hidden p-4 space-y-4">
            <!-- Cards injected dynamically -->
          </div>

          <!-- Desktop Table (Visible on >=768px) -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-300">
              <thead class="bg-[#131124] text-gray-400 uppercase tracking-wider font-mono border-b border-[#2A2455]">
                <tr>
                  <th class="py-3 px-4">Ref ID</th>
                  <th class="py-3 px-4">Student Name</th>
                  <th class="py-3 px-4">College Email</th>
                  <th class="py-3 px-4">Course / Branch</th>
                  <th class="py-3 px-4">WhatsApp No.</th>
                  <th class="py-3 px-4">Txn ID / Ref</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4 text-center">Status</th>
                </tr>
              </thead>
              <tbody id="membership-tbody" class="divide-y divide-[#1A182F]">
                <!-- Rows injected dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab Content 2: Google Sign-in Leads (Incomplete Registrations) -->
      <div id="section-leads" class="dash-section hidden">
        <div class="bg-[#0D0B18] border border-[#2A2455] rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-4 sm:p-5 border-b border-[#2A2455] flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                Google Logged-in Users (Incomplete Signups)
              </h2>
              <p class="text-xs text-gray-400 mt-0.5">Students who signed in with Google but haven't completed the payment & membership form.</p>
            </div>
            <button id="clear-leads-btn" class="text-xs text-rose-400 hover:text-rose-300 font-medium">Clear All Leads</button>
          </div>

          <!-- Mobile Cards Container for Leads (<768px) -->
          <div id="leads-mobile-cards" class="md:hidden p-4 space-y-4">
            <!-- Cards injected dynamically -->
          </div>

          <!-- Desktop Table for Leads (>=768px) -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-300">
              <thead class="bg-[#131124] text-gray-400 uppercase tracking-wider font-mono border-b border-[#2A2455]">
                <tr>
                  <th class="py-3 px-4">User</th>
                  <th class="py-3 px-4">Google Email</th>
                  <th class="py-3 px-4">Sign-in Date</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-center">Action</th>
                </tr>
              </thead>
              <tbody id="leads-tbody" class="divide-y divide-[#1A182F]">
                <!-- Rows injected dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab Content 3: Contact Form Submissions Section -->
      <div id="section-contacts" class="dash-section hidden">
        <div class="bg-[#0D0B18] border border-[#2A2455] rounded-2xl overflow-hidden shadow-2xl">
          <div class="p-4 sm:p-5 border-b border-[#2A2455] flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-[#B8A7FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              Contact Form Messages
            </h2>
            <button id="clear-contacts-btn" class="text-xs text-rose-400 hover:text-rose-300 font-medium">Clear All</button>
          </div>

          <!-- Mobile Cards Container (Visible on <768px) -->
          <div id="contacts-mobile-cards" class="md:hidden p-4 space-y-4">
            <!-- Cards injected dynamically -->
          </div>

          <!-- Desktop Table (Visible on >=768px) -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-300">
              <thead class="bg-[#131124] text-gray-400 uppercase tracking-wider font-mono border-b border-[#2A2455]">
                <tr>
                  <th class="py-3 px-4">Name</th>
                  <th class="py-3 px-4">Email</th>
                  <th class="py-3 px-4">Phone</th>
                  <th class="py-3 px-4">Message</th>
                  <th class="py-3 px-4">Received</th>
                </tr>
              </thead>
              <tbody id="contacts-tbody" class="divide-y divide-[#1A182F]">
                <!-- Rows injected dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- HTML Email Composer Modal -->
  <div id="email-modal" class="fixed inset-0 z-[300] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="relative w-full max-w-xl bg-[#0D0B18] border border-[#2A2455] rounded-3xl p-6 sm:p-8 space-y-5 shadow-2xl">
      <div class="flex items-center justify-between border-b border-[#2A2455] pb-4">
        <div>
          <h3 class="text-lg font-extrabold text-white">Send Premium Invitation Email</h3>
          <p class="text-xs text-[#B8A7FF]">Dispatches branded HTML invitation email with ACM AJCE Logo</p>
        </div>
        <button id="close-email-modal" class="w-8 h-8 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20">✕</button>
      </div>

      <form id="email-send-form" class="space-y-4 text-xs">
        <div>
          <label class="block text-gray-400 uppercase font-mono text-[10px] mb-1">Recipient Email</label>
          <input type="email" id="email-target-address" required readonly class="w-full bg-[#131124] border border-[#2A2455] rounded-xl p-3 text-white font-mono outline-none" />
        </div>

        <div>
          <label class="block text-gray-400 uppercase font-mono text-[10px] mb-1">Email Subject</label>
          <input type="text" id="email-subject" required class="w-full bg-[#131124] border border-[#2A2455] rounded-xl p-3 text-white font-semibold outline-none" value="Exclusive Invitation: Complete Your ACM AJCE Chapter Membership ✨" />
        </div>

        <div>
          <label class="block text-gray-400 uppercase font-mono text-[10px] mb-1">HTML Email Template Preview</label>
          <div class="h-40 bg-[#05060B] border border-[#2A2455] rounded-xl p-3 overflow-y-auto font-sans text-gray-300 space-y-2 text-[11px] leading-relaxed">
            <div class="text-center pb-2 border-b border-white/10">
              <span class="text-xs font-bold text-[#B8A7FF] uppercase tracking-widest">ACM AJCE STUDENT CHAPTER</span>
            </div>
            <p>Dear <span id="email-preview-name" class="font-bold text-white">Student</span>,</p>
            <p>You recently verified your Google account for the ACM AJCE Membership Portal! We noticed you haven't completed your registration yet.</p>
            <p class="text-gray-400">Join 200+ student innovators at Amal Jyothi College of Engineering. Gain priority access to technical workshops, hackathons, and international ACM India perks!</p>
            <div class="pt-2 text-center">
              <span class="inline-block px-4 py-2 bg-[#B8A7FF] text-[#0A0B14] font-bold rounded-lg uppercase tracking-wider text-[10px]">Complete Membership Now →</span>
            </div>
          </div>
        </div>

        <div class="pt-2 flex items-center justify-end gap-3">
          <button type="button" id="cancel-email-btn" class="py-2.5 px-4 rounded-xl bg-transparent border border-white/20 text-white font-semibold hover:bg-white/10">Cancel</button>
          <button type="submit" id="submit-send-email-btn" class="py-2.5 px-6 rounded-xl bg-[#B8A7FF] hover:bg-[#A592FF] text-[#0A0B14] font-extrabold uppercase tracking-wider flex items-center gap-2">
            <span>Send Email Now</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .active-tab {
    background: #2A2455;
    color: #FBFAFF;
    border: 1px solid #4D4770;
  }
  .inactive-tab {
    background: transparent;
    color: #A099C2;
  }
  .inactive-tab:hover {
    color: #FBFAFF;
  }

  /* Light Theme Styles for Dashboard */
  html.light-mode .dashboard-shell {
    background: #F8FAFC !important;
    color: #0F172A !important;
  }
  html.light-mode .bg-\[\#0D0B18\] {
    background: #FFFFFF !important;
    border-color: #E2E8F0 !important;
  }
  html.light-mode .bg-\[\#131124\] {
    background: #F1F5F9 !important;
    color: #0F172A !important;
  }
  html.light-mode .border-\[\#2A2455\] {
    border-color: #CBD5E1 !important;
  }
  html.light-mode .text-white {
    color: #0F172A !important;
  }
  html.light-mode .text-gray-300, html.light-mode .text-gray-400 {
    color: #475569 !important;
  }
  html.light-mode .active-tab {
    background: #6A5ACD !important;
    color: #FFFFFF !important;
  }
</style>

<script is:inline>
  // Theme Toggle Persistence Engine
  (() => {
    const applyTheme = (theme) => {
      if (theme === "light") {
        document.documentElement.classList.add("light-mode");
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.classList.remove("light-mode");
        document.documentElement.setAttribute("data-theme", "dark");
      }
    };

    try {
      const savedTheme = localStorage.getItem("acm_theme") || "dark";
      applyTheme(savedTheme);
    } catch (e) {}
  })();

  document.addEventListener("DOMContentLoaded", () => {
    const themeBtn = document.getElementById("theme-toggle-btn");
    const themeIcon = document.getElementById("theme-toggle-icon");
    const themeLabel = document.getElementById("theme-toggle-label");

    const updateThemeUI = () => {
      const isLight = document.documentElement.classList.contains("light-mode");
      if (themeIcon) themeIcon.textContent = isLight ? "☀️" : "🌙";
      if (themeLabel) themeLabel.textContent = isLight ? "Light" : "Dark";
    };

    updateThemeUI();

    themeBtn?.addEventListener("click", () => {
      const isLight = document.documentElement.classList.contains("light-mode");
      const nextTheme = isLight ? "dark" : "light";
      
      if (nextTheme === "light") {
        document.documentElement.classList.add("light-mode");
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.classList.remove("light-mode");
        document.documentElement.setAttribute("data-theme", "dark");
      }
      
      localStorage.setItem("acm_theme", nextTheme);
      updateThemeUI();
    });

    const tabMemberships = document.getElementById("tab-memberships");
    const tabLeads = document.getElementById("tab-leads");
    const tabContacts = document.getElementById("tab-contacts");
    
    const sectionMemberships = document.getElementById("section-memberships");
    const sectionLeads = document.getElementById("section-leads");
    const sectionContacts = document.getElementById("section-contacts");

    const membershipTbody = document.getElementById("membership-tbody");
    const leadsTbody = document.getElementById("leads-tbody");
    const contactsTbody = document.getElementById("contacts-tbody");

    const membershipMobileCards = document.getElementById("membership-mobile-cards");
    const leadsMobileCards = document.getElementById("leads-mobile-cards");
    const contactsMobileCards = document.getElementById("contacts-mobile-cards");

    const countMemberships = document.getElementById("count-memberships");
    const countLeads = document.getElementById("count-leads");
    const countContacts = document.getElementById("count-contacts");

    // Email Modal Elements
    const emailModal = document.getElementById("email-modal");
    const closeEmailModalBtn = document.getElementById("close-email-modal");
    const cancelEmailBtn = document.getElementById("cancel-email-btn");
    const emailSendForm = document.getElementById("email-send-form");
    const emailTargetAddress = document.getElementById("email-target-address");
    const emailPreviewName = document.getElementById("email-preview-name");
    const emailSubject = document.getElementById("email-subject");
    const submitSendEmailBtn = document.getElementById("submit-send-email-btn");

    let activeEmailLead = null;

    // Tab Navigation Switchers
    tabMemberships?.addEventListener("click", () => {
      tabMemberships.className = "dash-tab active-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      tabLeads.className = "dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      tabContacts.className = "dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      sectionMemberships.classList.remove("hidden");
      sectionLeads.classList.add("hidden");
      sectionContacts.classList.add("hidden");
    });

    tabLeads?.addEventListener("click", () => {
      tabLeads.className = "dash-tab active-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      tabMemberships.className = "dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      tabContacts.className = "dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      sectionLeads.classList.remove("hidden");
      sectionMemberships.classList.add("hidden");
      sectionContacts.classList.add("hidden");
    });

    tabContacts?.addEventListener("click", () => {
      tabContacts.className = "dash-tab active-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      tabMemberships.className = "dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      tabLeads.className = "dash-tab inactive-tab py-2.5 px-2 sm:px-3 rounded-lg font-bold text-xs sm:text-sm text-center transition-all cursor-pointer truncate";
      sectionContacts.classList.remove("hidden");
      sectionMemberships.classList.add("hidden");
      sectionLeads.classList.add("hidden");
    });

    const seedMockData = () => {
      if (!localStorage.getItem("acm_memberships")) {
        const mockMemberships = [
          {
            id: "MEM-948201",
            fullName: "Geo Cherian Mathew",
            course: "B.Tech",
            branch: "CSE (2024-2028)",
            department: "Computer Science",
            phone: "+91 9876543210",
            email: "geo2028@cs.ajce.in",
            txnId: "423589123456",
            submittedAt: "05/08/2026, 01:15 AM",
            status: "Verified"
          }
        ];
        localStorage.setItem("acm_memberships", JSON.stringify(mockMemberships));
      }

      if (!localStorage.getItem("acm_lead_users")) {
        const mockLeads = [
          {
            uid: "LEAD-001",
            name: "Rahul S Nair",
            email: "rahul2027@cs.ajce.in",
            photoURL: "",
            signedInAt: "06/08/2026, 10:45 PM",
            status: "Incomplete (Payment Pending)"
          },
          {
            uid: "LEAD-002",
            name: "Ananya V Varma",
            email: "ananya2026@ce.ajce.in",
            photoURL: "",
            signedInAt: "06/08/2026, 08:20 PM",
            status: "Incomplete (Payment Pending)"
          }
        ];
        localStorage.setItem("acm_lead_users", JSON.stringify(mockLeads));
      }

      if (!localStorage.getItem("acm_contacts")) {
        const mockContacts = [
          {
            name: "Anannya R Nair",
            email: "anannya@ajce.in",
            phone: "+91 9812345678",
            message: "Interested in organizing the upcoming Hackathon event.",
            receivedAt: "04/08/2026, 09:30 PM"
          }
        ];
        localStorage.setItem("acm_contacts", JSON.stringify(mockContacts));
      }
    };

    const renderDashboard = () => {
      seedMockData();

      const memberships = JSON.parse(localStorage.getItem("acm_memberships") || "[]");
      const leads = JSON.parse(localStorage.getItem("acm_lead_users") || "[]");
      const contacts = JSON.parse(localStorage.getItem("acm_contacts") || "[]");

      if (countMemberships) countMemberships.textContent = memberships.length;
      if (countLeads) countLeads.textContent = leads.length;
      if (countContacts) countContacts.textContent = contacts.length;

      // Render Desktop Memberships
      if (membershipTbody) {
        if (memberships.length === 0) {
          membershipTbody.innerHTML = `<tr><td colspan="8" class="text-center py-8 text-gray-500">No membership registrations found.</td></tr>`;
        } else {
          membershipTbody.innerHTML = memberships.map((m) => `
            <tr class="hover:bg-[#131124] transition-colors">
              <td class="py-3 px-4 font-mono text-[#B8A7FF]">${m.id}</td>
              <td class="py-3 px-4 font-semibold text-white">${m.fullName}</td>
              <td class="py-3 px-4 text-gray-300">${m.email}</td>
              <td class="py-3 px-4">${m.course} - ${m.branch}</td>
              <td class="py-3 px-4 font-mono">${m.phone}</td>
              <td class="py-3 px-4 font-mono text-amber-300">${m.txnId}</td>
              <td class="py-3 px-4 text-gray-400">${m.submittedAt}</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${m.status === 'Verified' ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400' : 'bg-amber-500/10 border border-amber-500/30 text-amber-400'}">
                  ${m.status}
                </span>
              </td>
            </tr>
          `).join("");
        }
      }

      // Render Mobile Cards for Memberships
      if (membershipMobileCards) {
        if (memberships.length === 0) {
          membershipMobileCards.innerHTML = `<div class="text-center py-8 text-gray-500 text-xs">No membership registrations found.</div>`;
        } else {
          membershipMobileCards.innerHTML = memberships.map((m) => `
            <div class="rounded-xl bg-[#131124] border border-[#2A2455] p-4 space-y-3 shadow-md">
              <div class="flex items-center justify-between border-b border-[#2A2455] pb-2">
                <span class="font-mono text-xs font-bold text-[#B8A7FF]">${m.id}</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${m.status === 'Verified' ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400' : 'bg-amber-500/10 border border-amber-500/30 text-amber-400'}">
                  ${m.status}
                </span>
              </div>
              <div class="space-y-1">
                <h3 class="text-sm font-bold text-white">${m.fullName}</h3>
                <p class="text-xs text-gray-300 break-all">${m.email}</p>
                <p class="text-xs text-gray-400">${m.course} - ${m.branch}</p>
              </div>
              <div class="pt-2 border-t border-[#2A2455] grid grid-cols-2 gap-2 text-[11px]">
                <div>
                  <span class="text-gray-400 block font-mono text-[9px] uppercase">WhatsApp</span>
                  <span class="font-mono font-medium text-white">${m.phone}</span>
                </div>
                <div>
                  <span class="text-gray-400 block font-mono text-[9px] uppercase">Txn Ref ID</span>
                  <span class="font-mono font-medium text-amber-300 break-all">${m.txnId}</span>
                </div>
              </div>
            </div>
          `).join("");
        }
      }

      // Render Desktop Leads Table
      if (leadsTbody) {
        if (leads.length === 0) {
          leadsTbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-gray-500">No Google sign-in leads found.</td></tr>`;
        } else {
          leadsTbody.innerHTML = leads.map((l, idx) => `
            <tr class="hover:bg-[#131124] transition-colors">
              <td class="py-3 px-4 font-semibold text-white flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-[#2A2455] text-[#B8A7FF] font-bold flex items-center justify-center text-xs">
                  ${l.name.charAt(0)}
                </div>
                <span>${l.name}</span>
              </td>
              <td class="py-3 px-4 text-gray-300 font-mono">${l.email}</td>
              <td class="py-3 px-4 text-gray-400">${l.signedInAt}</td>
              <td class="py-3 px-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 border border-amber-500/30 text-amber-400">
                  ${l.status}
                </span>
              </td>
              <td class="py-3 px-4 text-center">
                <button data-lead-email="${l.email}" data-lead-name="${l.name}" class="send-invite-btn py-1.5 px-3 rounded-lg bg-[#B8A7FF]/20 hover:bg-[#B8A7FF] text-[#B8A7FF] hover:text-[#0A0B14] border border-[#B8A7FF]/40 text-xs font-bold transition-all cursor-pointer">
                  Send Invite 📧
                </button>
              </td>
            </tr>
          `).join("");
        }
      }

      // Render Mobile Leads Cards
      if (leadsMobileCards) {
        if (leads.length === 0) {
          leadsMobileCards.innerHTML = `<div class="text-center py-8 text-gray-500 text-xs">No Google sign-in leads found.</div>`;
        } else {
          leadsMobileCards.innerHTML = leads.map((l) => `
            <div class="rounded-xl bg-[#131124] border border-[#2A2455] p-4 space-y-3 shadow-md">
              <div class="flex items-center justify-between border-b border-[#2A2455] pb-2">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-[#2A2455] text-[#B8A7FF] font-bold flex items-center justify-center text-xs">
                    ${l.name.charAt(0)}
                  </div>
                  <h3 class="text-xs font-bold text-white">${l.name}</h3>
                </div>
                <span class="text-[9px] font-mono text-gray-400">${l.signedInAt}</span>
              </div>
              <p class="text-xs text-gray-300 font-mono break-all">${l.email}</p>
              <div class="flex items-center justify-between pt-2 border-t border-[#2A2455]">
                <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/10 border border-amber-500/30 text-amber-400">
                  ${l.status}
                </span>
                <button data-lead-email="${l.email}" data-lead-name="${l.name}" class="send-invite-btn py-1 px-2.5 rounded-lg bg-[#B8A7FF]/20 hover:bg-[#B8A7FF] text-[#B8A7FF] hover:text-[#0A0B14] border border-[#B8A7FF]/40 text-[10px] font-bold transition-all cursor-pointer">
                  Send Invite 📧
                </button>
              </div>
            </div>
          `).join("");
        }
      }

      // Render Desktop Contacts Table
      if (contactsTbody) {
        if (contacts.length === 0) {
          contactsTbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-gray-500">No contact form messages found.</td></tr>`;
        } else {
          contactsTbody.innerHTML = contacts.map((c) => `
            <tr class="hover:bg-[#131124] transition-colors">
              <td class="py-3 px-4 font-semibold text-white">${c.name}</td>
              <td class="py-3 px-4 text-gray-300">${c.email}</td>
              <td class="py-3 px-4 font-mono">${c.phone || 'N/A'}</td>
              <td class="py-3 px-4 text-gray-200 max-w-xs truncate">${c.message}</td>
              <td class="py-3 px-4 text-gray-400">${c.receivedAt}</td>
            </tr>
          `).join("");
        }
      }

      // Render Mobile Contacts Cards
      if (contactsMobileCards) {
        if (contacts.length === 0) {
          contactsMobileCards.innerHTML = `<div class="text-center py-8 text-gray-500 text-xs">No contact form messages found.</div>`;
        } else {
          contactsMobileCards.innerHTML = contacts.map((c) => `
            <div class="rounded-xl bg-[#131124] border border-[#2A2455] p-4 space-y-2 shadow-md">
              <div class="flex items-center justify-between border-b border-[#2A2455] pb-2">
                <h3 class="text-xs font-bold text-white">${c.name}</h3>
                <span class="text-[10px] font-mono text-gray-400">${c.receivedAt}</span>
              </div>
              <p class="text-xs text-gray-300 break-all">${c.email} • <span class="font-mono text-gray-400">${c.phone || 'N/A'}</span></p>
              <div class="bg-[#0D0B18] p-2.5 rounded-lg border border-[#2A2455] text-xs text-gray-200 leading-relaxed">
                "${c.message}"
              </div>
            </div>
          `).join("");
        }
      }

      // Attach Send Invite button handlers
      document.querySelectorAll(".send-invite-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const email = btn.getAttribute("data-lead-email");
          const name = btn.getAttribute("data-lead-name");
          if (!email) return;

          activeEmailLead = { email, name };
          if (emailTargetAddress) emailTargetAddress.value = email;
          if (emailPreviewName) emailPreviewName.textContent = name || "Student";
          emailModal?.classList.remove("hidden");
          emailModal?.classList.add("flex");
        });
      });
    };

    // Close Email Modal
    const hideEmailModal = () => {
      emailModal?.classList.add("hidden");
      emailModal?.classList.remove("flex");
    };
    closeEmailModalBtn?.addEventListener("click", hideEmailModal);
    cancelEmailBtn?.addEventListener("click", hideEmailModal);

    // Send Email Form Handler
    emailSendForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!activeEmailLead) return;

      const targetEmail = emailTargetAddress?.value;
      const subject = emailSubject?.value;

      if (!targetEmail || !subject) return;

      if (submitSendEmailBtn) {
        submitSendEmailBtn.disabled = true;
        submitSendEmailBtn.textContent = "Dispatching...";
      }

      const bodyHtml = `
        <div style="font-family: Arial, sans-serif; background: #05060B; color: #FBFAFF; padding: 30px; border-radius: 16px;">
          <div style="text-align: center; margin-bottom: 24px;">
            <h2 style="color: #B8A7FF; font-size: 20px; text-transform: uppercase; letter-spacing: 2px;">ACM AJCE STUDENT CHAPTER</h2>
            <p style="color: #A099C2; font-size: 12px; margin-top: 4px;">Amal Jyothi College of Engineering</p>
          </div>
          <p>Dear <strong>${activeEmailLead.name}</strong>,</p>
          <p>You recently verified your Google account on the official ACM AJCE Membership Portal.</p>
          <p style="color: #D4CEF0; line-height: 1.6;">Join our vibrant student computing community! Gain exclusive access to hands-on workshops, hackathons, guest talks, and national ACM India networking opportunities.</p>
          <div style="text-align: center; margin: 30px 0;">
            <a href="https://acm-ajce-website.vercel.app/membership/" style="background: #B8A7FF; color: #0A0B14; padding: 12px 28px; border-radius: 99px; font-weight: bold; text-decoration: none; display: inline-block; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">Complete Membership Now →</a>
          </div>
          <p style="color: #716B94; font-size: 11px; text-align: center; border-top: 1px solid #2A2455; padding-top: 16px;">
            Official Communication from ACM AJCE Executive Committee • Amal Jyothi College of Engineering, Kanjirappally.
          </p>
        </div>
      `;

      try {
        const res = await fetch("/api/admin/send-email", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ to: targetEmail, subject, bodyHtml }),
        });

        if (res.ok) {
          alert(`✓ Premium invitation email dispatched to ${targetEmail}!`);
          hideEmailModal();
        } else {
          alert("⚠️ Failed to dispatch email. Please check server connection.");
        }
      } catch (err) {
        alert("Error sending email: " + err.message);
      } finally {
        if (submitSendEmailBtn) {
          submitSendEmailBtn.disabled = false;
          submitSendEmailBtn.innerHTML = `<span>Send Email Now</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>`;
        }
      }
    });

    document.getElementById("refresh-data-btn")?.addEventListener("click", renderDashboard);
    document.getElementById("clear-memberships-btn")?.addEventListener("click", () => {
      if (confirm("Are you sure you want to clear all membership records?")) {
        localStorage.removeItem("acm_memberships");
        renderDashboard();
      }
    });
    document.getElementById("clear-leads-btn")?.addEventListener("click", () => {
      if (confirm("Are you sure you want to clear all Google sign-in leads?")) {
        localStorage.removeItem("acm_lead_users");
        renderDashboard();
      }
    });
    document.getElementById("clear-contacts-btn")?.addEventListener("click", () => {
      if (confirm("Are you sure you want to clear all contact messages?")) {
        localStorage.removeItem("acm_contacts");
        renderDashboard();
      }
    });

    renderDashboard();
  });
</script>
