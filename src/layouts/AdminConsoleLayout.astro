---
type Props = {
  title?: string;
  viewerName: string;
  viewerEmail: string;
  preview?: boolean;
};

const {
  title = "ACM AJCE Admin Console",
  viewerName,
  viewerEmail,
  preview = false,
} = Astro.props;
const initial = viewerName.trim().charAt(0).toUpperCase() || "A";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090a14" />
    <link rel="icon" type="image/png" href="/brand/acm-ajce-light.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="console-body">
    <div class="console-shell">
      <aside class="console-sidebar" data-console-sidebar>
        <div class="console-sidebar__top">
          <a class="console-brand" href="/" aria-label="Back to ACM AJCE home">
            <img src="/brand/acm-ajce-light.png" alt="ACM AJCE" />
            <span class="console-brand__copy"><strong>ACM AJCE</strong><small>Admin console</small></span>
          </a>
          <button class="console-sidebar-toggle" type="button" data-sidebar-toggle title="Collapse navigation" aria-label="Collapse navigation" aria-expanded="true"><span></span><span></span><span></span></button>
        </div>

        <nav class="console-nav" aria-label="Admin console sections">
          <button class="console-nav__item is-active" type="button" data-console-nav data-view="overview" aria-current="page"><span class="console-nav__mark console-nav__mark--overview"></span><span>Overview</span></button>
          <button class="console-nav__item" type="button" data-console-nav data-view="members"><span class="console-nav__mark console-nav__mark--members"></span><span>Members</span></button>
          <button class="console-nav__item" type="button" data-console-nav data-view="events"><span class="console-nav__mark console-nav__mark--events"></span><span>Events</span></button>
          <button class="console-nav__item" type="button" data-console-nav data-view="certificates"><span class="console-nav__mark console-nav__mark--certificates"></span><span>Certificates</span></button>
          <button class="console-nav__item" type="button" data-console-nav data-view="coupons"><span class="console-nav__mark console-nav__mark--coupons"></span><span>Coupons</span></button>
          <button class="console-nav__item" type="button" data-console-nav data-view="funds"><span class="console-nav__mark console-nav__mark--funds"></span><span>Funds</span></button>
        </nav>

        <div class="console-profile">
          <div class="console-avatar" aria-hidden="true">{initial}</div>
          <div class="console-profile__copy"><strong>{viewerName}</strong><span>{preview ? "Local preview" : viewerEmail}</span></div>
        </div>
        {preview ? (
          <a class="console-signout" href="/membership?preview=member"><span>Exit preview</span></a>
        ) : (
          <form method="post" action="/api/auth/logout"><button class="console-signout" type="submit"><span>Sign out</span></button></form>
        )}
      </aside>

      <div class="console-main">
        <header class="console-topbar">
          <div class="console-topbar__context"><span class="console-status-dot" aria-hidden="true"></span><span>Chapter systems online</span></div>
          <div class="console-topbar__actions"><a href="/" class="console-link">Website</a><a href={preview ? "/membership?preview=member" : "/membership"} class="console-link">Member view</a><button class="console-theme-toggle" type="button" data-console-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme"><span></span></button></div>
        </header>
        <main class="console-content"><slot /></main>
      </div>
    </div>
  </body>
</html>

<style>
  :root { color-scheme: dark; font-family: Inter, Arial, sans-serif; background: #090a14; color: #f8f7ff; }
  * { box-sizing: border-box; }
  html, .console-body { min-height: 100%; margin: 0; background: #090a14; }
  .console-body { overflow-x: hidden; }
  .console-body::before { position: fixed; inset: 0; z-index: -1; background-image: linear-gradient(rgba(184, 167, 255, 0.042) 1px, transparent 1px), linear-gradient(90deg, rgba(184, 167, 255, 0.042) 1px, transparent 1px); background-size: 34px 34px; content: ""; pointer-events: none; }
  button, input, textarea, select { font: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  .console-shell { min-height: 100vh; display: grid; grid-template-columns: 246px minmax(0, 1fr); background: rgba(9, 10, 20, 0.88); transition: grid-template-columns 220ms ease; }
  .console-sidebar { position: sticky; top: 0; align-self: start; height: 100vh; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; padding: 21px 15px 16px; border-right: 1px solid rgba(220, 216, 255, 0.12); background: rgba(12, 13, 28, 0.96); transition: padding 220ms ease; }
  .console-sidebar__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; padding: 0 4px 23px; border-bottom: 1px solid rgba(230, 225, 255, 0.09); }
  .console-brand { min-width: 0; display: flex; align-items: center; gap: 9px; color: #f8f7ff; text-decoration: none; }
  .console-brand img { width: 74px; height: 38px; object-fit: contain; object-position: left center; }
  .console-brand__copy { display: grid; gap: 3px; white-space: nowrap; }
  .console-brand__copy strong { font-size: 0.76rem; letter-spacing: 0.035em; }
  .console-brand__copy small { color: #8e8a9c; font: 700 0.56rem/1 "Space Mono", monospace; letter-spacing: 0.08em; text-transform: uppercase; }
  .console-sidebar-toggle { width: 33px; height: 33px; display: grid; align-content: center; gap: 4px; flex: 0 0 auto; padding: 0 8px; border: 1px solid rgba(230, 225, 255, 0.14); border-radius: 6px; background: #141526; cursor: pointer; }
  .console-sidebar-toggle span { height: 1px; width: 100%; display: block; background: #dedaff; transition: transform 180ms ease, opacity 180ms ease; }
  .console-sidebar-toggle:hover, .console-sidebar-toggle:focus-visible { border-color: #a99aff; outline: none; }
  .console-nav { display: grid; gap: 6px; padding-top: 20px; }
  .console-nav__item { width: 100%; min-height: 44px; display: flex; align-items: center; gap: 12px; overflow: hidden; padding: 0 10px; border: 1px solid transparent; border-radius: 7px; background: transparent; color: #a9a6ba; text-align: left; font-size: 0.8rem; font-weight: 700; white-space: nowrap; cursor: pointer; transition: background 170ms ease, border-color 170ms ease, color 170ms ease, transform 170ms ease; }
  .console-nav__item:hover, .console-nav__item:focus-visible { color: #fbfaff; background: rgba(184, 167, 255, 0.09); outline: none; }
  .console-nav__item.is-active { border-color: rgba(150, 129, 255, 0.62); background: linear-gradient(90deg, rgba(111, 92, 236, 0.94), rgba(128, 104, 235, 0.78)); color: #fff; box-shadow: 0 9px 23px rgba(78, 61, 193, 0.22); }
  .console-nav__mark { width: 14px; height: 14px; position: relative; flex: 0 0 auto; border: 1.5px solid currentColor; border-radius: 3px; }
  .console-nav__mark::before, .console-nav__mark::after { position: absolute; content: ""; background: currentColor; }
  .console-nav__mark--overview::before { inset: 3px; border: 1px solid currentColor; background: transparent; }
  .console-nav__mark--members::before { top: 2px; left: 4px; width: 4px; height: 4px; border-radius: 50%; }
  .console-nav__mark--members::after { right: 2px; bottom: 2px; left: 2px; height: 4px; border-radius: 5px 5px 2px 2px; }
  .console-nav__mark--events::before { top: 3px; right: 2px; left: 2px; height: 1.5px; }
  .console-nav__mark--events::after { bottom: 2px; left: 3px; width: 2px; height: 2px; box-shadow: 4px 0 0 currentColor; }
  .console-nav__mark--coupons::before { width: 5px; height: 5px; inset: 3px; transform: rotate(45deg); }
  .console-nav__mark--funds::before { top: 2px; right: 2px; left: 2px; height: 3px; border: 1px solid currentColor; background: transparent; }
  .console-nav__mark--funds::after { bottom: 2px; left: 3px; width: 6px; height: 1.5px; }
  .console-nav__mark--certificates::before { top: 2px; right: 3px; left: 3px; height: 5px; border-bottom: 1px solid currentColor; background: transparent; }
  .console-nav__mark--certificates::after { bottom: 2px; left: 4px; width: 4px; height: 4px; border: 1px solid currentColor; background: transparent; transform: rotate(45deg); }
  .console-profile { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 9px; margin-top: auto; padding: 19px 4px 12px; border-top: 1px solid rgba(230, 225, 255, 0.1); }
  .console-avatar { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; background: #2a2759; color: #c2b6ff; font: 700 0.78rem/1 "Space Mono", monospace; }
  .console-profile__copy { min-width: 0; }
  .console-profile strong, .console-profile span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .console-profile strong { font-size: 0.72rem; }
  .console-profile span { margin-top: 3px; color: #858194; font-size: 0.62rem; }
  .console-signout { width: 100%; display: inline-flex; padding: 8px 4px 0; border: 0; background: transparent; color: #d5a2ff; font-size: 0.71rem; font-weight: 700; text-align: left; text-decoration: none; cursor: pointer; }
  .console-signout:hover, .console-signout:focus-visible { color: #f1dcff; outline: none; }
  .console-main { min-width: 0; }
  .console-topbar { min-height: 67px; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 0 clamp(22px, 4vw, 52px); border-bottom: 1px solid rgba(230, 225, 255, 0.1); background: rgba(9, 10, 20, 0.79); backdrop-filter: blur(14px); }
  .console-topbar__context { display: inline-flex; align-items: center; gap: 8px; color: #a7a3b5; font: 700 0.63rem/1 "Space Mono", monospace; letter-spacing: 0.035em; }
  .console-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #46dea2; box-shadow: 0 0 12px rgba(70, 222, 162, 0.68); }
  .console-topbar__actions { display: flex; gap: 8px; }
  .console-link { min-height: 33px; display: inline-flex; align-items: center; padding: 0 10px; border: 1px solid rgba(230, 225, 255, 0.16); border-radius: 6px; background: rgba(19, 20, 37, 0.82); color: #d8d5e4; font-size: 0.68rem; font-weight: 700; text-decoration: none; transition: border-color 160ms ease, color 160ms ease, background 160ms ease; }
  .console-link:hover, .console-link:focus-visible { border-color: #b8a7ff; background: rgba(72, 62, 142, 0.42); color: #fff; outline: none; }
  .console-content { width: min(1480px, 100%); padding: clamp(24px, 3.8vw, 46px); }
  .console-shell.is-collapsed { grid-template-columns: 78px minmax(0, 1fr); }
  .console-shell.is-collapsed .console-sidebar { padding-right: 13px; padding-left: 13px; }
  .console-shell.is-collapsed .console-sidebar__top { justify-content: center; padding-right: 0; padding-left: 0; }
  .console-shell.is-collapsed .console-brand { display: none; }
  .console-shell.is-collapsed .console-sidebar-toggle { width: 38px; }
  .console-shell.is-collapsed .console-nav__item { justify-content: center; padding: 0; }
  .console-shell.is-collapsed .console-nav__item > span:last-child, .console-shell.is-collapsed .console-profile__copy, .console-shell.is-collapsed .console-signout span { display: none; }
  .console-shell.is-collapsed .console-profile { grid-template-columns: 1fr; justify-items: center; padding-right: 0; padding-left: 0; }
  .console-shell.is-collapsed .console-signout { justify-content: center; min-height: 28px; padding: 0; }
  .console-shell.is-collapsed .console-signout::before { content: "×"; font-size: 1rem; }
  @media (max-width: 860px) { .console-shell, .console-shell.is-collapsed { grid-template-columns: 1fr; } .console-sidebar { position: relative; height: auto; overflow: visible; padding: 14px 16px 0; border-right: 0; border-bottom: 1px solid rgba(230, 225, 255, 0.1); } .console-sidebar__top { padding-bottom: 13px; } .console-brand img { width: 74px; } .console-sidebar-toggle { display: none; } .console-nav { display: flex; overflow-x: auto; gap: 7px; padding: 11px 0 14px; } .console-nav__item, .console-shell.is-collapsed .console-nav__item { width: auto; min-width: max-content; justify-content: flex-start; min-height: 36px; padding: 0 9px; } .console-profile, .console-sidebar > form, .console-sidebar > .console-signout { display: none; } .console-topbar { min-height: 56px; padding: 0 18px; } .console-content { padding: 26px 18px 46px; } }
  @media (max-width: 510px) { .console-brand__copy { display: none; } .console-topbar__context { font-size: 0.57rem; } .console-topbar__actions .console-link:first-child { display: none; } }
  .console-theme-toggle { width: 42px; height: 28px; position: relative; padding: 0; border: 1px solid rgba(230, 225, 255, 0.16); border-radius: 999px; background: #141526; cursor: pointer; }
  .console-theme-toggle span { width: 20px; height: 20px; position: absolute; top: 3px; right: 3px; border-radius: 50%; background: #b8a7ff; transition: transform 180ms ease, background 180ms ease; }
  :global(html[data-theme="light"]) { color-scheme: light; }
  :global(html[data-theme="light"]) .console-body { background: #f4f6fc; color: #171b2d; }
  :global(html[data-theme="light"]) .console-body::before { background-image: radial-gradient(circle, rgba(90, 72, 232, 0.14) 1px, transparent 1.5px); background-size: 24px 24px; opacity: 0.6; }
  :global(html[data-theme="light"]) .console-shell { background: transparent; }
  :global(html[data-theme="light"]) .console-sidebar { border-color: #e2e6f0; background: rgba(255, 255, 255, 0.9); }
  :global(html[data-theme="light"]) .console-sidebar__top, :global(html[data-theme="light"]) .console-profile { border-color: #e2e6f0; }
  :global(html[data-theme="light"]) .console-brand { color: #171b2d; }:global(html[data-theme="light"]) .console-brand img { filter: invert(1); }:global(html[data-theme="light"]) .console-brand__copy small, :global(html[data-theme="light"]) .console-profile span { color: #76839b; }
  :global(html[data-theme="light"]) .console-sidebar-toggle { border-color: #dfe4ee; background: #f7f8fc; }:global(html[data-theme="light"]) .console-sidebar-toggle span { background: #28314a; }
  :global(html[data-theme="light"]) .console-nav__item { color: #74819a; }:global(html[data-theme="light"]) .console-nav__item:hover, :global(html[data-theme="light"]) .console-nav__item:focus-visible { background: #eeebff; color: #5a48e8; }:global(html[data-theme="light"]) .console-nav__item.is-active { border-color: #5a48e8; background: linear-gradient(135deg, #604df0, #4b39dd); box-shadow: 0 10px 20px rgba(90, 72, 232, 0.22); }
  :global(html[data-theme="light"]) .console-avatar { background: #eeeaff; color: #5a48e8; }:global(html[data-theme="light"]) .console-signout { color: #b23d59; }
  :global(html[data-theme="light"]) .console-topbar { border-color: #e2e6f0; background: rgba(255, 255, 255, 0.7); }:global(html[data-theme="light"]) .console-topbar__context { color: #75819a; }:global(html[data-theme="light"]) .console-link, :global(html[data-theme="light"]) .console-theme-toggle { border-color: #dfe4ee; background: #fff; color: #66748c; }:global(html[data-theme="light"]) .console-link:hover, :global(html[data-theme="light"]) .console-link:focus-visible { border-color: #6a57eb; background: #f1efff; color: #5140d2; }:global(html[data-theme="light"]) .console-theme-toggle span { background: #5a48e8; }
  :global(html[data-theme="dark"]) .console-theme-toggle span { transform: translateX(-14px); background: #f2c45c; }
</style>

<script>
  const sidebarToggle = document.querySelector("[data-sidebar-toggle]");
  const consoleShell = document.querySelector(".console-shell");
  const collapsedKey = "acm-ajce-admin-sidebar-collapsed";
  const applySidebarState = (collapsed) => {
    consoleShell?.classList.toggle("is-collapsed", collapsed);
    sidebarToggle?.setAttribute("aria-expanded", String(!collapsed));
    sidebarToggle?.setAttribute("title", collapsed ? "Expand navigation" : "Collapse navigation");
    sidebarToggle?.setAttribute("aria-label", collapsed ? "Expand navigation" : "Collapse navigation");
  };
  try { applySidebarState(window.localStorage.getItem(collapsedKey) === "true"); } catch { applySidebarState(false); }
  sidebarToggle?.addEventListener("click", () => {
    const collapsed = !consoleShell?.classList.contains("is-collapsed");
    applySidebarState(collapsed);
    try { window.localStorage.setItem(collapsedKey, String(collapsed)); } catch { /* Ignore unavailable storage. */ }
  });
  const consoleThemeToggle = document.querySelector("[data-console-theme-toggle]");
  const consoleThemeKey = "acm-ajce-dashboard-theme";
  const applyConsoleTheme = (theme) => {
    document.documentElement.dataset.theme = theme;
    consoleThemeToggle?.setAttribute("aria-label", theme === "light" ? "Switch to dark theme" : "Switch to light theme");
    consoleThemeToggle?.setAttribute("title", theme === "light" ? "Switch to dark theme" : "Switch to light theme");
  };
  try { applyConsoleTheme(window.localStorage.getItem(consoleThemeKey) || "light"); } catch { applyConsoleTheme("light"); }
  consoleThemeToggle?.addEventListener("click", () => { const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"; applyConsoleTheme(next); try { window.localStorage.setItem(consoleThemeKey, next); } catch { /* Storage is optional. */ } });
</script>
