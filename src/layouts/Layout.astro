---
import Preloader from "../components/Preloader.astro";
import Header from "../components/Header.astro";
import { getAssetUrl } from "../utils/cdn";

const siteUrl = "https://acm-ajce-website.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = `${siteUrl}/og-image.png`;

const title = "ACM AJCE | Premier Student Chapter | Amal Jyothi College of Engineering";
const description = "Official ACM Student Chapter at Amal Jyothi College of Engineering (AJCE). Empowering students in computer science, software engineering, hackathons, and research under ACM India.";
const keywords = "ACM, ACM AJCE, ACM India, AJCE, ACM Membership, ACM Student Chapter, Amal Jyothi College of Engineering, ACM Local Chapter, Computing Community, Tech Events, Software Engineering";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "ACM AJCE Student Chapter",
  "alternateName": ["ACM AJCE", "Association for Computing Machinery AJCE", "ACM India AJCE Chapter"],
  "url": siteUrl,
  "logo": `${siteUrl}/brand/acm-ajce-light.png`,
  "image": ogImageUrl,
  "description": description,
  "parentOrganization": {
    "@type": "Organization",
    "name": "ACM India",
    "url": "https://india.acm.org"
  },
  "subOrganization": {
    "@type": "CollegeOrUniversity",
    "name": "Amal Jyothi College of Engineering",
    "url": "https://www.ajce.in"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kanjirappally",
    "addressRegion": "Kerala",
    "addressCountry": "India"
  },
  "sameAs": [
    "https://www.ajce.in",
    "https://india.acm.org"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={getAssetUrl("/favicon.png")} />

    <!-- Primary Meta Tags -->
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("acm_theme");
          if (storedTheme === "light") {
            document.documentElement.classList.add("light-mode");
            document.documentElement.setAttribute("data-theme", "light");
          } else {
            document.documentElement.classList.remove("light-mode");
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="ACM AJCE Chapter" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / WhatsApp Social Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ACM AJCE Student Chapter" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="ACM AJCE | Premier Computing Community at AJCE" />
    <meta property="og:description" content="Innovate, build, and lead with ACM AJCE. Join the global computing network under ACM India at Amal Jyothi College of Engineering." />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ACM AJCE Banner Logo" />

    <!-- Twitter Social Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content="ACM AJCE | Premier Computing Community at AJCE" />
    <meta name="twitter:description" content="Innovate, build, and lead with ACM AJCE. Join the global computing network under ACM India at Amal Jyothi College of Engineering." />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD Structured Data for Google Indexing -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Preloader />
    <div class="technical-grid acm-grid-surface" aria-hidden="true"></div>
    <div class="brand-logos" aria-label="ACM AJCE at Amal Jyothi College of Engineering">
      <img
        src={getAssetUrl("/brand/acm-ajce-light.png")}
        alt="ACM AJCE Student Chapter"
        class="acm-ajce-logo"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="app-root min-h-screen flex flex-col">
      <Header />
      <main class="content flex-1 relative pt-28">
        <slot />
      </main>
    </div>
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.config({
        limitCallbacks: true,
        ignoreMobileResize: true,
        autoRefreshEvents: "visibilitychange,DOMContentLoaded,load",
      });

      const refreshHard = () => {
        ScrollTrigger.refresh(true);
      };

      const kickRefresh = () => {
        refreshHard();
        setTimeout(refreshHard, 250);
        setTimeout(refreshHard, 900);
      };

      if (document.readyState === "complete") {
        kickRefresh();
      } else {
        window.addEventListener("load", kickRefresh, { once: true });
      }

      if (document.fonts?.ready) {
        document.fonts.ready.then(() => {
          refreshHard();
          setTimeout(refreshHard, 250);
        });
      }

      let refreshTimeout = 0;
      const scheduleRefresh = () => {
        clearTimeout(refreshTimeout);
        refreshTimeout = window.setTimeout(refreshHard, 150);
      };

      window.addEventListener("resize", scheduleRefresh, { passive: true });
      window.addEventListener("orientationchange", scheduleRefresh, {
        passive: true,
      });
      window.addEventListener("app:variants-mounted", () => {
        requestAnimationFrame(() => {
          refreshHard();
          setTimeout(refreshHard, 150);
        });
      });

      const isCoarsePointer = window.matchMedia("(pointer: coarse)").matches;
      if (isCoarsePointer) {
        let scrollRafId = 0;
        let stableScrollFrames = 0;
        let lastScrollSnapshot = "";

        const getScrollSnapshot = () => {
          const viewport = window.visualViewport;
          return [
            window.scrollY || window.pageYOffset || 0,
            document.documentElement.scrollTop || 0,
            document.body.scrollTop || 0,
            viewport?.pageTop || 0,
            viewport?.offsetTop || 0,
          ].join(":");
        };

        const runScrollMonitor = (force = false) => {
          const nextSnapshot = getScrollSnapshot();
          const scrollChanged = nextSnapshot !== lastScrollSnapshot;
          lastScrollSnapshot = nextSnapshot;

          ScrollTrigger.update();

          stableScrollFrames =
            force || scrollChanged ? 0 : stableScrollFrames + 1;

          if (scrollChanged || stableScrollFrames < 12) {
            scrollRafId = requestAnimationFrame(() => runScrollMonitor(false));
            return;
          }

          scrollRafId = 0;
        };

        const queueScrollMonitor = (force = false) => {
          if (force) stableScrollFrames = 0;
          if (scrollRafId) return;
          scrollRafId = requestAnimationFrame(() => runScrollMonitor(force));
        };

        const updateOnTouch = () => {
          queueScrollMonitor(true);
        };

        const updateOnScroll = () => {
          ScrollTrigger.update();
          queueScrollMonitor(true);
        };

        document.addEventListener("touchstart", updateOnTouch, {
          passive: true,
        });
        document.addEventListener("touchmove", updateOnTouch, {
          passive: true,
        });
        document.addEventListener("touchend", updateOnTouch, {
          passive: true,
        });
        window.addEventListener("scroll", updateOnScroll, { passive: true });
        window.visualViewport?.addEventListener("scroll", updateOnScroll, {
          passive: true,
        });
        window.visualViewport?.addEventListener("resize", updateOnScroll, {
          passive: true,
        });
      }
    </script>

    <script>
      (() => {
        let variantRafId = 0;

        const mountVariants = () => {
          const hosts = document.querySelectorAll("[data-variant-host]");
          if (!hosts.length) {
            window.dispatchEvent(
              new CustomEvent("variants-mounted", {
                detail: { mountedAny: false, hostCount: 0 },
              })
            );
            return;
          }

          const defaultQuery = "(max-width: 768px), (pointer: coarse)";

          const restartContactLaptopScript = (host: HTMLElement, variant: string) => {
            if (!host.hasAttribute("data-contact-laptop-host") || variant !== "desktop") {
              return;
            }

            const originalScript = host.querySelector<HTMLScriptElement>(
              ':scope > script[type="module"][src*="ContactUs"]'
            );
            if (!originalScript?.src) return;

            const script = document.createElement("script");
            script.type = "module";
            script.src = `${originalScript.src}${originalScript.src.includes("?") ? "&" : "?"}contact-init=${Date.now()}`;
            originalScript.replaceWith(script);
          };

          let mountedAny = false;
          let mountedVariant = "";

          hosts.forEach((host) => {
            const element = host as HTMLElement;
            const query = element.dataset.variantQuery || defaultQuery;
            const isMobile = window.matchMedia(query).matches;
            const variant = isMobile ? "mobile" : "desktop";
            if (element.dataset.variantReady === variant) return;

            const template = element.querySelector(
              `template[data-variant="${variant}"]`
            ) as HTMLTemplateElement | null;
            if (!template) return;

            Array.from(element.children).forEach((child) => {
              if (child.tagName !== "TEMPLATE") {
                child.remove();
              }
            });

            element.appendChild(template.content.cloneNode(true));
            element.dataset.variantReady = variant;
            restartContactLaptopScript(element, variant);
            mountedAny = true;
            mountedVariant = variant;
          });

          window.dispatchEvent(
            new CustomEvent("variants-mounted", {
              detail: { mountedAny, hostCount: hosts.length },
            })
          );

          if (mountedAny) {
            window.dispatchEvent(
              new CustomEvent("app:variants-mounted", {
                detail: { variant: mountedVariant },
              })
            );
            requestAnimationFrame(() => {
              window.dispatchEvent(new Event("resize"));
            });
          }
        };

        const queueMountVariants = () => {
          if (variantRafId) return;

          variantRafId = requestAnimationFrame(() => {
            variantRafId = 0;
            mountVariants();
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", mountVariants);
        } else {
          mountVariants();
        }

        window.addEventListener("resize", queueMountVariants, {
          passive: true,
        });
        window.addEventListener("orientationchange", queueMountVariants, {
          passive: true,
        });
      })();
    </script>
    <script>
      (() => {
        const root = document.documentElement;

        const scaleFromWidth = (
          width: number,
          maxWidth: number,
          minWidth: number,
          maxScale: number,
          minScale: number
        ) => {
          if (width >= maxWidth) return maxScale;
          if (width <= minWidth) return minScale;

          const progress = (width - minWidth) / (maxWidth - minWidth);
          return minScale + progress * (maxScale - minScale);
        };

        const navScaleFromWidth = (width: number) => {
          if (width > 1363) return 1;
          if (width > 1335) {
            return scaleFromWidth(width, 1363, 1335, 0.9, 0.8);
          }
          return scaleFromWidth(width, 1335, 768, 0.8, 0.75);
        };

        const applyHeaderScales = () => {
          const width = window.innerWidth || document.documentElement.clientWidth;

          root.style.setProperty(
            "--brand-logo-scale",
            scaleFromWidth(width, 1363, 768, 0.8, 0.55).toFixed(4)
          );
          root.style.setProperty(
            "--grep-button-scale",
            scaleFromWidth(width, 1136, 768, 0.8, 0.5).toFixed(4)
          );
          root.style.setProperty(
            "--nav-bar-scale",
            navScaleFromWidth(width).toFixed(4)
          );
        };

        let scaleRafId = 0;
        const queueHeaderScales = () => {
          if (scaleRafId) return;
          scaleRafId = requestAnimationFrame(() => {
            scaleRafId = 0;
            applyHeaderScales();
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", applyHeaderScales, {
            once: true,
          });
        } else {
          applyHeaderScales();
        }

        window.addEventListener("load", applyHeaderScales, { once: true });
        window.addEventListener("resize", queueHeaderScales, { passive: true });
        window.addEventListener("orientationchange", queueHeaderScales, {
          passive: true,
        });
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    overscroll-behavior-y: none;
    position: relative;
    background: #05060B;
    font-family:
      "PolySans Trial", Inter, Roboto, "Helvetica Neue", "Arial Nova",
      "Nimbus Sans", Arial, sans-serif;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  :root {
    --brand-logo-scale: 1;
    --grep-button-scale: 1;
    --nav-bar-scale: 1;
  }

  .technical-grid {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-repeat: repeat;
    opacity: 0.24;
    z-index: 0;
    pointer-events: none;
  }

  .brand-logos {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: clamp(10px, 0.9vw, 16px);
    pointer-events: none;
    transform: scale(var(--brand-logo-scale));
    transform-origin: top left;
    transition:
      opacity 180ms ease,
      transform 160ms ease;
  }

  .acm-ajce-logo {
    width: 138px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.36));
  }

  @media screen and (max-width: 952px) {
    .brand-logos {
      transform: scale(0.7);
    }
  }

  @media screen and (min-width: 769px) and (max-width: 952px) {
    .brand-logos {
      transform: scale(0.72);
    }
  }

  .app-root {
    position: relative;
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 768px) {
    .brand-logos {
      top: 15px;
      left: 15px;
      right: auto;
      width: max-content;
      justify-content: flex-start;
      gap: 8px;
      transform: none;
    }

    .technical-grid {
      opacity: 0.18;
    }
  }

  @media screen and (max-width: 480px) {
    .brand-logos {
      top: 10px;
      left: 10px;
      transform: scale(0.62);
      transform-origin: top left;
    }

    .technical-grid {
      opacity: 0.15;
    }
  }

  @media screen and (max-width: 427px) {
    .brand-logos {
      transform: scale(0.52);
      transform-origin: top left;
    }
  }

  body.mobile-menu-open .brand-logos {
    opacity: 0;
    pointer-events: none;
  }
</style>
