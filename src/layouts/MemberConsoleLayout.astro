---
type Props = {
  viewerName: string;
  viewerEmail: string;
  preview?: boolean;
  admin?: boolean;
};

const { viewerName, viewerEmail, preview = false, admin = false } = Astro.props;
const initial = viewerName.trim().charAt(0).toUpperCase() || "M";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f6fc" />
    <link rel="icon" type="image/png" href="/brand/acm-ajce-light.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <title>ACM AJCE Member Dashboard</title>
  </head>
  <body class="member-console-body">
    <div class="member-console-shell">
      <aside class="member-console-sidebar" data-member-sidebar>
        <div class="member-console-sidebar__top">
          <a class="member-console-brand" href="/" aria-label="Back to ACM AJCE home">
            <img src="/brand/acm-ajce-light.png" alt="ACM AJCE" />
            <span><strong>ACM AJCE</strong><small>Member dashboard</small></span>
          </a>
          <button class="member-console-menu" type="button" data-member-sidebar-toggle aria-label="Collapse navigation" title="Collapse navigation"><span></span><span></span><span></span></button>
        </div>

        <nav class="member-console-nav" aria-label="Member dashboard sections">
          <button class="is-active" type="button" data-member-layout-tab="overview"><span class="member-console-nav__icon member-console-nav__icon--overview"></span><span>Overview</span></button>
          <button type="button" data-member-layout-tab="events"><span class="member-console-nav__icon member-console-nav__icon--events"></span><span>Events</span></button>
          <button type="button" data-member-layout-tab="certificates"><span class="member-console-nav__icon member-console-nav__icon--certificates"></span><span>Certificates</span></button>
          <button type="button" data-member-layout-tab="payments"><span class="member-console-nav__icon member-console-nav__icon--payments"></span><span>Payments</span></button>
        </nav>

        <div class="member-console-account">
          <span class="member-console-account__avatar" aria-hidden="true">{initial}</span>
          <span><strong>{viewerName}</strong><small>{preview ? "Preview member" : viewerEmail}</small></span>
        </div>
        {preview ? (
          <a class="member-console-exit" href="/membership/admin?preview=admin">Admin preview</a>
        ) : (
          <form method="post" action="/api/auth/logout"><button class="member-console-exit" type="submit">Sign out</button></form>
        )}
      </aside>

      <div class="member-console-main">
        <header class="member-console-topbar">
          <div class="member-console-topbar__status"><i></i><span>Member account active</span></div>
          <div class="member-console-topbar__actions">
            <a href="/">Website</a>
            {admin && <a href={preview ? "/membership/admin?preview=admin" : "/membership/admin"}>Admin</a>}
            <button class="member-console-theme" type="button" data-member-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme"><span></span></button>
          </div>
        </header>
        <main class="member-console-content"><slot /></main>
      </div>
    </div>
  </body>
</html>

<style>
  :root { color-scheme: light; font-family: Inter, Arial, sans-serif; }
  * { box-sizing: border-box; }
  html, .member-console-body { min-height: 100%; margin: 0; }
  .member-console-body { --canvas: #f4f6fc; --surface: #ffffff; --surface-alt: #f8f9fd; --border: #e2e6f0; --text: #171b2d; --muted: #71809a; --accent: #5a48e8; --accent-soft: #edeaff; --shadow: 0 15px 35px rgba(47, 62, 100, 0.08); background: var(--canvas); color: var(--text); overflow-x: hidden; }
  .member-console-body::before { position: fixed; inset: 0; z-index: -1; background-image: radial-gradient(circle, rgba(90, 72, 232, 0.13) 1px, transparent 1.5px); background-size: 24px 24px; content: ""; opacity: 0.58; pointer-events: none; }
  .member-console-shell { min-height: 100vh; display: grid; grid-template-columns: 248px minmax(0, 1fr); transition: grid-template-columns 200ms ease; }
  .member-console-sidebar { position: sticky; top: 0; align-self: start; height: 100vh; min-height: 0; display: flex; flex-direction: column; padding: 20px 14px 17px; overflow-y: auto; border-right: 1px solid var(--border); background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(16px); }
  .member-console-sidebar__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; padding: 2px 4px 20px; border-bottom: 1px solid var(--border); }
  .member-console-brand { min-width: 0; display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; }
  .member-console-brand img { width: 72px; height: 38px; object-fit: contain; object-position: left center; filter: invert(1); }
  .member-console-brand span { display: grid; gap: 4px; white-space: nowrap; }
  .member-console-brand strong { font-size: 0.77rem; letter-spacing: 0.025em; }.member-console-brand small { color: var(--muted); font: 700 0.56rem/1 "Space Mono", monospace; letter-spacing: 0.07em; text-transform: uppercase; }
  .member-console-menu { width: 34px; height: 34px; display: grid; align-content: center; gap: 4px; flex: 0 0 auto; padding: 0 8px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-alt); cursor: pointer; }
  .member-console-menu span { width: 100%; height: 1.5px; background: var(--text); }.member-console-menu:hover, .member-console-menu:focus-visible { border-color: var(--accent); outline: none; }
  .member-console-nav { display: grid; gap: 6px; padding-top: 20px; }
  .member-console-nav button { width: 100%; min-height: 43px; display: flex; align-items: center; gap: 12px; overflow: hidden; padding: 0 11px; border: 1px solid transparent; border-radius: 13px; background: transparent; color: var(--muted); text-align: left; font-size: 0.8rem; font-weight: 700; white-space: nowrap; cursor: pointer; transition: color 160ms ease, background 160ms ease, transform 160ms ease; }
  .member-console-nav button:hover, .member-console-nav button:focus-visible { background: var(--accent-soft); color: var(--accent); outline: none; }.member-console-nav button.is-active { background: linear-gradient(135deg, #604df0, #4b39dd); color: #fff; box-shadow: 0 10px 20px rgba(90, 72, 232, 0.22); }
  .member-console-nav__icon { width: 16px; height: 16px; position: relative; flex: 0 0 auto; border: 1.5px solid currentColor; border-radius: 4px; }.member-console-nav__icon::before, .member-console-nav__icon::after { position: absolute; content: ""; background: currentColor; }.member-console-nav__icon--overview::before { inset: 3px; border: 1px solid currentColor; background: transparent; }.member-console-nav__icon--events::before { top: 3px; right: 2px; left: 2px; height: 1px; }.member-console-nav__icon--events::after { bottom: 3px; left: 3px; width: 3px; height: 3px; box-shadow: 5px 0 0 currentColor; }.member-console-nav__icon--certificates::before { top: 2px; right: 3px; left: 3px; height: 5px; border-bottom: 1px solid currentColor; background: transparent; }.member-console-nav__icon--certificates::after { bottom: 2px; left: 4px; width: 4px; height: 4px; transform: rotate(45deg); }.member-console-nav__icon--payments::before { top: 3px; right: 2px; left: 2px; height: 3px; border: 1px solid currentColor; background: transparent; }.member-console-nav__icon--payments::after { right: 3px; bottom: 3px; left: 3px; height: 1px; }
  .member-console-account { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 9px; margin-top: auto; padding: 18px 4px 12px; border-top: 1px solid var(--border); }.member-console-account__avatar { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 12px; background: var(--accent-soft); color: var(--accent); font: 700 0.76rem/1 "Space Mono", monospace; }.member-console-account strong, .member-console-account small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.member-console-account strong { font-size: 0.72rem; }.member-console-account small { margin-top: 3px; color: var(--muted); font-size: 0.62rem; }.member-console-exit { display: inline-flex; padding: 8px 4px 0; border: 0; background: transparent; color: #b23d59; font-size: 0.7rem; font-weight: 800; text-decoration: none; cursor: pointer; }
  .member-console-topbar { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 clamp(20px, 4vw, 48px); border-bottom: 1px solid var(--border); background: rgba(255, 255, 255, 0.68); backdrop-filter: blur(14px); }.member-console-topbar__status { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font: 700 0.62rem/1 "Space Mono", monospace; letter-spacing: 0.035em; }.member-console-topbar__status i { width: 7px; height: 7px; border-radius: 50%; background: #24bd7a; box-shadow: 0 0 10px rgba(36, 189, 122, 0.52); }.member-console-topbar__actions { display: flex; align-items: center; gap: 8px; }.member-console-topbar__actions a { min-height: 33px; display: inline-flex; align-items: center; padding: 0 11px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--muted); font-size: 0.68rem; font-weight: 800; text-decoration: none; }.member-console-topbar__actions a:hover, .member-console-topbar__actions a:focus-visible { border-color: var(--accent); color: var(--accent); outline: none; }.member-console-theme { width: 42px; height: 28px; position: relative; padding: 0; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); cursor: pointer; }.member-console-theme span { width: 20px; height: 20px; position: absolute; top: 3px; right: 3px; border-radius: 50%; background: var(--accent); box-shadow: 0 3px 8px rgba(90, 72, 232, 0.25); transition: transform 180ms ease, background 180ms ease; }
  .member-console-content { width: min(1450px, 100%); padding: clamp(24px, 3.7vw, 46px); }
  .member-console-shell.is-collapsed { grid-template-columns: 78px minmax(0, 1fr); }.member-console-shell.is-collapsed .member-console-brand { display: none; }.member-console-shell.is-collapsed .member-console-sidebar__top { justify-content: center; }.member-console-shell.is-collapsed .member-console-nav button { justify-content: center; padding: 0; }.member-console-shell.is-collapsed .member-console-nav button > span:last-child, .member-console-shell.is-collapsed .member-console-account > span:last-child, .member-console-shell.is-collapsed .member-console-exit { display: none; }.member-console-shell.is-collapsed .member-console-account { grid-template-columns: 1fr; justify-items: center; }
  html[data-theme="dark"] { color-scheme: dark; }.member-console-body:has(*) { transition: background 160ms ease, color 160ms ease; }html[data-theme="dark"] .member-console-body { --canvas: #0c0e17; --surface: #161827; --surface-alt: #1d2031; --border: #2b2f43; --text: #f7f6fb; --muted: #a4a7b6; --accent: #ab9dff; --accent-soft: #29254a; background: var(--canvas); }html[data-theme="dark"] .member-console-sidebar, html[data-theme="dark"] .member-console-topbar { background: rgba(14, 16, 28, 0.88); }html[data-theme="dark"] .member-console-brand img { filter: none; }html[data-theme="dark"] .member-console-theme span { transform: translateX(-14px); background: #f2c55c; }
  @media (max-width: 860px) { .member-console-shell, .member-console-shell.is-collapsed { grid-template-columns: 1fr; }.member-console-sidebar { position: relative; height: auto; overflow: visible; padding: 14px 16px 0; border-right: 0; border-bottom: 1px solid var(--border); }.member-console-menu { display: none; }.member-console-nav { display: flex; overflow-x: auto; padding: 11px 0 14px; }.member-console-nav button { width: auto; min-width: max-content; min-height: 37px; }.member-console-account, .member-console-exit, .member-console-sidebar form { display: none; }.member-console-topbar { min-height: 56px; padding: 0 18px; }.member-console-content { padding: 25px 18px 42px; } }
  @media (max-width: 500px) { .member-console-brand span, .member-console-topbar__status { display: none; }.member-console-topbar__actions a:first-child { display: none; } }
</style>

<script>
  const memberShell = document.querySelector(".member-console-shell");
  const memberSidebarToggle = document.querySelector("[data-member-sidebar-toggle]");
  const memberThemeToggle = document.querySelector("[data-member-theme-toggle]");
  const memberThemeKey = "acm-ajce-dashboard-theme";
  const applyMemberTheme = (theme) => {
    document.documentElement.dataset.theme = theme;
    memberThemeToggle?.setAttribute("aria-label", theme === "light" ? "Switch to dark theme" : "Switch to light theme");
    memberThemeToggle?.setAttribute("title", theme === "light" ? "Switch to dark theme" : "Switch to light theme");
  };
  try { applyMemberTheme(window.localStorage.getItem(memberThemeKey) || "light"); } catch { applyMemberTheme("light"); }
  memberThemeToggle?.addEventListener("click", () => { const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"; applyMemberTheme(next); try { window.localStorage.setItem(memberThemeKey, next); } catch { /* Storage is optional. */ } });
  memberSidebarToggle?.addEventListener("click", () => memberShell?.classList.toggle("is-collapsed"));
  document.querySelectorAll("[data-member-layout-tab]").forEach((button) => button.addEventListener("click", () => {
    const tab = button.dataset.memberLayoutTab;
    document.querySelector(`[data-member-tab="${tab}"]`)?.click();
    document.querySelectorAll("[data-member-layout-tab]").forEach((item) => item.classList.toggle("is-active", item === button));
  }));
</script>
