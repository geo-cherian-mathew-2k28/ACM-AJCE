---
import { getAssetUrl } from "../utils/cdn";
const fallbackEmail = "info@ajce.in";
const rawEndpoint = (import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "").trim();
const formAction = rawEndpoint ? undefined : `mailto:${fallbackEmail}`;
---

<section class="w-full px-4 py-12">
  <div
    class="mx-auto max-w-xl rounded-[32px] border border-white/15 bg-white/[0.04] p-6 text-white shadow-[0_15px_45px_rgba(0,0,0,0.45)]"
  >
    <div class="mb-5 text-center">
      <h3 class="text-3xl font-semibold uppercase">Contact us!</h3>
      <p class="mt-2 text-xs uppercase tracking-[0.45em] text-white/60">
        Say Hello!
      </p>
    </div>

    <form
      class="flex flex-col gap-4 text-sm"
      method="POST"
      id="contact-form-mobile"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:gap-3">
        <label
          class="flex flex-col gap-2 text-xs font-semibold uppercase tracking-[0.35em] text-white/60"
        >
          First Name
          <input
            type="text"
            name="firstName"
            required
            class="rounded-2xl border-2 border-dashed border-white/35 bg-transparent px-4 py-3 text-base text-white outline-none transition focus:border-[#B8A7FF]"
          />
        </label>
        <label
          class="flex flex-col gap-2 text-xs font-semibold uppercase tracking-[0.35em] text-white/60"
        >
          Last Name
          <input
            type="text"
            name="lastName"
            class="rounded-2xl border-2 border-dashed border-white/35 bg-transparent px-4 py-3 text-base text-white outline-none transition focus:border-[#B8A7FF]"
          />
        </label>
      </div>

      <label
        class="flex flex-col gap-2 text-xs font-semibold uppercase tracking-[0.35em] text-white/60"
      >
        Email
        <input
          type="email"
          name="email"
          required
          class="rounded-2xl border-2 border-dashed border-white/35 bg-transparent px-4 py-3 text-base text-white outline-none transition focus:border-[#B8A7FF]"
        />
      </label>

      <label
        class="flex flex-col gap-2 text-xs font-semibold uppercase tracking-[0.35em] text-white/60"
      >
        Phone
        <input
          type="tel"
          name="phone"
          inputmode="tel"
          pattern="[0-9]{7,15}"
          class="rounded-2xl border-2 border-dashed border-white/35 bg-transparent px-4 py-3 text-base text-white outline-none transition focus:border-[#B8A7FF]"
        />
      </label>

      <label
        class="flex flex-col gap-2 text-xs font-semibold uppercase tracking-[0.35em] text-white/60"
      >
        Message
        <textarea
          name="message"
          rows="4"
          required
          class="rounded-2xl border-2 border-dashed border-white/35 bg-transparent px-4 py-3 text-base text-white outline-none transition focus:border-[#B8A7FF]"
        ></textarea>
      </label>

      <button
        type="submit"
        class="mt-2 inline-flex items-center justify-center rounded-full border border-white/60 px-8 py-3 text-lg font-semibold uppercase tracking-[0.35em] text-white transition hover:bg-white/10"
      >
        Submit
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form-mobile");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn ? submitBtn.innerHTML : "Submit";
      const setSubmitting = (submitting: boolean) => {
        if (!submitBtn) return;
        submitBtn.innerHTML = submitting ? "Sending..." : originalBtnText;
        if (submitBtn) submitBtn.disabled = submitting;
      };

      setSubmitting(true);
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      let isDelivered = false;

      // Post to real-time SSE server on port 5050
      try {
        const res = await fetch("http://localhost:5050/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (res.ok) isDelivered = true;
      } catch (err) {}

      // Fallback post to Astro endpoint
      if (!isDelivered) {
        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          if (res.ok) isDelivered = true;
        } catch (err) {}
      }

      setSubmitting(false);

      if (isDelivered) {
        try {
          const existingContacts = JSON.parse(localStorage.getItem("acm_contacts") || "[]");
          existingContacts.unshift({
            name: `${data.firstName || ''} ${data.lastName || ''}`.trim(),
            email: data.email,
            phone: data.phone || 'N/A',
            message: data.message,
            receivedAt: new Date().toLocaleString()
          });
          localStorage.setItem("acm_contacts", JSON.stringify(existingContacts));
          window.dispatchEvent(new Event("storage"));
        } catch (err) {}
        form.reset();
        alert("✓ Message sent successfully!");
      } else {
        alert("⚠️ Failed to deliver message. Please check backend connections.");
      }
    });
  }
</script>
