---
// Gallery_Phone.astro — redesigned with marquee strip + scroll-reveal cards
import ProofGallery from "../components/ProofGallery.astro";
import { getAssetUrl } from "../utils/cdn";
---

<section class="gallery-phone-section relative w-full overflow-hidden pb-0">

  <!-- Section label -->
  <div class="relative z-10 px-5 pt-10 pb-2 flex items-center gap-3">
    <span class="label-chip">Gallery</span>
    <div class="flex-1 h-px bg-white/10"></div>
    <span class="text-[10px] tracking-[0.2em] text-white/30 uppercase font-mono">ACM AJCE</span>
  </div>

  <!-- Headline -->
  <div class="relative z-10 px-5 pb-6">
    <h2 class="gallery-headline">
      Moments<br/><em>captured.</em>
    </h2>
    <p class="gallery-subline">A look into the events, people and energy that make our chapter.</p>
  </div>

  <!-- Marquee strip 1 (left → right) -->
  <div class="marquee-track mb-1.5" aria-hidden="true">
    <div class="marquee-inner marquee-ltr">
      {["UXPLORE","ASTERISK","PIXIEART","SHE CODES","DATA ALCHEMY","UXPLORE","ASTERISK","PIXIEART","SHE CODES","DATA ALCHEMY"].map(w => (
        <span class="marquee-chip">{w}</span>
      ))}
    </div>
  </div>

  <!-- Marquee strip 2 (right → left, offset) -->
  <div class="marquee-track mb-6" aria-hidden="true">
    <div class="marquee-inner marquee-rtl">
      {["DATA ALCHEMY","SHE CODES","PIXIEART","ASTERISK","UXPLORE","DATA ALCHEMY","SHE CODES","PIXIEART","ASTERISK","UXPLORE"].map(w => (
        <span class="marquee-chip marquee-chip--outline">{w}</span>
      ))}
    </div>
  </div>

  <!-- Photo Grid (4 cards visible directly on mobile) -->
  <div class="px-5 mb-6 grid grid-cols-2 gap-3">
    {
      [
        { src: "/gallery/acm-ajce/workshop-lab.png", title: "Workshop Lab", cat: "Hands-on" },
        { src: "/gallery/acm-ajce/session-facilitator.jpg", title: "Learning Session", cat: "Talks" },
        { src: "/gallery/acm-ajce/blender-session.jpg", title: "Blender Session", cat: "3D Forge" },
        { src: "/gallery/acm-ajce/collaborative-learning.jpg", title: "Collab Space", cat: "Community" }
      ].map((item, idx) => (
        <div 
          class="gallery-mini-card relative aspect-[4/3] rounded-xl overflow-hidden bg-white/5 border border-white/10 cursor-pointer active:scale-95 transition-transform"
          onclick={`window.openProofGallery ? window.openProofGallery(${idx}) : null`}
          role="button"
          tabindex="0"
        >
          <img 
            src={getAssetUrl(item.src)} 
            alt={item.title} 
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-2.5">
            <span class="text-[9px] uppercase font-mono tracking-widest text-[#B8A7FF]">{item.cat}</span>
            <span class="text-xs font-semibold text-[#FBFAFF] truncate">{item.title}</span>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Featured banner CTA -->
  <div class="px-5 mb-8">
    <button
      type="button"
      onclick="window.openProofGallery ? window.openProofGallery() : null"
      class="w-full py-3 px-4 rounded-xl bg-[#B8A7FF]/15 border border-[#B8A7FF]/30 text-[#FBFAFF] flex items-center justify-between text-xs font-semibold uppercase tracking-wider active:bg-[#B8A7FF]/30 transition-colors"
    >
      <span class="flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B8A7FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        Explore 10+ Event Shots
      </span>
      <span class="text-[#B8A7FF] flex items-center gap-1">
        View All
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
        </svg>
      </span>
    </button>
  </div>

  <!-- Stat bar -->
  <div class="stats-bar mx-5 mb-8 grid grid-cols-3 divide-x divide-white/10 rounded-2xl bg-white/5 border border-white/10">
    <div class="stat-cell">
      <span class="stat-num">50+</span>
      <span class="stat-label">Events</span>
    </div>
    <div class="stat-cell">
      <span class="stat-num">200+</span>
      <span class="stat-label">Members</span>
    </div>
    <div class="stat-cell">
      <span class="stat-num">5+</span>
      <span class="stat-label">Years</span>
    </div>
  </div>

  <!-- ProofGallery lightbox (shared) -->
  <ProofGallery />
</section>

<style>
  .gallery-phone-section {
    background: #05060B;
    font-family: "Inter", system-ui, sans-serif;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Label chip */
  .label-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #B8A7FF;
    background: rgba(184,167,255,0.1);
    border: 1px solid rgba(184,167,255,0.25);
    border-radius: 99px;
    padding: 3px 10px;
    white-space: nowrap;
  }

  /* Headline */
  .gallery-headline {
    font-size: clamp(2.4rem, 9vw, 3.5rem);
    font-weight: 800;
    line-height: 1.08;
    color: #FBFAFF;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .gallery-headline em {
    font-style: italic;
    color: #B8A7FF;
  }
  .gallery-subline {
    font-size: 0.8rem;
    color: rgba(251,250,255,0.45);
    line-height: 1.5;
    margin: 0;
    max-width: 36ch;
  }

  /* Marquee */
  .marquee-track {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-inner {
    display: flex;
    gap: 0.6rem;
    width: max-content;
  }
  .marquee-ltr {
    animation: marquee-ltr 28s linear infinite;
  }
  .marquee-rtl {
    animation: marquee-rtl 32s linear infinite;
  }
  @keyframes marquee-ltr {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes marquee-rtl {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }
  .marquee-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 14px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #B8A7FF;
    background: rgba(184,167,255,0.08);
    border: 1px solid rgba(184,167,255,0.18);
    white-space: nowrap;
  }
  .marquee-chip--outline {
    color: rgba(251,250,255,0.4);
    background: transparent;
    border-color: rgba(251,250,255,0.12);
  }

  /* Featured frame */
  .gallery-phone-frame {
    width: calc(100% - 2.5rem);
    margin-left: auto;
    margin-right: auto;
    min-height: 220px;
    aspect-ratio: 4/3;
    border-radius: 1rem;
    overflow: hidden;
    position: relative;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .gallery-phone-frame.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  .gallery-phone-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.3) brightness(0.85);
    transition: filter 0.4s ease;
  }
  .gallery-phone-frame:active .gallery-phone-img {
    filter: grayscale(0) brightness(1);
  }
  .gallery-phone-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(5,6,11,0) 40%,
      rgba(5,6,11,0.75) 100%
    );
    pointer-events: none;
  }
  .gallery-phone-cta {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 99px;
    background: rgba(184,167,255,0.9);
    color: #0a0b14;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .gallery-phone-cta:active {
    transform: scale(0.96);
    background: #ffffff;
  }

  /* Stats bar */
  .stats-bar {
    padding: 0;
  }
  .stat-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 0.5rem;
    gap: 0.2rem;
  }
  .stat-num {
    font-size: 1.3rem;
    font-weight: 800;
    color: #B8A7FF;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stat-label {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(251,250,255,0.4);
  }
</style>

<script>
  // Scroll-reveal for the featured frame
  const revealEls = document.querySelectorAll("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -80px 0px", threshold: 0.1 }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("revealed"));
  }
</script>
