---
// Gallery_Phone.astro
import ProofGallery from "../components/ProofGallery.astro";
import { getAssetUrl } from "../utils/cdn";
---

<section class="gallery-section relative w-full pt-12 pb-0 overflow-hidden">
  <!-- Floating Words Background -->
  <div class="floating-words-container" aria-hidden="true">
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 45s; --x: 5%; --y: 5%;"
      >UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 55s; --x: 80%; --y: 8%;"
      >ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 50s; --x: 10%; --y: 25%;"
      >PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 60s; --x: 70%; --y: 30%;">SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 48s; --x: 25%; --y: 15%;">DATA ALCHEMY</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 52s; --x: 85%; --y: 20%;"
      >UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 58s; --x: 2%; --y: 35%;"
      >ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 47s; --x: 60%; --y: 5%;">PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 54s; --x: 40%; --y: 2%;"
      >SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 51s; --x: 90%; --y: 15%;">DATA ALCHEMY</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 56s; --x: 15%; --y: 18%;">UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 49s; --x: 75%; --y: 2%;">ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 53s; --x: 35%; --y: 30%;"
      >PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 57s; --x: 50%; --y: 22%;"
      >SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 46s; --x: 65%; --y: 12%;">DATA ALCHEMY</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 59s; --x: 8%; --y: 10%;">UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 50s; --x: 82%; --y: 35%;">ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 55s; --x: 45%; --y: 10%;">PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 48s; --x: 20%; --y: 30%;">SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 52s; --x: 55%; --y: 35%;">DATA ALCHEMY</span
    >
  </div>

  <div class="flex w-full flex-col items-center gap-4 relative z-10">
    <div class="relative flex w-full max-w-4xl flex-col items-center px-4">
      <img
        src={getAssetUrl("/gallery.webp")}
        alt="Gallery Title"
        class="gallery-title relative z-10 w-[95vw] max-w-md mb-4"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="gallery-frame relative w-full overflow-hidden mt-2">
      <img
        src={getAssetUrl("/full-core.webp")}
        alt="ACM AJCE gallery preview"
        class="gallery-image w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <button type="button" onclick="window.openProofGallery()" class="gallery-open-button">
        <span>View gallery</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
  <ProofGallery />
</section>

<style>
  .gallery-section {
    font-family: "PolySans Trial", "PolySans", system-ui, sans-serif;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .gallery-section * {
    -webkit-user-select: none;
    user-select: none;
  }

  .gallery-section img {
    -webkit-user-drag: none;
  }

  .gallery-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(3, 3, 3, 0) 40%,
      rgba(3, 3, 3, 0.55) 100%
    );
    pointer-events: none;
  }

  .gallery-image {
    filter: grayscale(1);
    transition: filter 0.3s ease;
  }

  .gallery-frame:hover .gallery-image {
    filter: grayscale(0.2);
  }

  .gallery-open-button {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 38px;
    padding: 0 0.8rem;
    border: 1px solid rgba(251, 250, 255, 0.76);
    border-radius: 6px;
    background: rgba(42, 36, 85, 0.92);
    color: #FBFAFF;
    font-family: "PolySans Trial", monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gallery-open-button svg {
    width: 14px;
    height: 14px;
  }

  /* Floating Words Background */
  .floating-words-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .floating-word {
    position: absolute;
    font-family: "Inter", sans-serif;
    font-size: clamp(1rem, 4vw, 1.5rem);
    font-weight: 900;
    font-style: normal;
    line-height: normal;
    text-transform: uppercase;
    opacity: 0.08;
    white-space: nowrap;
    letter-spacing: 0.1em;
    color: #FBFAFF;
    will-change: transform;
    animation: float var(--duration, 50s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    left: clamp(20%, var(--x, 50%), 80%);
    top: var(--y, 50%);
    transform: translate(-50%, 0);
  }

  .floating-word:nth-child(even) {
    -webkit-text-stroke-width: 1.5px;
    -webkit-text-stroke-color: #FBFAFF;
    color: transparent;
    opacity: 0.055;
  }

  .floating-word:nth-child(n + 9) {
    display: none;
  }

  .floating-word:nth-child(1) { --x: 24% !important; --y: 12% !important; }
  .floating-word:nth-child(2) { --x: 74% !important; --y: 18% !important; }
  .floating-word:nth-child(3) { --x: 22% !important; --y: 44% !important; }
  .floating-word:nth-child(4) { --x: 72% !important; --y: 42% !important; }
  .floating-word:nth-child(5) { --x: 48% !important; --y: 28% !important; }
  .floating-word:nth-child(6) { --x: 74% !important; --y: 66% !important; }
  .floating-word:nth-child(7) { --x: 24% !important; --y: 68% !important; }
  .floating-word:nth-child(8) { --x: 54% !important; --y: 76% !important; }


  @keyframes float {
    0%,
    100% {
      transform: translate(-50%, 0) rotate(0deg);
    }
    25% {
      transform: translate(-48%, -0.4rem) rotate(0.5deg);
    }
    50% {
      transform: translate(-52%, 0.55rem) rotate(-0.45deg);
    }
    75% {
      transform: translate(-49%, 0.25rem) rotate(0.35deg);
    }
  }
</style>
