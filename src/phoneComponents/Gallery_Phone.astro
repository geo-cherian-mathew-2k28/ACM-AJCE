---
// Gallery_Phone.astro — Mobile-first Gallery with Working Touch Lightbox
import { getAssetUrl } from "../utils/cdn";

const galleryItems = [
  { src: "/gallery/acm-ajce/workshop-lab.png", title: "Workshop Lab", category: "Workshops", tag: "Hands-on" },
  { src: "/gallery/acm-ajce/session-facilitator.jpg", title: "Learning Session", category: "Talks", tag: "Expert Talks" },
  { src: "/gallery/acm-ajce/workshop-audience.jpg", title: "Workshop Audience", category: "Workshops", tag: "Community" },
  { src: "/gallery/acm-ajce/learning-circle.jpg", title: "Learning Circle", category: "Community", tag: "Peer Learning" },
  { src: "/gallery/acm-ajce/creative-tools-demo.jpg", title: "Creative Tools Demo", category: "Workshops", tag: "Design" },
  { src: "/gallery/acm-ajce/collaborative-learning.jpg", title: "Collab Space", category: "Community", tag: "Teamwork" },
  { src: "/gallery/acm-ajce/hands-on-guidance.jpg", title: "Hands-On Guidance", category: "Workshops", tag: "Mentorship" },
  { src: "/gallery/acm-ajce/interactive-session.jpg", title: "Interactive Session", category: "Talks", tag: "Q&A" },
  { src: "/gallery/acm-ajce/blender-session.jpg", title: "Blender Session", category: "3D Forge", tag: "3D Graphics" },
  { src: "/gallery/acm-ajce/blender-forge.jpg", title: "Blender Forge", category: "3D Forge", tag: "Render" },
];

const categories = ["ALL", "WORKSHOPS", "TALKS", "3D FORGE", "COMMUNITY"];
---

<section class="gallery-phone-section relative w-full overflow-hidden py-8 px-4 bg-[#05060B]">
  <!-- Header & Title -->
  <div class="relative z-10 mb-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="px-3 py-1 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/20 text-[10px] uppercase font-mono tracking-widest text-[#B8A7FF]">
        GALLERY & HIGHLIGHTS
      </span>
      <div class="flex-1 h-px bg-white/10"></div>
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-[#FBFAFF] uppercase tracking-tight font-['PolySans_Trial']">
      Moments <em class="not-italic text-[#B8A7FF]">Captured.</em>
    </h2>
    <p class="text-xs text-white/60 mt-1 max-w-sm">
      Explore the workshops, sessions, and collaborative energy of ACM AJCE.
    </p>
  </div>

  <!-- Filter Pills (Touch scrollable) -->
  <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 no-scrollbar" id="phone-gallery-filters">
    {categories.map((cat, idx) => (
      <button
        type="button"
        data-filter={cat.toLowerCase()}
        class={`phone-filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase whitespace-nowrap border transition-all active:scale-95 ${
          idx === 0
            ? "bg-[#B8A7FF] text-[#0A0B14] border-[#B8A7FF]"
            : "bg-white/5 text-white/70 border-white/15 hover:border-white/40"
        }`}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Photo Grid (2-column responsive layout) -->
  <div class="grid grid-cols-2 gap-3 mb-6" id="phone-gallery-grid">
    {galleryItems.map((item, idx) => (
      <div
        class="phone-gallery-card group relative aspect-[4/3] rounded-xl overflow-hidden bg-white/5 border border-white/10 cursor-pointer active:scale-95 transition-all duration-300"
        data-category={item.category.toLowerCase()}
        data-index={idx}
        data-src={getAssetUrl(item.src)}
        data-title={item.title}
        data-cat={item.category}
        role="button"
        tabindex="0"
        aria-label={`View ${item.title}`}
      >
        <img
          src={getAssetUrl(item.src)}
          alt={item.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
        <!-- Permanent Text Overlay on Mobile -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#05060B]/90 via-[#05060B]/20 to-transparent flex flex-col justify-end p-3 pointer-events-none">
          <span class="text-[9px] uppercase font-mono tracking-widest text-[#B8A7FF] font-bold mb-0.5">
            {item.tag}
          </span>
          <h3 class="text-xs font-semibold text-[#FBFAFF] truncate m-0">
            {item.title}
          </h3>
        </div>
      </div>
    ))}
  </div>

  <!-- View All / Stats Banner -->
  <div class="rounded-2xl bg-gradient-to-r from-[#131525] via-[#0A0B14] to-[#131525] border border-[#B8A7FF]/20 p-4 flex items-center justify-between">
    <div class="flex flex-col">
      <span class="text-[10px] uppercase font-mono tracking-widest text-[#B8A7FF]">Total Captures</span>
      <span class="text-lg font-bold text-[#FBFAFF] font-['PolySans_Trial']">10+ Event Memories</span>
    </div>
    <button
      type="button"
      id="phone-gallery-view-all"
      class="px-4 py-2.5 rounded-full bg-[#B8A7FF] text-[#0A0B14] font-bold text-xs uppercase tracking-wider shadow-lg active:scale-95 transition-transform flex items-center gap-1.5"
    >
      <span>View All</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
      </svg>
    </button>
  </div>
</section>

<!-- Mobile Fullscreen Touch Lightbox Modal -->
<div
  id="phone-gallery-lightbox"
  class="fixed inset-0 z-[200] hidden flex-col justify-between bg-[#05060B]/98 backdrop-blur-xl p-4 sm:p-6 opacity-0 transition-opacity duration-300 pointer-events-none"
  aria-hidden="true"
  role="dialog"
>
  <!-- Header Bar -->
  <div class="flex items-center justify-between w-full pt-2 px-1 relative z-20">
    <div class="flex flex-col">
      <span id="phone-lightbox-counter" class="text-[11px] font-mono uppercase tracking-widest text-[#B8A7FF]">
        1 / 10
      </span>
      <span id="phone-lightbox-cat" class="text-xs text-white/60 font-semibold uppercase tracking-wider">
        Workshops
      </span>
    </div>
    <button
      type="button"
      id="phone-lightbox-close"
      class="w-10 h-10 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-white active:scale-90 transition-transform"
      aria-label="Close Gallery"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Image Container -->
  <div class="flex-1 flex items-center justify-center relative my-auto py-4 overflow-hidden">
    <img
      id="phone-lightbox-img"
      src=""
      alt=""
      class="max-h-[70vh] max-w-full object-contain rounded-xl border border-white/20 shadow-[0_10px_40px_rgba(0,0,0,0.8)] transition-all duration-300"
    />

    <!-- Navigation Overlay Buttons -->
    <button
      type="button"
      id="phone-lightbox-prev"
      class="absolute left-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/75 border border-white/25 flex items-center justify-center text-white active:scale-90 transition-transform z-30 shadow-lg"
      aria-label="Previous Image"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>

    <button
      type="button"
      id="phone-lightbox-next"
      class="absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/75 border border-white/25 flex items-center justify-center text-white active:scale-90 transition-transform z-30 shadow-lg"
      aria-label="Next Image"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </button>
  </div>

  <!-- Caption Footer -->
  <div class="text-center pb-4 pt-2 border-t border-white/10 relative z-20">
    <h3 id="phone-lightbox-title" class="text-lg font-bold text-[#FBFAFF] uppercase tracking-wide font-['PolySans_Trial'] m-0">
      Workshop Lab
    </h3>
    <span class="text-xs text-[#B8A7FF] block mt-0.5 font-mono">
      ACM AJCE Event Highlight
    </span>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .phone-lightbox-open {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

<script>
  const setupMobileGallery = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".phone-gallery-card"));
    const filterBtns = document.querySelectorAll<HTMLElement>(".phone-filter-btn");
    const viewAllBtn = document.getElementById("phone-gallery-view-all");
    
    const lightbox = document.getElementById("phone-gallery-lightbox");
    const lightboxImg = document.getElementById("phone-lightbox-img") as HTMLImageElement | null;
    const lightboxTitle = document.getElementById("phone-lightbox-title");
    const lightboxCat = document.getElementById("phone-lightbox-cat");
    const lightboxCounter = document.getElementById("phone-lightbox-counter");
    const closeBtn = document.getElementById("phone-lightbox-close");
    const prevBtn = document.getElementById("phone-lightbox-prev");
    const nextBtn = document.getElementById("phone-lightbox-next");

    let currentVisibleItems = [...cards];
    let currentIndex = 0;

    const updateLightbox = () => {
      const item = currentVisibleItems[currentIndex];
      if (!item || !lightboxImg) return;

      const src = item.getAttribute("data-src") || "";
      const title = item.getAttribute("data-title") || "";
      const cat = item.getAttribute("data-cat") || "";

      lightboxImg.src = src;
      lightboxImg.alt = title;
      if (lightboxTitle) lightboxTitle.textContent = title;
      if (lightboxCat) lightboxCat.textContent = cat;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${currentVisibleItems.length}`;
      }
    };

    const openLightbox = (index: number) => {
      if (!lightbox || !currentVisibleItems.length) return;
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add("phone-lightbox-open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.remove("phone-lightbox-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    const moveIndex = (direction: number) => {
      if (!currentVisibleItems.length) return;
      currentIndex = (currentIndex + direction + currentVisibleItems.length) % currentVisibleItems.length;
      updateLightbox();
    };

    // Filter switching
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter") || "all";
        
        filterBtns.forEach((b) => {
          b.classList.remove("bg-[#B8A7FF]", "text-[#0A0B14]", "border-[#B8A7FF]");
          b.classList.add("bg-white/5", "text-white/70", "border-white/15");
        });
        btn.classList.add("bg-[#B8A7FF]", "text-[#0A0B14]", "border-[#B8A7FF]");
        btn.classList.remove("bg-white/5", "text-white/70", "border-white/15");

        currentVisibleItems = [];
        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-category") || "";
          if (filter === "all" || cardCat.includes(filter)) {
            card.style.display = "block";
            currentVisibleItems.push(card);
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    // Card click events
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const itemIdx = currentVisibleItems.indexOf(card);
        if (itemIdx !== -1) openLightbox(itemIdx);
      });
    });

    // View All button triggers lightbox with 1st image
    viewAllBtn?.addEventListener("click", () => {
      // Reset filter to ALL
      const allBtn = filterBtns[0];
      allBtn?.click();
      openLightbox(0);
    });

    closeBtn?.addEventListener("click", closeLightbox);
    prevBtn?.addEventListener("click", () => moveIndex(-1));
    nextBtn?.addEventListener("click", () => moveIndex(1));

    // Touch Swipe support for Lightbox
    let touchStartX = 0;
    let touchEndX = 0;

    lightbox?.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox?.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeDistance = touchEndX - touchStartX;
      if (swipeDistance > 50) moveIndex(-1); // Swipe Right -> Prev
      if (swipeDistance < -50) moveIndex(1); // Swipe Left -> Next
    }, { passive: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileGallery);
  } else {
    setupMobileGallery();
  }
</script>
