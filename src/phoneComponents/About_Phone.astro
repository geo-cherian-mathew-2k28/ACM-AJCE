---
import { getAssetUrl } from "../utils/cdn";
---

<!-- About Sections for Phone -->
<div class="w-full overflow-hidden py-4 flex flex-col gap-4">
  <!-- About Section 1: ACM AJCE -->
  <section
    class="about-section-phone section-1 w-full relative flex items-center justify-center px-4 py-5 bg-[#05060B]"
  >
    <div
      class="curvy-card relative w-full p-6 sm:p-8 rounded-[2rem] bg-gradient-to-br from-[#131525]/95 via-[#0a0b14]/98 to-[#05060b] border border-[#B8A7FF]/25 shadow-[0_15px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl flex flex-col gap-6 overflow-hidden"
    >
      <!-- Ambient Glow -->
      <div class="absolute -top-16 -left-16 w-48 h-48 bg-[#B8A7FF]/15 rounded-full blur-2xl pointer-events-none"></div>

      <div class="heading-container flex flex-col gap-3 relative z-10">
        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.25em] text-[#B8A7FF] px-3 py-1 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/20 w-max">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B8A7FF] animate-pulse"></span>
          01 // Community
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white uppercase leading-tight">
          ABOUT <span class="text-[#B8A7FF] drop-shadow-[0_0_12px_rgba(184,167,255,0.4)]">ACM AJCE</span>
        </h2>
        <div class="w-14 h-1 bg-gradient-to-r from-[#B8A7FF] to-transparent rounded-full"></div>
      </div>

      <div class="text-container-phone text-white/90 relative z-10">
        <div class="flex flex-col gap-4 text-xs sm:text-sm leading-relaxed font-light">
          <p class="border-l-2 border-[#B8A7FF]/40 pl-3">
            ACM AJCE is a student community for people who want to explore
            computing with curiosity, care, and practical collaboration. We
            learn by building, sharing knowledge, and making room for new
            voices.
          </p>
          <p class="text-white/75">
            We ask questions, build with purpose, and learn together. Through
            workshops, events, and peer-led projects, we want technology to feel
            more approachable, useful, and connected to people.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section 2: AJCE -->
  <section
    class="about-section-phone section-2 w-full relative flex items-center justify-center px-4 py-5 bg-[#05060B]"
  >
    <div
      class="curvy-card relative w-full p-6 sm:p-8 rounded-[2rem] bg-gradient-to-br from-[#131525]/95 via-[#0a0b14]/98 to-[#05060b] border border-[#B8A7FF]/25 shadow-[0_15px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl flex flex-col gap-6 overflow-hidden"
    >
      <!-- Ambient Glow -->
      <div class="absolute -bottom-16 -right-16 w-48 h-48 bg-[#6A5ACD]/20 rounded-full blur-2xl pointer-events-none"></div>

      <div class="heading-container flex flex-col gap-3 relative z-10">
        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.25em] text-[#B8A7FF] px-3 py-1 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/20 w-max">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B8A7FF] animate-pulse"></span>
          02 // Campus
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white uppercase leading-tight">
          ABOUT <span class="text-[#B8A7FF] drop-shadow-[0_0_12px_rgba(184,167,255,0.4)]">AMAL JYOTHI</span>
        </h2>
        <div class="w-14 h-1 bg-gradient-to-r from-[#B8A7FF] to-transparent rounded-full"></div>
      </div>

      <div class="text-container-phone text-white/90 relative z-10">
        <div class="flex flex-col gap-4 text-xs sm:text-sm leading-relaxed font-light">
          <p class="border-l-2 border-[#B8A7FF]/40 pl-3">
            Amal Jyothi College of Engineering is located in Kanjirappally,
            Kottayam, Kerala. ACM AJCE brings students together on campus to
            explore technology, exchange ideas, and create work that matters.
          </p>
          <p class="text-white/75">
            Our chapter is being shaped as an open space for learning: a place
            to try unfamiliar things, collaborate across interests, and grow
            through the craft of computing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section 3: Mission -->
  <section
    id="mission"
    class="about-section-phone section-3 w-full relative flex items-center justify-center px-4 py-5 bg-[#05060B]"
  >
    <div
      class="curvy-card relative w-full p-6 sm:p-8 rounded-[2rem] bg-gradient-to-br from-[#131525]/95 via-[#0a0b14]/98 to-[#05060b] border border-[#B8A7FF]/25 shadow-[0_15px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl flex flex-col gap-6 overflow-hidden"
    >
      <!-- Ambient Glow -->
      <div class="absolute -top-16 -right-16 w-48 h-48 bg-[#B8A7FF]/20 rounded-full blur-2xl pointer-events-none"></div>

      <div class="heading-container flex flex-col gap-3 relative z-10">
        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.25em] text-[#B8A7FF] px-3 py-1 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/20 w-max">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B8A7FF] animate-pulse"></span>
          03 // Purpose
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white uppercase leading-tight">
          OUR <span class="text-[#B8A7FF] drop-shadow-[0_0_12px_rgba(184,167,255,0.4)]">MISSION</span> & VISION
        </h2>
        <div class="w-14 h-1 bg-gradient-to-r from-[#B8A7FF] to-transparent rounded-full"></div>
      </div>

      <div class="text-container-phone text-white/90 relative z-10">
        <div class="flex flex-col gap-4 text-xs sm:text-sm leading-relaxed font-light">
          <div class="bg-[#B8A7FF]/10 p-4 rounded-xl border border-[#B8A7FF]/20">
            <span class="block mb-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#B8A7FF]">Our Mission</span>
            To foster a deep passion for technology and innovation among our
            members, making space for curiosity and experimentation.
          </div>
          <p class="text-white/80">
            The Association for Computing Machinery (ACM) is the world's
            largest educational and scientific computing society, uniting educators, researchers, and professionals.
          </p>
          <p class="text-white/70">
            It promotes technical excellence, lifelong learning, and career development globally.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .about-section-phone {
    background-color: #05060B;
  }
</style>
