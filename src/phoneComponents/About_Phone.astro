---
import { getAssetUrl } from "../utils/cdn";
---

<!-- About Sections for Phone -->
<div class="w-full overflow-hidden">
  <!-- About Section 1 -->
  <section
    class="about-section-phone section-1 w-full h-screen relative flex flex-col justify-center px-4 py-8 overflow-hidden bg-center bg-cover bg-no-repeat radial-overlay"
    data-bg={getAssetUrl("/about/about-acm.webp")}
    style="background-color: #05060B;"
  >
    <div
      class="content-wrapper flex flex-col items-center justify-center h-full gap-4"
    >
      <div class="text-container-phone text-white p-4 text-right">
        <div class="flex flex-col gap-4 text-[0.8rem] leading-[1.4]">
          <p>
            ACM AJCE is a student community for people who want to explore
            computing with curiosity, care, and practical collaboration. We
            learn by building, sharing knowledge, and making room for new
            voices.
          </p>
          <p>
            We ask questions, build with purpose, and learn together. Through
            workshops, events, and peer-led projects, we want technology to feel
            more approachable, more useful, and more connected to people.
          </p>
        </div>
      </div>
      <div
        class="svg-container-phone w-full max-w-[250px] flex justify-center items-end"
      >
        <img
          src={getAssetUrl("/about/Cassette.svg")}
          alt="Cassette 1"
          class="cassette-svg-phone w-full h-auto origin-center drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] will-change-[transform]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- About Section 2 -->
  <section
    class="about-section-phone section-2 w-full h-screen relative flex flex-col justify-center px-4 py-8 overflow-hidden bg-center bg-cover bg-no-repeat radial-overlay"
    data-bg={getAssetUrl("/about/about-acm.webp")}
    style="background-color: #05060B;"
  >
    <div
      class="content-wrapper flex flex-col items-center justify-center h-full gap-4"
    >
      <div class="text-container-phone text-white p-4 text-left">
        <div class="flex flex-col gap-4 text-[0.8rem] leading-[1.4]">
          <p>
            Amal Jyothi College of Engineering is located in Kanjirappally,
            Kottayam, Kerala. ACM AJCE brings students together on campus to
            explore technology, exchange ideas, and create work that matters.
          </p>
          <p>
            Our chapter is being shaped as an open space for learning: a place
            to try unfamiliar things, collaborate across interests, and grow
            through the craft of computing.
          </p>
        </div>
      </div>
      <div
        class="svg-container-phone w-full max-w-[250px] flex justify-center items-end"
      >
        <img
          src={getAssetUrl("/about/3.webp")}
          alt="Cassette 2"
          class="cassette-svg-phone w-full h-auto origin-center drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] will-change-[transform]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- About Section 3 -->
  <section
    id="mission"
    class="about-section-phone section-3 w-full h-screen relative flex flex-col justify-center px-4 py-8 overflow-hidden bg-center bg-cover bg-no-repeat radial-overlay"
    data-bg={getAssetUrl("/about/about-acm.webp")}
    style="background-color: #05060B;"
  >
    <div
      class="content-wrapper flex flex-col items-center justify-center h-full gap-4"
    >
      <div class="text-container-phone text-white p-4 text-right">
        <div class="flex flex-col gap-4 text-[0.8rem] leading-[1.4]">
          <p>
            <span class="block mb-2 font-mono uppercase tracking-[0.24em] text-[#B8A7FF]">Our mission</span>
            To foster a deep passion for technology and innovation among our
            members, making space for curiosity and experimentation.
          </p>
          <p>
            The Association for Computing Machinery (ACM) is the world's
            largest educational and scientific computing society. Since its
            inception in 1947, ACM has united educators, researchers, and
            professionals to advance computing as a science and a profession.
          </p>
          <p>
            It promotes the highest standards of technical excellence, fosters
            lifelong learning, and supports career development through a global
            network of conferences, publications, and professional communities.
            With a strong commitment to innovation and leadership, ACM
            continues to shape the future of computing worldwide.
          </p>
        </div>
      </div>
      <div
        class="svg-container-phone w-full max-w-[250px] flex justify-center items-end"
      >
        <img
          src={getAssetUrl("/about/2.webp")}
          alt="Cassette 3"
          class="cassette-svg-phone w-full h-auto origin-center drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] will-change-[transform]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>
</div>

<style>
  .radial-overlay {
    position: relative;
  }
  .radial-overlay::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle at 30% 50%,
      rgba(26, 26, 26, 0.6) 0%,
      rgba(6, 6, 6, 0.85) 70%
    );
    pointer-events: none;
    z-index: 0;
  }
  .radial-overlay > * {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initPhoneAnimations() {
    console.log("Initializing Phone Animations");
    const lazySections = document.querySelectorAll(".about-section-phone");
    const loadBg = (section: Element) => {
      if (!(section instanceof HTMLElement)) return;
      const bg = section.dataset.bg;
      if (!bg) return;
      section.style.backgroundImage = `url(${bg})`;
      section.removeAttribute("data-bg");
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadBg(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "200px 0px", threshold: 0.01 }
      );
      lazySections.forEach((section) => observer.observe(section));
    } else {
      lazySections.forEach(loadBg);
    }

    const sections = document.querySelectorAll(".about-section-phone");

    sections.forEach((section, index) => {
      const cassette = section.querySelector(".cassette-svg-phone");

      if (cassette) {
        let xStart, xEnd, rotationEnd;

        if (index === 0) {
          // Section 1
          xStart = -100; // Reduced from -200
          xEnd = -20; // Reduced from -40
          rotationEnd = 10; // Reduced rotation
        } else if (index === 1) {
          // Section 2
          xStart = 100; // Reduced from 200
          xEnd = 25; // Reduced from 50
          rotationEnd = -10;
        } else {
          // Section 3
          xStart = -100;
          xEnd = -20;
          rotationEnd = 10;
        }

        const rotationStart = -45;

        gsap.fromTo(
          cassette,
          {
            y: 300,
            x: xStart,
            rotation: rotationStart,
          },
          {
            y: 0,
            x: xEnd,
            rotation: rotationEnd,
            duration: 1,
            ease: "power2.out",
            scrollTrigger: {
              trigger: section,
              start: "top 70%",
              end: "bottom bottom",
              scrub: 1,
              toggleActions: "play none none reverse",
            },
          }
        );
      }
    });

    // Refresh ScrollTrigger to ensure positions are correct after layout
    ScrollTrigger.refresh();
  }

  let phoneInit = false;
  const safeInit = () => {
    if (phoneInit) return;
    phoneInit = true;
    initPhoneAnimations();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", safeInit);
  } else {
    safeInit();
  }

  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
  });
</script>
