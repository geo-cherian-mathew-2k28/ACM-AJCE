---
// ACM-W Bento
import { getAssetUrl } from "../utils/cdn";
---

<section
  class="w-full flex flex-col justify-center items-center px-8 md:px-16 pt-16 pb-10 md:py-10 min-h-[55vh] md:min-h-[60vh]"
>
  <a
    href="https://blog.acmvit.in"
    target="_blank"
    rel="noopener noreferrer"
    class="relative w-full max-w-[210px] sm:max-w-[266px] md:max-w-[640px] lg:max-w-[1000px] block focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-pink/60 rounded-md"
  >
    <img
      src={getAssetUrl("/acmw-bento-phone.webp")}
      alt="ACM-W bento (mobile)"
      class="acmw-bento-art block md:hidden w-full h-auto select-none"
      loading="lazy"
      decoding="async"
    />

    <img
      src={getAssetUrl("/acmw-bento.webp")}
      alt="ACM-W bento"
      class="acmw-bento-art hidden md:block w-full h-auto select-none"
      loading="lazy"
      decoding="async"
    />
  </a>

</section>

<style>
  .acmw-bento-art {
    filter: hue-rotate(285deg) saturate(0.72) brightness(0.94);
  }
</style>
