---

---

<section class="laptop-section relative w-full h-[300vh]">
  <div
    class="sticky top-0 left-0 w-full h-screen flex items-center justify-center overflow-hidden"
  >
    <canvas
      id="laptop-canvas"
      class="contact-laptop-canvas w-[80%] h-[80%] object-contain"
      style="background: url('/outputFolder/frame_0001.avif') center / contain no-repeat;"
      aria-label="Animated contact laptop"
    ></canvas>
    <div
      class="contact-heading absolute top-[25%] left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center z-10 opacity-100 pointer-events-none"
    >
      <div
        class="justify-start text-white text-5xl font-semibold font-['PolySans_Trial'] uppercase"
      >
        Contact us!
      </div>
    </div>

    <!-- Contact Form Overlay -->
    <div
      class="contact-form-overlay absolute top-[17%] left-[11%] w-[78%] h-[53%] z-20 opacity-0 pointer-events-none flex flex-col items-center justify-center"
    >
      <!-- Compact Success Notification Toast -->
      <div id="contact-success-banner" class="hidden absolute top-2 left-1/2 transform -translate-x-1/2 z-30 px-3.5 py-1.5 rounded-full bg-emerald-500/90 text-white text-[11px] font-semibold shadow-lg backdrop-blur-sm transition-all flex items-center gap-1.5 border border-emerald-400/40">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Message Sent Successfully!
      </div>

      <form
        class="contact-form pointer-events-auto flex w-full max-w-[44%] flex-col gap-2.5 text-xs text-[#2A2455] px-2"
        method="POST"
        id="contact-form-desktop"
      >
        <div class="contact-grid grid gap-2.5 sm:grid-cols-2">
          <label
            class="flex flex-col gap-0.5 text-[8px] font-semibold uppercase tracking-[0.28em] text-[#4D4770] sm:text-[9px]"
          >
            First Name
            <input
              type="text"
              name="firstName"
              required
              class="contact-input"
            />
          </label>
          <label
            class="flex flex-col gap-0.5 text-[8px] font-semibold uppercase tracking-[0.28em] text-[#4D4770] sm:text-[9px]"
          >
            Last Name
            <input type="text" name="lastName" class="contact-input" />
          </label>
        </div>

        <div class="contact-grid grid gap-2.5 sm:grid-cols-2">
          <label
            class="flex flex-col gap-0.5 text-[8px] font-semibold uppercase tracking-[0.28em] text-[#4D4770] sm:text-[9px]"
          >
            Email
            <input type="email" name="email" required class="contact-input" />
          </label>
          <label
            class="flex flex-col gap-0.5 text-[8px] font-semibold uppercase tracking-[0.28em] text-[#4D4770] sm:text-[9px]"
          >
            Phone
            <input
              type="tel"
              name="phone"
              inputmode="tel"
              pattern="[0-9]{7,15}"
              class="contact-input"
            />
          </label>
        </div>

        <label
          class="flex flex-col gap-0.5 text-[8px] font-semibold uppercase tracking-[0.28em] text-[#4D4770] sm:text-[9px]"
        >
          Message
          <textarea
            name="message"
            rows="2"
            required
            class="contact-input resize-none py-1.5"></textarea>
        </label>

        <div class="flex flex-col items-center justify-center pt-1.5 mt-0.5">
          <div
            class="w-32 h-8 bg-[#2A2455] rounded-[200px] flex items-center justify-center overflow-hidden shadow-sm"
          >
            <button
              type="submit"
              class="group inline-flex items-center justify-center gap-2 w-full h-full text-xs font-semibold text-[#FBFAFF] sm:text-sm hover:bg-white/10 transition-colors cursor-pointer"
            >
              Submit
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-input {
    border-radius: 0.75rem;
    border: 1.5px dashed #4d4770;
    background: transparent;
    padding: 0.6rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #2a2455;
    outline: none;
    transition: border 0.2s ease;
    width: 100%;
  }

  .contact-input:focus {
    border-color: #6a5acd;
  }

  .contact-laptop-canvas {
    filter: hue-rotate(230deg) saturate(0.82) brightness(1.12);
  }

  /* Adjust form layout for the laptop screen size */
  .contact-form {
    height: auto;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { getAssetUrl } from "../utils/cdn";

  gsap.registerPlugin(ScrollTrigger);

  const canvas = document.querySelector("#laptop-canvas");
  const context = canvas ? canvas.getContext("2d", { alpha: true }) : null;
  const section = document.querySelector(".laptop-section");

  const frameCount = 125;
  const frames: HTMLImageElement[] = new Array(frameCount);
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const laptop = {
    frame: 0,
  };

  const currentFrame = (index: number) =>
    getAssetUrl(
      `/outputFolder/frame_${(index + 1).toString().padStart(4, "0")}.avif`
    );

  const resizeCanvas = () => {
    if (!canvas || !context) return;
    const rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
  };

  let renderPending = false;
  let lastFrameRendered = -1;

  const render = () => {
    if (renderPending) return;
    renderPending = true;
    requestAnimationFrame(() => {
      renderPending = false;
      if (!context || !canvas) return;
      const targetIndex = Math.max(
        0,
        Math.min(frameCount - 1, Math.round(laptop.frame))
      );
      if (targetIndex === lastFrameRendered) return;
      const img = frames[targetIndex];
      if (img && img.complete) {
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.drawImage(img, 0, 0, canvas.width, canvas.height);
        lastFrameRendered = targetIndex;
      }
    });
  };

  const preloadAllFrames = async () => {
    const promises = [];
    for (let i = 0; i < frameCount; i++) {
      const img = new Image();
      img.decoding = "async";
      img.src = currentFrame(i);
      frames[i] = img;
      promises.push(
        new Promise((resolve) => {
          if (img.complete) {
            resolve(null);
            return;
          }
          img.onload = () => resolve(null);
          img.onerror = () => resolve(null);
        })
      );
    }
    await Promise.all(promises);
  };

  const initSequence = async () => {
    if (!canvas || !context) return;
    resizeCanvas();
    await preloadAllFrames();
    render();

    if (prefersReducedMotion) {
      const formOverlay = document.querySelector(
        ".contact-form-overlay"
      ) as HTMLElement | null;
      if (formOverlay) {
        formOverlay.style.opacity = "1";
        formOverlay.style.pointerEvents = "auto";
      }
      const heading = document.querySelector(".contact-heading");
      if (heading) {
        heading.style.opacity = "0";
        heading.style.transform = "translateY(-50px)";
      }
      return;
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".laptop-section",
        start: "top top",
        end: "bottom bottom",
        scrub: 0.1,
      },
    });

    tl.to(laptop, {
      frame: frameCount - 1,
      snap: "frame",
      ease: "none",
      duration: 2.2,
      onUpdate: render,
    })
      .to(
        ".contact-heading",
        {
          opacity: 0,
          y: -50,
          duration: 0.3,
          ease: "power1.out",
        },
        0.8
      )
      .to(
        ".contact-form-overlay",
        {
          opacity: 1,
          pointerEvents: "auto",
          duration: 0.35,
          ease: "power2.out",
        },
        1.8
      );
  };

  let started = false;
  const startWhenVisible = () => {
    if (started) return;
    started = true;
    initSequence();
  };

  if (section && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          startWhenVisible();
          observer.disconnect();
        }
      },
      { rootMargin: "200px" }
    );
    observer.observe(section);
  } else {
    startWhenVisible();
  }

  window.addEventListener("resize", () => {
    resizeCanvas();
    lastFrameRendered = -1;
    render();
  });

  const form = document.getElementById("contact-form-desktop");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn ? submitBtn.innerHTML : "Submit";
      const setSubmitting = (submitting: boolean) => {
        if (!submitBtn) return;
        submitBtn.innerHTML = submitting ? "Sending..." : originalBtnText;
        if (submitBtn) submitBtn.disabled = submitting;
      };

      setSubmitting(true);
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      let isDelivered = false;

      // Post to real-time server on port 5050
      try {
        const res = await fetch("http://localhost:5050/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          isDelivered = true;
        }
      } catch (err) {
        console.error("Contact API delivery error:", err);
      }

      setSubmitting(false);

      if (isDelivered) {
        // Save locally
        try {
          const existingContacts = JSON.parse(localStorage.getItem("acm_contacts") || "[]");
          existingContacts.unshift({
            name: `${data.firstName || ''} ${data.lastName || ''}`.trim(),
            email: data.email,
            phone: data.phone || 'N/A',
            message: data.message,
            receivedAt: new Date().toLocaleString()
          });
          localStorage.setItem("acm_contacts", JSON.stringify(existingContacts));
          window.dispatchEvent(new Event("storage"));
        } catch (err) {}

        // Show Toast only on verified delivery
        const banner = document.getElementById("contact-success-banner");
        if (banner) banner.classList.remove("hidden");
        form.reset();

        setTimeout(() => {
          if (banner) banner.classList.add("hidden");
        }, 4000);
      } else {
        alert("⚠️ Failed to deliver message to Executive Dashboard. Please ensure backend server is running.");
      }
    });
  }
</script>
