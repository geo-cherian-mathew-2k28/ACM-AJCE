---
// Gallery.astro
import { getAssetUrl } from "../utils/cdn";
import ProofGallery from "./ProofGallery.astro";

// Set to true once the new team group photo is placed at public/full-core.webp
const showGroupPhoto = false;
---

<section
  id="gallery"
  class="gallery-section relative w-full py-20 sm:py-32 overflow-hidden flex flex-col items-center justify-center"
>
  <!-- Floating Words Background -->
  <div class="floating-words-container pointer-events-none" aria-hidden="true">
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 45s; --x: 5%; --y: 10%;"
      >UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 55s; --x: 80%; --y: 15%;"
      >ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 2s; --duration: 40s; --x: 75%; --y: 70%;"
      >COMMUNITY</span
    >
    <span
      class="floating-word"
      style="--delay: 7s; --duration: 55s; --x: 10%; --y: 75%;"
      >EXCELLENCE</span
    >
  </div>

  <div class="flex w-full flex-col items-center justify-center gap-8 relative z-20 px-4 max-w-5xl mx-auto">
    <!-- Gallery Title Graphic -->
    <div class="relative flex w-full flex-col items-center justify-center">
      <img
        src={getAssetUrl("/gallery.webp")}
        alt="Gallery Title"
        class="gallery-title relative z-10 w-[85vw] max-w-3xl h-auto object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>

    {
      showGroupPhoto ? (
        <div class="gallery-frame relative w-full overflow-hidden rounded-2xl shadow-2xl border border-white/10">
          <img
            src={getAssetUrl("/full-core.webp")}
            alt="ACM AJCE gallery preview"
            class="gallery-image w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <button type="button" onclick="window.openProofGallery()" class="gallery-open-button">
            <span>View gallery</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </button>
        </div>
      ) : (
        <div class="gallery-standalone-box relative z-20 w-full max-w-xl p-8 sm:p-12 rounded-3xl border border-purple-500/30 bg-gradient-to-b from-[#181436]/90 to-[#0A0B14]/90 backdrop-blur-xl flex flex-col items-center justify-center text-center shadow-[0_0_50px_rgba(106,90,205,0.2)] transition-all duration-300 hover:border-purple-400/50 my-4">
          <p class="text-purple-200/90 text-sm sm:text-base font-medium mb-6 tracking-wide leading-relaxed">
            Explore photos from our workshops, events, and community moments
          </p>
          <button 
            type="button" 
            onclick="window.openProofGallery()" 
            class="gallery-open-button-standalone group relative inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-[#6A5ACD] to-[#B8A7FF] text-white font-bold text-sm sm:text-base tracking-wider uppercase shadow-[0_0_25px_rgba(184,167,255,0.4)] hover:shadow-[0_0_40px_rgba(184,167,255,0.75)] transition-all duration-300 hover:scale-105 cursor-pointer border border-white/20"
          >
            <span>View Photo Gallery</span>
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </button>
        </div>
      )
    }
  </div>
  <ProofGallery />
</section>

<script>
  // Ensure the function is available (if ProofGallery script hasn't run yet, though it should have)
</script>

<style>
  .gallery-section {
    font-family: "PolySans Trial", "PolySans", system-ui, sans-serif;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .gallery-section * {
    -webkit-user-select: none;
    user-select: none;
  }

  .gallery-section img {
    -webkit-user-drag: none;
  }

  .gallery-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(3, 3, 3, 0) 40%,
      rgba(3, 3, 3, 0.55) 100%
    );
    pointer-events: none;
  }

  .gallery-image {
    filter: grayscale(1);
    transition: filter 0.3s ease;
  }

  .gallery-frame:hover .gallery-image {
    filter: grayscale(0.2);
  }

  .gallery-open-button {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1rem, 4vw, 3rem);
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 46px;
    padding: 0 1rem 0 1.15rem;
    border: 1px solid rgba(251, 250, 255, 0.76);
    border-radius: 6px;
    background: rgba(42, 36, 85, 0.9);
    color: #FBFAFF;
    font-family: "PolySans Trial", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .gallery-open-button:hover {
    border-color: #B8A7FF;
    background: #2A2455;
    transform: translateY(-2px);
  }

  .gallery-open-button svg {
    width: 17px;
    height: 17px;
  }

  .gallery-open-button-standalone {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 52px;
    padding: 0 2.2rem;
    border: 1.5px solid rgba(184, 167, 255, 0.6);
    border-radius: 9999px;
    background: rgba(42, 36, 85, 0.85);
    backdrop-filter: blur(12px);
    color: #FBFAFF;
    font-family: "PolySans Trial", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 8px 32px rgba(184, 167, 255, 0.15);
    transition: all 250ms ease;
    cursor: pointer;
  }

  .gallery-open-button-standalone:hover {
    border-color: #B8A7FF;
    background: #6A5ACD;
    color: #FFFFFF;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 40px rgba(106, 90, 205, 0.4);
  }

  .gallery-open-button-standalone svg {
    width: 20px;
    height: 20px;
    transition: transform 250ms ease;
  }

  .gallery-open-button-standalone:hover svg {
    transform: translateX(4px);
  }

  /* Floating Words Background */
  .floating-words-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .floating-word {
    position: absolute;
    font-family: "Inter", sans-serif;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 900;
    font-style: normal;
    line-height: normal;
    text-transform: uppercase;
    opacity: 0.08;
    white-space: nowrap;
    letter-spacing: 0.1em;
    color: #FBFAFF;
    will-change: transform;
    animation: float 22s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    animation-delay: var(--delay, 0s);
    left: clamp(20%, var(--x, 50%), 80%);
    top: var(--y, 50%);
    transform: translate(-50%, 0);
  }

  .floating-word:nth-child(even) {
    -webkit-text-stroke-width: 2.28px;
    -webkit-text-stroke-color: #FBFAFF;
    color: transparent;
    opacity: 0.055;
  }

  .floating-word:nth-child(n + 11) {
    display: none;
  }

  .floating-word:nth-child(2n) { animation-duration: 26s; }
  .floating-word:nth-child(3n) { animation-duration: 19s; }
  .floating-word:nth-child(5n) { animation-duration: 28s; }

  .floating-word:nth-child(1) { --x: 22% !important; --y: 14% !important; }
  .floating-word:nth-child(2) { --x: 76% !important; --y: 18% !important; }
  .floating-word:nth-child(3) { --x: 22% !important; --y: 46% !important; }
  .floating-word:nth-child(4) { --x: 72% !important; --y: 44% !important; }
  .floating-word:nth-child(5) { --x: 48% !important; --y: 30% !important; }
  .floating-word:nth-child(6) { --x: 76% !important; --y: 64% !important; }
  .floating-word:nth-child(7) { --x: 22% !important; --y: 68% !important; }
  .floating-word:nth-child(8) { --x: 54% !important; --y: 72% !important; }
  .floating-word:nth-child(9) { --x: 44% !important; --y: 8% !important; }
  .floating-word:nth-child(10) { --x: 70% !important; --y: 82% !important; }


  @keyframes float {
    0%,
    100% {
      transform: translate(-50%, 0) rotate(0deg);
    }
    25% {
      transform: translate(-42%, -0.85rem) rotate(0.8deg);
    }
    50% {
      transform: translate(-58%, 1.1rem) rotate(-0.75deg);
    }
    75% {
      transform: translate(-44%, 0.45rem) rotate(0.65deg);
    }
  }

  /* Ensure gallery content is above the floating words */
  /* The z-index on gallery-section is not strictly needed here as floating-words-container is now a child with z-index 0 and main content has z-10 */
  /* .gallery-section {
    position: relative;
    z-index: 1;
  } */

  @media (max-width: 640px) {
    .floating-word {
      font-size: clamp(1rem, 4vw, 2rem);
      opacity: 0.02;
    }
  }
</style>
