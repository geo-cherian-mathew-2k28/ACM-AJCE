---
// Gallery.astro
import { getAssetUrl } from "../utils/cdn";
import ProofGallery from "./ProofGallery.astro";
---

<section
  class="gallery-section relative w-full pt-16 pb-0 sm:pt-24 sm:pb-0 overflow-hidden"
>
  <!-- Floating Words Background -->
  <div class="floating-words-container" aria-hidden="true">
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 45s; --x: 5%; --y: 10%;"
      >UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 55s; --x: 80%; --y: 15%;"
      >ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 50s; --x: 10%; --y: 35%;"
      >PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 60s; --x: 70%; --y: 40%;">SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 48s; --x: 25%; --y: 20%;">DATA ALCHEMY</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 52s; --x: 85%; --y: 30%;"
      >UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 58s; --x: 2%; --y: 45%;"
      >ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 47s; --x: 60%; --y: 10%;"
      >PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 54s; --x: 40%; --y: 5%;"
      >SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 51s; --x: 90%; --y: 25%;">DATA ALCHEMY</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 56s; --x: 15%; --y: 25%;">UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 49s; --x: 75%; --y: 5%;">ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 53s; --x: 35%; --y: 40%;"
      >PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 57s; --x: 50%; --y: 30%;"
      >SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 46s; --x: 65%; --y: 20%;">DATA ALCHEMY</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 59s; --x: 8%; --y: 15%;">UXPLORE</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 50s; --x: 82%; --y: 45%;">ASTERISK</span
    >
    <span
      class="floating-word"
      style="--delay: 6s; --duration: 55s; --x: 45%; --y: 15%;">PIXIEART</span
    >
    <span
      class="floating-word"
      style="--delay: 0s; --duration: 48s; --x: 20%; --y: 40%;">SHE CODES</span
    >
    <span
      class="floating-word"
      style="--delay: 3s; --duration: 52s; --x: 55%; --y: 45%;">DATA ALCHEMY</span
    >
  </div>

  <div class="flex w-full flex-col items-center gap-3 relative z-10">
    <div class="relative flex w-full max-w-4xl flex-col items-center px-4">
      <img
        src={getAssetUrl("/gallery.webp")}
        alt="Gallery Title"
        class="gallery-title relative z-10 w-[90vw] max-w-3xl mb-2"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="gallery-frame relative w-full overflow-hidden">
      <img
        src={getAssetUrl("/full-core.webp")}
        alt="ACM AJCE gallery preview"
        class="gallery-image w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <button type="button" onclick="window.openProofGallery()" class="gallery-open-button">
        <span>View gallery</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
  <ProofGallery />
</section>

<script>
  // Ensure the function is available (if ProofGallery script hasn't run yet, though it should have)
  // Actually, Astro scripts module hoist, so it might be fine, but let's be safe.
</script>

<style>
  .gallery-section {
    font-family: "PolySans Trial", "PolySans", system-ui, sans-serif;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .gallery-section * {
    -webkit-user-select: none;
    user-select: none;
  }

  .gallery-section img {
    -webkit-user-drag: none;
  }

  .gallery-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(3, 3, 3, 0) 40%,
      rgba(3, 3, 3, 0.55) 100%
    );
    pointer-events: none;
  }

  .gallery-image {
    filter: grayscale(1);
    transition: filter 0.3s ease;
  }

  .gallery-frame:hover .gallery-image {
    filter: grayscale(0.2);
  }

  .gallery-open-button {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1rem, 4vw, 3rem);
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 46px;
    padding: 0 1rem 0 1.15rem;
    border: 1px solid rgba(251, 250, 255, 0.76);
    border-radius: 6px;
    background: rgba(42, 36, 85, 0.9);
    color: #FBFAFF;
    font-family: "PolySans Trial", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .gallery-open-button:hover {
    border-color: #B8A7FF;
    background: #2A2455;
    transform: translateY(-2px);
  }

  .gallery-open-button svg {
    width: 17px;
    height: 17px;
  }

  /* Floating Words Background */
  .floating-words-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .floating-word {
    position: absolute;
    font-family: "Inter", sans-serif;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 900;
    font-style: normal;
    line-height: normal;
    text-transform: uppercase;
    opacity: 0.08;
    white-space: nowrap;
    letter-spacing: 0.1em;
    color: #FBFAFF;
    will-change: transform;
    animation: float 22s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    animation-delay: var(--delay, 0s);
    left: clamp(20%, var(--x, 50%), 80%);
    top: var(--y, 50%);
    transform: translate(-50%, 0);
  }

  .floating-word:nth-child(even) {
    -webkit-text-stroke-width: 2.28px;
    -webkit-text-stroke-color: #FBFAFF;
    color: transparent;
    opacity: 0.055;
  }

  .floating-word:nth-child(n + 11) {
    display: none;
  }

  .floating-word:nth-child(2n) { animation-duration: 26s; }
  .floating-word:nth-child(3n) { animation-duration: 19s; }
  .floating-word:nth-child(5n) { animation-duration: 28s; }

  .floating-word:nth-child(1) { --x: 22% !important; --y: 14% !important; }
  .floating-word:nth-child(2) { --x: 76% !important; --y: 18% !important; }
  .floating-word:nth-child(3) { --x: 22% !important; --y: 46% !important; }
  .floating-word:nth-child(4) { --x: 72% !important; --y: 44% !important; }
  .floating-word:nth-child(5) { --x: 48% !important; --y: 30% !important; }
  .floating-word:nth-child(6) { --x: 76% !important; --y: 64% !important; }
  .floating-word:nth-child(7) { --x: 22% !important; --y: 68% !important; }
  .floating-word:nth-child(8) { --x: 54% !important; --y: 72% !important; }
  .floating-word:nth-child(9) { --x: 44% !important; --y: 8% !important; }
  .floating-word:nth-child(10) { --x: 70% !important; --y: 82% !important; }


  @keyframes float {
    0%,
    100% {
      transform: translate(-50%, 0) rotate(0deg);
    }
    25% {
      transform: translate(-42%, -0.85rem) rotate(0.8deg);
    }
    50% {
      transform: translate(-58%, 1.1rem) rotate(-0.75deg);
    }
    75% {
      transform: translate(-44%, 0.45rem) rotate(0.65deg);
    }
  }

  /* Ensure gallery content is above the floating words */
  /* The z-index on gallery-section is not strictly needed here as floating-words-container is now a child with z-index 0 and main content has z-10 */
  /* .gallery-section {
    position: relative;
    z-index: 1;
  } */

  @media (max-width: 640px) {
    .floating-word {
      font-size: clamp(1rem, 4vw, 2rem);
      opacity: 0.02;
    }
  }
</style>
