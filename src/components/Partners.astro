---
import PartnerLaptopSingular from "../components/PartnerLaptopSingular.astro";
import { reader } from "../utils/reader";
import { getAssetUrl } from "../utils/cdn";

const partnersData = await reader.singletons.partners.read();
const partners = partnersData?.items ?? [];

const marqueeRepeat = 4;
const marqueeRows = [
  {
    items: partners.filter((_, index) => index % 2 === 0),
    reverse: false,
  },
  {
    items: partners.filter((_, index) => index % 2 === 1),
    reverse: true,
  },
];
---

<div id="partners-container" class="partners-scene">
  <div class="partners-stage">
    <div
      id="Cassette-pos-1"
      class="partners-floating w-full flex justify-center mt-0 relative"
    >
      <img
        id="partners-svg"
        src={getAssetUrl("/partners-cassette.webp")}
        alt="Partners Image"
        class="partners-title-cassette max-w-[300px] md:max-w-[500px] w-auto object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="partners-carousel relative z-10">
      <div class="partners-track">
      {
        partners.map((partner) => (
          <div class="partners-card">
            <PartnerLaptopSingular title={partner.title} />
          </div>
        ))
      }
      </div>
      <div class="partners-marquee">
        {marqueeRows.map((row) => (
          <div
            class={`partners-marquee-row${row.reverse ? " is-reverse" : ""}`}
          >
            {Array.from({ length: marqueeRepeat }).map((_, index) => (
              <div
                class="partners-marquee-group"
                aria-hidden={index === 0 ? undefined : "true"}
              >
                {row.items.map((partner) => (
                  <div class="partners-card">
                    <PartnerLaptopSingular title={partner.title} />
                  </div>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .partners-scene {
    position: relative;
    min-height: 220vh;
  }

  .partners-stage {
    position: sticky;
    top: 0;
    display: flex;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .partners-carousel {
    display: flex;
    width: min(80vw, 72rem);
    align-items: center;
    justify-content: center;
    padding-bottom: 4.5rem;
  }

  .partners-track {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .partners-floating {
    position: fixed;
    left: 0;
    right: 0;
    bottom: -140px;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    will-change: opacity;
  }

  .partners-title-cassette {
    filter: hue-rotate(285deg) saturate(0.72) brightness(0.94);
  }

  .partners-floating.is-fixed {
    opacity: 1;
  }

  .partners-marquee {
    display: none;
  }

  .partners-marquee-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--gap);
  }

  .partners-marquee-row.is-reverse .partners-marquee-group {
    animation-direction: reverse;
  }

  .partners-marquee-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--gap);
    animation: partners-marquee var(--duration) linear infinite;
    will-change: transform;
  }

  @keyframes partners-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }

  @media (max-width: 768px) {
    .partners-scene {
      min-height: 180vh;
      overflow: visible;
    }

    .partners-stage {
      min-height: 100svh;
    }

    .partners-floating {
      bottom: -110px;
    }
    .partners-carousel {
      width: 100vw;
      padding: 0 6vw 5rem;
      overflow: visible;
    }

    .partners-card {
      flex: 0 0 auto;
    }

    .partners-track {
      display: none;
    }

    .partners-marquee {
      display: flex;
      flex-direction: column;
      gap: var(--gap);
      padding: 0.5rem 1vw;
      --duration: 40s;
      --gap: 1.25rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initializePartners = () => {
    const container = document.getElementById("partners-container");
    const pos1 = document.getElementById("Cassette-pos-1");
    const section = document.getElementById("partners");
    const gallery = document.getElementById("gallery");

    if (container && container.dataset.laptopSceneReady !== "true") {
      container.dataset.laptopSceneReady = "true";
      const screens = Array.from(
        container.querySelectorAll<HTMLElement>(
          ".partner-laptop__screen-shell"
        )
      ).filter((screen) => screen.offsetParent !== null);

      if (
        screens.length &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        gsap.set(screens, {
          "--partner-screen-tilt": "-86deg",
          "--partner-screen-shift": "12%",
          "--partner-screen-opacity": 0.56,
          "--partner-screen-brightness": 0.58,
        });

        gsap.timeline({
          scrollTrigger: {
            trigger: container,
            start: "top top",
            end: "bottom bottom",
            scrub: 0.65,
            invalidateOnRefresh: true,
          },
        }).to(screens, {
          "--partner-screen-tilt": "0deg",
          "--partner-screen-shift": "0%",
          "--partner-screen-opacity": 1,
          "--partner-screen-brightness": 1,
          duration: 1,
          ease: "none",
          stagger: 0.1,
        });
      }
    }

    if (!pos1 || !section || pos1.dataset.visibilityReady === "true") return;
    pos1.dataset.visibilityReady = "true";

    let inPartners = false;
    let inGallery = false;
    const updateVisibility = () => {
      const isActive = inPartners && !inGallery;
      pos1.classList.toggle("is-fixed", isActive);
      document.body.classList.toggle("partners-active", isActive);
    };

    const partnersObserver = new IntersectionObserver(
      ([entry]) => {
        inPartners = entry.isIntersecting;
        updateVisibility();
      },
      {
        root: null,
        rootMargin: "-15% 0px -15% 0px",
        threshold: 0,
      }
    );

    partnersObserver.observe(section);

    if (gallery) {
      const galleryObserver = new IntersectionObserver(
        ([entry]) => {
          inGallery = entry.isIntersecting;
          updateVisibility();
        },
        {
          root: null,
          rootMargin: "0px 0px 0px 0px",
          threshold: 0,
        }
      );

      galleryObserver.observe(gallery);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializePartners, {
      once: true,
    });
  } else {
    initializePartners();
  }

  window.addEventListener("app:variants-mounted", initializePartners);
</script>
