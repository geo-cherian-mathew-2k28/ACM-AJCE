---
import { reader } from "../utils/reader";

const partnersData = await reader.singletons.partners.read();
const partners = partnersData?.items ?? [];
---

<section
  class="partner-laptop-section relative w-full"
  data-partner-laptop-scene
>
  <div
    class="sticky top-0 left-0 w-full h-screen flex items-center justify-center overflow-hidden"
  >
    <div
      class="partner-laptop-heading absolute left-1/2 text-center z-10 pointer-events-none"
    >
      <p
        class="m-0 text-white text-5xl font-semibold font-['PolySans_Trial'] uppercase"
      >
        Partners
      </p>
    </div>

    <div class="partner-laptop-grid" role="list">
      {
        partners.map((partner) => (
          <article class="partner-mini-laptop" role="listitem">
            <a
              class="partner-mini-laptop__link"
              href={partner.link}
              target="_blank"
              rel="noreferrer"
              aria-label={`Visit ${partner.title}`}
            >
              <canvas
                class="partner-mini-laptop__canvas"
                data-partner-laptop-canvas
                data-partner-logo={partner.imageUrl ?? ""}
                data-partner-name={partner.title}
                style="background: url('/outputFolder/frame_0001.avif') center / contain no-repeat;"
                aria-label={`${partner.title} animated partner laptop`}
              ></canvas>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .partner-laptop-grid {
    position: absolute;
    top: 30%;
    left: 50%;
    display: grid;
    width: min(68vw, 52rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.75rem);
    transform: translateX(-50%);
    transition: top 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .partner-laptop-heading {
    top: 22%;
    display: grid;
    width: min(80vw, 76rem);
    place-items: center;
  }

  .partner-laptop-section {
    height: 160vh;
  }

  .partner-mini-laptop {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .partner-mini-laptop__link {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .partner-mini-laptop__canvas {
    display: block;
    width: 100%;
    height: 100%;
    filter:
      drop-shadow(0 0 0.45rem rgba(184, 167, 255, 0.44))
      drop-shadow(0 0 1.15rem rgba(106, 90, 205, 0.2));
    transition: filter 180ms ease, transform 180ms ease;
  }

  .partner-mini-laptop__link:hover .partner-mini-laptop__canvas,
  .partner-mini-laptop__link:focus-visible .partner-mini-laptop__canvas {
    filter:
      drop-shadow(0 0 0.6rem rgba(184, 167, 255, 0.62))
      drop-shadow(0 0 1.35rem rgba(106, 90, 205, 0.32));
    outline: none;
    transform: translateY(-0.12rem);
  }

  @media (min-width: 1024px) {
    .partner-laptop-grid {
      width: min(80vw, 76rem);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(0.85rem, 1.8vw, 1.5rem);
      top: 36%;
    }

    .partner-laptop-grid.is-open {
      top: 55%;
    }

    .partner-laptop-heading {
      top: 22%;
    }
  }

  @media (max-width: 767px) {
    .partner-laptop-section {
      height: 190vh;
    }

    .partner-laptop-heading {
      top: 15%;
    }

    .partner-laptop-heading p {
      font-size: clamp(2rem, 9vw, 3rem);
    }

    .partner-laptop-grid {
      top: 25%;
      width: 84vw;
      gap: 0.35rem;
    }

    .partner-laptop-grid.is-open {
      top: 32%;
    }

  }
</style>

<script>
  import { getAssetUrl } from "../utils/cdn";

  type PartnerCanvas = {
    canvas: HTMLCanvasElement;
    context: CanvasRenderingContext2D | null;
    logoUrl: string;
    name: string;
    logo: HTMLImageElement | null;
  };

  const canvases: PartnerCanvas[] = Array.from(
    document.querySelectorAll<HTMLCanvasElement>("[data-partner-laptop-canvas]")
  ).map((canvas) => ({
    canvas,
    context: canvas.getContext("2d", { alpha: true }),
    logoUrl: canvas.dataset.partnerLogo ?? "",
    name: canvas.dataset.partnerName ?? "",
    logo: null,
  }));
  const section = document.querySelector(".partner-laptop-section");
  const heading = document.querySelector(
    ".partner-laptop-heading"
  ) as HTMLElement | null;
  const grid = document.querySelector(
    ".partner-laptop-grid"
  ) as HTMLElement | null;

  const frameCount = 125;
  const narrowQuery = "(max-width: 1024px)";
  let maxCacheSize = frameCount;
  let preloadRadius = 8;
  const pendingFrames = new Set<number>();
  const frameCache = new Map<number, HTMLImageElement>();
  const partnerLogoCache = new Map<string, Promise<HTMLImageElement | null>>();
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const laptop = { frame: 0 };

  const updatePerfSettings = () => {
    const isNarrow = window.matchMedia(narrowQuery).matches;
    maxCacheSize = isNarrow ? Math.min(12, frameCount) : frameCount;
    preloadRadius = isNarrow ? 3 : 8;
  };

  const currentFrame = (index: number) =>
    getAssetUrl(
      `/outputFolder/frame_${(index + 1).toString().padStart(4, "0")}.avif`
    );

  const normalizeFrameUrl = (url: string) => {
    try {
      return new URL(url, window.location.href).href;
    } catch {
      return url;
    }
  };

  const clampFrame = (index: number) =>
    Math.max(0, Math.min(frameCount - 1, Math.round(index)));

  const loadPartnerLogo = (url: string) => {
    if (!url) return Promise.resolve(null);
    const cached = partnerLogoCache.get(url);
    if (cached) return cached;

    const promise = new Promise<HTMLImageElement | null>((resolve) => {
      const image = new Image();
      image.decoding = "async";
      image.onload = () => resolve(image);
      image.onerror = () => resolve(null);
      image.src = getAssetUrl(url);
    });
    partnerLogoCache.set(url, promise);
    return promise;
  };

  const resizeCanvases = () => {
    updatePerfSettings();
    const maxDpr = window.matchMedia(narrowQuery).matches ? 1.25 : 1.5;
    const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
    for (const { canvas, context } of canvases) {
      if (!context) continue;
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) continue;
      const width = Math.round(rect.width * dpr);
      const height = Math.round(rect.height * dpr);
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
      }
    }
  };

  const trimCache = (center: number) => {
    if (maxCacheSize >= frameCount || frameCache.size <= maxCacheSize) return;
    const keys = Array.from(frameCache.keys()).sort(
      (a, b) => Math.abs(a - center) - Math.abs(b - center)
    );
    const keep = new Set(keys.slice(0, maxCacheSize));
    for (const key of frameCache.keys()) {
      if (!keep.has(key)) frameCache.delete(key);
    }
  };

  const loadFrame = async (index: number) => {
    const clampedIndex = clampFrame(index);
    const cached = frameCache.get(clampedIndex);
    if (cached) return cached;

    const frameUrl = currentFrame(clampedIndex);
    const frameKey = normalizeFrameUrl(frameUrl);
    const sharedFrameCache = (window as any).__contactLaptopFrameCache as
      | Map<string, HTMLImageElement>
      | undefined;
    const sharedFrame = sharedFrameCache?.get(frameKey);
    if (sharedFrame) {
      frameCache.set(clampedIndex, sharedFrame);
      return sharedFrame;
    }
    if (pendingFrames.has(clampedIndex)) return null;
    pendingFrames.add(clampedIndex);

    const image = new Image();
    image.decoding = "async";
    image.src = frameUrl;
    const awaitLoad = () =>
      new Promise((resolve) => {
        if (image.complete) {
          resolve(null);
          return;
        }
        image.onload = () => resolve(null);
        image.onerror = () => resolve(null);
      });

    if (typeof image.decode === "function") {
      try {
        await image.decode();
      } catch {
        await awaitLoad();
      }
    } else {
      await awaitLoad();
    }

    pendingFrames.delete(clampedIndex);
    frameCache.set(clampedIndex, image);
    sharedFrameCache?.set(frameKey, image);
    trimCache(clampedIndex);
    return image;
  };

  const queueFrames = (center: number) => {
    const start = Math.max(0, center - preloadRadius);
    const end = Math.min(frameCount - 1, center + preloadRadius);
    for (let index = start; index <= end; index++) {
      void loadFrame(index);
    }
  };

  let preloadAllScheduled = false;
  const preloadAllFrames = async () => {
    const concurrency = Math.min(6, frameCount);
    let nextIndex = 0;
    const worker = async () => {
      while (nextIndex < frameCount) {
        const index = nextIndex;
        nextIndex += 1;
        await loadFrame(index);
      }
    };
    await Promise.all(Array.from({ length: concurrency }, () => worker()));
  };

  const schedulePreloadAll = () => {
    if (prefersReducedMotion || preloadAllScheduled) return;
    if (window.matchMedia(narrowQuery).matches) return;
    preloadAllScheduled = true;
    window.setTimeout(() => {
      void preloadAllFrames();
    }, 200);
  };

  let lastRenderedFrame = -1;
  let lastCanvasSignature = "";

  const drawPartnerScreen = (partner: PartnerCanvas) => {
    const { canvas, context, logo, name } = partner;
    if (!context || !canvas.width || !canvas.height) return;

    const screenX = canvas.width * 0.17;
    const screenY = canvas.height * 0.105;
    const screenWidth = canvas.width * 0.66;
    const screenHeight = canvas.height * 0.68;
    const screenCenterX = screenX + screenWidth / 2;

    context.save();
    if (logo?.naturalWidth && logo.naturalHeight) {
      const isGdg = name.trim().toLowerCase() === "gdg ajce";
      const maximumLogoWidth = screenWidth * (isGdg ? 0.66 : 0.52);
      const maximumLogoHeight = screenHeight * (isGdg ? 0.54 : 0.44);
      const scale = Math.min(
        maximumLogoWidth / logo.naturalWidth,
        maximumLogoHeight / logo.naturalHeight
      );
      const logoWidth = logo.naturalWidth * scale;
      const logoHeight = logo.naturalHeight * scale;
      context.drawImage(
        logo,
        screenCenterX - logoWidth / 2,
        screenY + screenHeight * 0.12,
        logoWidth,
        logoHeight
      );
    }

    context.fillStyle = "#2A2455";
    context.textAlign = "center";
    context.textBaseline = "middle";
    context.font = `700 ${Math.max(11, canvas.height * 0.095)}px "PolySans Bold", monospace`;
    context.fillText(
      name,
      screenCenterX,
      screenY + screenHeight * 0.8,
      screenWidth * 0.84
    );
    context.restore();
  };

  const render = () => {
    const frame = clampFrame(laptop.frame);
    const image = frameCache.get(frame);
    if (!image) {
      void loadFrame(frame).then((loaded) => {
        if (loaded && frame === clampFrame(laptop.frame)) render();
      });
      return;
    }

    const signature = canvases
      .map(({ canvas }) => `${canvas.width}x${canvas.height}`)
      .join("|");
    if (frame === lastRenderedFrame && signature === lastCanvasSignature) return;
    lastRenderedFrame = frame;
    lastCanvasSignature = signature;

    const isScreenVisible = frame >= Math.round(frameCount * 0.72);
    grid?.classList.toggle("is-open", isScreenVisible);
    for (const partner of canvases) {
      const { canvas, context } = partner;
      if (!context || !canvas.width || !canvas.height) continue;
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      if (isScreenVisible) drawPartnerScreen(partner);
    }
    queueFrames(frame);
  };

  const clampProgress = (value: number) => Math.max(0, Math.min(1, value));

  const updateSequenceFromScroll = () => {
    if (!section || prefersReducedMotion) return;
    const rect = section.getBoundingClientRect();
    const scrollRange = Math.max(section.clientHeight - window.innerHeight, 1);
    const sceneProgress = clampProgress(-rect.top / scrollRange);
    const frameProgress = clampProgress((sceneProgress - 0.04) / 0.92);
    const headingProgress = clampProgress((frameProgress - 0.28) / 0.22);
    laptop.frame = frameProgress * (frameCount - 1);
    if (heading) {
      heading.style.opacity = String(1 - headingProgress * 0.35);
      heading.style.transform = "translate(-50%, -50%)";
    }
    render();
  };

  let scrollAnimationFrame = 0;
  const queueScrollUpdate = () => {
    if (scrollAnimationFrame) return;
    scrollAnimationFrame = window.requestAnimationFrame(() => {
      scrollAnimationFrame = 0;
      updateSequenceFromScroll();
    });
  };

  const initSequence = async () => {
    if (!canvases.length || !section) return;
    resizeCanvases();
    await loadFrame(0);
    render();
    schedulePreloadAll();

    for (const partner of canvases) {
      void loadPartnerLogo(partner.logoUrl).then((logo) => {
        partner.logo = logo;
        lastRenderedFrame = -1;
        render();
      });
    }

    if (prefersReducedMotion) {
      laptop.frame = frameCount - 1;
      render();
      return;
    }
    updateSequenceFromScroll();
  };

  let started = false;
  const startWhenVisible = () => {
    if (started) return;
    started = true;
    void initSequence();
  };

  if (section && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        startWhenVisible();
        observer.disconnect();
      },
      { rootMargin: "200px" }
    );
    observer.observe(section);
  } else {
    startWhenVisible();
  }

  const updateOnScroll = () => queueScrollUpdate();
  window.addEventListener("scroll", updateOnScroll, { passive: true });
  document.body.addEventListener("scroll", updateOnScroll, { passive: true });

  window.addEventListener("resize", () => {
    resizeCanvases();
    lastRenderedFrame = -1;
    queueScrollUpdate();
  });
</script>
