---
import { getAssetUrl } from "../utils/cdn";
---

<!-- About Sections-->
<div class="about-container w-screen overflow-hidden">
  <!-- About Section 1: -->
  <section
    id="about-acm-ajce"
    data-section="about-acm-ajce"
    class="about-section section-1 video-bg-section w-screen h-screen relative bg-center bg-cover bg-no-repeat"
  >
    <div
      class="cassette-container cassette-left svg-container svg-left relative w-[500px] h-[500px] ml-[-50px] mb-[-600px] md:h-[400px] md:w-[400px] lg:h-[500px] lg:w-[500px]"
    >
      <img
        src={getAssetUrl("/about/Cassette.webp")}
        alt="Cassette 1"
        class="cassette-svg w-full h-auto origin-bottom-left rotate-[21deg]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div
      class="text-container text-right absolute top-1/2 -translate-y-1/2 text-white p-8 left-[45vw] w-[50vw] max-w-[800px]"
    >
      <div
        class="text-[1.4rem] leading-[1.55] max-w-[700px] flex flex-col gap-6"
      >
        <p>
          ACM AJCE is a student community for people who want to explore
          computing with curiosity, care, and practical collaboration. We learn
          by building, sharing knowledge, and making room for new voices.
        </p>
        <p>
          We ask questions, build with purpose, and learn together. Through
          workshops, events, and peer-led projects, we want technology to feel
          more approachable, more useful, and more connected to the people who
          use it.
        </p>
      </div>
    </div>
  </section>

  <!-- About Section 2:-->
  <section
    id="about-ajce"
    data-section="about-ajce"
    class="about-section section-2 video-bg-section w-screen h-screen relative bg-center bg-cover bg-no-repeat"
  >
    <div
      class="text-container text-left absolute top-1/2 -translate-y-1/2 text-white p-8 left-[10vw] w-[55vw] max-w-[800px]"
    >
      <div
        class="text-[1.4rem] leading-[1.55] max-w-[700px] flex flex-col gap-6"
      >
        <p>
          Amal Jyothi College of Engineering is located in Kanjirappally,
          Kottayam, Kerala. ACM AJCE brings students together on campus to
          explore technology, exchange ideas, and create work that matters.
        </p>
        <p>
          Our chapter is being shaped as an open space for learning: a place to
          try unfamiliar things, collaborate across interests, and grow through
          the craft of computing.
        </p>
      </div>
    </div>
    <div
      class="cassette-container cassette-right svg-container svg-right w-[500px] h-[500px] absolute right-0 top-1/2 -translate-y-1/2 mr-[-100px] md:h-[400px] md:w-[400px] lg:h-[500px] lg:w-[500px]"
    >
      <img
        src={getAssetUrl("/about/3.webp")}
        alt="Cassette 2"
        class="cassette-svg w-full h-auto origin-bottom-right rotate-[-15deg]"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <!-- About Section 3:-->
  <section
    id="mission"
    data-section="mission"
    class="about-section section-3 video-bg-section w-screen h-screen relative bg-center bg-cover bg-no-repeat"
  >
    <div
      class="cassette-container cassette-left cassette-left-two svg-container svg-left-two relative w-[500px] h-[500px] ml-[-50px] mb-[200px] md:h-[400px] md:w-[400px] lg:h-[500px] lg:w-[500px]"
    >
      <img
        src={getAssetUrl("/about/2.webp")}
        alt="Cassette 3"
        class="cassette-svg w-full h-auto origin-bottom-left rotate-[11deg]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div
      class="text-container text-right absolute top-1/2 -translate-y-1/2 text-white p-8 left-[45vw] w-[50vw] max-w-[800px]"
    >
      <div
        class="text-[1.4rem] leading-[1.55] max-w-[700px] flex flex-col gap-6"
      >
        <p>
          <span class="block mb-2 text-sm font-mono uppercase tracking-[0.28em] text-[#B8A7FF]">Our mission</span>
          To foster a deep passion for technology and innovation among our
          members, making space for curiosity, experimentation, and ideas that
          matter beyond the classroom.
        </p>
        <p>
          The Association for Computing Machinery (ACM) is the world’s largest
          educational and scientific computing society. Since its inception in
          1947, ACM has united educators, researchers, and professionals to
          advance computing as a science and a profession.
        </p>
        <p>
          It promotes the highest standards of technical excellence, fosters
          lifelong learning, and supports career development through a global
          network of conferences, publications, and professional communities.
          With a strong commitment to innovation and leadership, ACM continues
          to shape the future of computing worldwide.
        </p>
      </div>
    </div>
  </section>
</div>

<style>
  @media (max-height: 720px) {
    .about-container .text-container {
      padding: 1.25rem;
    }

    .about-container .text-container > div {
      font-size: 1.15rem;
      line-height: 1.45;
      gap: 1rem;
    }

    .about-container .cassette-container {
      width: 420px;
      height: 420px;
    }

    .about-container .section-1 .cassette-container {
      margin-left: -20px;
      margin-bottom: -420px;
    }

    .about-container .section-2 .cassette-container {
      margin-right: -60px;
    }

    .about-container .section-3 .cassette-container {
      margin-left: -20px;
      margin-bottom: 100px;
    }
  }

  @media (max-height: 600px) {
    .about-container .text-container {
      top: 56%;
      padding: 1rem;
    }

    .about-container .text-container > div {
      font-size: 1rem;
      line-height: 1.4;
      gap: 0.75rem;
    }

    .about-container .cassette-container {
      width: 360px;
      height: 360px;
    }

    .about-container .section-1 .cassette-container {
      margin-bottom: -320px;
    }

    .about-container .section-2 .cassette-container {
      top: 55%;
      margin-right: -40px;
    }

    .about-container .section-3 .cassette-container {
      margin-bottom: 40px;
    }
  }

  @media (min-width: 769px) and (max-width: 1099px) and (min-height: 601px) {
    #about-acm-ajce .text-container > div,
    #about-ajce .text-container > div,
    #mission .text-container > div {
      font-size: 1.12rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const lazySections = document.querySelectorAll(".js-lazy-bg");
    const loadBg = (section: Element) => {
      if (!(section instanceof HTMLElement)) return;
      const bg = section.dataset.bg;
      if (!bg) return;
      section.style.backgroundImage = `url(${bg})`;
      section.removeAttribute("data-bg");
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadBg(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "200px 0px", threshold: 0.01 },
      );
      lazySections.forEach((section) => observer.observe(section));
    } else {
      lazySections.forEach(loadBg);
    }

    const sections = document.querySelectorAll(".about-section");

    sections.forEach((section) => {
      const cassette = section.querySelector(".cassette-svg");
      const isLeft =
        section.querySelector(".cassette-left") ||
        section.querySelector(".cassette-left-two") ||
        section.querySelector(".svg-left") ||
        section.querySelector(".svg-left-two") ||
        section.querySelector(".webp-left") ||
        section.querySelector(".webp-left-two");
      const isRight =
        section.querySelector(".cassette-right") ||
        section.querySelector(".svg-right") ||
        section.querySelector(".webp-right");

      if (cassette && (isLeft || isRight)) {
        const xStart = isLeft ? -300 : 300;

        //tilt animation
        gsap.from(cassette, {
          x: xStart,
          rotation: 45, //45 degrees
          duration: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: section,
            start: "top 80%",
            end: "center center",
            scrub: 1,
            toggleActions: "play none none reverse",
          },
        });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>
