---
import BoardMemberCardSingular from "../components/BoardMemberCardSingular.astro";
import { reader } from "../utils/reader";
import { getAssetUrl } from "../utils/cdn";

const boardData = await reader.singletons.board.read();
const boardMembers = boardData?.items ?? [];

const facultyMembers = boardMembers.filter(
  (member) => member.position.toLowerCase().includes("faculty")
);

// 1. Executive Officers
const execPositions = [
  "chairperson",
  "chairman",
  "vice chair",
  "treasurer",
  "secretary",
  "chief operating officer",
  "webmaster",
];

const executiveLeaders = boardMembers.filter(
  (member) =>
    !member.position.toLowerCase().includes("faculty") &&
    !member.position.toLowerCase().includes("women") &&
    execPositions.some((p) => member.position.toLowerCase().includes(p))
);

// 2. Women's Chapter
const acmwLeaders = boardMembers.filter(
  (member) =>
    !member.position.toLowerCase().includes("faculty") &&
    (member.isW || member.position.toLowerCase().includes("women"))
);

// 3. Department Leads & Coordinators
const departmentLeads = boardMembers.filter(
  (member) =>
    !member.position.toLowerCase().includes("faculty") &&
    !member.position.toLowerCase().includes("women") &&
    !executiveLeaders.includes(member) &&
    (member.position.toLowerCase().includes("lead") ||
      member.position.toLowerCase().includes("coordinator")) &&
    !member.position.toLowerCase().includes("team")
);

// 4. Sub-teams (Marketing Team, Media Team Member, Design Team, Event Coordination Team, Content Writer)
const teamMembers = boardMembers.filter(
  (member) =>
    !member.position.toLowerCase().includes("faculty") &&
    !member.position.toLowerCase().includes("women") &&
    !executiveLeaders.includes(member) &&
    !departmentLeads.includes(member)
);
---

<section
  id="team"
  class="board-section w-full min-h-screen py-16 px-4 relative overflow-hidden"
>
  <div class="fixed inset-0 z-0 pointer-events-none opacity-0 board-bg-layer">
    <img
      src={getAssetUrl("/glow_ball_red.svg")}
      alt="Board Background"
      class="w-full h-full object-cover scale-125"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="max-w-7xl mx-auto flex flex-col relative z-10">
    <!-- Header Title -->
    <div class="flex justify-center mb-8">
      <img
        src={getAssetUrl("/the_team.webp")}
        alt="The Team"
        class="w-80 md:w-[30rem] lg:w-[48rem] h-auto team-heading-theme-filter"
        loading="lazy"
        decoding="async"
        data-board-preload
        data-preloader-ignore
      />
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex justify-center items-center gap-2.5 mb-12 flex-wrap" id="team-tabs">
      <button
        data-view="exec"
        class="team-pill-btn active text-xs sm:text-sm font-semibold tracking-wider px-5 py-2.5 rounded-full border transition-all duration-300"
      >
        EXECUTIVE OFFICERS
      </button>
      <button
        data-view="acmw"
        class="team-pill-btn text-xs sm:text-sm font-semibold tracking-wider px-5 py-2.5 rounded-full border transition-all duration-300"
      >
        WOMEN'S CHAPTER
      </button>
      <button
        data-view="leads"
        class="team-pill-btn text-xs sm:text-sm font-semibold tracking-wider px-5 py-2.5 rounded-full border transition-all duration-300"
      >
        DEPARTMENT LEADS
      </button>
      <button
        data-view="teams"
        class="team-pill-btn text-xs sm:text-sm font-semibold tracking-wider px-5 py-2.5 rounded-full border transition-all duration-300"
      >
        CORE SUB-TEAMS
      </button>
      <button
        data-view="faculty"
        class="team-pill-btn text-xs sm:text-sm font-semibold tracking-wider px-5 py-2.5 rounded-full border transition-all duration-300"
      >
        FACULTY IN-CHARGE
      </button>
      <button
        data-view="all"
        class="team-pill-btn text-xs sm:text-sm font-semibold tracking-wider px-5 py-2.5 rounded-full border transition-all duration-300"
      >
        ALL MEMBERS
      </button>
    </div>

    <!-- 1. Executive Officers Grid -->
    <div id="view-exec" class="team-view-section active w-full flex flex-col items-center">
      <div class="w-full lg:w-[75vw] flex flex-wrap justify-center gap-5 mb-8">
        {
          executiveLeaders.map((member) => (
            <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] transition-all duration-300 hover:scale-105 flex justify-center">
              <BoardMemberCardSingular
                title={member.title}
                fullName={member.fullName}
                position={member.position}
                imageUrl={getAssetUrl(member.imageUrl)}
                linkedinUrl={member.linkedinUrl}
                googleScholarUrl={member.googleScholarUrl}
                githubUrl={member.githubUrl}
                portfolioUrl={member.portfolioUrl}
                isW={member.isW}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 2. Women's Chapter Grid -->
    <div id="view-acmw" class="team-view-section hidden w-full flex flex-col items-center">
      <div class="w-full lg:w-[75vw] flex flex-wrap justify-center gap-5 mb-8">
        {
          acmwLeaders.map((member) => (
            <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] transition-all duration-300 hover:scale-105 flex justify-center">
              <BoardMemberCardSingular
                title={member.title}
                fullName={member.fullName}
                position={member.position}
                imageUrl={getAssetUrl(member.imageUrl)}
                linkedinUrl={member.linkedinUrl}
                googleScholarUrl={member.googleScholarUrl}
                githubUrl={member.githubUrl}
                portfolioUrl={member.portfolioUrl}
                isW={member.isW}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 3. Department Leads Grid -->
    <div id="view-leads" class="team-view-section hidden w-full flex flex-col items-center">
      <div class="w-full lg:w-[75vw] flex flex-wrap justify-center gap-5 mb-8">
        {
          departmentLeads.map((member) => (
            <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] transition-all duration-300 hover:scale-105 flex justify-center">
              <BoardMemberCardSingular
                title={member.title}
                fullName={member.fullName}
                position={member.position}
                imageUrl={getAssetUrl(member.imageUrl)}
                linkedinUrl={member.linkedinUrl}
                googleScholarUrl={member.googleScholarUrl}
                githubUrl={member.githubUrl}
                portfolioUrl={member.portfolioUrl}
                isW={member.isW}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 4. Core Sub-teams Grid -->
    <div id="view-teams" class="team-view-section hidden w-full flex flex-col items-center">
      <div class="w-full lg:w-[75vw] flex flex-wrap justify-center gap-5 mb-8">
        {
          teamMembers.map((member) => (
            <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] transition-all duration-300 hover:scale-105 flex justify-center">
              <BoardMemberCardSingular
                title={member.title}
                fullName={member.fullName}
                position={member.position}
                imageUrl={getAssetUrl(member.imageUrl)}
                linkedinUrl={member.linkedinUrl}
                googleScholarUrl={member.googleScholarUrl}
                githubUrl={member.githubUrl}
                portfolioUrl={member.portfolioUrl}
                isW={member.isW}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 5. Faculty In-Charge Grid -->
    <div id="view-faculty" class="team-view-section hidden w-full flex flex-col items-center">
      <div class="w-full lg:w-[75vw] flex flex-wrap justify-center gap-5 mb-8">
        {
          facultyMembers.map((member) => (
            <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] transition-all duration-300 hover:scale-105 flex justify-center">
              <BoardMemberCardSingular
                title={member.title}
                fullName={member.fullName}
                position={member.position}
                imageUrl={getAssetUrl(member.imageUrl)}
                linkedinUrl={member.linkedinUrl}
                googleScholarUrl={member.googleScholarUrl}
                githubUrl={member.githubUrl}
                portfolioUrl={member.portfolioUrl}
                isW={member.isW}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 5. All Members Grid -->
    <div id="view-all" class="team-view-section hidden w-full flex flex-col items-center">
      <div class="w-full lg:w-[75vw] flex flex-wrap justify-center gap-5 mb-8">
        {
          boardMembers.map((member) => (
            <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] transition-all duration-300 hover:scale-105 flex justify-center">
              <BoardMemberCardSingular
                title={member.title}
                fullName={member.fullName}
                position={member.position}
                imageUrl={getAssetUrl(member.imageUrl)}
                linkedinUrl={member.linkedinUrl}
                googleScholarUrl={member.googleScholarUrl}
                githubUrl={member.githubUrl}
                portfolioUrl={member.portfolioUrl}
                isW={member.isW}
              />
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>

<style>
  .team-heading-theme-filter {
    filter: hue-rotate(245deg) saturate(1.4) brightness(1.2);
  }

  .team-pill-btn {
    background: rgba(106, 90, 205, 0.12);
    border-color: rgba(184, 167, 255, 0.22);
    color: rgba(255, 255, 255, 0.7);
  }
  .team-pill-btn:hover {
    border-color: rgba(184, 167, 255, 0.55);
    color: #ffffff;
  }
  .team-pill-btn.active {
    background: linear-gradient(135deg, rgba(106, 90, 205, 0.5), rgba(184, 167, 255, 0.25));
    border-color: #B8A7FF;
    color: #ffffff;
    box-shadow: 0 0 20px rgba(184, 167, 255, 0.35);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  if (typeof gsap !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);

    const initBoardAnimation = () => {
      const bgLayer = document.querySelector(".board-bg-layer");
      const section = document.querySelector(".board-section");

      if (!bgLayer || !section) return;

      ScrollTrigger.create({
        trigger: section,
        start: "top 30%",
        end: "bottom 60%",
        onEnter: () => gsap.to(bgLayer, { opacity: 1, duration: 0.5 }),
        onLeave: () => gsap.to(bgLayer, { opacity: 0, duration: 0.5 }),
        onEnterBack: () => gsap.to(bgLayer, { opacity: 1, duration: 0.5 }),
        onLeaveBack: () => gsap.to(bgLayer, { opacity: 0, duration: 0.5 }),
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initBoardAnimation);
    } else {
      initBoardAnimation();
    }
  }

  // --- Category Tab Switcher ---
  const setupTeamTabSwitching = () => {
    const tabBtns = document.querySelectorAll(".team-pill-btn");
    const viewSections = document.querySelectorAll(".team-view-section");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetView = btn.getAttribute("data-view");

        tabBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        viewSections.forEach((sec) => {
          if (sec.id === `view-${targetView}`) {
            sec.classList.remove("hidden");
            sec.classList.add("active");
          } else {
            sec.classList.add("hidden");
            sec.classList.remove("active");
          }
        });
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTeamTabSwitching);
  } else {
    setupTeamTabSwitching();
  }
</script>
