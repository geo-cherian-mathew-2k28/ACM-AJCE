---
interface Props {
  title: string;
  index?: number;
}

const { title, index = 0 } = Astro.props;
---

<article
  class="partner-laptop"
  data-partner-laptop
  style={`--partner-delay: ${index * 90}ms`}
  aria-label={`${title} partner`}
>
  <div class="partner-laptop__device" aria-hidden="true">
    <div class="partner-laptop__screen-shell">
      <div class="partner-laptop__screen">
        <div class="partner-laptop__grid"></div>
        <div class="partner-laptop__screen-glow"></div>
      </div>
    </div>
    <div class="partner-laptop__base">
      <div class="partner-laptop__keyboard"></div>
      <div class="partner-laptop__trackpad"></div>
    </div>
  </div>
  <p class="partner-laptop__label">{title}</p>
</article>

<style>
  .partner-laptop {
    position: relative;
    width: min(74vw, 19rem);
    color: #FBFAFF;
    text-align: center;
  }

  .partner-laptop__device {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    perspective: 850px;
  }

  .partner-laptop__screen-shell {
    position: absolute;
    z-index: 1;
    bottom: 12%;
    left: 5%;
    width: 90%;
    aspect-ratio: 16 / 10;
    transform: rotateX(-82deg) translateY(8%);
    transform-origin: 50% 100%;
    opacity: 0.54;
    filter: brightness(0.62);
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1) var(--partner-delay),
      opacity 360ms ease var(--partner-delay),
      filter 540ms ease var(--partner-delay);
    will-change: transform, opacity;
  }

  .partner-laptop.is-open .partner-laptop__screen-shell {
    transform: rotateX(0deg) translateY(0);
    opacity: 1;
    filter: brightness(1);
  }

  .partner-laptop__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 2px solid rgba(184, 167, 255, 0.68);
    border-radius: 7px 7px 3px 3px;
    background-color: #0C0D18;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.34);
  }

  .partner-laptop__grid {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background-image:
      linear-gradient(rgba(184, 167, 255, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(184, 167, 255, 0.18) 1px, transparent 1px);
    background-size: 15px 15px;
  }

  .partner-laptop__screen-glow {
    position: relative;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 50% 100%,
      rgba(106, 90, 205, 0.34),
      transparent 62%
    );
  }

  .partner-laptop__base {
    position: relative;
    z-index: 2;
    top: 78%;
    width: 100%;
    height: 18%;
    overflow: hidden;
    border: 1px solid rgba(184, 167, 255, 0.58);
    border-radius: 4px 4px 10px 10px;
    background-color: #242043;
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.32);
    clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
  }

  .partner-laptop__keyboard {
    position: absolute;
    top: 16%;
    left: 16%;
    width: 68%;
    height: 36%;
    opacity: 0.46;
    background-image:
      linear-gradient(rgba(251, 250, 255, 0.42) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251, 250, 255, 0.42) 1px, transparent 1px);
    background-size: 8px 6px;
  }

  .partner-laptop__trackpad {
    position: absolute;
    bottom: 12%;
    left: 50%;
    width: 20%;
    height: 22%;
    border: 1px solid rgba(251, 250, 255, 0.18);
    border-radius: 2px 2px 5px 5px;
    transform: translateX(-50%);
  }

  .partner-laptop__label {
    margin: 0.85rem 0 0;
    color: #FBFAFF;
    font-family: "PolySans Bold", "PolySans Trial", sans-serif;
    font-size: clamp(0.85rem, 1.25vw, 1.1rem);
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: normal;
    text-wrap: nowrap;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .partner-laptop {
      width: min(30vw, 17rem);
    }
  }

  @media (min-width: 1024px) {
    .partner-laptop {
      width: min(16vw, 15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-laptop__screen-shell {
      transform: rotateX(0deg) translateY(0);
      opacity: 1;
      filter: brightness(1);
      transition: none;
    }
  }
</style>
