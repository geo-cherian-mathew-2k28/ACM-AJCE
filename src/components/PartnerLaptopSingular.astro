---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article
  class="partner-laptop"
  data-partner-laptop
  aria-label={`${title} partner`}
>
  <div class="partner-laptop__device" aria-hidden="true">
    <div class="partner-laptop__screen-shell">
      <div class="partner-laptop__screen">
        <div class="partner-laptop__grid"></div>
        <div class="partner-laptop__screen-glow"></div>
        <div class="partner-laptop__screen-content">
          <div class="partner-laptop__logo-slot">
            <span class="partner-laptop__logo-mark"></span>
          </div>
          <p class="partner-laptop__screen-name">{title}</p>
          <span class="partner-laptop__screen-rule"></span>
        </div>
      </div>
    </div>
    <div class="partner-laptop__base">
      <div class="partner-laptop__keyboard"></div>
      <div class="partner-laptop__trackpad"></div>
    </div>
  </div>
</article>

<style>
  .partner-laptop {
    position: relative;
    width: min(74vw, 19rem);
    color: #FBFAFF;
    text-align: center;
  }

  .partner-laptop__device {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    perspective: 850px;
  }

  .partner-laptop__screen-shell {
    --partner-screen-tilt: -86deg;
    --partner-screen-shift: 12%;
    --partner-screen-opacity: 0.56;
    --partner-screen-brightness: 0.58;
    position: absolute;
    z-index: 1;
    bottom: 12%;
    left: 5%;
    width: 90%;
    aspect-ratio: 16 / 10;
    transform: rotateX(var(--partner-screen-tilt))
      translateY(var(--partner-screen-shift));
    transform-origin: 50% 100%;
    opacity: var(--partner-screen-opacity);
    filter: brightness(var(--partner-screen-brightness));
    will-change: transform, opacity, filter;
  }

  .partner-laptop__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 2px solid rgba(184, 167, 255, 0.68);
    border-radius: 7px 7px 3px 3px;
    background-color: #0C0D18;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.34);
  }

  .partner-laptop__grid {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background-image:
      linear-gradient(rgba(184, 167, 255, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(184, 167, 255, 0.18) 1px, transparent 1px);
    background-size: 15px 15px;
  }

  .partner-laptop__screen-glow {
    position: relative;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 50% 100%,
      rgba(106, 90, 205, 0.34),
      transparent 62%
    );
  }

  .partner-laptop__screen-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.85rem;
  }

  .partner-laptop__logo-slot {
    display: grid;
    width: clamp(1.7rem, 22%, 3.1rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px dashed rgba(251, 250, 255, 0.62);
    border-radius: 5px;
    background-color: rgba(106, 90, 205, 0.12);
  }

  .partner-laptop__logo-mark {
    width: 34%;
    aspect-ratio: 1;
    border: 1px solid rgba(184, 167, 255, 0.92);
    transform: rotate(45deg);
  }

  .partner-laptop__screen-name {
    max-width: 100%;
    margin: 0;
    color: #FBFAFF;
    font-family: "PolySans Bold", "PolySans Trial", sans-serif;
    font-size: clamp(0.68rem, 1.15vw, 1.05rem);
    font-weight: 700;
    line-height: 1.1;
    overflow-wrap: normal;
    text-align: center;
    text-wrap: nowrap;
    white-space: nowrap;
  }

  .partner-laptop__screen-rule {
    width: 30%;
    height: 1px;
    background-color: rgba(184, 167, 255, 0.72);
  }

  .partner-laptop__base {
    position: relative;
    z-index: 2;
    top: 78%;
    width: 100%;
    height: 18%;
    overflow: hidden;
    border: 1px solid rgba(184, 167, 255, 0.58);
    border-radius: 4px 4px 10px 10px;
    background-color: #242043;
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.32);
    clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
  }

  .partner-laptop__keyboard {
    position: absolute;
    top: 16%;
    left: 16%;
    width: 68%;
    height: 36%;
    opacity: 0.46;
    background-image:
      linear-gradient(rgba(251, 250, 255, 0.42) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251, 250, 255, 0.42) 1px, transparent 1px);
    background-size: 8px 6px;
  }

  .partner-laptop__trackpad {
    position: absolute;
    bottom: 12%;
    left: 50%;
    width: 20%;
    height: 22%;
    border: 1px solid rgba(251, 250, 255, 0.18);
    border-radius: 2px 2px 5px 5px;
    transform: translateX(-50%);
  }

  @media (min-width: 640px) {
    .partner-laptop {
      width: min(30vw, 17rem);
    }
  }

  @media (min-width: 1024px) {
    .partner-laptop {
      width: min(16vw, 15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-laptop__screen-shell {
      --partner-screen-tilt: 0deg;
      --partner-screen-shift: 0%;
      --partner-screen-opacity: 1;
      --partner-screen-brightness: 1;
    }
  }
</style>
