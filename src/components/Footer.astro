            src={footerBackgroundSrc}
            alt="Starry mountain footer background"
            class="footer-star-background"
            loading="lazy"
            decoding="async"
          />
          <div class="footer-star-motion" aria-hidden="true">
            <canvas class="footer-star-canvas" data-footer-star-canvas></canvas>
          </div>
