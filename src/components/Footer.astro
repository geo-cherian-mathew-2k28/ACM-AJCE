---
// Footer.astro
import { getAssetUrl } from "../utils/cdn";

const footerBackgroundSrc = getAssetUrl("/footer/acm-ajce-footer.png");
const ajceWebsite = "https://www.ajce.in/";
const ajceDirections =
  "https://www.google.com/maps/dir/?api=1&destination=Amal+Jyothi+College+of+Engineering%2C+Kanjirappally";
const creatorLinkedIn = "https://in.linkedin.com/in/geo-cherian-mathew";
const creatorPortfolio = "https://github.com/geo-cherian-mathew-2k28";
---

<div data-variant-host>
  <template data-variant="desktop">
    <footer
      id="footer"
      class="relative w-full overflow-hidden m-0 p-0 flex flex-col"
    >
      <div
        class="hidden md:block w-full max-w-[1438px] h-0 outline outline-1 outline-offset-[-0.50px] outline-white mx-auto"
      >
      </div>

      <div class="relative z-10 hidden md:flex flex-col min-h-[50vh] pb-8">
        <div
          class="flex-grow flex flex-col lg:flex-row items-start gap-10 lg:gap-0 justify-between px-6 lg:px-16 pt-6"
        >
          <div class="flex-shrink-0 w-full lg:w-auto mr-8">
            <div
              class="text-yellow-50 text-xl font-bold font-['PolySans_Trial'] leading-tight"
              style="font-family: 'PolySans Bold', 'PolySans Trial', sans-serif;"
            >
              association for<br />computing machinery
            </div>
            <div
              class="w-fit my-4 relative flex items-center border border-zinc-100 rounded-full px-6 py-1.5 pr-8"
            >
              <!-- glowign dot -->
              <div
                class="w-3 h-3 bg-green-500 rounded-full shadow-[0_0_8px_2px_rgba(34,197,94,0.6)]
            animate-[pulse_1.5s_ease-in-out_infinite]"
              >
              </div>

              <div
                class="ml-3 text-zinc-100 text-[13px] font-thin font-['PolySans_Trial'] whitespace-nowrap"
              >
                All systems online
              </div>
            </div>

            <a
              href={ajceDirections}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-location-laptop"
              aria-label="Get directions to Amal Jyothi College of Engineering in Google Maps"
            >
              <div class="footer-location-laptop__screen">
                <div class="footer-location-map" aria-hidden="true">
                  <span class="footer-location-map__road footer-location-map__road--main"></span>
                  <span class="footer-location-map__road footer-location-map__road--cross"></span>
                  <span class="footer-location-map__block footer-location-map__block--one"></span>
                  <span class="footer-location-map__block footer-location-map__block--two"></span>
                  <span class="footer-location-map__block footer-location-map__block--three"></span>
                  <span class="footer-location-map__pin">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                  </span>
                </div>
              </div>
              <div class="footer-location-laptop__base" aria-hidden="true"></div>
            </a>
            <a
              href={ajceWebsite}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-location-link"
            >
              <span>AJCE campus</span>
              <span>Kanjirappally, Kerala</span>
            </a>
          </div>

          <!-- Navigation Sections -->
          <div
            class="flex w-full lg:w-auto justify-start items-start gap-6 lg:gap-8 flex-wrap"
          >
            <!-- About Section -->
            <div
              class="w-24 inline-flex flex-col justify-start items-start gap-4"
            >
              <div
                class="footer-section-title text-yellow-50 text-base font-light font-['PolySans_Trial'] uppercase"
              >
                About
              </div>
              <div
                class="self-stretch flex flex-col justify-start items-start gap-2"
              >
                <a
                  href="#about"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  Our chapter
                </a>
                <a
                  href={ajceWebsite}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  AJCE website
                </a>
                <a
                  href="https://www.acm.org"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  ACM
                </a>
              </div>
            </div>

            <!-- Explore Section -->
            <div
              class="w-44 inline-flex flex-col justify-start items-start gap-4"
            >
              <div
                class="footer-section-title text-yellow-50 text-base font-light font-['PolySans_Trial'] uppercase"
              >
                Explore
              </div>
              <div
                class="self-stretch flex flex-col justify-start items-start gap-2"
              >
                <a
                  href="#events"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  events
                </a>
                <a
                  href="#gallery"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  gallery
                </a>
                <a
                  href="#acm-w"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  ACM-W
                </a>
                <a
                  href="#team"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  team
                </a>
              </div>
            </div>

            <!-- Events Section -->
            <div
              class="w-36 inline-flex flex-col justify-start items-start gap-4"
            >
              <div
                class="footer-section-title text-yellow-50 text-base font-light font-['PolySans_Trial'] uppercase"
              >
                Events
              </div>
              <div
                class="self-stretch flex flex-col justify-start items-start gap-2"
              >
                <a
                  href="#events"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  UXPLORE
                </a>
                <a
                  href="#events"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  ASTERISK
                </a>
                <a
                  href="#events"
                  class="self-stretch text-[#B8A7FF] text-base font-light font-['PolySans_Trial'] uppercase hover:text-violet-300 transition-colors"
                >
                  MORE
                </a>
              </div>
            </div>

            <!-- ACM-W Section -->
            <div
              class="w-24 inline-flex flex-col justify-start items-start gap-4"
            >
              <div
                class="footer-section-title text-yellow-50 text-base font-light font-['PolySans_Trial'] uppercase"
              >
                ACM-W
              </div>
              <div
                class="self-stretch flex flex-col justify-start items-start gap-2"
              >
                <a
                  href="#acm-w"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  about
                </a>
                <a
                  href="#acm-w"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  events
                </a>
              </div>
            </div>

            <!-- More Section -->
            <div
              class="w-24 inline-flex flex-col justify-start items-start gap-4"
            >
              <div
                class="footer-section-title text-[#B8A7FF] text-base font-light font-['PolySans_Trial'] uppercase"
              >
                More
              </div>
              <div
                class="self-stretch flex flex-col justify-start items-start gap-2"
              >
                <a
                  href="#team"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  team
                </a>
                <a
                  href="#partners"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  partners
                </a>
                <a
                  href="#gallery"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  gallery
                </a>
                <a
                  href="#contact"
                  class="self-stretch text-white text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >
                  contact us
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="hidden md:flex w-full flex-col items-center justify-center relative"
      >
        <div
          class="flex flex-col items-center justify-center mb-4 z-30 relative"
        >
          <p
            class="text-neutral-400 text-lg lg:text-xl text-white mb-10 lg:mb-12"
          >
            © 2026&nbsp;ACM AJCE. All rights reserved.
          </p>
          <!-- Social Icons -->
          <div class="footer-social-links footer-social-links-desktop">
            <a href={ajceWebsite} aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3.3" y="3.3" width="17.4" height="17.4" rx="5"></rect><circle cx="12" cy="12" r="4.15"></circle><circle cx="17.4" cy="6.65" r="1" fill="currentColor" stroke="none"></circle></svg>
            </a>
            <a href={ajceWebsite} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.34 7.43A2.06 2.06 0 1 0 5.34 3.3a2.06 2.06 0 0 0 0 4.13ZM3.56 8.99h3.56v11.46H3.56V8.99Zm5.78 0h3.41v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99Z" /></svg>
            </a>
            <a href={ajceWebsite} aria-label="WhatsApp" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12.04 2A9.84 9.84 0 0 0 3.7 17.08L2 22l5.07-1.66A9.96 9.96 0 1 0 12.04 2Zm0 18.12a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.01.98 1-2.94-.2-.31a8.17 8.17 0 1 1 6.64 3.58Zm4.48-6.08c-.25-.12-1.47-.73-1.7-.81-.23-.08-.4-.12-.57.12-.17.25-.65.81-.8.98-.15.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.24-.74-.66-1.24-1.48-1.39-1.73-.15-.25-.02-.39.11-.51l.38-.45c.12-.14.15-.25.23-.42.08-.16.04-.31-.02-.43-.06-.12-.57-1.37-.77-1.88-.2-.48-.4-.42-.57-.42h-.49c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.04s.88 2.37 1 2.54c.12.16 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.51.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.22-.17-.47-.29Z" /></svg>
            </a>
            <a href={ajceWebsite} aria-label="AJCE website" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
            </a>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div class="flex items-center gap-2">
              <img
                src={getAssetUrl("/footer/pixel-heart.webp")}
                alt="pixel heart"
                class="w-5 h-5 lg:w-6 lg:h-6"
                loading="lazy"
                decoding="async"
              />
              <span
                class="text-neutral-400 text-sm lg:text-base text-white font-['PolySans_Trial']"
                >crafted with love by Geo Cherian Mathew</span
              >
            </div>
            <div class="footer-creator-links">
              <a href={creatorLinkedIn} aria-label="Geo Cherian Mathew on LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer" class="footer-creator-link">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.34 7.43A2.06 2.06 0 1 0 5.34 3.3a2.06 2.06 0 0 0 0 4.13ZM3.56 8.99h3.56v11.46H3.56V8.99Zm5.78 0h3.41v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99Z" /></svg>
              </a>
              <a href={creatorPortfolio} aria-label="Geo Cherian Mathew portfolio" title="Portfolio" target="_blank" rel="noopener noreferrer" class="footer-creator-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="7" width="19" height="13" rx="2"></rect><path d="M8 7V4.5h8V7M2.5 12h19M10 12v2h4v-2"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      <!-- Footer Star Field -->
      <div
        class="footer-star-art hidden md:flex w-full justify-center items-end mt-auto pointer-events-none"
      >
        <div class="footer-star-fade" aria-hidden="true"></div>
        <div class="footer-star-scene">
          <img
            src={footerBackgroundSrc}
            alt="Starry mountain footer background"
            class="footer-star-background"
            loading="lazy"
            decoding="async"
          />
          <div class="footer-star-motion" aria-hidden="true">
            <canvas class="footer-star-canvas" data-footer-star-canvas></canvas>
          </div>
        </div>
      </div>
    </footer>
  </template>

  <template data-variant="mobile">
    <!-- Phone Screen Version -->
    <footer
      id="footer"
      class="relative w-full h-auto overflow-hidden min-h-[100svh] pb-0 flex flex-col"
    >
      <!-- Divider line -->
      <div
        class="w-full h-0 outline outline-1 outline-offset-[-0.5px] outline-white mx-auto"
      >
      </div>

      <!-- Content -->
      <div class="relative z-10 flex flex-col px-4 sm:px-8 md:px-10 pt-4 gap-6">
        <!-- Title -->
        <div
          class="text-yellow-50 text-base sm:text-lg md:text-xl font-bold leading-tight text-center font-['PolySans_Trial'] mb-2"
        >
          association for computing machinery
        </div>

        <!-- Navigation Sections (mobile grid) -->
        <div
          class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 md:gap-8 relative z-20"
        >
          <!-- About Section -->
          <div
            class="w-full inline-flex flex-col justify-start items-start gap-2 sm:gap-3"
          >
            <div
              class="text-yellow-50 text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase"
            >
              About
            </div>
            <div class="flex flex-col justify-start items-start gap-1">
              <a
                href="#about"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >Our chapter</a
              >
              <a
                href={ajceWebsite}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >AJCE website</a
              >
              <a
                href="https://www.acm.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >ACM</a
              >
            </div>
          </div>

          <!-- Explore Section -->
          <div
            class="w-full inline-flex flex-col justify-start items-start gap-2 sm:gap-3"
          >
            <div
              class="text-yellow-50 text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase"
            >
              Explore
            </div>
            <div class="flex flex-col justify-start items-start gap-1">
              <a
                href="#events"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >events</a
              >
              <a
                href="#gallery"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >gallery</a
              >
              <a
                href="#acm-w"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >ACM-W</a
              >
              <a
                href="#team"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >team</a
              >
            </div>
          </div>

          <!-- Events Section -->
          <div
            class="w-full inline-flex flex-col justify-start items-start gap-2 sm:gap-3"
          >
            <div
              class="text-yellow-50 text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase"
            >
              Events
            </div>
            <div class="flex flex-col justify-start items-start gap-1">
              <a
                href="#events"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >UXPLORE</a
              >
              <a
                href="#events"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >ASTERISK</a
              >
              <a
                href="#events"
                class="text-[#B8A7FF] text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-violet-300 transition-colors"
                >MORE</a
              >
            </div>
          </div>

          <!-- ACM-W Section -->
          <div
            class="w-full inline-flex flex-col justify-start items-start gap-2 sm:gap-3"
          >
            <div
              class="text-yellow-50 text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase"
            >
              ACM-W
            </div>
            <div class="flex flex-col justify-start items-start gap-1">
              <a
                href="#acm-w"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >about</a
              >
              <a
                href="#acm-w"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >events</a
              >
            </div>
          </div>

          <!-- More Section -->
          <div
            class="w-full inline-flex flex-col justify-start items-start gap-2 sm:gap-3"
          >
            <div
              class="text-[#B8A7FF] text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase"
            >
              More
            </div>
            <div class="flex flex-col justify-start items-start gap-1">
              <a
                href="#team"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >team</a
              >
              <a
                href="#partners"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >partners</a
              >
              <a
                href="#gallery"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >gallery</a
              >
              <a
                href="#contact"
                class="text-white text-xs sm:text-sm md:text-base font-light font-['PolySans_Trial'] uppercase hover:text-yellow-50 transition-colors"
                >contact us</a
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Section (mobile) -->
      <div
        class="w-full flex flex-col items-center justify-center relative px-4 pt-4"
      >
        <div
          class="flex flex-col items-center justify-center mb-4 z-30 relative"
        >
          <p
            class="text-white text-xs sm:text-sm md:text-base mb-4 text-center"
          >
            © 2026&nbsp;ACM AJCE. All rights reserved.
          </p>
          <!-- Social Icons -->
          <div class="footer-social-links footer-social-links-mobile">
            <a href={ajceWebsite} aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3.3" y="3.3" width="17.4" height="17.4" rx="5"></rect><circle cx="12" cy="12" r="4.15"></circle><circle cx="17.4" cy="6.65" r="1" fill="currentColor" stroke="none"></circle></svg>
            </a>
            <a href={ajceWebsite} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer" class="footer-social-link">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.34 7.43A2.06 2.06 0 1 0 5.34 3.3a2.06 2.06 0 0 0 0 4.13ZM3.56 8.99h3.56v11.46H3.56V8.99Zm5.78 0h3.41v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99Z" /></svg>
