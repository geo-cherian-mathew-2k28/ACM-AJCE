                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.34 7.43A2.06 2.06 0 1 0 5.34 3.3a2.06 2.06 0 0 0 0 4.13ZM3.56 8.99h3.56v11.46H3.56V8.99Zm5.78 0h3.41v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99Z" /></svg>
