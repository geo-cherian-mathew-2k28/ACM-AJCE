---
interface Props {
  title?: string;
  fullName: string;
  position: string;
  imageUrl: string;
  linkedinUrl?: string;
  googleScholarUrl?: string;
  githubUrl?: string;
  portfolioUrl?: string;
  isW?: boolean;
  preloadImage?: boolean;
}

const {
  title,
  fullName,
  position,
  imageUrl,
  linkedinUrl,
  googleScholarUrl,
  githubUrl,
  portfolioUrl,
  isW = false,
  preloadImage = false,
} = Astro.props;

import { getAssetUrl } from "../utils/cdn";

const displayName = `${title?.trim() ? `${title.trim()} ` : ""}${fullName.trim()}`;
const isFaculty = position.toLowerCase().includes("faculty");
---

<div
  class={`board-member-card relative w-full aspect-[1.6] rounded-xl overflow-hidden flex items-end justify-center shadow-lg border ${
    isW
      ? "bg-gradient-to-br from-[#FFF5F8] to-[#FCE7F0] border-pink-300/60 shadow-pink-900/10"
      : "bg-white border-purple-100/30"
  }`}
  data-faculty={isFaculty}
  data-is-w={isW}
>
  <!-- Background Noise Texture -->
  <div
    class="absolute inset-0 pointer-events-none opacity-40 z-0"
    style={`background-image: url('${getAssetUrl("/noise.webp")}'); background-size: cover;`}
  >
  </div>

  <!-- Subtle Bottom Brand Accent Line (Gold for Faculty, Pink for ACM-W, Purple for main chapter) -->
  <div
    class={`absolute bottom-0 inset-x-0 h-1 z-20 ${
      isFaculty
        ? "bg-gradient-to-r from-[#D97706] to-[#F59E0B]"
        : isW
        ? "bg-gradient-to-r from-[#EC4899] to-[#F472B6]"
        : "bg-gradient-to-r from-[#6A5ACD] to-[#B8A7FF]"
    }`}
  >
  </div>

  <!-- Member Info Layout -->
  <div class="flex items-center w-full h-full text-center z-10">
    <!-- Left: Photo Container -->
    <div class="h-full w-2/5 flex items-end overflow-hidden relative">
      <img
        src={imageUrl}
        alt={fullName}
        class={`h-full w-full object-cover object-top filter grayscale contrast-105 ${
          isFaculty
            ? "brightness-95"
            : isW
            ? "brightness-95 sepia-[0.15] hue-rotate-[290deg]"
            : "brightness-95"
        }`}
        loading="lazy"
        decoding="async"
        data-board-preload={preloadImage}
        data-preloader-ignore={preloadImage}
      />
    </div>

    <!-- Right: Name, Role & Social Links -->
    <div
      class="board-card-copy w-3/5 min-w-0 z-20 text-left flex flex-col justify-center gap-2 pl-5 pr-4 sm:pl-6"
    >
      <div>
        <h3
          style="font-family: 'PolySans Bold';"
          class={`board-card-name m-0 ${
            isW ? "text-pink-950" : "text-gray-900"
          }`}
        >
          {displayName}
        </h3>
        <p
          style="font-family: PolySans Slim;"
          class={`board-card-role m-0 mt-0.5 font-semibold ${
            isFaculty ? "text-[#D97706]" : isW ? "text-[#DB2777]" : "text-[#7C3AED]"
          }`}
        >
          {position}
        </p>
      </div>

      <!-- Social Links -->
      <div class="board-card-social flex items-center gap-3 mt-1">
        {
          linkedinUrl && (
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:cursor-pointer transition-transform hover:scale-110"
            >
              <img
                src={getAssetUrl("/linkedin-orange.svg")}
                alt="LinkedIn"
                class={`board-card-icon ${
                  isFaculty
                    ? "filter hue-rotate-[20deg] saturate-150"
                    : isW
                    ? "filter hue-rotate-[290deg] saturate-150"
                    : ""
                }`}
                loading="lazy"
                decoding="async"
              />
            </a>
          )
        }

        {
          googleScholarUrl && (
            <a
              href={googleScholarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:cursor-pointer transition-transform hover:scale-110"
            >
              <img
                src={getAssetUrl("/google-scholar-orange.svg")}
                alt="Google Scholar"
                class={`board-card-icon ${
                  isFaculty
                    ? "filter hue-rotate-[20deg] saturate-150"
                    : isW
                    ? "filter hue-rotate-[290deg] saturate-150"
                    : ""
                }`}
                loading="lazy"
                decoding="async"
              />
            </a>
          )
        }

        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:cursor-pointer transition-transform hover:scale-110"
            >
              <img
                src={getAssetUrl("/github-orange.svg")}
                alt="GitHub"
                class={`board-card-icon ${
                  isFaculty
                    ? "filter hue-rotate-[20deg] saturate-150"
                    : isW
                    ? "filter hue-rotate-[290deg] saturate-150"
                    : ""
                }`}
                loading="lazy"
                decoding="async"
              />
            </a>
          )
        }

        {
          portfolioUrl && (
            <a
              href={portfolioUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:cursor-pointer transition-transform hover:scale-110 flex items-center justify-center"
              title="Portfolio Website"
            >
              <svg 
                class={`w-5 h-5 ${
                  isFaculty
                    ? "text-[#D97706]"
                    : isW
                    ? "text-[#EC4899]"
                    : "text-[#8B5CF6]"
                }`} 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m-9 9a9 9 0 019-9"></path>
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .board-card-name {
    display: block;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-size: clamp(0.85rem, 3vw, 1.2rem);
    line-height: 1.12;
  }

  .board-card-role {
    display: block;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-size: clamp(0.72rem, 2.25vw, 0.98rem);
    line-height: 1.16;
  }

  .board-card-icon {
    width: clamp(1.1rem, 4.8vw, 1.75rem);
    height: clamp(1.1rem, 4.8vw, 1.75rem);
    object-fit: contain;
  }

  .board-member-card[data-faculty="true"] .board-card-copy {
    padding-left: clamp(0.85rem, 3vw, 1.25rem);
    padding-right: clamp(0.85rem, 3vw, 1.25rem);
  }

  .board-member-card[data-faculty="true"] .board-card-name {
    font-size: clamp(0.8rem, 2.6vw, 1.05rem);
    line-height: 1.08;
  }

  .board-member-card[data-faculty="true"] .board-card-role {
    font-size: clamp(0.68rem, 2.2vw, 0.9rem);
  }

  .board-member-card[data-faculty="true"] .board-card-social {
    gap: clamp(0.4rem, 1.8vw, 0.75rem);
    margin-top: clamp(0.2rem, 1vw, 0.5rem);
  }
</style>
