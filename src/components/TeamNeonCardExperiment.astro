---
import { getAssetUrl } from "../utils/cdn";

interface Member {
  fullName: string;
  position: string;
  imageUrl: string;
}

interface Props {
  members: Member[];
}

const { members } = Astro.props;

const accents = [
  { color: "#19DDB2", offset: "16px" },
  { color: "#16BDF3", offset: "4px" },
  { color: "#FF3D88", offset: "0px" },
  { color: "#F2C94C", offset: "8px" },
  { color: "#FF21C8", offset: "18px" },
];

const cutoutPortraits = [
  undefined,
  "/board/team-neon/rohit-sakamuri.png",
  "/board/team-neon/drashti-shukla.png",
  "/board/team-neon/shaurya-garg.png",
  undefined,
];
---

<div class="team-neon-experiment" aria-label="Team card design preview">
  {
    members.map((member, index) => {
      const accent = accents[index % accents.length];
      const cutoutPortrait = cutoutPortraits[index];
      return (
        <article
          class:list={[
            "team-neon-card",
            { "team-neon-card--cutout": Boolean(cutoutPortrait) },
          ]}
          style={`--neon: ${accent.color}; --card-offset: ${accent.offset};`}
        >
          <img
            class="team-neon-card__portrait"
            src={getAssetUrl(cutoutPortrait ?? member.imageUrl)}
            alt={member.fullName}
            loading="lazy"
            decoding="async"
          />
          <div class="team-neon-card__wash" aria-hidden="true"></div>
          <div class="team-neon-card__meta">
            <span class="team-neon-card__status" aria-hidden="true"></span>
            <span>ACM AJCE</span>
          </div>
          <div class="team-neon-card__copy">
            <h3>{member.fullName}</h3>
            <p>{member.position}</p>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .team-neon-experiment {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: end;
    width: min(calc(100% - 2rem), 50rem);
    margin: clamp(2.5rem, 7vw, 5.5rem) auto clamp(3rem, 7vw, 5rem);
    padding: 0 clamp(0.25rem, 1.5vw, 1rem) clamp(1.4rem, 3vw, 2.5rem);
    gap: clamp(0.6rem, 1.7vw, 1.35rem);
  }

  .team-neon-card {
    position: relative;
    min-width: 0;
    aspect-ratio: 0.64;
    overflow: hidden;
    border: 2px solid var(--neon);
    border-radius: 0.62rem;
    background: #090B12;
    box-shadow:
      0 0 0 1px rgba(5, 6, 11, 0.9) inset,
      0 0 0.7rem color-mix(in srgb, var(--neon) 72%, transparent),
      0 0 1.6rem color-mix(in srgb, var(--neon) 22%, transparent);
    transform: translateY(var(--card-offset));
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .team-neon-card:hover {
    box-shadow:
      0 0 0 1px rgba(5, 6, 11, 0.9) inset,
      0 0 1rem color-mix(in srgb, var(--neon) 88%, transparent),
      0 0 2.1rem color-mix(in srgb, var(--neon) 30%, transparent);
    transform: translateY(calc(var(--card-offset) - 0.35rem));
  }

  .team-neon-card__portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.82) contrast(1.08);
  }

  .team-neon-card--cutout {
    background:
      radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--neon) 30%, transparent), transparent 58%),
      #090B12;
  }

  .team-neon-card--cutout .team-neon-card__portrait {
    object-fit: contain;
    object-position: center bottom;
    padding: 0.65rem 0.4rem 1.65rem;
    filter: grayscale(1) contrast(1.14) brightness(1.08);
  }

  .team-neon-card__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--neon) 26%, transparent) 0%, transparent 42%),
      linear-gradient(0deg, rgba(5, 6, 11, 0.96) 0%, rgba(5, 6, 11, 0.5) 38%, transparent 70%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .team-neon-card__meta {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.26rem;
    color: #FBFAFF;
    font-family: "PolySans Bold", sans-serif;
    font-size: clamp(0.4rem, 0.7vw, 0.56rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .team-neon-card__status {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--neon);
    box-shadow: 0 0 0.45rem var(--neon);
  }

  .team-neon-card__copy {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    left: 0.65rem;
    color: #FBFAFF;
  }

  .team-neon-card__copy h3,
  .team-neon-card__copy p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .team-neon-card__copy h3 {
    font-family: "PolySans Bold", sans-serif;
    font-size: clamp(0.62rem, 1.15vw, 0.86rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .team-neon-card__copy p {
    margin-top: 0.18rem;
    color: var(--neon);
    font-family: "PolySans Trial", sans-serif;
    font-size: clamp(0.46rem, 0.82vw, 0.62rem);
    line-height: 1.15;
  }

  @media (max-width: 600px) {
    .team-neon-experiment {
      grid-auto-columns: minmax(8.2rem, 31vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      justify-content: start;
      width: 100%;
      padding-right: 1rem;
      padding-left: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .team-neon-experiment::-webkit-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-neon-card,
    .team-neon-card:hover {
      transform: none;
      transition: none;
    }
  }
</style>
