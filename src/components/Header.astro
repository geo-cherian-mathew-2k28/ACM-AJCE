---
const membershipHref = "/membership/";
---

<header
  class="site-header fixed top-4 left-0 right-0 z-50 w-full px-4 md:px-8 pointer-events-none"
>
  <div class="max-w-[1400px] mx-auto relative flex items-center justify-between w-full h-[50px]">
    
    <!-- Left Spacer for layout symmetry (Official logos are fixed via Layout.astro) -->
    <div class="hidden lg:block w-48 pointer-events-none"></div>

    <!-- Mobile left spacer so hamburger doesn't sit over logos -->
    <div class="block lg:hidden w-[120px] pointer-events-none flex-shrink-0"></div>

    <!-- Center Navigation Pill -->
    <div class="header-inner relative flex justify-center pointer-events-auto mx-auto lg:mx-0">
      <nav>
        <!-- Desktop nav -->
        <div class="nav-desktop">
          <div
            class="header-pill relative flex items-center justify-center w-fit px-8 overflow-hidden"
            style="height:50px;border-radius:41px;border:1px solid rgba(251,250,255,0.25);background:rgba(10,11,20,0.65);backdrop-filter:blur(12px);"
          >
            <!-- The Blob -->
            <div
              id="nav-blob"
              class="absolute top-0 bottom-0 bg-[#B8A7FF] rounded-[41px] transition-all duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] opacity-0 -z-10"
              style="left: 0; width: 0;"
            >
            </div>

            <!-- Dynamic Title for MORE sections -->
            <div
              id="dynamic-title"
              class="absolute inset-0 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
            >
              <div
                class="justify-start text-white text-base font-light font-['PolySans_Trial'] uppercase"
              >
              </div>
            </div>

            <ul
              class="nav-list relative z-10 flex items-center gap-2 md:gap-4 text-[13.5px] md:text-[14.8px] font-mono uppercase text-white"
              style="white-space:nowrap;align-items:center;letter-spacing:0.04em;"
            >
              <li>
                <a
                  href="#about"
                  class="nav-link inline-block px-3 py-1 hover:text-white transition-colors"
                  >ABOUT</a
                >
              </li>
              <li>
                <a
                  href="#mission"
                  class="nav-link inline-block px-3 py-1 hover:text-white transition-colors"
                  >MISSION</a
                >
              </li>
              <li>
                <a
                  href="#events"
                  class="nav-link inline-block px-3 py-1 hover:text-white transition-colors"
                  >EVENTS</a
                >
              </li>
              <li>
                <a
                  href="#acm-w"
                  class="nav-link inline-block px-3 py-1 hover:text-white transition-colors"
                  >ACM-W</a
                >
              </li>
              <li>
                <a
                  href="#"
                  role="button"
                  class="more-toggle inline-block px-3 py-1 more-link hover:opacity-80 transition-opacity"
                  aria-controls="desktopMoreMenu"
                  aria-expanded="false">MORE</a
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Desktop More dropdown -->
        <div id="desktopMoreMenu" class="more-menu w-[200px]">
          <ul class="mobile-more-list flex flex-col gap-1 p-1">
            {
              [
                { label: "Team", href: "#team" },
                { label: "Gallery", href: "#gallery" },
                { label: "Contact Us", href: "#contact" }
              ].map(item => (
                <li>
                  <a
                    href={item.href}
                    class="desktop-more-item group flex items-center justify-between px-3 py-2 rounded-lg text-[#FBFAFF] font-['PolySans_Trial'] text-xs uppercase tracking-wider transition-all duration-200 hover:bg-[#B8A7FF]/20 hover:text-[#B8A7FF] hover:translate-x-1"
                  >
                    <span>{item.label}</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
                      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Mobile nav -->
        <div class="nav-mobile">
          <button
            id="mobile-menu-btn"
            class="pointer-events-auto w-12 h-12 flex items-center justify-center rounded-full bg-[rgba(0,0,0,0.35)] border border-[#FBFAFF] backdrop-blur transition-transform active:scale-95"
            aria-label="Toggle menu"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#FBFAFF"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>

          <div
            id="mobile-menu-overlay"
            class="fixed inset-0 bg-black/95 z-[100] translate-x-full transition-transform duration-300 flex flex-col items-center justify-center"
          >
            <!-- Close button -->
            <button
              id="mobile-menu-close"
              class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center text-[#FBFAFF]"
            >
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>

            <!-- Primary nav links -->
            <ul class="flex flex-col gap-5 text-center">
              {
                [
                  { label: "About",   href: "#about" },
                  { label: "Mission", href: "#mission" },
                  { label: "Events",  href: "#events" },
                  { label: "ACM‑W",   href: "#acm-w" },
                ].map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="mobile-nav-link text-3xl font-light font-['PolySans_Trial'] uppercase text-[#FBFAFF] hover:text-[#B8A7FF] transition-colors"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }

              <!-- MORE accordion -->
              <li class="more-accordion-item">
                <button
                  id="mobile-more-btn"
                  class="text-3xl font-light font-['PolySans_Trial'] uppercase text-[#B8A7FF] flex items-center gap-2 mx-auto transition-colors"
                  aria-expanded="false"
                  aria-controls="mobile-more-panel"
                >
                  More
                  <svg id="mobile-more-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>

                <!-- Sub-items panel -->
                <div
                  id="mobile-more-panel"
                  class="overflow-hidden"
                  style="max-height:0; transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1);"
                >
                  <ul class="flex flex-col gap-3 pt-4 text-center">
                    {
                      [
                        { label: "Team",     href: "#team" },
                        { label: "Gallery",  href: "#gallery" },
                        { label: "Contact",  href: "#contact" },
                      ].map((item) => (
                        <li>
                          <a
                            href={item.href}
                            class="mobile-nav-link text-xl font-light font-['PolySans_Trial'] uppercase text-white/60 hover:text-[#B8A7FF] transition-colors tracking-widest"
                          >
                            {item.label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </li>
            </ul>

            <!-- Membership CTA -->
            <a
              href={membershipHref}
              class="mobile-nav-link mobile-membership-cta mt-10"
            >
              <span class="cta-badge">JOIN</span>
              <span>ACM Membership</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!-- Right: High-Converting ACM Membership CTA -->
    <div class="pointer-events-auto hidden sm:flex items-center">
      <a
        href={membershipHref}
        class="membership-cta-hero group"
        aria-label="Join ACM Chapter"
      >
        <span class="membership-cta-badge">JOIN</span>
        <span class="membership-cta-label">ACM Membership</span>
        <span class="membership-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

  </div>
</header>


<style>
  :global(body.modal-open-active) .site-header,
  :global(body.modal-open-active) .membership-cta-hero {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  .membership-cta-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    height: 46px;
    padding: 0 1.1rem 0 0.8rem;
    border: 1px solid rgba(184, 167, 255, 0.4);
    border-radius: 41px;
    background: rgba(15, 14, 28, 0.75);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 15px rgba(184, 167, 255, 0.15);
    color: #fbfaff;
    font-family: "PolySans Trial", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .membership-cta-badge {
    padding: 0.25rem 0.55rem;
    border-radius: 20px;
    background: #b8a7ff;
    color: #0a0b14;
    font-size: 0.65rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.08em;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .membership-cta-arrow {
    font-size: 0.95rem;
    line-height: 1;
    color: #b8a7ff;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .membership-cta-hero:hover {
    border-color: #b8a7ff;
    background: rgba(28, 24, 52, 0.95);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(184, 167, 255, 0.35);
  }

  .membership-cta-hero:hover .membership-cta-badge {
    background: #ffffff;
    transform: scale(1.05);
  }

  .membership-cta-hero:hover .membership-cta-arrow {
    transform: translateX(4px);
    color: #ffffff;
  }

  .header-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      width 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  /* Dynamic Mode Styles */
  .header-pill.dynamic-mode {
    width: 112px; /* w-28 */
    background-color: #B8A7FF !important;
    border-color: #FBFAFF;
  }

  .header-pill.dynamic-mode.pink-mode {
    background-color: #6A5ACD !important;
  }

  .header-pill.dynamic-mode .nav-list {
    opacity: 0;
    pointer-events: none;
  }

  .header-pill.dynamic-mode #dynamic-title {
    opacity: 1;
  }

  /* Hover state for dynamic mode - revert to full menu */
  .header-pill.dynamic-mode:hover {
    width: var(--full-width, auto) !important;
    background-color: rgba(0, 0, 0, 0.35) !important;
    border-color: #FBFAFF;
  }

  .header-pill.dynamic-mode:hover .nav-list {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0.1s;
  }

  .header-pill.dynamic-mode:hover #dynamic-title {
    opacity: 0;
    transition-delay: 0s;
  }
  .nav-list a {
    position: relative;
    z-index: 10;
    color: #FBFAFF;
    transition: color 0.3s ease;
  }
  .nav-list a.more-link {
    color: #B8A7FF !important;
  }
  .nav-list li {
    white-space: nowrap;
  }
  .nav-desktop {
    display: block;
    position: relative;
    transform: scale(var(--nav-bar-scale, 1));
    transform-origin: top center;
    transition: transform 160ms ease;
  }
  .nav-mobile {
    display: none;
    position: relative;
    pointer-events: auto; /* Ensure button is clickable */
  }

  /* 'More' dropdown */
  .more-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: auto;
    border: 1px solid rgba(251, 250, 255, 0.2);
    border-radius: 16px;
    background: rgba(10, 11, 20, 0.92);
    backdrop-filter: blur(16px);
    padding: 12px 14px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    z-index: 60;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transform-origin: top right;
    transition:
      opacity 0.18s ease,
      transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
  }
  .nav-desktop:hover .more-menu,
  .more-menu.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  @media (max-width: 952px) {
    body.partners-active .site-header {
      z-index: 200;
    }
    body.mobile-menu-open #mobile-menu-btn {
      opacity: 0;
      pointer-events: none;
    }
    .site-header {
      top: 14px;
      bottom: auto;
      padding: 0 16px;
    }
    .header-inner {
      width: 100%;
      justify-content: flex-end;
    }
    #mobile-menu-btn {
      position: fixed;
      top: 14px;
      right: 16px;
      width: 44px;
      height: 44px;
      z-index: 60;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    }
    #mobile-menu-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 44px;
      height: 44px;
    }
    .nav-desktop {
      display: none;
      transform: none;
    }
    .nav-mobile {
      display: block;
    }
  }

  @media screen and (max-width: 480px) {
    .site-header {
      top: 10px;
      padding: 0 12px;
    }
    #mobile-menu-btn {
      top: 10px;
      right: 12px;
      width: 38px;
      height: 38px;
    }
    #mobile-menu-close {
      top: 10px;
      right: 12px;
      width: 38px;
      height: 38px;
    }
    #mobile-menu-btn svg,
    #mobile-menu-close svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Mobile overlay Membership CTA */
  .mobile-membership-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.4rem 0.6rem 0.85rem;
    border-radius: 99px;
    border: 1px solid rgba(184, 167, 255, 0.4);
    background: rgba(184, 167, 255, 0.1);
    color: #FBFAFF;
    font-family: "PolySans Trial", monospace;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-membership-cta:active {
    background: rgba(184, 167, 255, 0.22);
    border-color: #B8A7FF;
  }
  .mobile-membership-cta .cta-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    background: #B8A7FF;
    color: #0a0b14;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
</style>

<script>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    // BLOB NAVIGATION LOGIC
    const blob = document.getElementById("nav-blob");
    const navLinks = document.querySelectorAll(".nav-desktop .nav-link");
    const sections = Array.from(
      document.querySelectorAll("section[id], footer[id]")
    );
    const moreToggle = document.querySelector(".nav-desktop .more-toggle");
    const pill = document.querySelector(".header-pill");
    const dynamicTitle = document.querySelector("#dynamic-title div");

    // Mobile Menu Logic
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
    const mobileMenuClose = document.getElementById("mobile-menu-close");
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
    const mobileMoreBtn = document.getElementById("mobile-more-btn");
    const mobileMorePanel = document.getElementById("mobile-more-panel");
    const mobileMoreChevron = document.getElementById("mobile-more-chevron");

    function toggleMobileMenu(show) {
      if (show) {
        mobileMenuOverlay.classList.remove("translate-x-full");
        document.body.classList.add("mobile-menu-open");
      } else {
        mobileMenuOverlay.classList.add("translate-x-full");
        document.body.classList.remove("mobile-menu-open");
        // Also collapse the More panel when menu closes
        if (mobileMorePanel) {
          mobileMorePanel.style.maxHeight = "0";
          if (mobileMoreChevron) mobileMoreChevron.style.transform = "";
          if (mobileMoreBtn) mobileMoreBtn.setAttribute("aria-expanded", "false");
        }
      }
    }

    // More accordion toggle
    if (mobileMoreBtn && mobileMorePanel) {
      mobileMoreBtn.addEventListener("click", () => {
        const isOpen = mobileMoreBtn.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          mobileMorePanel.style.maxHeight = "0";
          mobileMoreChevron && (mobileMoreChevron.style.transform = "");
          mobileMoreBtn.setAttribute("aria-expanded", "false");
        } else {
          mobileMorePanel.style.maxHeight = mobileMorePanel.scrollHeight + "px";
          mobileMoreChevron && (mobileMoreChevron.style.transform = "rotate(180deg)");
          mobileMoreBtn.setAttribute("aria-expanded", "true");
        }
      });
    }

    // Desktop More toggle
    const desktopMoreMenu = document.getElementById("desktopMoreMenu");
    if (moreToggle && desktopMoreMenu) {
      moreToggle.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = desktopMoreMenu.classList.contains("open");
        if (isOpen) {
          desktopMoreMenu.classList.remove("open");
          moreToggle.setAttribute("aria-expanded", "false");
        } else {
          desktopMoreMenu.classList.add("open");
          moreToggle.setAttribute("aria-expanded", "true");
        }
      });
      // Close when clicking outside
      document.addEventListener("click", (e) => {
        if (!desktopMoreMenu.contains(e.target) && e.target !== moreToggle) {
          desktopMoreMenu.classList.remove("open");
          moreToggle.setAttribute("aria-expanded", "false");
        }
      });
      // Close when a More link is clicked
      desktopMoreMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          desktopMoreMenu.classList.remove("open");
          moreToggle.setAttribute("aria-expanded", "false");
        });
      });
    }
    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener("click", () => toggleMobileMenu(true));
    }
    if (mobileMenuClose) {
      mobileMenuClose.addEventListener("click", () => toggleMobileMenu(false));
    }
    mobileNavLinks.forEach((link) => {
      link.addEventListener("click", () => toggleMobileMenu(false));
    });

    let fullWidth = pill ? pill.offsetWidth : 0;
    if (pill) {
      pill.style.setProperty("--full-width", `${fullWidth}px`);
      window.addEventListener("resize", () => {
        const wasDynamic = pill.classList.contains("dynamic-mode");
        if (wasDynamic) pill.classList.remove("dynamic-mode");

        const navList = document.querySelector(".nav-list");
        if (navList) {
          const w = navList.offsetWidth + 64;
          pill.style.setProperty("--full-width", `${w}px`);
        }

        if (wasDynamic) pill.classList.add("dynamic-mode");
        currentSectionId = null;
        scheduleNavUpdate();
      });
    }

    const moreSectionIds = [
      "team",
      "partners",
      "gallery",
      "contact",
    ];
    const navSectionMap = {
      home: null,
      about: "about",
      "about-acm-ajce": "about",
      "about-ajce": "about",
      mission: "mission",
      "community-outreach": "mission",
      "community-sdg": "mission",
      "community-chapter": "mission",
      "community-conduct": "mission",
      "community-speaker": "mission",
      events: "events",
      work: "events",
      "acm-w": "acm-w",
      team: "team",
      partners: "partners",
      gallery: "gallery",
      contact: "contact",
      footer: null,
    };
    let currentSectionId = null;
    let rafPending = false;

    const getNavSectionId = (sectionId) =>
      Object.hasOwn(navSectionMap, sectionId)
        ? navSectionMap[sectionId]
        : null;

    const getNavStateId = (sectionId) => {
      const navSectionId = getNavSectionId(sectionId);
      return moreSectionIds.includes(sectionId)
        ? sectionId
        : navSectionId || "none";
    };

    function updateBlob(targetLink) {
      if (!targetLink || !blob) return;

      const pill = document.querySelector(".header-pill");
      if (!pill) return;

      const pillRect = pill.getBoundingClientRect();
      const linkRect = targetLink.getBoundingClientRect();
      const scaleX = pill.offsetWidth > 0 ? pillRect.width / pill.offsetWidth : 1;
      const safeScaleX = Number.isFinite(scaleX) && scaleX > 0 ? scaleX : 1;

      const relativeLeft = (linkRect.left - pillRect.left) / safeScaleX;
      const width = linkRect.width / safeScaleX;

      blob.style.left = `${relativeLeft}px`;
      blob.style.width = `${width}px`;
      blob.style.opacity = "1";

      const href = targetLink.getAttribute("href");
      if (href === "#acm-w") {
        blob.style.backgroundColor = "#6A5ACD";
      } else {
        blob.style.backgroundColor = "#B8A7FF";
      }
    }

    function hideBlob() {
      if (blob) blob.style.opacity = "0";
    }

    function setDynamicMode(isDynamic, sectionId) {
      if (!pill) return;

      if (isDynamic) {
        pill.classList.add("dynamic-mode");
        if (sectionId === "acm-w") {
          pill.classList.add("pink-mode");
        } else {
          pill.classList.remove("pink-mode");
        }

        if (dynamicTitle) {
          let text = sectionId;
          let isLongText = false;

          if (sectionId.startsWith("community-")) {
            const sub = sectionId.replace("community-", "");
            let displaySub = sub;
            if (sub === "outreach") displaySub = "Outreach";
            else if (sub === "sdg") displaySub = "SDG";
            else if (sub === "conduct") displaySub = "Code of Conduct";
            else if (sub === "speaker") displaySub = "Speakers";

            text = `Community: ${displaySub}`;
            isLongText = true;
          }

          dynamicTitle.textContent = text;
          dynamicTitle.style.whiteSpace = "nowrap";

          if (isLongText) {
            const font = "16px PolySans_Trial";
            const tempSpan = document.createElement("span");
            tempSpan.style.fontFamily = "'PolySans_Trial', sans-serif";
            tempSpan.style.fontSize = "16px";
            tempSpan.style.fontWeight = "300";
            tempSpan.style.textTransform = "uppercase";
            tempSpan.style.visibility = "hidden";
            tempSpan.style.position = "absolute";
            tempSpan.style.whiteSpace = "nowrap";
            tempSpan.textContent = text;
            document.body.appendChild(tempSpan);
            const width = tempSpan.offsetWidth;
            document.body.removeChild(tempSpan);

            const totalWidth = width + 55;

            pill.style.setProperty("width", `${totalWidth}px`);
            pill.style.setProperty("padding-left", "0px");
          } else {
            pill.style.setProperty("width", "112px");
          }
        }
        hideBlob();
      } else {
        pill.classList.remove("dynamic-mode");
        pill.classList.remove("pink-mode");
        pill.style.removeProperty("width");
        pill.style.removeProperty("padding-left");
      }
    }

    function applyNavState(sectionId) {
      if (!sectionId) return;

      const navSectionId = getNavSectionId(sectionId);

      if (!navSectionId) {
        setDynamicMode(false);
        hideBlob();
        return;
      }

      if (moreSectionIds.includes(sectionId)) {
        setDynamicMode(true, sectionId);
        return;
      }

      setDynamicMode(false);

      const activeLink = document.querySelector(
        `.nav-desktop .nav-link[href="#${navSectionId}"]`
      );
      if (activeLink) {
        updateBlob(activeLink);
      } else {
        hideBlob();
      }
    }

    function getActiveSection() {
      const focusLine = Math.min(
        Math.max(window.innerHeight * 0.36, 170),
        360
      );
      const measurements = sections
        .map((section, index) => ({
          section,
          index,
          rect: section.getBoundingClientRect(),
        }))
        .filter(({ section }) => Object.hasOwn(navSectionMap, section.id));

      const containingFocusLine = measurements.filter(
        ({ rect }) => rect.top <= focusLine && rect.bottom > focusLine
      );

      if (containingFocusLine.length) {
        containingFocusLine.sort(
          (a, b) =>
            a.rect.height - b.rect.height || b.index - a.index
        );
        return containingFocusLine[0].section;
      }

      const passedSections = measurements.filter(
        ({ rect }) => rect.top <= focusLine
      );
      if (passedSections.length) {
        passedSections.sort(
          (a, b) => b.rect.top - a.rect.top || b.index - a.index
        );
        return passedSections[0].section;
      }

      measurements.sort(
        (a, b) => a.rect.top - b.rect.top || a.index - b.index
      );
      return measurements[0]?.section || null;
    }

    function updateActiveSection() {
      rafPending = false;
      const activeSection = getActiveSection();
      if (!activeSection) return;
      const id = activeSection.getAttribute("id");
      if (!id) return;
      const nextStateId = getNavStateId(id);
      if (nextStateId === currentSectionId) return;
      currentSectionId = nextStateId;
      applyNavState(id);
    }

    function scheduleNavUpdate() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(updateActiveSection);
    }

    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver(() => {
      scheduleNavUpdate();
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
    window.addEventListener("scroll", scheduleNavUpdate, { passive: true });
  });
</script>
