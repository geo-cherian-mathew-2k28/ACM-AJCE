---
const preloaderLogo = "/brand/acm-ajce-light.png";
---

<div id="preloader" class="preloader-overlay">
  <div class="logo-wrapper">
    <div class="logo-glow"></div>
    <img src={preloaderLogo} alt="ACM AJCE" class="acm-logo" />
    <div class="loading-bar-container">
      <div class="loading-bar-fill"></div>
    </div>
  </div>
</div>

<script>
  function dismissPreloader() {
    const preloader = document.getElementById("preloader");
    if (!preloader || (window as any).__preloaderDone) return;
    (window as any).__preloaderDone = true;

    preloader.style.opacity = "0";
    setTimeout(() => {
      preloader.style.display = "none";
      window.dispatchEvent(new CustomEvent("preloader:done"));
      window.dispatchEvent(new CustomEvent("siteLoaded"));
    }, 400);
  }

  if (document.readyState === "complete") {
    setTimeout(dismissPreloader, 100);
  } else {
    window.addEventListener("load", dismissPreloader);
    document.addEventListener("DOMContentLoaded", () => setTimeout(dismissPreloader, 200));
    setTimeout(dismissPreloader, 600); // Safety fallback
  }
</script>

<style>
  .preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background-color: #0a0b14;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .logo-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(184, 167, 255, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(20px);
    animation: logoPulse 1.8s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .acm-logo {
    width: clamp(140px, 20vw, 220px);
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 10;
    filter: drop-shadow(0 0 25px rgba(184, 167, 255, 0.4));
  }

  .loading-bar-container {
    width: 120px;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
    z-index: 10;
  }

  .loading-bar-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #B8A7FF, transparent);
    animation: barSlide 1.2s ease-in-out infinite;
  }

  @keyframes logoPulse {
    0% {
      transform: translate(-50%, -50%) scale(0.85);
      opacity: 0.4;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 0.9;
    }
  }

  @keyframes barSlide {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
</style>
