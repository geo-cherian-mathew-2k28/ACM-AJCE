---
import type { MemberUser, MembershipRecord } from "../lib/membership";

type Props = {
  user: MemberUser;
  membership: MembershipRecord;
  preview?: boolean;
  admin?: boolean;
};

const { user, membership, preview = false, admin = false } = Astro.props;
const expiry = new Date(membership.expires_at).toLocaleDateString("en-IN", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
const cardHref = preview ? "/membership/card?preview=member" : "/membership/card";
const dashboardApi = "/api/member/dashboard";
---

<section class="member-workspace" data-member-workspace data-demo={preview ? "true" : "false"} data-api={dashboardApi}>
  <header class="member-workspace__heading">
    <div>
      <p class="member-workspace__eyebrow">ACM AJCE local chapter</p>
      <h1>Good evening, {user.full_name.split(" ")[0]}.</h1>
      <p class="member-workspace__intro">Your membership, event activity, and chapter records in one place.</p>
    </div>
    <div class="member-workspace__heading-actions">
      {admin && <a class="member-workspace__text-button" href={preview ? "/membership/admin?preview=admin" : "/membership/admin"}>Admin console</a>}
      <a class="member-workspace__primary" href={cardHref}>Open ID card</a>
    </div>
  </header>

  <nav class="member-workspace__tabs" aria-label="Member dashboard sections">
    <button class="is-active" type="button" data-member-tab="overview" aria-current="page">Overview</button>
    <button type="button" data-member-tab="events">Events</button>
    <button type="button" data-member-tab="certificates">Certificates</button>
    <button type="button" data-member-tab="payments">Payments</button>
  </nav>

  <section data-member-view="overview">
    <div class="member-workspace__signal">
      <span><i></i>Membership active</span>
      <span>Valid through <strong>{expiry}</strong></span>
      <span><strong data-member-summary="events">--</strong> chapter registrations</span>
      <span><strong data-member-summary="certificates">--</strong> certificates</span>
    </div>

    <div class="member-workspace__overview-grid">
      <article class="member-id-preview">
        <div class="member-id-preview__top"><span>ACM AJCE</span><span>LOCAL MEMBER</span></div>
        <div class="member-id-preview__content">
          <p>Member</p>
          <strong>{user.full_name}</strong>
          <span>{user.department ?? "Amal Jyothi College of Engineering"}</span>
        </div>
        <div class="member-id-preview__bottom"><span>{membership.member_number}</span><span>VALID TO {expiry.toUpperCase()}</span></div>
        <a href={cardHref} aria-label="Open your downloadable ACM AJCE ID card">Open member ID</a>
      </article>

      <div class="member-workspace__metrics">
        <article class="member-workspace__metric">
          <span class="member-workspace__metric-icon member-workspace__metric-icon--violet">M</span>
          <div><small>Membership plan</small><strong>Local annual</strong><span>Rs. 150 / one year</span></div>
        </article>
        <article class="member-workspace__metric">
          <span class="member-workspace__metric-icon member-workspace__metric-icon--mint">E</span>
          <div><small>Events joined</small><strong data-member-metric="events">--</strong><span>Registrations on your account</span></div>
        </article>
        <article class="member-workspace__metric">
          <span class="member-workspace__metric-icon member-workspace__metric-icon--amber">C</span>
          <div><small>Certificates</small><strong data-member-metric="certificates">--</strong><span>Issued participation records</span></div>
        </article>
        <article class="member-workspace__metric">
          <span class="member-workspace__metric-icon member-workspace__metric-icon--cyan">R</span>
          <div><small>Renewal date</small><strong>{new Date(membership.expires_at).toLocaleDateString("en-IN", { month: "short", year: "numeric" })}</strong><span>Keep your local plan active</span></div>
        </article>
      </div>
    </div>

    <div class="member-workspace__split">
      <section class="member-workspace__panel">
        <div class="member-workspace__panel-heading"><div><span>Next up</span><h2>New chapter events</h2></div><button type="button" data-member-open="events">See all events</button></div>
        <div id="member-overview-events" class="member-workspace__event-list"><p class="member-workspace__empty">Loading upcoming events...</p></div>
      </section>
      <section class="member-workspace__panel member-workspace__activity-panel">
        <div class="member-workspace__panel-heading"><div><span>Activity</span><h2>Your chapter trail</h2></div></div>
        <div id="member-activity" class="member-workspace__activity"><p class="member-workspace__empty">Loading member activity...</p></div>
      </section>
    </div>
  </section>

  <section data-member-view="events" hidden>
    <header class="member-workspace__section-heading"><div><span>Events</span><h2>Join what ACM AJCE is building next.</h2><p>Apply from your member account. Personal coupons are checked once, then expire immediately after successful use.</p></div></header>
    <div id="member-events" class="member-workspace__event-grid"><p class="member-workspace__empty">Loading events...</p></div>
    <section class="member-workspace__panel member-workspace__registered-panel">
      <div class="member-workspace__panel-heading"><div><span>Your registrations</span><h2>Events on your record</h2></div></div>
      <div id="member-registrations" class="member-workspace__record-list"><p class="member-workspace__empty">Loading registrations...</p></div>
    </section>
  </section>

  <section data-member-view="certificates" hidden>
    <header class="member-workspace__section-heading"><div><span>Certificates</span><h2>Participation records, ready when you need them.</h2><p>Certificates appear here after the ACM AJCE team issues them for an eligible event registration.</p></div></header>
    <div id="member-certificates" class="member-workspace__certificate-grid"><p class="member-workspace__empty">Loading certificates...</p></div>
  </section>

  <section data-member-view="payments" hidden>
    <header class="member-workspace__section-heading"><div><span>Payments</span><h2>Your membership transactions.</h2><p>Keep a simple record of chapter payments and verification status.</p></div></header>
    <div class="member-workspace__table-wrap"><div id="member-payments"><p class="member-workspace__empty">Loading payment history...</p></div></div>
  </section>
</section>

<script>
  // @ts-nocheck
  const workspace = document.querySelector("[data-member-workspace]");
  const isDemo = workspace?.dataset.demo === "true";
  const formatDate = (value, options = { dateStyle: "medium" }) => new Intl.DateTimeFormat("en-IN", options).format(new Date(value));
  const formatMoney = (value) => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(Number(value || 0) / 100);
  const text = (node, value) => { node.textContent = value; return node; };
  const requestJson = async (url, options = {}) => {
    const response = await fetch(url, options);
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.message || "Unable to load your member records.");
    return data;
  };
  const demoData = {
    upcoming: [
      { id: "uxplore", title: "UXplore 2026", summary: "A design challenge for teams building thoughtful campus experiences.", venue: "AJCE Main Block", starts_at: "2026-08-18T09:30:00.000Z", registration_status: null, event_url: "", whatsapp_url: "" },
      { id: "alchemy", title: "Data Alchemy", summary: "A hands-on session on turning data into useful stories and products.", venue: "Innovation Lab", starts_at: "2026-09-05T10:00:00.000Z", registration_status: "registered", event_url: "", whatsapp_url: "", after_registration_content: "Bring your laptop. Session updates will appear in the event group." },
    ],
    registrations: [
      { id: "alchemy", title: "Data Alchemy", venue: "Innovation Lab", starts_at: "2026-09-05T10:00:00.000Z", status: "registered", registered_at: "2026-08-02T10:00:00.000Z", event_url: "", whatsapp_url: "" },
      { id: "pixie", title: "PixieArt", venue: "Design Studio", starts_at: "2026-05-11T10:00:00.000Z", status: "registered", registered_at: "2026-04-28T10:00:00.000Z", event_url: "", whatsapp_url: "" },
    ],
    certificates: [
      { id: "preview-cert", certificate_number: "AJCE-CERT-2026-DEMO01", status: "issued", issued_at: "2026-05-16T10:00:00.000Z", event_title: "PixieArt", starts_at: "2026-05-11T10:00:00.000Z" },
    ],
    transactions: [
      { id: "payment-preview", amount_paise: 15000, currency: "INR", status: "captured", razorpay_payment_id: "pay_preview", receipt: "AJCE-ACM-DEMO-2026", created_at: "2026-07-01T10:00:00.000Z", verified_at: "2026-07-01T10:01:00.000Z" },
    ],
  };
  const tabButtons = [...document.querySelectorAll("[data-member-tab]")];
  const views = [...document.querySelectorAll("[data-member-view]")];
  const openView = (view) => {
    views.forEach((element) => { element.hidden = element.dataset.memberView !== view; });
    tabButtons.forEach((button) => { const active = button.dataset.memberTab === view; button.classList.toggle("is-active", active); if (active) button.setAttribute("aria-current", "page"); else button.removeAttribute("aria-current"); });
    window.scrollTo({ top: 0, behavior: "smooth" });
  };
  tabButtons.forEach((button) => button.addEventListener("click", () => openView(button.dataset.memberTab)));
  document.querySelectorAll("[data-member-open]").forEach((button) => button.addEventListener("click", () => openView(button.dataset.memberOpen)));

  const eventCard = (event, compact = false) => {
    const article = document.createElement("article");
    article.className = compact ? "member-workspace__mini-event" : "member-workspace__event-card";
    const meta = document.createElement("p"); meta.className = "member-workspace__event-meta"; text(meta, `${formatDate(event.starts_at, { dateStyle: "medium", timeStyle: "short" })}${event.venue ? ` / ${event.venue}` : ""}`);
    const title = document.createElement("h3"); text(title, event.title);
    const summary = document.createElement("p"); summary.className = "member-workspace__event-summary"; text(summary, event.summary || "Event details will be shared by ACM AJCE.");
    article.append(meta, title, summary);
    if (compact) return article;
    const details = document.createElement("p"); details.className = "member-workspace__event-detail"; text(details, event.registration_status && event.after_registration_content ? event.after_registration_content : "Apply from your member account to keep this event on your record.");
    const action = document.createElement("div"); action.className = "member-workspace__event-action";
    if (event.registration_status) {
      const status = document.createElement("span"); status.className = "member-workspace__status"; text(status, "Registered"); action.append(status);
    } else {
      const input = document.createElement("input"); input.placeholder = "Coupon code (optional)"; input.setAttribute("aria-label", `Coupon code for ${event.title}`);
      const apply = document.createElement("button"); apply.type = "button"; text(apply, "Apply");
      apply.addEventListener("click", async () => {
        if (isDemo) { apply.disabled = true; text(apply, "Preview registration"); return; }
        apply.disabled = true;
        try {
          await requestJson(`/api/events/${event.id}/register`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ couponCode: input.value }) });
          text(apply, "Registered"); input.disabled = true;
        } catch (error) { apply.disabled = false; window.alert(error.message); }
      });
      action.append(input, apply);
    }
    article.append(details, action);
    return article;
  };
  const render = (data) => {
    const upcoming = data.upcoming || [];
    const registrations = data.registrations || [];
    const certificates = data.certificates || [];
    const transactions = data.transactions || [];
    document.querySelectorAll('[data-member-summary="events"], [data-member-metric="events"]').forEach((node) => text(node, registrations.length));
    document.querySelectorAll('[data-member-summary="certificates"], [data-member-metric="certificates"]').forEach((node) => text(node, certificates.length));
    const overviewEvents = document.querySelector("#member-overview-events"); overviewEvents.replaceChildren();
    if (upcoming.length) upcoming.slice(0, 3).forEach((event) => overviewEvents.append(eventCard(event, true))); else overviewEvents.append(text(document.createElement("p"), "No new events are published yet."));
    const activity = document.querySelector("#member-activity"); activity.replaceChildren();
    const activityItems = [
      ...registrations.slice(0, 2).map((item) => ({ label: "Event registration", detail: item.title, date: item.registered_at })),
      ...certificates.slice(0, 2).map((item) => ({ label: "Certificate issued", detail: item.event_title, date: item.issued_at })),
      ...transactions.slice(0, 1).map((item) => ({ label: "Membership payment", detail: formatMoney(item.amount_paise), date: item.verified_at || item.created_at })),
    ].sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 4);
    if (activityItems.length) activityItems.forEach((item) => { const row = document.createElement("div"); const copy = document.createElement("span"); const label = document.createElement("small"); text(label, item.label); const detail = document.createElement("strong"); text(detail, item.detail); copy.append(label, detail); const date = document.createElement("time"); text(date, formatDate(item.date)); row.append(copy, date); activity.append(row); }); else activity.append(text(document.createElement("p"), "Your latest chapter activity will appear here."));
    const events = document.querySelector("#member-events"); events.replaceChildren(); if (upcoming.length) upcoming.forEach((event) => events.append(eventCard(event))); else events.append(text(document.createElement("p"), "No published events yet. Check back soon."));
    const recordList = document.querySelector("#member-registrations"); recordList.replaceChildren();
    if (registrations.length) registrations.forEach((item) => { const row = document.createElement("article"); row.className = "member-workspace__record"; const copy = document.createElement("div"); const title = document.createElement("strong"); text(title, item.title); const detail = document.createElement("span"); text(detail, `${formatDate(item.starts_at)}${item.venue ? ` / ${item.venue}` : ""}`); copy.append(title, detail); const status = document.createElement("span"); status.className = "member-workspace__status"; text(status, item.status); row.append(copy, status); recordList.append(row); }); else recordList.append(text(document.createElement("p"), "You have not registered for an event yet."));
    const certificateGrid = document.querySelector("#member-certificates"); certificateGrid.replaceChildren();
    if (certificates.length) certificates.forEach((item) => { const card = document.createElement("article"); card.className = "member-workspace__certificate"; const tag = document.createElement("span"); text(tag, "ACM AJCE / ISSUED"); const title = document.createElement("h3"); text(title, item.event_title); const number = document.createElement("p"); text(number, item.certificate_number); const date = document.createElement("time"); text(date, `Issued ${formatDate(item.issued_at)}`); card.append(tag, title, number, date); certificateGrid.append(card); }); else certificateGrid.append(text(document.createElement("p"), "No certificates have been issued to this account yet."));
    const paymentBox = document.querySelector("#member-payments"); paymentBox.replaceChildren();
    if (transactions.length) { const table = document.createElement("table"); table.innerHTML = "<thead><tr><th>Date</th><th>Receipt</th><th>Amount</th><th>Status</th></tr></thead>"; const body = document.createElement("tbody"); transactions.forEach((item) => { const row = document.createElement("tr"); [formatDate(item.created_at), item.receipt, formatMoney(item.amount_paise), item.status].forEach((value) => { const cell = document.createElement("td"); text(cell, value); row.append(cell); }); body.append(row); }); table.append(body); paymentBox.append(table); } else paymentBox.append(text(document.createElement("p"), "Your membership payment history will appear here."));
  };
  if (workspace) {
    if (isDemo) render(demoData);
    else requestJson(workspace.dataset.api).then(render).catch((error) => document.querySelectorAll(".member-workspace__empty").forEach((element) => text(element, error.message)));
  }
</script>

<style>
  .member-workspace { display: grid; gap: 25px; color: #f7f6fb; }
  .member-workspace__heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-top: 6px; }
  .member-workspace__eyebrow, .member-workspace__panel-heading > div > span, .member-workspace__section-heading > div > span, .member-id-preview__top, .member-id-preview__bottom, .member-workspace__certificate > span { margin: 0; color: #b9a8ff; font: 700 0.64rem/1.3 "Space Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  .member-workspace__heading h1 { margin: 8px 0 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1; letter-spacing: 0; }
  .member-workspace__intro { margin: 11px 0 0; color: #a9a8b7; font-size: 0.94rem; }
  .member-workspace__heading-actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .member-workspace__text-button, .member-workspace__primary { min-height: 39px; display: inline-flex; align-items: center; justify-content: center; padding: 0 14px; border: 1px solid rgba(198, 188, 255, 0.3); border-radius: 6px; color: #e5e1fb; font-size: 0.73rem; font-weight: 800; text-decoration: none; transition: transform 160ms ease, background 160ms ease, border-color 160ms ease; }
  .member-workspace__primary { border-color: #9f8aff; background: #6858d8; color: #fff; box-shadow: 0 8px 20px rgba(104, 88, 216, 0.24); }
  .member-workspace__text-button:hover, .member-workspace__text-button:focus-visible, .member-workspace__primary:hover, .member-workspace__primary:focus-visible { transform: translateY(-1px); border-color: #bcaeff; outline: none; }
  .member-workspace__tabs { display: flex; gap: 5px; width: max-content; max-width: 100%; overflow-x: auto; padding: 4px; border: 1px solid rgba(230, 225, 255, 0.13); border-radius: 7px; background: rgba(16, 17, 31, 0.8); }
  .member-workspace__tabs button { min-height: 35px; padding: 0 13px; border: 0; border-radius: 4px; background: transparent; color: #aaa7b7; font-size: 0.72rem; font-weight: 800; white-space: nowrap; cursor: pointer; transition: color 160ms ease, background 160ms ease; }
  .member-workspace__tabs button:hover, .member-workspace__tabs button:focus-visible { color: #fff; outline: none; }
  .member-workspace__tabs button.is-active { background: rgba(125, 103, 230, 0.92); color: #fff; }
  .member-workspace__signal { display: flex; flex-wrap: wrap; gap: 0; overflow: hidden; border: 1px solid rgba(230, 225, 255, 0.1); border-radius: 7px; background: rgba(16, 17, 31, 0.78); }
  .member-workspace__signal span { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-right: 1px solid rgba(230, 225, 255, 0.09); color: #b6b3c2; font-size: 0.75rem; }
  .member-workspace__signal strong { color: #f5f3ff; }
  .member-workspace__signal i { width: 7px; height: 7px; border-radius: 50%; background: #4de1a8; box-shadow: 0 0 12px rgba(77, 225, 168, 0.75); }
  .member-workspace__overview-grid { display: grid; grid-template-columns: minmax(280px, 1.15fr) minmax(360px, 1fr); gap: 16px; }
  .member-id-preview { position: relative; min-height: 255px; display: flex; flex-direction: column; overflow: hidden; padding: 22px; border: 1px solid rgba(194, 183, 255, 0.43); border-radius: 8px; background: linear-gradient(135deg, #272058, #5447a0 55%, #7d67d2); box-shadow: 0 20px 45px rgba(50, 38, 129, 0.25); }
  .member-id-preview::after { position: absolute; right: -45px; bottom: -69px; width: 185px; height: 185px; border: 1px solid rgba(255, 255, 255, 0.19); border-radius: 34px; content: ""; transform: rotate(36deg); }
  .member-id-preview__top, .member-id-preview__bottom { z-index: 1; display: flex; justify-content: space-between; gap: 12px; color: rgba(251, 250, 255, 0.83); }
  .member-id-preview__content { z-index: 1; margin: auto 0; }
  .member-id-preview__content p { margin: 0 0 8px; color: #d2caff; font: 700 0.62rem/1 "Space Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  .member-id-preview__content strong { display: block; font-size: clamp(1.7rem, 3.2vw, 2.7rem); line-height: 1.03; }
  .member-id-preview__content span { display: block; margin-top: 10px; color: rgba(251, 250, 255, 0.76); font-size: 0.84rem; }
  .member-id-preview a { z-index: 1; position: absolute; right: 22px; bottom: 19px; color: #fff; font-size: 0.71rem; font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }
  .member-workspace__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .member-workspace__metric { position: relative; min-height: 121px; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 12px; overflow: hidden; padding: 16px; border: 1px solid rgba(230, 225, 255, 0.11); border-radius: 7px; background: rgba(18, 19, 34, 0.85); }
  .member-workspace__metric::after { position: absolute; right: -17px; bottom: -17px; width: 48px; height: 48px; border: 1px solid rgba(220, 215, 255, 0.08); border-radius: 10px; content: ""; transform: rotate(45deg); }
  .member-workspace__metric-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 7px; color: #fff; font: 800 0.73rem/1 "Space Mono", monospace; }
  .member-workspace__metric-icon--violet { background: rgba(113, 91, 237, 0.3); color: #cfc4ff; } .member-workspace__metric-icon--mint { background: rgba(40, 202, 151, 0.2); color: #82f0c5; } .member-workspace__metric-icon--amber { background: rgba(245, 173, 65, 0.17); color: #ffd28a; } .member-workspace__metric-icon--cyan { background: rgba(69, 176, 225, 0.19); color: #94dcff; }
  .member-workspace__metric small, .member-workspace__metric span:not(.member-workspace__metric-icon) { display: block; color: #9b98ab; font-size: 0.66rem; line-height: 1.35; }
  .member-workspace__metric strong { display: block; margin: 7px 0 3px; color: #f8f7ff; font-size: 1.1rem; }
  .member-workspace__split { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.75fr); gap: 16px; }
  .member-workspace__panel, .member-workspace__event-card, .member-workspace__certificate, .member-workspace__table-wrap { border: 1px solid rgba(230, 225, 255, 0.11); border-radius: 7px; background: rgba(16, 17, 31, 0.82); }
  .member-workspace__panel { padding: 19px; }
  .member-workspace__panel-heading { display: flex; align-items: start; justify-content: space-between; gap: 15px; }
  .member-workspace__panel-heading h2 { margin: 5px 0 0; font-size: 1.06rem; letter-spacing: 0; }
  .member-workspace__panel-heading button { border: 0; background: transparent; color: #b5a7ff; font-size: 0.72rem; font-weight: 800; cursor: pointer; }
  .member-workspace__panel-heading button:hover, .member-workspace__panel-heading button:focus-visible { color: #e6e1ff; outline: none; }
  .member-workspace__event-list { display: grid; gap: 0; margin-top: 12px; }
  .member-workspace__mini-event { display: grid; grid-template-columns: 150px minmax(0, 1fr) minmax(0, 1.4fr); align-items: center; gap: 12px; padding: 13px 0; border-top: 1px solid rgba(230, 225, 255, 0.09); }
  .member-workspace__mini-event:first-child { border-top: 0; }
  .member-workspace__event-meta { margin: 0; color: #b7a8ff; font: 700 0.6rem/1.4 "Space Mono", monospace; letter-spacing: 0.04em; text-transform: uppercase; }
  .member-workspace__mini-event h3, .member-workspace__event-card h3, .member-workspace__certificate h3 { margin: 0; font-size: 0.94rem; letter-spacing: 0; }
  .member-workspace__event-summary { margin: 0; color: #a8a6b3; font-size: 0.75rem; line-height: 1.45; }
  .member-workspace__activity { display: grid; gap: 0; margin-top: 13px; }
  .member-workspace__activity > div { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid rgba(230, 225, 255, 0.09); }
  .member-workspace__activity > div:first-child { border-top: 0; }
  .member-workspace__activity small, .member-workspace__activity strong { display: block; }
