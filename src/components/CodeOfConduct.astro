---
import "../styles/globals.css";
---

<div class="code-of-conduct-container w-screen overflow-hidden py-12 px-6 md:px-16 lg:px-24">
  <div id="community-conduct" class="absolute -top-24 pointer-events-none"></div>

  <!-- Section Wrapper -->
  <div
    class="max-w-[1200px] mx-auto p-8 md:p-12 rounded-[2.5rem] bg-gradient-to-br from-[#131525]/90 via-[#0a0b14]/95 to-[#05060b]/98 border border-[#B8A7FF]/25 shadow-[0_20px_60px_rgba(0,0,0,0.7)] backdrop-blur-xl flex flex-col lg:flex-row gap-10 overflow-hidden relative group"
  >
    <!-- Ambient Glow -->
    <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-[#B8A7FF]/15 rounded-full blur-3xl pointer-events-none group-hover:bg-[#B8A7FF]/25 transition-all duration-700"></div>

    <!-- Left Header Column -->
    <div class="w-full lg:w-4/12 flex flex-col justify-between gap-6 relative z-10">
      <div class="flex flex-col gap-4">
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-[#B8A7FF] px-3.5 py-1.5 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/20 w-max font-mono">
          <span class="w-2 h-2 rounded-full bg-[#B8A7FF] animate-pulse"></span>
          Ethics & Conduct
        </span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white uppercase leading-tight">
          ACM AJCE <br/>
          <span class="text-[#B8A7FF] drop-shadow-[0_0_15px_rgba(184,167,255,0.4)]">CODE OF CONDUCT</span>
        </h2>
        <div class="w-16 h-1 bg-gradient-to-r from-[#B8A7FF] to-transparent rounded-full mt-1"></div>
      </div>

      <p class="text-xs md:text-sm font-mono text-white/75 leading-relaxed uppercase border-l-2 border-[#B8A7FF]/40 pl-4">
        Ground in the ACM Code of Ethics. Computing professionals have a profound impact on society and must prioritise the public good.
      </p>

      <div class="hidden lg:block text-xs font-mono text-white/40">
        ASSOCIATION FOR COMPUTING MACHINERY
      </div>
    </div>

    <!-- Right Content Grid -->
    <div class="w-full lg:w-8/12 grid grid-cols-1 sm:grid-cols-2 gap-6 relative z-10">
      
      <!-- Principle 1 -->
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-[#B8A7FF]/40 transition-all flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-[#B8A7FF] font-semibold">
          1 // Ethical Principles
        </span>
        <h3 class="text-base font-bold text-white uppercase">Society & Public Good</h3>
        <p class="text-xs text-white/70 font-light leading-relaxed">
          Contribute to societal well-being, avoid harm, uphold inclusivity, respect privacy, and honor intellectual property.
        </p>
      </div>

      <!-- Principle 2 -->
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-[#B8A7FF]/40 transition-all flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-[#B8A7FF] font-semibold">
          2 // Professional Standard
        </span>
        <h3 class="text-base font-bold text-white uppercase">Excellence & Security</h3>
        <p class="text-xs text-white/70 font-light leading-relaxed">
          Deliver high-quality work, evaluate system risks, design secure & reliable solutions, and adhere to policies.
        </p>
      </div>

      <!-- Principle 3 -->
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-[#B8A7FF]/40 transition-all flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-[#B8A7FF] font-semibold">
          3 // Leadership Values
        </span>
        <h3 class="text-base font-bold text-white uppercase">Transparency & Growth</h3>
        <p class="text-xs text-white/70 font-light leading-relaxed">
          Ensure goals prioritize public good, foster ethical behavior, and support team well-being and growth.
        </p>
      </div>

      <!-- Principle 4 -->
      <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-[#B8A7FF]/40 transition-all flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-[#B8A7FF] font-semibold">
          4 // Compliance
        </span>
        <h3 class="text-base font-bold text-white uppercase">Upholding The Code</h3>
        <p class="text-xs text-white/70 font-light leading-relaxed">
          Uphold and promote the ACM Code. Unethical behavior is incompatible with ACM chapter membership.
        </p>
      </div>

    </div>
  </div>
</div>
