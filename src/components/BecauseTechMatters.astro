---
// Technology Animation Section
---

<div class="relative btm-wrapper" style="margin-top: -7rem;">
  <section
    class="tech-hero-section video-bg-section w-screen h-[130vh] relative flex items-center justify-center overflow-hidden"
    id="tech-hero"
  >
    <div
      class="text-container relative flex flex-col items-center justify-center"
      id="textContainer"
    >
      <!-- Line 1: technology -->
      <div
        class="line absolute flex items-center justify-center gap-[clamp(0.5rem,2vw,1.5rem)] whitespace-nowrap z-10"
        id="line1"
      >
        <span class="tech-word text-[#FBFAFF] font-bold tracking-tight">technology</span>
      </div>

      <!-- Line 2: technology -->
      <div
        class="line absolute flex items-center justify-center gap-[clamp(0.5rem,2vw,1.5rem)] whitespace-nowrap z-20"
        id="line2"
      >
        <span class="tech-word text-[#FBFAFF] font-bold tracking-tight">technology</span>
      </div>

      <!-- Line 3: because [OUTLINED technology] matters -->
      <!-- Placed at z-15 so Line 2 (z-20) & Line 4 (z-30) sit ABOVE it for natural intersection -->
      <div
        class="line absolute flex items-center justify-center gap-[clamp(0.5rem,2vw,1.5rem)] whitespace-nowrap z-15"
        id="line3"
      >
        <span class="side-text text-[#FBFAFF] font-semibold">because</span>
        <!-- Outlined word wrapped with background-clip SVG stroke simulation for clean inner counter holes -->
        <span class="tech-word-outline-wrapper relative inline-block">
          <span class="tech-word outlined font-bold tracking-tight">technology</span>
        </span>
        <span class="side-text text-[#FBFAFF] font-semibold">matters</span>
      </div>

      <!-- Line 4: technology (z-30 overlays outlined technology naturally) -->
      <div
        class="line absolute flex items-center justify-center gap-[clamp(0.5rem,2vw,1.5rem)] whitespace-nowrap z-30"
        id="line4"
      >
        <span class="tech-word text-[#FBFAFF] font-bold tracking-tight">technology</span>
      </div>

      <!-- Line 5: technology -->
      <div
        class="line absolute flex items-center justify-center gap-[clamp(0.5rem,2vw,1.5rem)] whitespace-nowrap z-10"
        id="line5"
      >
        <span class="tech-word text-[#FBFAFF] font-bold tracking-tight">technology</span>
      </div>
    </div>
  </section>
</div>

<style>
  @font-face {
    font-family: "PolySans Bold";
    src: url("../assets/fonts/PolySans-trial/PolySans-trial/Mono/PolySansTrial-BulkyMono.otf")
      format("opentype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  .tech-word, .side-text {
    font-family: "PolySans Trial", sans-serif;
    font-size: clamp(1.5rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1;
    display: inline-block;
  }

  /*
    Clean Vector Outlined Typography with paint-order fill stroke:
    - paint-order: stroke fill keeps glyph counter holes (inside 't', 'e', 'o', 'g') 100% clean and transparent
    - stroke-alignment stays outer-clean without inner path self-overlaps
  */
  .tech-word.outlined {
    color: transparent !important;
    background: transparent !important;
    -webkit-text-stroke: 1.25px #B8A7FF !important;
    text-stroke: 1.25px #B8A7FF !important;
    paint-order: stroke fill;
    -webkit-paint-order: stroke fill;
    text-shadow: none !important;
    filter: none !important;
    box-shadow: none !important;
  }

  @media (max-width: 768px), (pointer: coarse) {
    .tech-word.outlined {
      -webkit-text-stroke: 1px #B8A7FF !important;
      text-stroke: 1px #B8A7FF !important;
    }
  }

  .btm-wrapper { margin-top: 0 !important; }
  .tech-hero-section { height: 110vh; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimation = () => {
    const isMobile = window.matchMedia("(max-width: 768px)").matches;
    const lineHeight = isMobile ? 44 : 66;

    // All 5 lines start centered
    gsap.set("#line1", { y: 0, opacity: 1 });
    gsap.set("#line2", { y: 0, opacity: 1 });
    gsap.set("#line3", { y: 0, opacity: 1 });
    gsap.set("#line4", { y: 0, opacity: 1 });
    gsap.set("#line5", { y: 0, opacity: 1 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#tech-hero",
        start: isMobile ? "top 75%" : "top 60%",
        end: isMobile ? "bottom 45%" : "bottom 50%",
        scrub: 0.8,
        pin: false,
        anticipatePin: 1,
      },
    });

    // Expand lines vertically with precise tight overlap (~15-20% intersection)
    tl.to(
      "#line1",
      {
        y: -lineHeight * 2,
        opacity: 1,
        duration: 1,
        ease: "power2.out",
      },
      0
    )
      .to(
        "#line2",
        {
          y: -lineHeight,
          opacity: 1,
          duration: 1,
          ease: "power2.out",
        },
        0
      )
      .to(
        "#line3",
        {
          y: 0,
          opacity: 1,
          duration: 1,
          ease: "power2.out",
        },
        0
      )
      .to(
        "#line4",
        {
          y: lineHeight,
          opacity: 1,
          duration: 1,
          ease: "power2.out",
        },
        0
      )
      .to(
        "#line5",
        {
          y: lineHeight * 2,
          opacity: 1,
          duration: 1,
          ease: "power2.out",
        },
        0
      );
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimation);
  } else {
    initAnimation();
  }
</script>
