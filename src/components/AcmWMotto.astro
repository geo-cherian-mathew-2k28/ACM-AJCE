---
import { getAssetUrl } from "../utils/cdn";
---

<section class="acmw-motto-section w-full relative overflow-hidden">
  <!-- Radial Glow Aura Background matching reference image style -->
  <div class="acmw-radial-glow" aria-hidden="true"></div>
  
  <!-- Subtle Grid Texture Overlay -->
  <div class="acmw-grid-pattern" aria-hidden="true"></div>

  <div class="marquee-outer relative z-10">
    <div class="marquee-track">

      <!-- Set 1 -->
      <div class="marquee-set">
        <span class="motto-word" data-text="She Leads.">She Leads.</span>
        <img
          src={getAssetUrl("/acm-w logo.png")}
          alt="ACM-W AJCE"
          class="motto-logo"
          loading="eager"
          decoding="async"
        />
        <span class="motto-word" data-text="She Codes.">She Codes.</span>
        <img
          src={getAssetUrl("/acm-w logo.png")}
          alt="ACM-W AJCE"
          class="motto-logo"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Set 2 — duplicate for seamless loop -->
      <div class="marquee-set" aria-hidden="true">
        <span class="motto-word" data-text="She Leads.">She Leads.</span>
        <img
          src={getAssetUrl("/acm-w logo.png")}
          alt=""
          class="motto-logo"
          loading="eager"
          decoding="async"
        />
        <span class="motto-word" data-text="She Codes.">She Codes.</span>
        <img
          src={getAssetUrl("/acm-w logo.png")}
          alt=""
          class="motto-logo"
          loading="eager"
          decoding="async"
        />
      </div>

    </div>
  </div>
</section>

<style>
  .acmw-motto-section {
    position: relative;
    padding-top: clamp(140px, 20vh, 240px);
    padding-bottom: clamp(90px, 12vh, 140px);
    background-color: #05040a;
  }

  /* Deep central radial glow aura matching the reference image concept (purple/lavender theme) */
  .acmw-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100%;
    background: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      rgba(106, 90, 205, 0.28) 0%,
      rgba(70, 45, 140, 0.16) 45%,
      rgba(5, 4, 10, 0) 80%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Micro grid pattern for rich surface depth */
  .acmw-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(rgba(184, 167, 255, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 2;
  }

  .marquee-outer {
    width: 100%;
    overflow: hidden;
  }
  .marquee-outer:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track {
    display: flex;
    animation: marquee-loop 22s linear infinite;
    will-change: transform;
  }

  .marquee-set {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 60px;
    padding-right: 60px;
  }

  /* Typography with Texture Overlay */
  .motto-word {
    position: relative;
    font-family: "PolySans Trial", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 700;
    font-size: clamp(3.5rem, 9.5vw, 8rem);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(
      135deg,
      #ffffff 0%,
      #e2d9ff 40%,
      #b8a7ff 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }

  /* SVG Noise Overlay clipped precisely to the text */
  .motto-word::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='textNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23textNoise)' opacity='0.35'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 100px 100px;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Logo badge */
  .motto-logo {
    height: clamp(50px, 7vw, 90px);
    width: auto;
    flex-shrink: 0;
    opacity: 0.95;
    filter: drop-shadow(0 0 16px rgba(184, 167, 255, 0.45));
    transition: opacity 0.3s ease, filter 0.3s ease;
  }
  .marquee-outer:hover .motto-logo {
    opacity: 1;
    filter: drop-shadow(0 0 24px rgba(184, 167, 255, 0.70));
  }

  @keyframes marquee-loop {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
