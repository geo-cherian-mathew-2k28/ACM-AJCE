---
import "../styles/globals.css";
import { getAssetUrl } from "../utils/cdn";
---

<div class="igniting-minds-container w-screen overflow-hidden py-16 px-6 md:px-16 lg:px-24">
  <div id="community" class="absolute -top-24 pointer-events-none"></div>

  <!-- Section 1: Outreach Initiative (Game Dev Workshop for School Students) -->
  <div class="max-w-[1200px] mx-auto mb-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-white/10 pb-8 mb-10">
      <div class="flex flex-col gap-2">
        <span class="font-mono text-xs uppercase tracking-[0.3em] text-[#B8A7FF] flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-[#B8A7FF]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"/>
          </svg>
          01 // OUTREACH INITIATIVE
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tighter text-white uppercase">
          BEYOND THE <span class="relative inline-block text-[#B8A7FF]">
            NORM
            <!-- Wavy Underline Squiggle -->
            <svg class="absolute -bottom-2 left-0 w-full h-3 text-[#B8A7FF] pointer-events-none" viewBox="0 0 100 12" fill="none" preserveAspectRatio="none">
              <path d="M0 6 Q 25 0, 50 6 T 100 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </span>
          <svg class="w-6 h-6 text-[#B8A7FF] inline-block ml-1.5 align-middle animate-pulse drop-shadow-[0_0_10px_#B8A7FF]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"/>
          </svg>
        </h2>
      </div>
      <p class="font-mono text-xs text-gray-400 max-w-sm leading-relaxed uppercase">
        Game Development & Digital Logic Workshops empowering school students.
      </p>
    </div>

    <!-- Outreach Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-[#080911] border border-white/10 rounded-3xl p-8 md:p-12 relative overflow-hidden group hover:border-[#B8A7FF]/30 transition-all duration-500">

      <!-- Left: Text Details -->
      <div class="lg:col-span-7 flex flex-col gap-6 relative z-10">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-[#B8A7FF]/10 border border-[#B8A7FF]/30 text-[#B8A7FF] font-mono text-xs uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#B8A7FF]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"/>
            </svg>
            Classes 7 to 9
          </span>
          <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-gray-400 font-mono text-xs uppercase tracking-wider">
            Game Dev & Logic
          </span>
        </div>

        <h3 class="text-2xl md:text-3xl font-bold text-white uppercase tracking-tight">
          School Student Game Development Workshop
        </h3>

        <p class="text-xs md:text-sm text-gray-300 font-mono leading-relaxed uppercase">
          Through hands-on game development and flowchart logic, we introduced students from Classes 7 to 9 to binary thinking and interactive problem-solving. Students created their first logic-driven games while connecting core technology to creative game mechanics.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10 font-mono text-xs text-gray-400">
          <div>
            <span class="block text-white font-bold text-sm">Interactive</span>
            <span>Game Mechanics</span>
          </div>
          <div>
            <span class="block text-white font-bold text-sm">Flowcharts</span>
            <span>Digital Logic Gates</span>
          </div>
          <div>
            <span class="block text-white font-bold text-sm">Empowering</span>
            <span>Young Creators</span>
          </div>
        </div>
      </div>

      <!-- Right: Image Preview -->
      <div class="lg:col-span-5 relative h-64 lg:h-80 rounded-2xl overflow-hidden border border-white/10 group">
        <img
          src={getAssetUrl("/outreacch/outreach-event.webp")}
          alt="Outreach Game Dev Workshop"
          class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#080911] via-transparent to-transparent opacity-80"></div>
      </div>
    </div>
  </div>


  <!-- Section 2: Separated, Dedicated JOIN ACM Chapter Banner -->
  <div class="max-w-[1200px] mx-auto">
    <div class="relative rounded-3xl bg-[#090b16] border border-[#B8A7FF]/40 p-8 md:p-14 overflow-hidden group shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
      
      <!-- Subtle ambient glow -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-[#B8A7FF]/10 rounded-full blur-3xl pointer-events-none group-hover:bg-[#B8A7FF]/20 transition-all duration-700"></div>

      <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10">
        
        <!-- Left: Catchy Headline & Copy -->
        <div class="max-w-2xl flex flex-col gap-5">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs uppercase tracking-[0.3em] text-[#B8A7FF] font-bold flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#B8A7FF]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"/>
              </svg>
              02 // CHAPTER MEMBERSHIP
            </span>
            <span class="w-2 h-2 rounded-full bg-[#B8A7FF] animate-ping"></span>
          </div>

          <h2 class="text-3xl md:text-5xl font-extrabold text-white uppercase tracking-tighter leading-none">
            BECOME A PART OF <br />
            <span class="relative inline-block text-[#B8A7FF]">
              ACM AJCE CHAPTER
              <!-- Wavy Underline Squiggle -->
              <svg class="absolute -bottom-2 left-0 w-full h-3 text-[#B8A7FF] pointer-events-none" viewBox="0 0 100 12" fill="none" preserveAspectRatio="none">
                <path d="M0 6 Q 25 0, 50 6 T 100 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </span>
            <svg class="w-7 h-7 text-[#B8A7FF] inline-block ml-1.5 align-middle animate-pulse drop-shadow-[0_0_10px_#B8A7FF]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"/>
            </svg>
          </h2>

          <p class="font-mono text-xs md:text-sm text-gray-300 leading-relaxed uppercase">
            Join a thriving community of student developers, researchers, and creators. Get access to global ACM resources, peer-led hackathons, technical paper reviews, and collaborative engineering projects.
          </p>

          <div class="flex flex-wrap gap-4 pt-2 font-mono text-xs">
            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-gray-300">
              ✓ Global ACM Network
            </span>
            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-gray-300">
              ✓ Peer Code Reviews & Projects
            </span>
            <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-gray-300">
              ✓ National Conferences & Workshops
            </span>
          </div>
        </div>

        <!-- Right: Separated Standalone Action Block -->
        <div class="w-full lg:w-auto flex flex-col gap-4 min-w-[280px]">
          <div class="p-6 rounded-2xl bg-[#06070d] border border-white/10 flex flex-col gap-4 relative overflow-hidden">
            <div class="flex items-center justify-between font-mono text-xs text-gray-400">
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#B8A7FF]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"/>
                </svg>
                MEMBERSHIP STATUS
              </span>
              <span class="text-emerald-400 font-bold">ACTIVE</span>
            </div>
            <div class="font-mono text-xs text-gray-400 border-t border-white/10 pt-3">
              Open to all students across all engineering branches.
            </div>
            <a
              href="/membership"
              class="w-full py-4 px-6 rounded-xl bg-[#B8A7FF] text-[#0a0b14] font-mono font-bold text-xs uppercase tracking-[0.2em] flex items-center justify-center gap-3 hover:bg-white transition-all duration-300 shadow-[0_0_25px_rgba(184,167,255,0.4)]"
            >
              <span>REGISTER NOW</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

</div>
