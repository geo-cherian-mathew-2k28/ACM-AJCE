---
import "../styles/globals.css";
import { getAssetUrl } from "../utils/cdn";
---

<div class="min-h-screen overflow-x-hidden">
  <!-- Part A: Outreach Event -->
  <div id="community" class="absolute -top-24 pointer-events-none"></div>
  <section
    id="community-outreach"
    class="relative z-20 py-12 md:py-20 border-t border-white/10 overflow-hidden"
  >
    <div
      class="max-w-[1400px] mx-auto md:grid md:grid-cols-10 md:grid-rows-5 gap-0 relative z-10 md:min-h-[600px]"
    >
      <!-- Horizontal Lines (Grid Row 3) - Visible on Left -->
      <div
        class="community-divider hidden md:block col-start-1 col-end-11 row-start-3 row-end-4 pointer-events-none z-20"
      >
      </div>

      <!-- Left: Text Content -->
      <!-- Top Section - Title (Rows 1-2) -->
      <div
        class="community-rail flex flex-col h-full md:col-start-1 md:col-end-6 md:row-start-1 md:row-end-3"
      >
        <div class="p-6 md:p-10 flex items-start h-full">
          <h1
            class="text-5xl sm:text-6xl md:text-7xl lg:text-[8rem] leading-[0.85] font-bold text-[#FBFAFF] uppercase tracking-tighter break-words"
          >
            OUTREACH<br />
            <span class="text-[#B8A7FF]">EVENT</span>
          </h1>
        </div>
      </div>

      <!-- Middle Section - Beyond the Norm (Row 3) -->
      <div
        class="community-rail flex flex-col h-full md:col-start-1 md:col-end-6 md:row-start-3 md:row-end-4"
      >
        <div class="px-6 md:px-10 py-4 md:py-0 flex items-center h-full">
          <div class="relative">
            <div
              class="text-[#B8A7FF] text-3xl sm:text-4xl md:text-5xl font-bold font-['Inter'] leading-tight md:leading-none"
            >
              BEYOND <img
                src={getAssetUrl("/outreacch/beyond-norm-logo.webp")}
                alt="Logo"
                class="inline h-8 sm:h-10 md:h-12 ml-2 align-baseline"
                loading="lazy"
                decoding="async"
              /><br />THE NORM
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Section - Empty/Mobile Desc (Rows 4-5) -->
      <div
        class="community-rail flex flex-col h-full md:col-start-1 md:col-end-6 md:row-start-4 md:row-end-6"
      >
        <div class="p-6 md:p-10 h-full block md:hidden">
          <div
            class="text-left text-gray-300 text-xs sm:text-sm font-mono leading-relaxed"
          >
            OUR OUTREACH INITIATIVE BROUGHT THE WORLD OF COMPUTING TO STUDENTS
            OF CLASSES 7 TO 9, USING THE THEME "FLOWCHARTS AND DIGITAL LOGIC."
            THROUGH INTERACTIVE DEMONSTRATIONS, SIMPLIFIED EXPLANATIONS OF
            BINARY THINKING, AND REAL-LIFE EXAMPLES OF LOGIC GATES, STUDENTS
            DISCOVERED HOW COMPUTERS "THINK" AND SOLVE PROBLEMS. THE SESSION NOT
            ONLY INTRODUCED THEM TO STRUCTURED PROBLEM-SOLVING THROUGH
            FLOWCHARTS BUT ALSO CONNECTED EVERYDAY TECHNOLOGY TO THE
            FUNDAMENTALS OF DIGITAL DESIGN, SPARKING CURIOSITY AND ENCOURAGING
            YOUNG LEARNERS TO EXPLORE THE WORLD OF COMPUTING.
          </div>
        </div>
      </div>

      <!-- Right: Image and Description (Rows 1-5) -->
      <div
        class="relative h-[50vh] md:h-full group md:col-start-6 md:col-end-11 md:row-start-1 md:row-end-6"
      >
        <!-- Image -->
        <div class="absolute inset-0">
          <img
            src={getAssetUrl("/outreacch/outreach-event.webp")}
            alt="Outreach Event"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Overlay Text - Only on desktop -->
        <div
          class="hidden md:block absolute bottom-8 right-10 left-10 text-right text-gray-300 text-sm font-mono leading-relaxed max-w-lg ml-auto z-10"
        >
          OUR OUTREACH INITIATIVE BROUGHT THE WORLD OF COMPUTING TO STUDENTS OF
          CLASSES 7 TO 9, USING THE THEME "FLOWCHARTS AND DIGITAL LOGIC."
          THROUGH INTERACTIVE DEMONSTRATIONS, SIMPLIFIED EXPLANATIONS OF BINARY
          THINKING, AND REAL-LIFE EXAMPLES OF LOGIC GATES, STUDENTS DISCOVERED
          HOW COMPUTERS "THINK" AND SOLVE PROBLEMS. THE SESSION NOT ONLY
          INTRODUCED THEM TO STRUCTURED PROBLEM-SOLVING THROUGH FLOWCHARTS BUT
          ALSO CONNECTED EVERYDAY TECHNOLOGY TO THE FUNDAMENTALS OF DIGITAL
          DESIGN, SPARKING CURIOSITY AND ENCOURAGING YOUNG LEARNERS TO EXPLORE
          THE WORLD OF COMPUTING.
        </div>
      </div>
    </div>
  </section>

  <!-- Part B: SDG Section -->
  <section
    id="community-sdg"
    class="relative z-20 py-12 md:py-20 border-t border-white/10 overflow-hidden"
  >
    <div
      class="max-w-[1400px] mx-auto flex flex-col md:grid md:grid-cols-10 md:grid-rows-5 gap-0 relative z-10 md:min-h-[600px]"
    >
      <!-- Horizontal Lines (Grid Row 3) - Visible on Left -->
      <div
        class="community-divider hidden md:block col-start-1 col-end-11 row-start-3 row-end-4 pointer-events-none z-20"
      >
      </div>

      <!-- Left Side -->
      <!-- Top Section - Empty (Rows 1-2) -->
      <div
        class="community-rail hidden md:flex flex-col h-full md:col-start-1 md:col-end-6 md:row-start-1 md:row-end-3"
      >
        <div class="hidden md:block h-full p-10"></div>
      </div>

      <!-- Middle Section - Educate Young Minds (Row 3) -->
      <div
        class="community-rail flex flex-col h-full order-2 md:order-1 md:col-start-1 md:col-end-6 md:row-start-3 md:row-end-4"
      >
        <div class="px-6 md:px-6 py-4 md:py-0 flex items-center h-full">
          <div class="relative">
            <div
              class="text-[#B8A7FF] text-3xl sm:text-4xl md:text-5xl font-bold font-['Inter'] leading-tight md:leading-none"
            >
              EDUCATE <img
                src={getAssetUrl("/outreacch/beyond-norm-logo.webp")}
                alt="Logo"
                class="inline h-8 sm:h-10 md:h-12 ml-2 align-baseline"
                loading="lazy"
                decoding="async"
              /><br />YOUNG MINDS
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Section - Description (Rows 4-5) -->
      <div
        class="community-rail flex flex-col h-full order-3 md:order-1 md:col-start-1 md:col-end-6 md:row-start-4 md:row-end-6"
      >
        <div class="p-6 md:p-2 h-full flex items-start md:items-end">
          <div
            class="text-left text-gray-300 text-xs sm:text-sm font-mono leading-relaxed max-w-lg"
          >
            ALIGNED WITH UN SUSTAINABLE DEVELOPMENT GOAL 4: QUALITY EDUCATION.
            THIS WORKSHOP FOCUSED ON REDUCING THE DIGITAL LEARNING GAP IN RURAL
            COMMUNITIES. PARTICIPANTS EXPLORED MODERN WEB TECHNOLOGIES AND
            LEARNED HOW SIMPLE DIGITAL TOOLS CAN STRENGTHEN CLASSROOMS WITH
            LIMITED RESOURCES. BY COMBINING TECHNICAL LEARNING WITH REAL SOCIAL
            IMPACT, THE SESSION EMPHASIZES ACM AJCE'S COMMITMENT TO INCLUSIVE,
            TECHNOLOGY-DRIVEN GROWTH, EMPOWERING PARTICIPANTS TO SUPPORT BETTER
            EDUCATIONAL ACCESS IN RURAL AREAS.
          </div>
        </div>
      </div>

      <!-- Right Side: SDG Title (Rows 1-5) -->
      <div
        class="p-6 md:p-10 flex flex-col justify-start h-full order-1 md:order-2 md:col-start-6 md:col-end-11 md:row-start-1 md:row-end-6"
      >
        <div
          class="md:h-[43%] flex flex-col items-start justify-start gap-4 md:gap-6 pt-0 md:pt-8"
        >
          <h1
            class="text-6xl sm:text-7xl md:text-[8rem] leading-none font-bold text-[#FBFAFF] uppercase tracking-tighter"
          >
            SDG
          </h1>
          <h2
            class="text-2xl sm:text-3xl md:text-4xl text-[#B8A7FF] font-normal leading-tight"
          >
            Simplifying Digital<br />
            Learning for Rural Schools
          </h2>
        </div>
        <!-- Empty spacers maintained for spacing emulation if needed, or removed if handled by simple flow -->
        <div class="hidden md:flex md:h-[14%] items-center"></div>
        <div class="hidden md:flex md:h-[43%] items-end justify-end"></div>
      </div>
    </div>
  </section>

  <section
    id="community-chapter"
    class="relative z-20 py-12 md:py-20 border-t border-white/10 overflow-hidden"
  >
    <div
      class="max-w-[1400px] mx-auto flex flex-col md:grid md:grid-cols-10 md:grid-rows-5 gap-0 relative z-10 md:min-h-[640px]"
    >
      <div
        class="order-2 md:order-1 flex flex-col h-full md:col-start-1 md:col-end-6 md:row-start-1 md:row-end-6"
      >
        <div class="p-6 md:p-10 md:pr-14 h-full flex flex-col justify-between gap-8">
          <div class="space-y-6">
            <p
              class="text-[#B8A7FF] text-xs sm:text-sm font-mono tracking-[0.28em] uppercase"
            >
              ACM membership
            </p>
            <h1
              class="community-award-title text-5xl sm:text-6xl md:text-7xl lg:text-[6.75rem] leading-[0.86] font-bold text-[#FBFAFF] uppercase tracking-tighter"
            >
              A NEW<br />
              <span class="text-[#B8A7FF]">CHAPTER</span>
            </h1>
          </div>

          <div class="max-w-xl space-y-5">
            <h2
              class="text-[#FBFAFF] text-xl sm:text-2xl md:text-3xl font-semibold leading-tight"
            >
              Learn, build, and belong
            </h2>
            <p
              class="text-gray-300 text-xs sm:text-sm font-mono leading-relaxed uppercase"
            >
              ACM membership gives you access to a global computing community,
              professional learning, and a stronger connection to the work we
              build at ACM AJCE.
            </p>
            <p
              class="text-gray-400 text-xs sm:text-sm font-mono leading-relaxed"
            >
              Join as we begin this new chapter on campus and make more room
              for students who want to learn, contribute, and find their
              people in technology.
            </p>
            <a
              href="/membership"
              class="inline-flex items-center gap-3 text-[#FBFAFF] text-xs sm:text-sm font-mono uppercase tracking-[0.18em] border border-white/12 px-4 py-3 transition-colors duration-300 hover:border-[#B8A7FF] hover:text-[#B8A7FF]"
            >
              Join ACM
              <span aria-hidden="true" class="text-[#B8A7FF]">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <div
        class="order-1 md:order-2 relative md:col-start-6 md:col-end-11 md:row-start-1 md:row-end-6 min-h-[320px] sm:min-h-[420px] md:min-h-0"
      >
        <div class="absolute inset-0 p-4 md:p-10 md:pl-32 flex items-center justify-center">
          <div
            class="relative h-full w-full flex items-center justify-center overflow-hidden"
          >
            <div class="flex h-full w-full items-center justify-center border border-[#B8A7FF]/35 bg-[#2A2455]/45">
              <p class="font-mono text-3xl font-bold tracking-[0.18em] text-[#B8A7FF] sm:text-5xl">JOIN ACM</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .bg-dots-pattern {
    background-image:
      linear-gradient(rgba(184, 167, 255, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(184, 167, 255, 0.14) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .community-divider {
    display: none;
  }

  .community-rail {
    position: relative;
  }

  @media (min-width: 768px) {
    .community-rail::after {
      content: "";
      position: absolute;
      top: clamp(1.75rem, 4vw, 3.75rem);
      right: clamp(1.75rem, 4vw, 3.75rem);
      width: clamp(3.25rem, 8vw, 8rem);
      height: clamp(2.5rem, 6vw, 5.5rem);
      border-top: 1px solid rgba(184, 167, 255, 0.42);
      border-right: 1px solid rgba(184, 167, 255, 0.42);
      opacity: 0.86;
    }

    .community-rail::before {
      content: "";
      position: absolute;
      top: clamp(4rem, 10vw, 9.25rem);
      right: clamp(1.55rem, 3.8vw, 3.55rem);
      width: 7px;
      height: 7px;
      background: #B8A7FF;
      box-shadow: 0 0 16px rgba(184, 167, 255, 0.62);
      transform: rotate(45deg);
      z-index: 30;
    }
  }

  @media (min-width: 768px) {
    .community-rail:nth-child(2n)::after {
      top: auto;
      bottom: clamp(1.75rem, 4vw, 3.75rem);
      border-top: 0;
      border-bottom: 1px solid rgba(184, 167, 255, 0.42);
    }

    .community-rail:nth-child(2n)::before {
      top: auto;
      bottom: clamp(4rem, 10vw, 9.25rem);
    }
  }

  @media (max-width: 399.98px) {
    .community-award-title {
      font-size: 2.4rem;
    }
  }
</style>
